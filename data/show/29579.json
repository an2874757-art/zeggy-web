":{"image":"https://cdn6.albox.co/storage/disk46/shows/69433743-ee0e-4022-b8f6-5e4dd3a27f7d.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":29579,"title":"","description":"21","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":29579,"type":"SERIES","title":"Fedakar - التضحية","logo":"","image":"https://cloud01.albox.co/seasons/36cd52ee-c4b6-412b-88d4-8974b9f6d992.jpg","background_image":"https://cloud01.albox.co/seasons/eef25209-bed4-4a9b-9312-311697824b34.jpg","likes":177,"dislikes":12,"views":45937,"release_date":"1679097600000","season_number":1,"description":"تدور الاحداث حول القصة المؤثرة لطارق . الذي يريد الانتقام من قاتل شقيقه . وأليف ، الذي لا يستطيع مواجهة حقيقة أن الشيء الوحيد الذي يجب التمسك به في الحياة هو القاتل ، يلتقي بالجمهور مع مسلسل التضحية فيدكار. إليف ، التي فقدت والدتها في سن مبكرة ، هي أخت مخلصة تدعم أشقائها سيفر ونارين. بينما تعيش إليف حياة مليئة بالصعوبات ، تفقد أختها الصغرى نارين ولا يبقى معها سوى سيفر. بينما يتشبث الشقيقان ببعضهما البعض ، تشعر \"إليف\" بالصدمة فجأة بسبب الادعاء بأن أختها \"سيفر\" هي القاتلة. الحياة السعيدة والهادئة لطارق ، الوريث الوحيد لشركة Karaca Holding ، إحدى الشركات القليلة في تركيا ، تتغير فجأة مع مقتل أخته الكبرى ، التي يحبها كثيرًا. يخطف طارق أليف للقبض على سيفر التي فُقدت لاعتقادها أن سيفر قتلت شقيقتها الكبرى يسيم. بينما يقسم طارق على الانتقام لأخته ، أبحر إليف وطارق من أجل حب مستحيل. هل سيساعد الوقت في كسر العقبات التي لا يمكن التغلب عليها؟ هل تكفي قوة الحب لنسيان ألم الأشقاء؟ هل ستشفي رحمة أليف جراح طارق؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"background_color":"","current_season_id":16756,"content_control":"NORMAL"}}