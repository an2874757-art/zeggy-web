":0,"continue_watching_progress":0},{"items":[],"id":27174,"title":"Ek Villain Returns","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/e87f5f7c-168e-4fc9-9eb7-c4313d16b5b2.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":37983,"title":"Maalik","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/2363fc64-4ef4-4230-875f-d800c0187775.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":11504,"title":"Horror Story","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk57/shows/3f982b5f-018e-4e60-81df-d73059294d18.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":33894,"title":"Savi","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/f94af1f9-2a6b-4bcf-9b57-a2c285ceb797.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":1905,"title":"Street Dancer 3D","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk54/shows/ed55f02b-9f2c-4af4-91df-18a2c5bd6da0.png"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":11411,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Crime"],"id":11411,"type":"MOVIE","title":"Singh Is Kinng","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/b9b9fe0c-89bc-4f43-81c9-649aa272666f.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/3b646955-0c57-4be6-951b-7e34a08804f8.jpg","likes":26,"dislikes":1,"views":3489,"release_date":"1218153600000","length":8175,"description":"Happy Singh lives in a small village in Punjab. He is always compassionate and helpful, but often ends up causing more damage so much so that the Village Panchayat gets together to reprimand him. When the community gets news that one of their residents, Lakhanpal Singh, is an underworld don in Australia, they decide to delegate someone to counsel him. The villagers chose Happy, so that they can get rid of him. Happy's ticket and other costs are paid for, and the Panchayat even asks a reluctant Rangeela to accompany him. Due to a mix-up, both end up in Egypt, leading to romance in Happy's life when he meets with Sonia, a Criminologist, who would prefer to have criminals killed than reform them. Both friends do find their way to Australia, where they locate Lakhanpal, who humiliates them and asks them to leave. Both befriend a boutique owner and live in her house. When rival goons attack Lakhanpal, Happy rescues him, and gets him hospitalized. Lakhanpal does recover, but is paralyzed. His goons comically misunderstand that he wants Happy to be Don, and he undergoes a transformation and moves in to live a wealthy lifestyle in Lakhanpal's mansion. When the boutique owner's daughter returns home along with her fiancé, Punit, Happy plans a charade to make her believe that the mansion belongs to her. Happy's life will soon be turned upside down when the daughter turns out to be none other than Sonia herself. Being aware of Sonia's dislike for criminals, he will have no option but to plan a lavish wedding for her, while rival gangsters, and even some of Lakhanpal's goons, plan to get rid of him.","rating":{"sources":[],"value":0,"age":"N/A"},"episode_id":11411,"content_control":"NORMAL"}}