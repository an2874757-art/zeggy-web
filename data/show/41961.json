es":["Documentary"],"id":41961,"type":"MOVIE","title":"The American Southwest","logo":"https://cloud02.albox.co/shows/16a053a7-6380-4e68-8407-c67d89b6da13.JPG","image":"https://cloud02.albox.co/shows/d46b09a9-5aa3-4c91-9cbc-fd85ee3bd7fe.jpg","background_image":"https://cloud02.albox.co/shows/276ce13a-e7be-44b3-9955-5d8c50bf2b01.jpg","likes":0,"dislikes":0,"views":39,"release_date":"1757030400000","length":6411,"description":"The American Southwest is a feature length blue chip natural history film narrated by indigenous environmentalist Quannah Chasinghorse.  The movie journeys down the mighty Colorado River, examining the astonishing beauty and biodiversity of the region, while confronting the environmental destruction from dams and the perilous fate of the river.  The story is told through never-before-seen wildlife sequences such as beavers building wetlands, condors recovering from the brink, and the potential return of Jaguars to American soil.  The film beautifully advocates for better management of the river and increased wildlife conservation efforts in the iconic landscapes of The American Southwest.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"TV-14"},"episode_id":1067625,"background_color":"#8d1111","content_control":"FAMILY"}}