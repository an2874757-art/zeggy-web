ogress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16485,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"],"id":16485,"type":"SERIES","title":"عيلة ست نجوم","logo":"","image":"https://cdn6.albox.co/storage/disk52/seasons/0e3319f6-1e2f-44c2-9b8e-19971988cbdd.jpg","background_image":"https://cdn6.albox.co/storage/disk44/seasons/d9feae01-c897-4741-b255-32d36d7869fe.jpg","likes":28,"dislikes":0,"views":2811,"release_date":"-2208988800000","season_number":1,"description":"مسلسل سوري كوميدي تقع أحداثه في 26 حلقة مختلفة العناوين. تدور القصة الرئيسة للمسلسل حول عائلة فردوس (أم جميل)، التي تعيش مع ابنها (جميل) وزوجته (بثينة)، وابنتها (كوثر) وزوجها (فرج) في شقة حصلت عليها كتعويض مادي من شركة إنتاج سينمائي، كتعويض عن استخدام اسمها مصادفة في أحد أفلام الشركة. ينقلب حال العائلة رأسًا على عقب، وتصبح (أم جميل) سيدة أعمال لها عملها ومكانتها في المجتمع.","rating":{"sources":[],"value":0,"age":"PG-13"},"current_season_id":4152,"content_control":"NORMAL"}}