b0abed6-d68f-4b1a-89df-0a6e9e271e66.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4331,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Animation","Crime"],"id":4331,"type":"MOVIE","title":"Psycho-Pass: The Movie","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/77be9121-5a67-43c8-91f8-44308033bec6.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/14af947c-6706-4e5d-b787-a9115442f49c.jpg","likes":58,"dislikes":0,"views":4450,"release_date":"1456704000000","length":6796,"description":"Year 2116-The Japanese government begins to export the Sibyl System unmanned drone robots to troubled countries, and the system spreads throughout the world. A state in the midst of a civil war, SEAUn (the South East Asia Union), brings in the Sibyl System as an experiment. Under the new system, the coastal town of Shambala Float achieves temporary peace and safety. But then SEAUn sends terrorists to Japan. They slip through the Sibyl System and then attack from within. The shadow of a certain man falls on this incident. In charge of the police, Tsunemori travels to Shambala Float to investigate. The truth of justice on this new ground will become clear.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":4331,"content_control":"NORMAL"}}