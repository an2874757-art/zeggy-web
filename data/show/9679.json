a":[{"items":[],"id":9679,"title":"","description":"27","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Mystery"],"id":9679,"type":"MOVIE","title":"Before I Go to Sleep","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/9896a661-8fc1-458c-9dc9-9fe140ef18a1.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/779f44c1-3ac5-491c-b552-b8f03aaf5ede.jpg","likes":105,"dislikes":7,"views":12788,"release_date":"1414713600000","length":5512,"description":"Forty-year-old Christine Lucas wakes up in bed with a man she does not know, in an unfamiliar house. The man explains that he is her husband, Ben, and that she suffered brain damage from a car accident ten years earlier. Christine wakes up every morning with no memory of her life from her early twenties onwards. Christine receives treatment from Dr. Nasch, a neurologist at a local hospital who provides her a camera to record her thoughts and progress each day, and calls her every morning to remind her to watch the video in the camera. Soon, she starts to discover the truth around her.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"R"},"episode_id":9679,"content_control":"FAMILY"}}