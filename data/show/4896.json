d01.albox.co/shows/dff64791-b8e5-4aec-9202-d8ceccb00880.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":26987,"title":"The Next 365 Days","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/766a5a96-177a-405c-af88-90b0831cb6c4.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10594,"title":"Shutter Island","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/e89fdffc-0097-405b-8526-8d40f79ce6fc.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4896,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Music"],"id":4896,"type":"MOVIE","title":"Cover Girl","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/f9cadca2-e2a3-4edd-8ae5-ce785ff071ea.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/4e6253ea-957a-40e8-82da-fb9b4500bd08.jpg","likes":6,"dislikes":3,"views":5681,"release_date":"-812246400000","length":6422,"description":"Rusty Parker, a red-headed leggy dancer at Danny McGuire's Night Club in Brooklyn, wants to be a successful Broadway star. She enters a contest to be a 'Cover Girl' as a stepping-stone in her career. She reminds the publisher, John Coudair, of his lost love, showgirl Maribelle Hicks. He was engaged to Maribelle, although his wealthy society mother made fun of her. Maribelle left John at the altar when she saw the piano at her wedding. It reminded her of the piano-player she truly loved. Rusty is Maribelle's granddaughter and there are musical sequences with Maribelle dancing to songs from the beginning of the 20th century. Rusty lands on the cover of her grandmother's former fiancé's magazine (as a bride). She is pursued by Coudair's pal, the wealthy theatrical producer, Noel Wheaton. He produces a lavish musical to star Rusty, surrounded by real cover girls of the mid 1940's. Rusty runs down a huge spiral into the arms of dozens of men who seem clumsy next to her ethereal dancing. But her success threatens Danny McGuire. He expressed his distress that his girlfriend will find success without him in Kelly's famous dance with himself, 'Alter Ego'. He and his sidekick, Genius, leave New York and entertain soldiers fighting in World War II. Rusty agrees to marry Noel, dazzled by success, security, and his power and money. But she drinks and loses weight because her heart belongs to Danny. She receives a symbolic pearl with great power and tells Coudair and Wheaton that she must spend her life with the man she loves.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"episode_id":4896,"content_control":"NORMAL"}}