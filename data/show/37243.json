s/885c5d96-563d-4ccb-a695-1dada9da9887.png","image":"https://cloud02.albox.co/shows/ec7d8e06-c0e2-4584-b964-12ab5b0c4205.jpg","background_image":"https://cloud02.albox.co/shows/e363f461-1f32-4beb-8d97-ed4984daf25f.jpg","likes":305,"dislikes":6,"views":32434,"release_date":"1743120000000","length":7184,"description":"في اليابان التي تعجّ بالكاياجو، يعمل كافكا هيبينو في التخلص من الوحوش. بعد لقائه بصديقة طفولته مينا أشيرو، النجمة الصاعدة في قوة الدفاع المضادة للكاياجو، يقرر كافكا السعي وراء حلمه المهجور بالانضمام إلى القوة... عندما يتحول فجأة إلى \"الكايجو رقم 8\" القوي. بمساعدة زميله الأصغر رينو إيتشيكاوا، يُخفي كافكا هويته بينما يسعى جاهدًا لتحقيق حلمه القديم باجتياز امتحان قوة الدفاع والوقوف إلى جانب مينا. ولكن عندما يهاجم كايجو ذكي وغامض قاعدةً لقوة الدفاع، يواجه كافكا قرارًا حاسمًا في موقفٍ يائس...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"episode_id":992754,"background_color":"","content_control":"FAMILY"}}