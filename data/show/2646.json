th":0,"continue_watching_progress":0},{"items":[],"id":41020,"title":"Human Resource","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/6dd7df0a-5721-4d3d-8212-95dda1fbdde5.JPG"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2646,"title":"","description":"48","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","History"],"id":2646,"type":"MOVIE","title":"Harakiri","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/d5c348ae-d802-4443-9f01-5aa00bbaa9d9.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/79e7b0fa-a429-4d9a-b747-c4ddd4802959.jpg","likes":174,"dislikes":4,"views":13189,"release_date":"-170726400000","length":7981,"description":"Peace in 17th-century Japan causes the Shogunate's breakup of warrior clans, throwing thousands of samurai out of work and into poverty. An honorable end to such fate under the samurai code is ritual suicide, or hara-kiri (self-inflicted disembowelment). An elder warrior, Hanshiro Tsugumo (Tatsuya Nakadai) seeks admittance to the house of a feudal lord to commit the act. There, he learns of the fate of his son-in-law, a young samurai who sought work at the house but was instead barbarically forced to commit traditional hara-kiri in an excruciating manner with a dull bamboo blade. In flashbacks the samurai tells the tragic story of his son-in-law, and how he was forced to sell his real sword to support his sick wife and child. Tsugumo thus sets in motion a tense showdown of revenge against the house.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"R"},"episode_id":2646,"content_control":"FAMILY"}}