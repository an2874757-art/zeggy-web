yle":{"image":"https://cdn6.albox.co/storage/disk44/shows/402641cb-5e0c-469e-a335-9b14e55ccae7.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14125,"title":"The Blacklist","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/ac14bb8d-9971-4f78-a4e5-c2d77e44ce57.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19456,"title":"Oz","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/d9ac345f-209f-4301-b48d-fa4762d276fc.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":20942,"title":"","description":"59","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Drama","Thriller","Crime","Mystery"],"id":20942,"type":"SERIES","title":"person of interest","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/f00a70f5-39f4-4dfe-8879-9cc1d18636dd.jpg","background_image":"https://cdn6.albox.co/storage/disk53/seasons/ab62bf3b-e4b5-444b-96ea-b6ffb246a471.jpg","likes":665,"dislikes":10,"views":138089,"release_date":"1316649600000","season_number":1,"description":"A billionaire software-genius named Harold Finch creates a Machine for the government that is designed to detect acts of terror before they can happen, by monitoring the entire world through every cell-phone, email and surveillance camera. Finch discovered that the machine sees everything, potential terrorist acts and violent crimes that involve ordinary people. When the government considered violent crimes between normal people \"irrelevant\", Finch built a back door into the system that gives him the social security number of a person involved in a future violent crime so he could act. Partnered with John Reese, an ex-CIA agent, the two work in secret to prevent violent crimes before they can happen. Eventually their activities lead to being hunted by the New York Police Department, CIA Agents in pursuit of Reese who was listed as dead, a computer hacker named Root who wants access to the Machine, and government officials who want to keep all knowledge of the Machine a complete secret.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"PG-13"},"current_season_id":10095,"content_control":"FAMILY"}}