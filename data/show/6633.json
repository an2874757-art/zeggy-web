tps://cdn6.albox.co/storage/disk47/shows/1cf297ff-271f-4ba1-ae8f-8c2a57e505d2.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6633,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Drama","Comedy","Music","Animation","Family"],"id":6633,"type":"MOVIE","title":"The Lorax","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/73889f50-b170-4ed2-890f-754db26108fc.png","background_image":"https://cdn6.albox.co/storage/disk42/shows/1bfa4831-7813-470d-86b6-c39efc5697c9.png","likes":108,"dislikes":3,"views":9951,"release_date":"1330646400000","length":5179,"description":"In the walled city of Thneed-Ville, where everything is artificial and even the air is a commodity, a boy named Ted hopes to win the heart of his dream girl, Audrey. When he learns of her wish to see a real tree, Ted seeks out the Once-ler, a ruined old businessman outside of town in a stark wasteland. Upon hearing of how the hermit gave into his greed for profits and devastated the land over the protests of the Lorax, Ted is inspired to undo the disaster. However, the greedy Mayor of Thneed-Ville, Aloysius O'Hare, has made his fortune exploiting the environmental collapse and is determined to stop the boy from undermining his business.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"PG"},"episode_id":6633,"content_control":"FAMILY"}}