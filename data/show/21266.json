 وهي أنها والمرأة المنتحرة في الحقيقة مستنسختان. بينما تبحث سارة عن أجوبة لتكتشف كارثة وهي أنه يوجد العديد مثلها ومثل المنتحرة تم زرعهم في المجتمع في ظروفٍ اجتماعيةٍ مختلفة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"current_season_id":10589,"content_control":"NORMAL"}}