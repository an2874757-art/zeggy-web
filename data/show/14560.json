ems":[],"id":14560,"title":"","description":"13","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Romance","Comedy","Historical"],"id":14560,"type":"SERIES","title":"The Romance of Tiger and Rose","logo":"","image":"https://cdn6.albox.co/storage/disk46/seasons/81b70439-e634-4f6b-b7f5-45c96d22d4d7.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/577b0009-ead8-4b84-9e0a-bb7c9868d640.jpg","likes":114,"dislikes":2,"views":7713,"release_date":"1589760000000","season_number":1,"description":"Chen Xiao Qian has dedicated her entire life to making her dream of becoming a well-respected screenwriter come true. Standing on the production set of the sweeping drama she penned through endless blood, sweat, and tears, Xiao Qian can hardly believe what she’s seeing: her work, come to life! Proud of the effort she put into creating this epic tale, Xiao Qian expects things on-set to go quickly and smoothly. But all her high-hopes are soon crushed as her script falls under the critical scrutiny of both the cast and crew.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"PG-13"},"current_season_id":1502,"content_control":"NORMAL"}}