tching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Short","Documentary"],"id":9057,"type":"MOVIE","title":"Dream Big: Engineering Our World","logo":"","image":"https://cdn6.albox.co/storage/disk41/shows/1496330e-3c38-4df9-b6db-2892f1705a35.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/ecae9377-4098-487c-85f8-33ad442117e0.jpg","likes":5,"dislikes":0,"views":5215,"release_date":"1487289600000","length":2533,"description":"Narrated by Academy Award® winner Jeff Bridges, DREAM BIG: Engineering Our World is a first film of its kind for IMAX® and giant screen theaters that will transform how we think about engineering. From the Great Wall of China and the world's tallest buildings to underwater robots, solar cars and smart, sustainable cities, DREAM BIG celebrates the human ingenuity behind engineering marvels big and small, and shows how engineers push the limits of innovation in unexpected and amazing ways. With its inspiring stories of human grit and aspiration, and extraordinary visuals for the world's largest screens, DREAM BIG reveals the compassion and creativity that drive engineers to create better lives for people and a more sustainable future for us all. DREAM BIG is a MacGillivray Freeman film produced in partnership with American Society of Civil Engineers and presented by Bechtel Corporation.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":9057,"background_color":"","content_control":"NORMAL"}}