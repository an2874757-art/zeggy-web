d_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":15288,"type":"SERIES","title":"وتلتقي القلوب","logo":"","image":"https://cdn6.albox.co/storage/disk48/seasons/5fd61d6b-6d59-4330-80c9-2933bbbb9cdb.jpg","background_image":"https://cdn6.albox.co/storage/disk57/seasons/9ddf481a-d222-493a-b8bc-b93e8350eace.jpg","likes":40,"dislikes":1,"views":8014,"release_date":"1538956800000","season_number":1,"description":"ابنة المليونير متعددة الأعمال الملياردير كيشان شروف الذي هو في إجازة لها في غوا، يقف bemusedly بالقرب من السقوط الراغبين. وقالت انها تجد من الصعب جدا لجعل الرغبة، لأنها ولدت مع ملعقة ذهبية وحصل على كل شيء في حياتها. والمصطاف غاضب (Neelu كولي)، الذي ينتظر بدوره لها لجعل الرغبة، يقول Aanya أنها ينبغي أن تجعل رغبة أن يخسر كل شيء في حياتها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"background_color":"","current_season_id":2512,"content_control":"NORMAL"}}