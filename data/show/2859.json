albox.co/storage/disk54/shows/157c6d4c-8637-4ed1-b43f-306ef47e5329.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/2df2f356-7ebb-410f-bab4-c31f9655ebac.jpg","likes":18,"dislikes":0,"views":2991,"release_date":"998006400000","length":7731,"description":"تدور أحداث الفيلم في عام 1941، أي أثناء الحرب العالمية الثانية ،حين يتزعم النقيب الإيطالي كوريللي\"نيكولاس كيدج\" حامية عسكرية تحتل جزيرة سيفالونيا إحدى الجزر اليونانية.في بداية الأمر يثير إستياء وغضب القرويين وجود الضيوف غير المرغوب فيهم على أراضيهم، إلا أن كوريللي يبدأ التعايش المشترك معهم ، فيشاركهم أنشطتهم ، كما يقع في حب بيلاجيا\"بينلوبي كروز\" إحدى جميلات الجزيرة، فيبدأ الجيش ينجذبون بجمال وسحر اﻹيطاليين ، حتى تتلاشى جميع الخلافات تدريجيًّا، ويبدو وكأنهم يقضون عطلة في اليونان.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"R"},"episode_id":2859,"content_control":"NORMAL"}}