 الأدلة، تكشف شو شي آن هويتها، لكنها تساعدها سرًا في سعيها للانتقام. لكن تشنغ يو ران تكشف في النهاية عن مؤامرة أعمق وتكتشف العقل المدبر الحقيقي وراء هذه المأساة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"R"},"background_color":"","current_season_id":21068,"content_control":"NORMAL"}}