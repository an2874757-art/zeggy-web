ضحية بدلًا من (إقبال). تنجح الجريمة لكن (عصمت) يوهم رأفت بأن (إقبال) لم تمت، ويسلمه مسدسًا ليقتلها. وإذا بمفاجأة تحدث بالنهاية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"N/A"},"episode_id":7848,"content_control":"NORMAL"}}