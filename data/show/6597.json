:0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6597,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","History"],"id":6597,"type":"MOVIE","title":"Amistad","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk56/shows/2b732fdb-bb6d-4382-baf1-53f589128e28.jpg","likes":33,"dislikes":0,"views":4625,"release_date":"883008000000","length":9283,"description":"Amistad is the name of a slave ship traveling from Cuba to the U.S. in 1839. It is carrying a cargo of Africans who have been sold into slavery in Cuba, taken on board, and chained in the cargo hold of the ship. As the ship is crossing from Cuba to the U.S., Cinque, who was a tribal leader in Africa, leads a mutiny and takes over the ship. They continue to sail, hoping to find help when they land. Instead, when they reach the United States, they are imprisoned as runaway slaves. They don't speak a word of English, and it seems like they are doomed to die for killing their captors when an abolitionist lawyer decides to take their case, arguing that they were free citizens of another country and not slaves at all. The case finally gets to the Supreme Court, where John Quincy Adams makes an impassioned and eloquent plea for their release.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"episode_id":6597,"content_control":"NORMAL"}}