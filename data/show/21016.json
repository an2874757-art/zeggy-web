":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/7348a6fc-7783-461d-9bc5-189f3b01241d.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":21016,"title":"","description":"18","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Drama"],"id":21016,"type":"SERIES","title":"The Pacific","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/90e34ee3-f592-48dd-87db-299e4a5ca65a.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/a487b4c5-fc3b-4e28-9d01-8a866331c1fc.jpg","likes":334,"dislikes":6,"views":48381,"release_date":"1268524800000","season_number":1,"description":"The Pacific follows the lives of a U.S Marine Corps squad during the campaign within the Pacific against the Japanese Empire during WW2. Made by the creators of Band of Brothers, it follows a similar line of thought to outline the hardships of the common man during war. The Pacific is in parts a fast paced war series that can be enjoyed by action lovers whilst containing a more sensitive side when projecting the relationships (brotherhood) of Marines on the battlefield. Where The Pacific takes a new direction from its \"older brother\" is in its depiction of the lives of soldiers who were picked to return home to increase the sales of war bonds. In doing this it also depicts the life cycle of returned soldiers from initial joy to the eventual feeling of regret and to a certain extent shame felt by soldiers wanting to return to the war in service of either their comrades or nation.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"r"},"current_season_id":10214,"content_control":"NORMAL"}}