items":[],"id":10730,"title":"","description":"186","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime"],"id":10730,"type":"MOVIE","title":"Pulp Fiction","logo":"https://cdn6.albox.co/storage/CLOUD00/shows/cd4d8a7a-1890-434b-9a93-bfd75b71c12c.png","image":"https://cdn6.albox.co/storage/CLOUD00/shows/4e76ec8e-644c-41aa-b8c5-07a0f1b7264d.jpg","background_image":"https://cdn6.albox.co/storage/CLOUD00/shows/fbb90d2f-2b0a-4fd9-af06-9f951736bb04.jpg","likes":975,"dislikes":31,"views":91007,"release_date":"782092800000","length":9297,"description":"Jules Winnfield (Samuel L. Jackson) and Vincent Vega (John Travolta) are two hit men who are out to retrieve a suitcase stolen from their employer, mob boss Marsellus Wallace (Ving Rhames). Wallace has also asked Vincent to take his wife Mia (Uma Thurman) out a few days later when Wallace himself will be out of town. Butch Coolidge (Bruce Willis) is an aging boxer who is paid by Wallace to lose his fight. The lives of these seemingly unrelated people are woven together comprising of a series of funny, bizarre and uncalled-for incidents.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.9}],"value":8.9,"age":"R"},"episode_id":10730,"content_control":"FAMILY"}}