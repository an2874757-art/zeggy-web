nd_image":"https://cloud02.albox.co/seasons/cda3d873-7f6f-4610-a860-6582b5792d9e.jpg","likes":9,"dislikes":0,"views":871,"release_date":"1265155200000","season_number":1,"description":"تتناول الدراما القرارات الصعبة والقصص الإنسانية المؤثرة التي تحدث يوميًا في قسم أمراض النساء والتوليد، مع التركيز بشكل خاص على سيو هي يونغ، طبيبة التوليد الموهوبة والعازمة التي انتقلت للتو من قاعدة سيول المرموقة إلى المستشفى الفرعي. إن أسلوبها المباشر في التعامل مع حياتها المهنية يتناقض مع حياتها العاطفية، التي شابتها علاقتها برجل متزوج. ويصبح هذا الأمر أكثر تشابكًا عندما تلتقي بلي سانج شيك، رئيس وحدة العناية المركزة لحديثي الولادة، ويظهر صديقها القديم وانج جاي سوك اهتمامه أيضًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"background_color":"","current_season_id":20028,"content_control":"FAMILY"}}