lbox.co/shows/701fa02e-f796-47c9-8c4f-bfe9c3d1de7c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":742,"title":"","description":"15","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Comedy","Crime","Mystery"],"id":742,"type":"MOVIE","title":"Clue","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/534ef51a-9a5b-40b1-ad0a-e5ef3360ec8d.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/e90e92d7-a63a-4edf-8e83-681e7dcd6ee5.jpg","likes":40,"dislikes":2,"views":4108,"release_date":"503280000000","length":5812,"description":"Clue is a movie about six guests, a butler, and a maid, who are all involved in the murders of six people. The guests all meet at Hill House, where you learn that Professor Plum works in D.C., where everyone else lives. Colonel Mustard is a client of Miss Scarlet, who is the ex-employer of Yvette, the maid, who had an affair with the husband of Mrs. White, etc. Blackmailer Mr. Boddy gives each guest a weapon and tells them to kill butler Wadsworth to avoid being exposed. Add in Mrs. Peacock's craziness and Mr. Green's clumsiness, and meet a whole group tangled in a web of murder, lies, and hilarity.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG"},"episode_id":742,"content_control":"NORMAL"}}