de-81b1cdd322ee.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5236,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Romance","Comedy"],"id":5236,"type":"MOVIE","title":"A Midsummer Night's Dream","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/15d22ffc-6093-4927-b6e3-98345af850a1.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/aefb5700-58b4-4e45-a7b1-49ee6d37e814.jpg","likes":37,"dislikes":1,"views":5997,"release_date":"926640000000","length":7258,"description":"Shakespeare's intertwined love polygons begin to get complicated from the start--Demetrius and Lysander both want Hermia but she only has eyes for Lysander. Bad news is, Hermia's father wants Demetrius for a son-in-law. On the outside is Helena, whose unreturned love burns hot for Demetrius. Hermia and Lysander plan to flee from the city under cover of darkness but are pursued by an enraged Demetrius (who is himself pursued by an enraptured Helena). In the forest, unbeknownst to the mortals, Oberon and Titania (King and Queen of the faeries) are having a spat over a servant boy. The plot twists up when Oberon's head mischief-maker, Puck, runs loose with a flower which causes people to fall in love with the first thing they see upon waking. Throw in a group of labourers preparing a play for the Duke's wedding (one of whom is given a donkey's head and Titania for a lover by Puck) and the complications become fantastically funny.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"PG-13"},"episode_id":5236,"content_control":"NORMAL"}}