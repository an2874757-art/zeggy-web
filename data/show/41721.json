elated","section_type":"normalPoster"},{"data":[{"items":[],"id":41721,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Reality","Travel"],"id":41721,"type":"SERIES","title":"Blooms for Her","logo":"","image":"https://cloud02.albox.co/seasons/9b12d369-23b9-4485-87ae-12b03bceac16.jpg","background_image":"https://cloud02.albox.co/seasons/a52d1621-26ef-4c52-876d-eb783c68fbd6.jpg","likes":40,"dislikes":4,"views":9968,"release_date":"1783209600000","season_number":1,"description":"مي لين، عميلة سرية في المكتب المظلم، تحمل في قلبها ديناً دموياً يدفعها للمخاطرة بحياتها في لعبة مميتة. تشق طريقها بين عدة رجال - فهي السيف الأشد فتكاً في يد الأمير المجنون مورونغ جينغ، وبديلة عن حب ضائع في نظر الأمير الأكبر عديم الرحمة، وهوس يو تشين، الأمير الرهينة من تشاو، الذي يحرس بشدة. وسط صراعات السلطة على العرش، تتكشف ساحة وحشية من التلاعب والولاء - جميلة ومأساوية في آن واحد.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"NC-17"},"background_color":"","current_season_id":24327,"content_control":"NORMAL"}}