type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":40513,"type":"SERIES","title":"Neighborhood Stories","logo":"https://cloud02.albox.co/shows/e1757c35-b884-4db2-83ed-ea60cb420bc6.png","image":"https://cloud02.albox.co/seasons/393010d8-757a-47ad-b49e-b2f73e0abecb.jpg","background_image":"https://cloud02.albox.co/seasons/4191754d-1491-4e5d-be1e-1314a0c79f4b.jpg","likes":10,"dislikes":0,"views":507,"release_date":"810691200000","season_number":1,"description":"ميكاكو كودا فتاة تبلغ من العمر ستة عشر عامًا، طموحها الوحيد هو تأسيس علامتها التجارية الخاصة للملابس. ولتحقيق هذا الهدف، تدرس في مدرسة يازاوا للفنون المرموقة برفقة صديق طفولتها تسوتومو ياماغوتشي. ورغم أن من حولهما يفسرون قربهما وشجارهما الدائم على أنه علامة على حب ناشئ، إلا أن ميكاكو وتسوتومو ينكران ذلك، فهما لا يريان في بعضهما إلا صديقين.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"TV-PG"},"background_color":"#ff5050","current_season_id":23620,"content_control":"NORMAL"}}