l,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Music"],"id":6462,"type":"MOVIE","title":"Music and Lyrics","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/1a5ffafb-4239-48a8-994c-3a2cecbcf707.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/e807bef8-4a46-4f2c-9ced-f29e12faa4b3.jpg","likes":48,"dislikes":1,"views":8304,"release_date":"1171411200000","length":6247,"description":"Cheery Alex Fletcher lives comfortably in Manhattan off the residuals from his 80's pop success and reprising his hits at school reunions, theme parks, and state fairs. But those gigs are declining, so he jumps at the chance to write a song and record it with reigning teen idol Cora Corman. Trouble is, he's good at melodies but needs a lyricist and has less than a week to finish. Enter Sophie Fisher, subbing for a friend who waters Alex's plants; she's a pretty good poet, quick witted, and could do it, if she'd agree. But there's some sort of shadow over her head that Alex may not be able to charm his way past. And what if they do get a song written, what then?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":6462,"content_control":"FAMILY"}}