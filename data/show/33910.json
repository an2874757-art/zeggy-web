easons/9927e8db-bacd-40a6-9fe0-cf5a47d39943.jpg","background_image":"https://cloud02.albox.co/seasons/596c9121-59d9-4c7a-9464-5a94948a9c49.jpg","likes":568,"dislikes":15,"views":62496,"release_date":"1722729600000","season_number":1,"description":"اعتاد لي جون أن يكون لاعب تنس واعدًا، لكنه أصيب. وبعد ذلك فقد كل احترامه لذاته، وتغيرت حياته تماما. باستخدام ممحاة الذاكرة، تمحى ذاكرته، ويولد من جديد بأقصى قدر من احترام الذات والحضور. أول حب تم التلاعب به هو كيونغ جو يون، طبيب نفسي في مركز أبحاث الدماغ. من بين الأشخاص الآخرين المحيطين به شقيقه الأصغر لي شين، الذي تم تصنيفه كأفضل لاعب تنس في العالم. وفي الوقت نفسه، جيون ساي يان هو مترجم لي شين.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"background_color":"","current_season_id":19063,"content_control":"NORMAL"}}