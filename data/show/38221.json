صممةً على تغيير مصيرها، تتحكم في مصيرها. عندما تقابل جون تشي مجددًا - هذه المرة عبدًا عاجزًا - تشتريه للانتقام. لكن بينما يواجهان الأعداء معًا، تتحول الكراهية إلى حب، وتتشابك حياتهما بلا رجعة في معركة من أجل العدالة والفداء.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"background_color":"","current_season_id":22154,"content_control":"NORMAL"}}