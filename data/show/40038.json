و لدراسة التصميم المعماري، ثم سافرت لاحقًا إلى فرنسا للدراسة. كما عمل شياو مان في الخارج.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"NC-17"},"background_color":"#000","current_season_id":23375,"content_control":"FAMILY"}}