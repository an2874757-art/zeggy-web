on":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Thriller"],"id":9325,"type":"MOVIE","title":"The Insider","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/dabf5fe8-24a4-4bb5-850b-8d4fccb985ce.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/10bf5bab-fe37-465b-b521-a914e5805d04.jpg","likes":106,"dislikes":4,"views":8515,"release_date":"941760000000","length":9467,"description":"Balls-out \"60 Minutes\" producer Lowell Bergman sniffs a story when a former research biologist for Brown & Williamson, Jeff Wigand, won't talk to him. When the company leans hard on Wigand to honor a confidentiality agreement, he gets his back up. Trusting Bergman and despite a crumbling marriage, he goes on camera for a Mike Wallace interview and risks arrest for contempt of court. Westinghouse is negotiating to buy CBS, so CBS attorneys advise CBS News to shelve the interview and avoid a lawsuit. \"60 Minutes\" and CBS News bosses cave, Wigand is hung out to dry, Bergman is compromised, and the CEOs of Big Tobacco may get away with perjury. Will the truth come out?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"R"},"episode_id":9325,"content_control":"FAMILY"}}