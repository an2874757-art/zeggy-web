g_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5865,"title":"","description":"31","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Horror"],"id":5865,"type":"MOVIE","title":"See No Evil","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/106fbd46-8eee-4f3d-acaf-aa2cf183da79.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/80ff4249-1ae3-432a-97e2-fb45f6012102.jpg","likes":192,"dislikes":14,"views":45447,"release_date":"1147996800000","length":5040,"description":"While investigating a call in an abandoned house, Officer Frank Williams and a rookie find a woman brutally blinded, but they are attacked by a huge psychopath with an ax; the rookie is killed and Frank shoots the criminal in the head, but has a severed arm. Four years later, the mutilated Frank is relocated, working as a guard in the County Detention Center. Frank goes with some delinquents to the Blackwell Hotel, an abandoned place since a fire burnt the last two floors, with the purpose of cleaning the location, preparing it to work as a shelter for the homeless; in return, the criminals will have their sentences reduced. During the night, the inmate Kira who has some Christian tattoos on her body is kidnapped by the deranged serial-killer Kane who collects the eyes of his victims, while the rest of the group is attacked by the psychopath with his ax.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.1}],"value":5.1,"age":"R"},"episode_id":5865,"content_control":"NORMAL"}}