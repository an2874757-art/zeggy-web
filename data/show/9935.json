type":"normalPoster"},{"data":[{"items":[],"id":9935,"title":"","description":"51","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Comedy"],"id":9935,"type":"MOVIE","title":"The Mask","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/55280ae1-7926-45da-b59a-15f8b0f8848b.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/6cdf52f5-6423-4bde-8914-225a39b73741.jpg","likes":989,"dislikes":20,"views":66189,"release_date":"775440000000","length":6072,"description":"Stanley Ipkiss (Jim Carrey) is a bank clerk that is an incredibly nice man. Unfortunately, he is too nice for his own good and is a pushover when it comes to confrontations. After one of the worst days of his life, he finds a mask that depicts Loki, the Norse night god of mischief. Now, when he puts it on, he becomes his inner, self: a cartoon romantic wild man. However, a small time crime boss, Dorian Tyrel (Peter Greene), comes across this character dubbed \"The Mask\" by the media. After Ipkiss's alter ego indirectly kills his friend in crime, Tyrel now wants this green-faced goon destroyed.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"episode_id":9935,"content_control":"FAMILY"}}