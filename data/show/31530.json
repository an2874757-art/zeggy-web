لى معابر الأنهار المُميتة في سيرينجيتي، تقاتل هذه الكائنات الخبيرة بالسافانا الأفريقية من أجل البقاء في هذه البيئات المُعادية.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG"},"background_color":"","current_season_id":17717,"content_control":"NORMAL"}}