00/shows/dd695184-e75b-4f6e-b3c2-edf2dbf2b724.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7873,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","War"],"id":7873,"type":"MOVIE","title":"Jarhead","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/5ea1e5c6-4797-42e2-9b8e-d917bd0915c3.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/21d70d65-9e2a-4b05-aa4e-970c462de96d.jpg","likes":186,"dislikes":21,"views":17636,"release_date":"1131062400000","length":7362,"description":"Anthony \"Swoff\" Swofford, a Camus-reading kid from Sacramento, enlists in the Marines in the late 1980s. He malingers during boot camp, but makes it through as a sniper, paired with the usually-reliable Troy. The Gulf War breaks out, and his unit goes to Saudi Arabia for Desert Shield. After 175 days of boredom, adrenaline, heat, worry about his girlfriend finding someone else, losing it and nearly killing a mate, demotion, latrine cleaning, faulty gas masks, and desert football, Desert Storm begins. In less than five days, it's over, but not before Swoff sees burned bodies, flaming oil derricks, an oil-drenched horse, and maybe a chance at killing. Where does all the testosterone go?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":7873,"content_control":"NORMAL"}}