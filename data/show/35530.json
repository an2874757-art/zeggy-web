/874ac41b-7667-4b9a-81e9-eb922811e422.jpg","background_image":"https://cloud02.albox.co/seasons/c92685c3-ecf5-4ebd-b1a7-e0053b30598b.jpg","likes":5,"dislikes":0,"views":1115,"release_date":"0","season_number":1,"description":"الأميرة ليو تشانج شينغ من مملكة فو يو، التي توصف بأنها \"قاتلة أزواج\"، تواجه ضغوطًا للعثور على زوج مناسب. يرسلها الإمبراطور للزواج من الأمير القاسي لي جينغ من مملكة دا تانغ، والمعروف باسم \"الشيطان ذو الوجه اليشم\". في مهمة \"قتل الأزواج لإنقاذ البلاد\"، يشرع تشانج شينغ ولي جينغ في رحلة كوميدية، ويتغلبان على الأحكام المسبقة والشائعات لاكتشاف المعنى الحقيقي للحب في النهاية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"background_color":"","current_season_id":20212,"content_control":"NORMAL"}}