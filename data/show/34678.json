le":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":34678,"title":"","description":"25","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"," Drama","  Romance"],"id":34678,"type":"SERIES","title":"An Incurable Case of Love","logo":"","image":"https://cloud02.albox.co/seasons/94f95583-cd80-4f04-8fef-f51581201c0d.jpg","background_image":"https://cloud02.albox.co/seasons/b21c2746-392f-4418-b02d-0519c7077866.jpg","likes":164,"dislikes":0,"views":8593,"release_date":"1578960000000","season_number":1,"description":"ساكورا ناناسي هي ممرضة مبتدئة تبلغ من العمر 22 عامًا. التقت بالدكتور تيندو كيري منذ عدة سنوات ووقعت في حبه. لمقابلته مرة أخرى، درست بجد وأصبحت ممرضة. بعد 5 سنوات، قابلت تيندو أخيرًا مرة أخرى، لكنه يتمتع بشخصية مختلفة تمامًا عما تخيلته. يُشار إلى تيندو، البالغ من العمر 33 عامًا، عادةً باسم \"الشيطان\" في العمل. إنه شخص كمالي متزن وغالبًا ما يدلي بتعليقات لاذعة للأطباء والممرضات. تعمل ساكورا بجد لتلقي التقدير من تيندو كما أنها تعبر له عن مشاعرها بصدق. وبسبب إصرارها، أصبحت ساكورا معروفة جيدًا في المستشفى وحصلت على لقب \"الفتاة المحاربة\". وفي الوقت نفسه، ينجذب تيندو إلى ساكورا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"R"},"background_color":"","current_season_id":19600,"content_control":"NORMAL"}}