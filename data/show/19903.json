ERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/7e6c3b2b-ab90-41ef-981f-e2745690a2fb.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":25193,"title":"Twenty-Five Twenty-One","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/b512b5fa-dbe3-46ae-8901-1f2865ecb6f2.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19903,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Crime","Mystery"],"id":19903,"type":"SERIES","title":"I Remember You - Hello Monster","logo":"","image":"https://cdn6.albox.co/storage/disk51/seasons/85ead8d7-08e0-4419-8c4e-5961ad773f7e.jpg","background_image":"https://cdn6.albox.co/storage/disk55/seasons/4d9255a5-8b45-49d8-8779-c1176066a7ae.jpg","likes":80,"dislikes":2,"views":7761,"release_date":"1434931200000","season_number":1,"description":"When a serial killer strikes women who all have a similar appearance, the police department's Special Crime Investigation Team is stumped. While Cha Ji An (Jang Na Ra), an elite detective, and her fellow colleagues are assessing the latest crime scene, the mysterious Lee Hyun (Seo In Guk) shows up and instantly assesses the trademark attributes of the killer. Hyun is a genius criminal profiler with a degree in criminal psychology who received an anonymous email that brought him to the crime scene all the way from the United States. The serial killer seems to be sending a personal message to Hyun with the clues he leaves behind, and Hyun wonders if it could be related to an escaped criminal \"monster\" from his childhood who killed his father and was responsible for the disappearance of his younger brother. Ji An has known Hyun since childhood and is ecstatic to see her childhood crush again, but Hyun doesn't seem to remember her. With no leads to capture the serial killer, Ji An and her colleagues solicit Hyun's help. Can Hyun and Ji An solve the case and find answers to their pasts?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"current_season_id":8709,"content_control":"NORMAL"}}