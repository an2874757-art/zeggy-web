age":"https://cdn7.albox.co/storage/CLOUD00/shows/588d0835-b6a7-41f9-a09e-3eca5baf0cd3.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":23210,"title":"Elize Matsunaga: Once Upon a Crime","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/a245920f-b4a2-467b-8b5f-16da131e167e.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15593,"title":"Circus of Books","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/437f4469-ff3e-4fed-9970-985ed70ed223.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":28376,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Documentary"],"id":28376,"type":"SERIES","title":"Branson","logo":"https://cloud01.albox.co/shows/7a5a5370-83c1-42e3-8199-5a566e9ca4f5.png","image":"https://cloud01.albox.co/seasons/6b0addce-dd6c-481c-b182-4a3c318983e8.jpg","background_image":"https://cloud01.albox.co/seasons/83ebed66-953f-48b0-82fc-e9e27a19486f.jpg","likes":6,"dislikes":1,"views":1420,"release_date":"1670630400000","season_number":1,"description":"Sixteen days before Richard Branson is scheduled to make a potentially historic flight as the first passenger to reach space in his own spacecraft in July 2021, the billionaire entrepreneur sits down for a conversation with acclaimed filmmaker Chris Smith, in light of the risk that lies ahead. Smith ultimately takes us on an expansive and intimate 70-year journey, from Branson's upbringing as the son of a spirited, tough-love mother in Britain, to his pursuits of extreme, personal daredevilry that serve both to grow his businesses' brands and feed his insatiable, lifelong thirst for high-stakes adventure. With added insight from family members, business associates, and journalists, and illustrated by decades of archival and home video footage, Branson reveals the ups and downs of a man driven by risk taking in both his business and personal life, reflecting on the costs and rewards of his lifelong, relentless optimism and boundary-pushing. After dropping out of school where he struggled with dyslexia, Branson began his entrepreneurial career as a 15-year-old publisher of a student magazine and went on to become a millionaire by the age of 22 with the booming success of Virgin Records. His launch of the airline Virgin Atlantic soon followed, along with a myriad of other Virgin branded businesses with varying levels of success, culminating in the launch of Virgin Galactic, his commercial spaceflight company in 2004. His record-breaking, transoceanic boat and balloon challenges, and now his crusade to bring customers to space, have all been positioned by Branson with the Virgin brand front and center. Branson remains a complex figure, committed to both philanthropic initiatives and his own bottom line.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"R"},"background_color":"#0169a4","current_season_id":15759,"content_control":"NORMAL"}}