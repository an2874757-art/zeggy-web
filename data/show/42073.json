length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Animation"],"id":42073,"type":"SERIES","title":"وكالة لايتون للتحقيقات ","logo":"","image":"https://cloud02.albox.co/seasons/f73d28fe-7447-4c8b-addd-bb729184b33b.png","background_image":"https://cloud02.albox.co/seasons/887577ce-0bd6-429a-b986-0a67a39fa8fc.png","likes":7,"dislikes":0,"views":686,"release_date":"1514764800000","season_number":1,"description":"تدور أحداث المسلسل في لندن، حيث تدير كاترييل لايتون، ابنة البروفيسور الشهير هيرشل لايتون، وكالة للتحقيقات. بعد اختفاء والدها الغامض، تقرر كاترييل أن تسير على خطاه وتبدأ بحل القضايا الغريبة التي تعترض طريقها، بمساعدة مساعدها نولان مونترو وكلبها المتكلم شيرل. تتنوع القضايا بين الغامضة والمضحكة، وتُظهر كاترييل ذكاءً فائقًا وقدرة على حل الألغاز المعقدة، بينما تحاول أيضًا كشف سر اختفاء والدها.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"TV-PG"},"background_color":"","current_season_id":24551,"content_control":"NORMAL"}}