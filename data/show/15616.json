ss":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15616,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Drama","Romance","Thriller","Comedy","Animation","History"],"id":15616,"type":"SERIES","title":"Rurouni Kenshin.","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/4b66fb2e-c9e3-425d-9fc8-6af82724f922.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/c31f5ff3-dcf6-4cbb-9d2c-d33c84b7604c.jpg","likes":109,"dislikes":7,"views":27132,"release_date":"1047859200000","season_number":1,"description":"A man slayer, Kenshin Himura, who played a major role in defeating Tokugawa Shogunate of feudal Japan carries his reverse blade sword (with a promise not to slay anymore). He embarks on a quest to repent for his sins by helping the innocent. He lodges in Kamia Kashin dojo where he becomes an acquaintance of Kaorou, the assistant instructor of the dojo. After being saved by Kenshin from mafia, a stubborn young boy, Yahiko Myojin joins the dojo as a student. Sanousuke, a victim of war becomes an acquaintance of Kenshin after losing to him in a duel. Together with his new friends, Kenshin carries out his ideal of helping the innocent. A series of events unfold that questions his ideal of living for the innocent and not slaying men. Kenshin faces every opponent with his reverse blade to uphold justice.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.5}],"value":8.5,"age":"PG-13"},"current_season_id":2961,"content_control":"NORMAL"}}