on_type":"normalPoster"},{"data":[{"items":[],"id":4840,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Romance","Comedy"],"id":4840,"type":"MOVIE","title":"Romancing the Stone","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/f7ec2bda-ccd2-49b4-be28-39b7436fbadc.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/908d5b94-f179-452c-af3e-c758bd35bd31.jpg","likes":5,"dislikes":0,"views":3288,"release_date":"449452800000","length":6346,"description":"Joan Wilder, a mousy romance novelist, receives a treasure map in the mail from her recently murdered brother-in-law. Meanwhile, her sister Elaine is kidnapped in Colombia and the two criminals responsible demand that she travel to Colombia to exchange the map for her sister. Joan does, and quickly becomes lost in the jungle after being waylayed by Zolo, a vicious and corrupt Colombian cop who will stop at nothing to obtain the map. There, she meets an irreverent soldier-of-fortune named Jack Colton who agrees to bring her back to civilization. Together, they embark upon an adventure that could be straight out of Joan's novels.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG"},"episode_id":4840,"content_control":"NORMAL"}}