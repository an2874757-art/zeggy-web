gth":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16135,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller"],"id":16135,"type":"SERIES","title":"The Honourable Woman","logo":"","image":"https://cdn6.albox.co/storage/disk56/seasons/f578a45b-595c-4685-8fa5-e55e5d3daf8f.jpg","background_image":"https://cdn6.albox.co/storage/disk54/seasons/6a693a29-000f-4985-9ea1-42a7f8d57158.jpg","likes":14,"dislikes":1,"views":2560,"release_date":"1406764800000","season_number":1,"description":"تدور احداث المسلسل حول امرأة كان أبوها تاجر أسلحة صهيونيّ, و التي شهدت مقتل أبيها. وعندما كبرت و ورثت شركة ابيها, حوّلتها من شركة للتجارة في السلاح إلى شركة تقوم بالربط بين “الكيان الصهيونيّ” و الضفة الغربية. يتم ضمّها فجأة إلى مجلس اللوردات البريطانيّ, بفضل أعمالها الخيرية في الشرق الأوسط, الأمر الذي يوقعها في مؤامرة دوليّة ستجعل الإستخبارات على أعقابها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"R"},"current_season_id":3686,"content_control":"NORMAL"}}