pe":"SERIES","title":"The Story of Pearl Girl","logo":"https://cloud02.albox.co/shows/95a4bc76-59fb-43e1-b268-cdaebb0aef96.png","image":"https://cloud02.albox.co/seasons/438a7a64-29b9-481d-bddc-39099d266671.jpg","background_image":"https://cloud02.albox.co/seasons/c07b8b4b-27d9-4f78-9d84-eebb12774f03.jpg","likes":358,"dislikes":6,"views":23768,"release_date":"1730505600000","season_number":1,"description":"تلتقي دوان وو، وهي غواصة لؤلؤ من هيبو، برجل الأعمال يان زي جينج من شيو (المنطقة الغربية)، وتشانغ جين ران، وهو رجل نبيل متواضع. تنضم إلى قافلة يان وتشرع في رحلة مليئة بالنضالات عندما تدخل عالم المجوهرات. ومع ذلك، أثناء رحلتها إلى الشمال الغربي، تكشف أسرار حياتها وتتورط في سعي يان زي جينج للانتقام. تواجه فقدان أقاربها المقربين وخيانة حبيبها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"R"},"background_color":"#050505","current_season_id":19673,"content_control":"NORMAL"}}