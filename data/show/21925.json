e":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/f309e153-0554-4e8f-a620-df6f5cae33e7.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":21925,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"],"id":21925,"type":"SERIES","title":"Last Man Standing","logo":"","image":"https://cdn6.albox.co/storage/CLOUD00/seasons/09a5b8ec-7cfb-47ae-857b-4039d96be9e0.jpg","background_image":"https://cdn6.albox.co/storage/CLOUD00/seasons/a8961934-bd10-4086-a2aa-bd26ce439a1b.jpg","likes":5,"dislikes":1,"views":3277,"release_date":"1318291200000","season_number":1,"description":"Mike Baxter is the marketing director for an iconic outdoor sporting goods store. He loves to have adventures while he's traveling for work and, of course, he drives a pick-up truck. While Mike is king of the hill at work, he's the odd man out in a home that is dominated by women -- namely his wife, Vanessa, and their three daughters, 20- year-old Kristin, 17-year-old Mandy and 13-year-old Eve. After being a stay-at-home mom for years, Vanessa recently returned to the workplace and was quickly promoted (much to the dismay of her primarily male co-workers). As a result of Vanessa's increased work load, Mike is pulled into more hands-on parenting than ever before.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"TV-PG"},"current_season_id":11074,"content_control":"NORMAL"}}