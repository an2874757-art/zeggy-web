198d1dfa-27d1-446d-a654-bc8c9ee92433.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36243,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Sci-Fi"],"id":36243,"type":"SERIES","title":"Moonrise ","logo":"","image":"https://cloud02.albox.co/seasons/6255193c-8c67-4992-bf46-500b66130212.jpg","background_image":"https://cloud02.albox.co/seasons/fc862746-1988-43cd-b0a3-dcb78d6afada.jpg","likes":50,"dislikes":2,"views":7410,"release_date":"1744243200000","season_number":1,"description":"في مستقبل غير بعيد، أسست البشرية حكومة عالمية غير منظمة، تُدار كل شيء بواسطة شبكة ذكاء اصطناعي دولية تُدعى \"سابينتيا\". يعيش الناس حياة سلمية باتباع قراراتها العقلانية بإخلاص. لكن مشروع \"سابينتيا\" لتطوير القمر، الذي يرسل المجرمين والملوثين إلى القمر للحفاظ على سلام الأرض، يُسبب تفاوتًا وفقرًا على سطح القمر، مُشعلًا شرارة حرب. يتورط جاكوب \"جاك\" شادو في هذا الصراع بعد أن فقد عائلته في تفجير إرهابي شنه جيش المتمردين على سطح القمر. مُتعهدًا بالانتقام، ينضم جاك إلى جيش الأرض ككشاف على سطح القمر، ليكتشف قائدًا غير متوقع بين قوات المقاومة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"","current_season_id":20843,"content_control":"NORMAL"}}