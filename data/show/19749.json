hing_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19749,"title":"","description":"23","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime","Mystery"],"id":19749,"type":"SERIES","title":"Sharp Objects","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/068ade42-0e9b-4fd8-a83e-d668f2b92bfa.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/b736ace0-6764-4eee-9cb3-ce5d50db5087.jpeg","likes":171,"dislikes":10,"views":35725,"release_date":"1527811200000","season_number":1,"description":"Fresh from a brief stay at a psych hospital, reporter Camille Preaker faces a troubling assignment: she must return to her tiny hometown to cover the murders of two preteen girls. For years, Camille has hardly spoken to her neurotic, hypochondriac mother or to the half-sister she barely knows: a beautiful 13 year old with an eerie grip on the town. Now, installed in her old bedroom in her family's Victorian mansion, Camille finds herself identifying with the young victms - a bit too strongly. Dogged by her own demons, she must unravel the psychological puzzle of her own past if she wants to get the story - and survive this homecoming.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.5}],"value":8.5,"age":"N/A"},"current_season_id":8495,"content_control":"FAMILY"}}