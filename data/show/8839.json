,"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8839,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi"],"id":8839,"type":"MOVIE","title":"John Carter","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/4e3bd76e-03ea-4f2c-99eb-c0468105c137.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/f80dd2c5-8b49-4471-b940-66ab588eb782.jpg","likes":225,"dislikes":8,"views":21512,"release_date":"1331251200000","length":7921,"description":"John Carter, a Civil War veteran, who in 1868 was trying to live a normal life, is \"asked\" by the Army to join, but he refuses so he is locked up. He escapes, and is pursued. Eventually they run into some Indians, and there's a gunfight. Carter seeks refuge in a cave. While there, he encounters someone who is holding some kind of medallion. When Carter touches it, he finds himself in a place where he can leap incredible heights, among other things. He later encounters beings he has never seen before. He meets a woman who helps him to discover that he is on Mars, and he learns there's some kind of unrest going on.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"episode_id":8839,"content_control":"FAMILY"}}