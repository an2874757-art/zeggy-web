e/CLOUD00/shows/128c853f-c911-42c7-9325-ec70fd57f7ac.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":41244,"title":"Super no Ura de Yani Suu Futari","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/d4d4ba0e-df0b-4d48-975b-4d46a8f16061.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":20314,"title":"Kamisama Kiss","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk43/shows/322cd98d-d776-4969-8f3d-01be3c42ff37.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15663,"title":"My Next Life as a Villainess: All Routes Lead to Doom!","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk60/shows/bbfcf74f-320d-4048-88ad-76cf08b82929.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16242,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Animation","Sport"],"id":16242,"type":"SERIES","title":"Initial D","logo":"","image":"https://cdn6.albox.co/storage/disk44/seasons/ab7fb28d-7df0-48d2-97ab-5d08d0c93ab6.jpg","background_image":"https://cdn6.albox.co/storage/disk57/seasons/265268f8-936b-4b5b-b04f-0aa236e51c27.jpg","likes":131,"dislikes":1,"views":10394,"release_date":"892857600000","season_number":1,"description":"Takumi Fujiwara is an average 18-year old high school student with an average job as a gas station attendant, and a not-so-average hand in the family business. To help his father's tofu shop, Takumi has been delivering tofu in his father's 'Eight-Six' Trueno (known as the Toyota Corolla GT-S in the US) to a hotel at the peak of Mt. Akina (the local mountain), every night at 4 a.m. In doing so, Takumi has been unknowingly training to be the greatest mountain-pass drift-racer in all of Japan. After a freak late-night encounter with Keisuke Takahashi, the number two driver of the infamous RedSuns team, Takumi is quickly, and unwillingly plunged into a high-speed world of white-knuckle contests on the most dangerous mountain passes in the Gunma prefecture. Assisted by the local Akina Speedstars team, his slightly obnoxious friend Itsuki, his somewhat shady girlfriend Natsuke and the sage-like words of his chain-smoking, ex-racer father Bunta, he'll need all the help he can get to outwit and outmaneuver Japan's most talented underground drift-racers.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"current_season_id":3838,"content_control":"NORMAL"}}