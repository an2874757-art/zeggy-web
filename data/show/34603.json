mments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Drama"," Suspense"],"id":34603,"type":"SERIES","title":"Touhai: Ura Rate Mahjong Touhai Roku ","logo":"","image":"https://cloud02.albox.co/seasons/648fd8b5-dd13-4645-9035-10ba9c7f1d1d.jpg","background_image":"https://cloud02.albox.co/seasons/66746f7e-9029-4547-9e5e-260895fb720d.jpg","likes":343,"dislikes":25,"views":65696,"release_date":"1728950400000","season_number":1,"description":"لا يعرف الكثير من الناس أن أحد أكثر لاعبي الماهجونغ موهبة وقسوة في المدينة هو فتى صغير في المدرسة الثانوية. كاي مراهق قليل الكلام، لكن مهاراته في الملاحظة وإرادته الثابتة وخبرته في اللعبة تسمح له بالبقاء على قيد الحياة في عالم مليء بالشخصيات القوية والثرية والخطيرة. كاي يخفي حاليًا فتاة تدعى أمينة دخلت البلاد بشكل غير قانوني ويحميها من الترحيل. يقضي أيامه نائمًا أثناء الحصص وليالي يلعب الماهجونغ عالية المخاطر، في انتظار وصول خصم جدير.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"background_color":"","current_season_id":19537,"content_control":"NORMAL"}}