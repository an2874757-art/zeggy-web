n6.albox.co/storage/disk55/seasons/d8c6cb9c-adc5-4eb5-8072-354efff8d67f.jpg","background_image":"https://cdn6.albox.co/storage/disk53/seasons/fd3081b9-3421-4665-b3d6-d8293b3c5e4b.png","likes":15,"dislikes":0,"views":1386,"release_date":"1475280000000","season_number":1,"description":"Takano Aki is a happy, ordinary housewife whose family (sweet husband and two kids) has moved to their dream apartment. Just as they are starting their new life, they encounter an ominous, terrifying neighbour, Sasaki Yumiko, who manipulates the dark emotions of pride, vanity and jealousy of the housewives living in the apartment building. She drives Aki into isolation within the building with unexpected methods and eventually causes the break up of her family. Meanwhile, a series of abduction cases take place. There seems to be a connection to the kidnapper and the frightening neighbor.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"pg-13"},"current_season_id":9714,"content_control":"NORMAL"}}