ي عالمٍ مليءٍ بالمخاطر غريبٍ عنها تمامًا. رغم أنها كانت تتوق إلى هذا اللقاء، إلا أن مواجهته تركتها قلقة. الأخ الذي ركضت نحوه دون تردد، بات الآن يبدو غريبًا عنها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"NC-17"},"background_color":"#fff0ff","current_season_id":22728,"content_control":"NORMAL"}}