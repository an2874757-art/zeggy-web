ormalPoster"},{"data":[{"items":[],"id":5677,"title":"","description":"14","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":5677,"type":"MOVIE","title":"Whatever It Takes","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/a2d57621-1d08-4975-a822-4020548e7ff0.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/25017e7e-6a69-43ff-b40d-1907825ffbed.jpg","likes":130,"dislikes":12,"views":9906,"release_date":"953856000000","length":5652,"description":"Ryan (Shane West) is a bit of a geek with eyes for the school sex bomb, Ashley (Jodi Lyn O'Keefe), which induces cringing in his neighbor and best friend, Maggie (Marla Sokoloff), a cute intellectual girl. But popular jock Chris (James Franco) has his eye on Maggie, and he offers to help Ryan win Ashley if Ryan will help Chris with Maggie. So begins a two-headed variation on Cyrano de Bergerac; Ryan composes soulful e-mails for Chris, and Chris advises Ryan to treat Ashley like dirt, which seems to be the only way to get her attention. At first, neither finds it easy to change their ways; Chris comes on too strong, and Ryan is too nervous to be a jerk. But as they start to succeed, Ryan begins to see Maggie in a new light and wonders if he's pursuing the right girl. He realizes Ashley is not meant for him, and tries to convince Maggie about Chris's affection for her. Maggie is reluctant to take him \"back\" at first, but then realizes Ryan has a change of heart.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.5}],"value":5.5,"age":"PG-13"},"episode_id":5677,"content_control":"NORMAL"}}