pe":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":18391,"type":"SERIES","title":"Hart of Dixie","logo":"","image":"https://cdn6.albox.co/storage/disk55/seasons/0e5d2b87-820d-4a2e-a4e5-2e8963b5c5ff.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/2ff2ace3-ae76-4ee7-92b1-135d20febc18.jpg","likes":44,"dislikes":0,"views":15606,"release_date":"1316995200000","season_number":1,"description":"Fast-talking New Yorker and brand new doctor Zoe Hart has it all figured out - after graduating top of her class from medical school, she'll follow in her father's footsteps and become a cardio-thoracic surgeon. But when her dreams fall apart, Zoe decides to accept an offer from a stranger, Dr. Harley Wilkes, to work with him at his small practice in Bluebell, Alabama. Zoe arrives in this small Gulf Coast town only to find that Harley has passed away and left his half of the medical practice to her in his will.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"current_season_id":6677,"content_control":"FAMILY"}}