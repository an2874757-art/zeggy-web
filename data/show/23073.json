s"}],"post_info":{"genres":["Shounen"," Action"," Mystery","Police"],"id":23073,"type":"MOVIE","title":"Detective Conan Movie 18: The Sniper from Another Dimension","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/shows/742c886d-d1c6-49c7-bc59-1d6230461a17.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/shows/497b081c-d139-4b37-bd9c-b43353ac6a68.jpg","likes":185,"dislikes":1,"views":12699,"release_date":"1397865600000","length":6613,"description":"في صباح أحد الأيام ، عند منصة المراقبة في برج بيل تري ، قُتل رجل فجأة برصاص قناص مجهول. يسارع كونان إيدوغاوا ، الذي تصادف زيارته أثناء وقوع القتل ، للقبض على القناص لكنه فشل في القيام بذلك. علم لاحقًا أن المشتبه به في الحادث ، تيموثي هنتر ، هو عضو سابق في فرقة العمليات الخاصة البحرية وكان يتم التحقيق معه بالفعل في قضية قتل سابقة. يعتقد مكتب التحقيقات الفيدرالي أن هناك ما لا يقل عن ثلاثة أشخاص يريد تيموثي الموت. ومع ذلك ، بعد وفاة اثنين منهم ، قُتل تيموثي نفسه ، مما أثار الفوضى في التحقيق.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"episode_id":409963,"content_control":"NORMAL"}}