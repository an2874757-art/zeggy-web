 في سنوات مراهقته!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"NC-17"},"background_color":"#b4dcf0","current_season_id":23644,"content_control":"NORMAL"}}