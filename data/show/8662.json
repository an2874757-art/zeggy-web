ontinue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8662,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","Horror"],"id":8662,"type":"MOVIE","title":"After.Life","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/c1580d46-aad3-4f1a-b954-56c59a2d780c.jpg","background_image":"","likes":57,"dislikes":4,"views":8069,"release_date":"1282780800000","length":6173,"description":"After a horrific car accident, Anna (Ricci) wakes up to find the local funeral director Eliot Deacon (Neeson) preparing her body for her funeral. Confused, terrified and feeling still very much alive, Anna doesn't believe she's dead, despite the funeral director's reassurances that she is merely in transition to the afterlife. Eliot convinces her he has the ability to communicate with the dead and is the only one who can help her. Trapped inside the funeral home, with nobody to turn to except Eliot, Anna is forced to face her deepest fears and accept her own death. But Anna's grief-stricken boyfriend Paul (Long) still can't shake the nagging suspicion that Eliot isn't what he appears to be. As the funeral nears, Paul gets closer to unlocking the disturbing truth, but it could be too late; Anna may have already begun to cross over the other side.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"R"},"episode_id":8662,"content_control":"NORMAL"}}