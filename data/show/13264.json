"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":13264,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":13264,"type":"MOVIE","title":"Love Happens","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/d0300559-747e-4a47-82e1-238db37c2721.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/fc2a30bf-1dcf-4a8f-a3c1-d40a9a4421e1.jpg","likes":43,"dislikes":3,"views":6963,"release_date":"1253232000000","length":6549,"description":"Burke is a motivational speaker whose book about dealing with grief is a best seller. His wife died in a car accident three years ago. He's in Seattle to lead a week-long workshop on healing and to negotiate a major multi-media deal. But something's amiss: he's a closet drinker, he won't ride elevators, his moods swing, he's estranged from his wife's father, and he's very much alone. In a hotel hallway, he bumps into a woman arranging flowers, tries to chat with her, and gets the brush-off. She's Eloise, a local florist who's just broken up with a boyfriend. He's persistent and they eventually go to dinner - it goes badly. What's blocking Burke? Can the physician heal himself.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"PG-13"},"episode_id":13264,"content_control":"NORMAL"}}