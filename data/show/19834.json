د بعضهم البعض - تقام كل خمسمائة عام ، حيث يتم تتويج الفائز بها شامان كينج. يسمح هذا العنوان لشاغل الوظيفة الحالي باستدعاء الروح العظمى وتشكيل العالم كما يراه مناسبًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"g"},"current_season_id":11207,"content_control":"NORMAL"}}