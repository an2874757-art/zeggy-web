er","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk44/shows/12bb274a-e07e-40a3-80cd-b4981db120aa.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14778,"title":"Ted Lasso","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/2d1287ee-68ff-455f-a871-de15ef34c4e5.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":27944,"title":"Wednesday","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/10beb9df-8454-477f-801b-f5c12bb14ab4.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":20157,"title":"","description":"41","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":20157,"type":"SERIES","title":"Mad Men","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/2f0f6a80-c364-42dc-8f24-2923cf754d61.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/25406692-5599-4616-aeb3-1dbf9e88210a.jpg","likes":348,"dislikes":3,"views":60348,"release_date":"1184803200000","season_number":1,"description":"The professional and personal lives of those who work in advertising on Madison Avenue - self-coined \"mad men\" - in the 1960s are presented. The stories focus on those at one of the avenue's smaller firms, Sterling Cooper, and its various incarnations over the decade. At the heart of these stories is Donald Draper, the creative genius of the company. That professional creative brilliance belies the fact of a troubled childhood, one that he would rather forget and not let anyone know about except for a select few, but one that shaped who he is as an adult and as an ad man in the need not only to sell products but sell himself to the outside world. His outward confidence also masks many insecurities as evidenced through his many vices, such as excessive smoking, drinking and womanizing - the latter despite being a family man - and how he deals with the aftermath of some of the negative aspects of his life.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"pg-13"},"current_season_id":9031,"content_control":"NORMAL"}}