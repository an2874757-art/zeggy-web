d_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/c0db9d77-88cc-43d1-b1c8-ca7a63720ea6.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8035,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy"],"id":8035,"type":"MOVIE","title":"Indiana Jones and the Kingdom of the Crystal Skull","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/7ed55f3f-14d3-45bd-a1ac-7adffdaa53fe.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/d55a40ae-39d7-4da9-b7ae-deb90e1f72af.jpg","likes":104,"dislikes":1,"views":12092,"release_date":"1211414400000","length":7352,"description":"During the Cold War, Soviet agents watch Professor Henry Jones when a young man brings him a coded message from an aged, demented colleague, Harold Oxley. Led by the brilliant Irina Spalko, the Soviets tail Jones and the young man, Mutt, to Peru. With Oxley's code, they find a legendary skull made of a single piece of quartz. If Jones can deliver the skull to its rightful place, all may be well; but if Irina takes it to its origin, she'll gain powers that could endanger the West. Aging professor and young buck join forces with a woman from Jones' past to face the dangers of the jungle, Russia, and the supernatural.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"PG-13"},"episode_id":8035,"content_control":"FAMILY"}}