ge/disk50/shows/2ebcd67b-c1bb-4344-a495-a458539d6314.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":40407,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":40407,"type":"SERIES","title":"Yaralı Kuşlar - الطيور المجروحة","logo":"https://cloud02.albox.co/shows/81c2f96a-50de-4c46-b57a-65ec8ffa5527.png","image":"https://cloud02.albox.co/shows/0f351375-d598-4a8a-9519-ad057b9b7bc1.jpg","background_image":"https://cloud02.albox.co/shows/89242f7e-abcd-4733-a073-70df6a57fe28.jpg","likes":53,"dislikes":4,"views":18079,"release_date":"1554076800000","season_number":1,"description":"تدور القصة حول أخ وأخت ممزقين بين عالمين: شوارع ولادتهما القاسية وفيلا عائلة ميتيهانوغلو الفاخرة. مريم شابة قوية وجميلة قضت السنوات الخمس الماضية تربي \"أخيها الصغير\" عمر. كانت بالكاد مراهقة عندما أعطى أحدهم الطفل عمر لوالدها الحقير، دورموس. كان ينوي بيع الرضيع، لكن دورموس تم اقتناله إلى السجن قبل أن يتمكن من إتمام عملية البيع. مريم مصممة على إبقاء عمر بعيدا عن الشوارع، وعملت ليلا نهارا لتجعل لهما حياة جيدة وكريمة معا. لكنها لا تعلم أن الصبي الصغير هو ابن صناعي مؤثر وتم اختطافه في صراع على السلطة على الإمبراطورية العائلية. الرابط بعالم والده البيولوجي يبدأ مغامرة عمر ومريم، حيث يلتقيان بشكل غير متوقع بليفنت، الرجل الذي ظن أنه لن يرى ابنه مرة أخرى.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"NC-17"},"background_color":"#e7bf1f","current_season_id":23561,"content_control":"NORMAL"}}