":[{"items":[],"id":8528,"title":"","description":"15","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action"],"id":8528,"type":"MOVIE","title":"The Suspect","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/a6526918-38fd-4b9d-8499-1aee5a0c8d32.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/65d62848-0243-4079-a69d-df1e1af9d32b.jpg","likes":100,"dislikes":1,"views":9835,"release_date":"1389312000000","length":8224,"description":"Dong-chul (Gong Yoo) is the best field agent in North Korea - until he is abandoned during a mission, his wife and daughter murdered. Hunted and on the run, torn between grief and vengeance, he takes a job as a night driver for the CEO of a powerful corporation. The chairman is brutally assassinated - but gives Dong-chul a pair of glasses before he dies. Now, he's on the run again. Accused of murder, wanted for treason, and desperate to uncover the volatile national secrets hidden inside the glasses. Dong-Chul wants the truth. And he'll start a war to get it.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"r"},"episode_id":8528,"content_control":"NORMAL"}}