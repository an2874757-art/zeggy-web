s":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy","Crime"],"id":7693,"type":"MOVIE","title":"Identity Thief","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/fbac73ba-688c-4df5-b632-4774c66ca67f.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/19351d64-e125-4984-b0fc-27ee85bcbc83.jpg","likes":41,"dislikes":2,"views":4048,"release_date":"1360281600000","length":7230,"description":"Sandy Patterson (Jason Bateman) gets a nice call confirming his name and other identifying information. The next thing he knows, a spa in Florida is reminding him of his appointment and his credit cards are maxed out. With his identity stolen, Sandy leaves his wife, kids and job to literally bring the thief to justice in Colorado. Keeping tabs on the other Sandy (Melissa McCarthy) and run-ins with bounty hunters is harder than he was expecting, and ultimately the cross-country trip is going to find both Sandys learning life tips from one another.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"R"},"episode_id":7693,"content_control":"FAMILY"}}