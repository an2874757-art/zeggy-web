نّه يحاول أن يرضيها، تعترف له أنها تخونه، فيرفض طلاقها، في الوقت الذي يتقدم مدحت إلى حسين يطلب يد أخته ميرفت. فيوافق، تثور زينب.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":487,"content_control":"NORMAL"}}