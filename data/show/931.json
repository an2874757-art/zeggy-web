ge/disk41/shows/6b9d02b4-1986-4f45-8714-fbcb41cec2d0.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":931,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","War"],"id":931,"type":"MOVIE","title":"Triage","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/0547fdeb-8bcd-4565-be48-eee56d1e61c2.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/8b989398-f21c-4f03-a231-5674b0684b05.jpg","likes":17,"dislikes":0,"views":5025,"release_date":"1258070400000","length":5977,"description":"Mark and David are best friends, photo journalists going from war to war. In the spring of 1988, they're in Kurdistan, at an isolated mountain clinic, waiting for an offensive. David's had enough - he wants to go home to Dublin to his pregnant wife. He leaves, with Mark promising to follow in a few days. A week or so later, Mark's home after being wounded, but David's not been heard from. Mark's slow recovery and uncharacteristic behavior alarm his girlfriend, Elena, who asks her grandfather, a Spanish psychologist, to come to Dublin to help. Are there things the carefree and detached journalist is bottling up? Is he a casualty of war?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"episode_id":931,"content_control":"NORMAL"}}