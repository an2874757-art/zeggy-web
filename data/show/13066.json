","History"],"id":13066,"type":"MOVIE","title":"The Impossible","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/1ac13232-6c42-41b0-a1ae-8504c1f1db0c.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/c750763a-bec6-465a-8d7e-c927ce006886.jpg","likes":391,"dislikes":6,"views":30067,"release_date":"1357257600000","length":6822,"description":"A regular family - Maria (Naomi Watts), Henry (Ewan McGregor) and their three kids - travel to Thailand to spend Christmas. They get an upgrade to a villa on the coastline. After settling in and exchanging gifts, they go to the pool, like so many other tourists. A perfect paradise vacation until a distant noise becomes a roar. There is no time to escape from the tsunami; Maria and her eldest are swept one way, Henry and the youngest another. Who will survive, and what will become of them?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"PG-13"},"episode_id":13066,"content_control":"FAMILY"}}