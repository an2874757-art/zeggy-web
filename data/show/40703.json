ntinue_watching_progress":0},{"items":[],"id":29112,"title":"Yamada-kun to Lv999 no Koi wo Suru","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/89765e66-776d-4952-b25a-ce489b37a2bb.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":40703,"title":"","description":"100","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"],"id":40703,"type":"SERIES","title":"I Made Friends with the Second Prettiest Girl in My Class","logo":"","image":"https://cloud02.albox.co/seasons/70dd5168-5274-4ae4-8a76-643bbfced3c7.jpeg","background_image":"https://cloud02.albox.co/seasons/314c0e84-c292-4562-b496-d36764a176a3.jpg","likes":521,"dislikes":17,"views":57067,"release_date":"1775692800000","season_number":1,"description":"أنا، ماهيرا ماكي، عانيتُ من صعوبة التواصل مع أي شخص خلال سنوات دراستي الثانوية، إذ وجدتُ صعوبة في تكوين صداقات. ثم جاءت نقطة تحول. دخلت فتاة تُدعى أسانجي حياتي. على الرغم من أن الأولاد كانوا يُطلقون عليها سرًا لقب \"ثاني أجمل فتاة في الصف\"، إلا أنها اختارت قضاء أيام الجمعة معي بدلًا من صديقتها المقربة أمامي، التي كانت تحمل لقب \"أجمل فتاة في الصف\". في راحة منزلي، انغمسنا في عالم الألعاب، وشاهدنا الأفلام، وقرأنا المانغا، وتناولنا الوجبات السريعة - البيتزا والهامبرغر - وشربنا الكولا، في سعادة وراحة بال. ربما بدونا فوضويتين بعض الشيء في نظر الآخرين، لكن بالنسبة لي ولأسانجي، كان ذلك وقتًا ثمينًا وسريًا قضيناه معًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"background_color":"","current_season_id":23736,"content_control":"NORMAL"}}