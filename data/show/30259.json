],"post_info":{"genres":["Action","Adventure","Fantasy"],"id":30259,"type":"SERIES","title":"The Winter King","logo":"https://cloud01.albox.co/shows/a77445c2-0413-432a-849c-e108f0462dea.png","image":"https://cloud01.albox.co/seasons/7ff22fbd-96ea-40d2-9141-abd2f9581ee3.jpg","background_image":"https://cloud01.albox.co/seasons/a77fd748-2bba-4ecd-aa7b-1e48bd34844d.jpg","likes":96,"dislikes":6,"views":14541,"release_date":"0","season_number":1,"description":"يصور المسلسل نظرة ثورية على أساطير آرثر المحبوبة، ويتبع آرثر بيندراجون وهو يتطور من ابن منبوذ إلى محارب وقائد أسطوري. تدور أحداث فيلم The Winter King في القرن الخامس، قبل فترة طويلة من توحيد بريطانيا، في أرض الفصائل والقبائل المتحاربة عندما كان العالم وحشيًا وكانت الحياة في كثير من الأحيان عابرة. استنادًا إلى سجلات أمراء الحرب للكاتب برنارد كورنويل.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.1}],"value":5.1,"age":"PG-13"},"background_color":"#a08333","current_season_id":17175,"content_control":"FAMILY"}}