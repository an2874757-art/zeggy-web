gress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":1156,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":1156,"type":"MOVIE","title":"The Air I Breathe","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/9d3806e2-e5fe-4b49-bc99-e034d5fc2364.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/ae83d676-b2b0-4aff-bd03-0a2ea524eb43.jpg","likes":25,"dislikes":0,"views":3741,"release_date":"1224201600000","length":5707,"description":"A frustrated and clumsy bank clerk overhears the conversation of three coworkers in the toilet about a fix in a horse race, and bets a large amount. He loses the bet and owes the money to the dangerous and powerful mobster Fingers. A gangster who works for Fingers has the ability of foreseeing pieces of the future; he is assigned to collect money for the boss, with his troublemaker nephew Tony, and is beaten up by a gang. The manager of pop-star Trista loses her contract to Fingers without her agreement and she is threatened by the gangster. A dedicated doctor seeks a blood donor that might have a rare blood type to save the life of his secret and unrequited passion, a beautiful epidemiologist who's married to a friend.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"R"},"episode_id":1156,"content_control":"NORMAL"}}