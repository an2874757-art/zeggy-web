ن هو بطل حرب لأرثدال. لقد مهد الطريق لأرثدال لتصبح مدينة وأمة مزدهرة وهو أقوى محارب في أرثدال. يحلم بأن يصبح أول ملك لأرثدال.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.5}],"value":8.5,"age":"R"},"background_color":"","current_season_id":12078,"content_control":"NORMAL"}}