h":0,"continue_watching_progress":0},{"items":[],"id":20080,"title":"My Hero Academia ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/acbea17b-b1cc-4873-acd2-a8a97148a577.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38300,"title":"May I Ask for One Final Thing?","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/7cde1abf-f34e-443b-a5b2-ec86aaffdbc4.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":32637,"title":"","description":"69","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action"],"id":32637,"type":"SERIES","title":"Kenka Dokugaku","logo":"","image":"https://cloud01.albox.co/seasons/e6013a82-4cc2-4356-b74c-1cd16c6ae616.jpg","background_image":"https://cloud01.albox.co/seasons/f6c8db8c-756c-484c-9e72-fd3f4aae7343.jpg","likes":318,"dislikes":11,"views":26879,"release_date":"1712793600000","season_number":1,"description":"بعد تعرضه للتنمر من قبل زميله في الفصل ومذيع البث الشهير باكغو، يقضي يو هوبين أيام دراسته الثانوية يعاني من الإذلال وسوء المعاملة. لكن مشاكله لا تنتهي عند هذا الحد؛ خارج المدرسة، يعمل هوبين في وظيفة بدوام جزئي لدفع فواتير مستشفى والدته. في أحد الأيام، سكب هوبين الرامن عن طريق الخطأ على مصور باكجو وو \"جيكساي\" جيهيوك، مما أدى إلى تعثره في سلك وفصل الصبي الآخر عن بث الألعاب الخاص به. أخيرًا، سئم هوبين من أسلوب حياته البائس، ويقاوم وينتهي به الأمر في شجار مثير للشفقة مع Jiksae.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"background_color":"","current_season_id":18416,"content_control":"NORMAL"}}