type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":2767,"type":"MOVIE","title":"Dangerous Liaisons","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/6477d335-bdeb-4a62-bb85-24791b5844f2.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/de03f565-24d0-4da1-b0a3-e59555442c99.jpg","likes":26,"dislikes":0,"views":4236,"release_date":"604281600000","length":7193,"description":"In 18th century France, the Marquise de Merteuil and the Vicomte de Valmont play a dangerous game of seduction. Valmont is someone who measures success by the number of his conquests and Merteuil challenges him to seduce the soon to be married Cecile de Volanges and provide proof in writing of his success. His reward for doing so will be to spend the night with Merteuil. He has little difficulty seducing Cecile but what he really wants is to seduce Madame de Tourvel. When Merteuil learns that he has actually fallen in love with her, she refuses to let him claim his reward for seducing Cecile. Death soon follows.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"episode_id":2767,"content_control":"FAMILY"}}