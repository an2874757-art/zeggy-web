hows/714e047b-2224-4c43-aec1-9e94713f34ad.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6348,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime"],"id":6348,"type":"MOVIE","title":"The Outsiders","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/824627c0-4a51-4dc3-a958-2aa563405c4d.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/da1bfa9e-aed9-453e-afab-3ada12098db8.jpg","likes":43,"dislikes":1,"views":3937,"release_date":"417398400000","length":6896,"description":"The movie details a town split between the wealthy South Zone gang called 'The Socials' and the poor North Zone gang called 'The Greasers'. Dallas Winston, Ponyboy Curtis and Johnny Cade from 'The Greasers' befriend the rich Cherry Valance and Marcia at a drive-in. Later that night, a group of 'The Socs' chase and beat up Johnny and attempt to drown Ponyboy in a fountain. However, Johnny stabs one Soc and kills him, saving Ponyboy. The desperate boys seek Dallas who finds a hideout for them in a nearby town. One week later, Johnny and Ponyboy decide to return to their hometown, with Dallas, to claim the murder as self-defense. But on their way back, they see the church on fire and Ponyboy and Johnny help the children trapped in the church and become heroes. However Johnny is badly wounded and confined to the hospital. Meanwhile The Socs and The Greasers prepare to fight.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG"},"episode_id":6348,"content_control":"NORMAL"}}