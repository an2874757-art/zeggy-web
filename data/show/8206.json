d":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8206,"title":"","description":"21","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Sport"],"id":8206,"type":"MOVIE","title":"Goal! The Dream Begins","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/8a92c684-d058-4f7e-bc4c-d021220d208b.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/96c22a66-6400-44f0-8b1a-3692c3beb986.jpg","likes":171,"dislikes":2,"views":9778,"release_date":"1147392000000","length":7087,"description":"Santiago's father, Hernan Munez, smuggled his penniless Mexican family over the US border to seek a better, albeit modest future in L.A. Eldest son Santiago dreams of more, like native Angelinos, then joining Hernan's gardening firm. His change arrives when a British ex-pro spots him as an exceptional soccer natural and promises he can arrange a real British talent scout to check him out. Although that falls trough and dad forbids it, Santiago accepts grandma's savings to try out with English premier league club Newcastle. Despite his asthma, he gets in and befriends the freshly transferred, desperately undisciplined bad boy star scorer, party animal Gavin Harris, who becomes his bothersome house-mate, a recipe for trouble and yet each's salvation.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"episode_id":8206,"content_control":"NORMAL"}}