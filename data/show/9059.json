gth":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9059,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller"],"id":9059,"type":"MOVIE","title":"Erased.","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/bc4c7445-f639-44ee-bcfa-1517b9de71e9.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/828fe1be-e655-4cc3-87ca-9b9e54facf15.jpg","likes":17,"dislikes":0,"views":4387,"release_date":"1348617600000","length":6022,"description":"The expatriate and widower Ben Logan has moved from New York to Anrwep with his estranged teenage daughter Amy Logan to work for the technology corporation Halgate Group. When he breaks a sophisticated security code from a device, he notes that its patent has no record in Halgate and he calls the attention of his boss Derek Kohler. Ben meets Amy and they do not go home; later Ben goes with Amy to his office and they find it completely empty. Further, all the records of his phone calls, e-mails, payslip and bank account have vanished. Out of the blue, a coworker abducts Ben and Amy in the bank but Ben kills him in self-defense. Ben finds a key from a locker in the Central Station and he finds photos of his daughter, himself and his coworkers. His further investigation shows that all the workers are dead in the morgue except Derek Kohler. Soon Ben discovers a huge conspiracy of Halgate Group relative to illegal arms sales to Africa with the involvement of rogue CIA agents. But Ben is in disgrace with the Agency and does not have any reliable contact to recur.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"episode_id":9059,"content_control":"NORMAL"}}