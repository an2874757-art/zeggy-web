a":[{"items":[],"id":8911,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":8911,"type":"MOVIE","title":"London","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/82dcd6ba-7d12-449e-9d7c-694a81252a94.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/c0437ffd-ee05-4b7b-97e1-14eae4cc819b.jpg","likes":75,"dislikes":10,"views":25807,"release_date":"1139529600000","length":5553,"description":"In New York, the drug-addicted Syd is consumed by drink and drugs - missing his girlfriend London, who broke up with him six months ago after a two-year relationship. When Syd finds that London's friends throw a going away party for her, he decides to go to the party without an invitation. But first he meets the banker and drug-dealer, Bateman, in a bar to buy coke, and he invites his new acquaintance to go to the party with him. While locked in the bathroom with Bateman snorting coke and drinking booze, Syd recalls moments of his relationship with London, inclusive that he had never said \"I love you\" to his girlfriend despite her countless requests. Bateman also \"open his heart\" under the influence of cocaine and tells his impotence problem to Syd; in the end he convinces Syd to talk to London.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"R"},"episode_id":8911,"content_control":"NORMAL"}}