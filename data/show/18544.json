oud01.albox.co/shows/5027f029-afea-42a4-9e5c-d3542f4d2595.png","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/20edefbb-543b-4740-b8a5-22c96b123200.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/65e72f72-b704-4258-a5d6-09db69ee91a3.jpg","likes":1015,"dislikes":22,"views":112761,"release_date":"1547251200000","season_number":1,"description":"في أكاديمية شوتشين الشهيرة ، ميوكي شيروجان وكاجويا شينوميا هما الممثلان الرئيسيان للهيئة الطلابية. تم تصنيفها كأفضل طالب في الدولة واحترامها من قبل أقرانها والموجهين على حد سواء ، يشغل ميوكي منصب رئيس مجلس الطلاب. وإلى جانبه ، تتفوق نائبة الرئيس كاجويا - الابنة الكبرى لعائلة شينوميا الثرية - في كل مجال يمكن تخيله. إنهم موضع حسد من جميع الطلاب ، حيث يُنظر إليهم على أنهم الزوجان المثاليان.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"PG-13"},"background_color":"#f30606","current_season_id":6861,"content_control":"NORMAL"}}