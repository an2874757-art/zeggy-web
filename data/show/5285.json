,"card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Drama","Romance","Western"],"id":5285,"type":"MOVIE","title":"Far and Away","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/e57068c3-40e3-4641-940c-84121e19b9ab.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/1faaf56a-5645-4293-a479-428e1e9d0d32.jpg","likes":32,"dislikes":1,"views":4952,"release_date":"706492800000","length":8400,"description":"A young man leaves Ireland with his landlord's daughter after some trouble with her father and they dream of owning land at the big give-away in Oklahoma ca. 1893. When they get to the new land, they find jobs and begin saving money. The man becomes a local bare-hands boxer and rides in glory until he is beaten, then his employers steal all the couple's money and they must fight off starvation in the winter and try to keep their dream of owning land alive. Meanwhile, the woman's parents find out where she has gone and have come to the U.S. to find her and take her back.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"episode_id":5285,"content_control":"NORMAL"}}