co/seasons/436e0f78-cc40-4e4c-859d-d09b8404c2c3.jpg","background_image":"https://cloud02.albox.co/seasons/b1e15bee-a9dd-4b10-bd3d-9f0eb4e80c83.jpeg","likes":79,"dislikes":0,"views":6257,"release_date":"1627948800000","season_number":1,"description":"سانغ وو يان، طالبة جامعية في السنة الأخيرة تطمح لأن تصبح مذيعة، تعمل مساعدة في محطة إذاعية، وتقع في حب كاتب الأغاني الغامض \"يي جين\". تلتقي لاحقًا بسو نيان تشين وتقع في حبه، لتكتشف لاحقًا أنه ضعيف البصر. مع تطور علاقتهما العاطفية، تكتشف ماضيه المضطرب وحقيقة أنه \"يي جين\". لكن الضغوط المتزايدة تُرهق علاقتهما، مما يؤدي إلى الانفصال. بعد ثلاث سنوات، يلتقيان مجددًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"PG-13"},"background_color":"","current_season_id":20835,"content_control":"FAMILY"}}