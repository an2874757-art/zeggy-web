o/storage/CLOUD00/shows/63ac53d8-febb-4ca2-a649-8d448c8ce7de.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/shows/3eb570fe-56ea-4caa-adce-33a6c4416ed1.jpg","likes":135,"dislikes":8,"views":11998,"release_date":"1087084800000","length":6926,"description":"يعتبر (بوب بار) المعروف أيضًا باسم مستر (إنكريدبل) وزوجته (هيلين) المعروفة باسم (إيلاستي جيرل) من أعظم وأشهر محاربي الجريمة ضمن زمرة الأبطال الخارقين. يقوم الثنائي دومًا بإنقاذ الحيوات ومحاربة الشر يوميًا، ولكن بمرور السنين يكون عليهما أن يتخفيا وراء شخصيات عادية وعيش حياة طبيعية قدر المستطاع بصحبة أولادهم الصغار، يرغب بوب في العودة إلى حياة الأبطال الخارقين، ولكن تلك الرغبة تقوده إلى طريق شائك، ويكون على الأسرة الصغيرة أن تتحد من أجل مواجهة الخطر المحدق.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"G"},"episode_id":493013,"background_color":"#c00310","content_control":"NORMAL"}}