pg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7574,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller"],"id":7574,"type":"MOVIE","title":"The A-Team","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/b097a13d-d811-4c0e-86ad-41a332905ee1.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/df94e6fc-806a-477a-abed-512bdad8be2d.jpeg","likes":108,"dislikes":4,"views":11282,"release_date":"1276214400000","length":8014,"description":"Four American soldiers who are in Iraq are sent on a mission to recover plates for printing 100 dollar bills that were used to print a billion dollars. After doing the job and returning to the base their commanding officer is killed in an explosion and the plates are stolen by another operative. They would be court martialed and sent to different prisons. 6 months later, the leader, Hannibal Smith is visited by a CIA spook who tells him he knows where the man who took the plates is and wants him and his men to recover it. So he helps him escape and he breaks out the others and they go after the plates. But after doing it, they discover that the spook might not be ok. And a military intelligence officer who was involved with one of them is pursuing them.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"episode_id":7574,"content_control":"FAMILY"}}