tyle":{"image":"https://cloud01.albox.co/shows/14802f95-a941-4b39-9353-7b26040c9c9b.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35317,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Animation","Family"],"id":35317,"type":"SERIES","title":"ThunderCats","logo":"https://cloud02.albox.co/shows/cabe600e-f0ba-4c1e-b512-e5ef24bf1787.png","image":"https://cloud02.albox.co/seasons/7f85190f-e631-48b0-bc5d-efca7c3f3d2f.jpg","background_image":"https://cloud02.albox.co/seasons/80f36076-75c9-4ce0-84dd-9eaf6080bf76.jpg","likes":91,"dislikes":11,"views":26463,"release_date":"475286400000","season_number":1,"description":"The inhabitants of the planet Thundera evacuate just before it is destroyed. They were pursued by a band of mutants. All but one of their escape ships was destroyed. Only a small group of Thunderans (Thundercats) remained. With only half engine power, the group, which was led by Jaga, had to set a course for the nearest planet. Jaga commanded their ship while the other seven were in their stasis tubes. Jaga died on their journey to Third Earth and their ship crashed there. Soon they made friends with various groups in the area and they designed a fortress. Mumm-Ra the centuries-old embodiment of evil, along with the mutants that destroyed the rest of the Thunderans are a constant threat. But Lion-O, the new leader of the Thundercats, with his weapon the \"Sword of Omens\" will help the Thundercats to have a standing chance.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"TV-Y7"},"background_color":"","current_season_id":20054,"content_control":"NORMAL"}}