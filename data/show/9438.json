lbox.co/storage/disk46/shows/80f0ca0a-f327-434c-af1a-ebf0cbb57311.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9438,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":9438,"type":"MOVIE","title":"Rachel Getting Married","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/100d4346-4478-435e-b73b-699f5d69ebbc.jpg","background_image":"","likes":38,"dislikes":4,"views":9174,"release_date":"1226016000000","length":6763,"description":"Kym Buchman has been in drug rehab for nine months, during which time she has been clean. She is released temporarily from the facility to attend her sister Rachel Buchman's wedding. During her release, Kym is staying at the family home, where the wedding is taking place. As such, it is like Grand Central Station for the duration of Kym's stay, which may not be the most conducive situation for her in constantly being exposed to the watching eyes of those who know and don't yet know her, but know of her situation. The reunion with her family members starts off well enough, but issues around Kym's release from rehab quickly surface. Kym and Rachel's father, Paul Buchman, wants to make sure that Kym is all right at all times, which to Kym feels instead like he doesn't trust her. Rachel slowly begins to resent Kym's situation taking over what is supposed to be the happiest day of her life, some of which is directed by Kym, some of which isn't. One person present but largely not included in the last minute wedding planning work is Kym and Rachel's mother, Abby, from who Paul is divorced. The two have since married other people. Outwardly, Abby has been nurturing of Kym throughout her life. However, what is one of the key moments in Kym's drug induced life, and in their collective family's lives, may profoundly affect the wedding. Beyond how Kym's presence affects the wedding, the goings-on of the family during Kym's short stay may either bring them closer together or tear them apart.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":9438,"content_control":"FAMILY"}}