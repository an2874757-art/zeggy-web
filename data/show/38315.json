ption":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/dc7ae5c7-bca6-4975-b27c-b6f235e8ea9a.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":38315,"title":"","description":"132","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy"],"id":38315,"type":"SERIES","title":"Backstabbed in a Backwater Dungeon","logo":"https://cloud02.albox.co/shows/1a281eb2-3b60-490e-86a2-1ba98403ef3f.jpg","image":"https://cloud02.albox.co/seasons/af54ebd2-5d3a-47a0-9e52-4c02d4fe8503.jpg","background_image":"https://cloud02.albox.co/seasons/8476bd1e-07f9-48f3-a996-ea6e1830bd87.jpg","likes":1125,"dislikes":22,"views":124839,"release_date":"1759449600000","season_number":1,"description":"عندما طُرد لايت من تحالف القبائل، انقلب عليه رفاقه السابقون على الفور. نجا لايت من هذه الخيانة الشنعاء بأعجوبة... ليجد نفسه في أعمق نقطة في الهاوية، أخطر زنزانة في العالم! لتجنب أن تأكله الوحوش آكلة اللحوم، استخدم غاتشا اللامحدود، مهارته السحرية الوحيدة. ولكن بينما كانت تنتج سابقًا عناصر غير مرغوب فيها، ظهرت مي - مقاتلة رائعة المستوى 9999 بزي خادمة - هذه المرة! بعد ثلاث سنوات، بنى لايت مملكته الخاصة في هذه الزنزانة النائية، مستدعيًا محاربات أكثر جمالًا من المستوى 9999 يُقسمن له بالولاء المطلق. الآن، وقد أصبح سيدًا قويًا من المستوى 9999، يخطط لايت للصعود إلى السطح والانتقام من خائنيه واحدًا تلو الآخر!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-14"},"background_color":"#283cf0","current_season_id":22233,"content_control":"NORMAL"}}