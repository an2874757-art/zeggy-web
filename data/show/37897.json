tion_type":"normalPoster"},{"data":[{"items":[],"id":37897,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Historical"," Comedy","Political"],"id":37897,"type":"SERIES","title":"Better Halves","logo":"","image":"https://cloud02.albox.co/seasons/eed176cd-cb0e-473f-a30b-a35f88539301.jpg","background_image":"https://cloud02.albox.co/seasons/2cdb3a4b-a15f-4dd2-b11d-7fcb02f9b3f3.jpg","likes":16,"dislikes":0,"views":2235,"release_date":"1753315200000","season_number":1,"description":"شي فا كي، الابنة المدللة لعائلة عريقة، حلمت بالاستمتاع بالحياة على أكمل وجه مع الطعام الشهي والتسوق، لكن والدتها أصرت بشدة على أن ترث صناعة العائلة. أرسل الإمبراطور لو تشي في مهمة سرية للتحقيق في نفوذ المدينة الإمبراطورية، فتتنكر في هيئة رجل أعمال ثري لتنفيذ المهمة. عندما التقى الاثنان، قررت شي فا كي العمل في مجال التوفيق بين الأزواج لمجرد لعب دور التوفيق بين الأزواج مع لو تشي، وفي المقابل وعدها بأن يكون ضيفها الأول في شركة عائلتها. تركز شي فا كي على استعادة مجد \"التوفيق بين الأزواج رقم واحد في العالم\"، وخلال العديد من التقلبات، عملت هي ولو تشي معًا لحل مشاكل الزواج وكشف الجناة الخائنين للإمبراطور.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"R"},"background_color":"","current_season_id":21969,"content_control":"FAMILY"}}