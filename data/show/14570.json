ed","section_type":"normalPoster"},{"data":[{"items":[],"id":14570,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Animation"],"id":14570,"type":"SERIES","title":"The Betrayal Knows My Name","logo":"","image":"https://cdn6.albox.co/storage/disk59/seasons/bf8bca4d-d3a2-4c86-a048-bd3f63fc8ee7.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/7f262822-f503-4df4-9154-016f190a63e4.jpg","likes":90,"dislikes":1,"views":6021,"release_date":"1270944000000","season_number":1,"description":"Yuki Sakuragi is a soft-hearted high-schooler who was abandoned by his parents as a child and was raised in an orphanage. While cursed by mysterious dreams and the strange ability to read the thoughts of other people through touch, Yuki searches for the reason to his existence. Although, as his powers grow stronger, a beautiful young man with a familiar face appears before him. The man calls himself \"Zess\", and warns Yuki not to go outside during Walpurgis Night, which is the eve of the blood-red moon. But Yuki's compassion leads him to disobey Zess, and now his life might be in danger.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"R"},"current_season_id":1513,"content_control":"NORMAL"}}