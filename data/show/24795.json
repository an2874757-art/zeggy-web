انت حياته تعتمد عليها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-13"},"background_color":"","current_season_id":13010,"content_control":"NORMAL"}}