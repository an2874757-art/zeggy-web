},{"data":[{"items":[],"id":9836,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Mystery"],"id":9836,"type":"MOVIE","title":"The Ghost Writer","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/d38ec596-8019-44ca-83c8-f634fcdb4ad4.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/09e6fa15-a903-4574-9a7c-7ae216d73187.jpg","likes":31,"dislikes":0,"views":5665,"release_date":"1268956800000","length":7683,"description":"An unremarkable ghost-writer has landed a lucrative contract to redact the memoirs of Adam Lang, the former UK Prime Minister. After dominating British politics for years, Lang has retired with his wife to the USA. He lives on an island, in luxurious, isolated premises complete with a security detail and a secretarial staff. Soon, Adam Lang gets embroiled in a major scandal with international ramifications that reveals how far he was ready to go in order to nurture UK's \"special relationship\" with the USA. But before this controversy has started, before even he has closed the deal with the publisher, the ghost-writer gets unmistakable signs that the turgid draft he is tasked to put into shape inexplicably constitutes highly sensitive material.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"episode_id":9836,"content_control":"NORMAL"}}