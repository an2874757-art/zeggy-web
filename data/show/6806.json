gth":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6806,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy"],"id":6806,"type":"MOVIE","title":"Year One","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/c08d31ae-42dc-432b-8d18-845c6da1d993.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/6c803368-b6ca-4077-b773-851f1181924c.jpg","likes":21,"dislikes":2,"views":5412,"release_date":"1245369600000","length":5813,"description":"Zed, a prehistoric would-be hunter, eats from a tree of forbidden fruit and is banished from his tribe, accompanied by Oh, a shy gatherer. On their travels, they meet Cain and Abel on a fateful day, stop Abraham from killing Isaac, become slaves, and reach the city of Sodom where their tribe is now enslaved. Zed and Oh are determined to rescue the women they love, Maya and Eema. Standing in their way is Sodom's high priest and the omnipresent Cain. Zed tries to form an alliance with Princess Innana, which may backfire. Can an inept hunter and a smart but slender and diffident gatherer become heroes and make a difference?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.9}],"value":4.9,"age":"PG-13"},"episode_id":6806,"content_control":"NORMAL"}}