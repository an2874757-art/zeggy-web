h":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Drama","War"],"id":12584,"type":"MOVIE","title":"Inglourious Basterds","logo":"https://cdn6.albox.co/storage/CLOUD00/shows/aa8701ed-f7ae-4dbe-a99a-c172917b09ce.png","image":"https://cdn6.albox.co/storage/CLOUD00/shows/7a157031-c09f-4e70-a1bd-ed595ef96675.jpg","background_image":"https://cdn6.albox.co/storage/CLOUD00/shows/76b85937-4b6c-49fd-8fc6-85748be6a270.jpg","likes":2564,"dislikes":135,"views":165298,"release_date":"1250812800000","length":9180,"description":"In German-occupied France, young Jewish refugee Shosanna Dreyfus witnesses the slaughter of her family by Colonel Hans Landa. Narrowly escaping with her life, she plots her revenge several years later when German war hero Fredrick Zoller takes a rapid interest in her and arranges an illustrious movie premiere at the theater she now runs. With the promise of every major Nazi officer in attendance, the event catches the attention of the \"Basterds\", a group of Jewish-American guerrilla soldiers led by the ruthless Lt. Aldo Raine. As the relentless executioners advance and the conspiring young girl's plans are set in motion, their paths will cross for a fateful evening that will shake the very annals of history.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"episode_id":12584,"content_control":"FAMILY"}}