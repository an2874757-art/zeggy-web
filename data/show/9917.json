omments","section_type":"comments"}],"post_info":{"genres":["Mystery","Horror"],"id":9917,"type":"MOVIE","title":"Session 9","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/8538c2cb-328b-407a-81e5-13838eeeb28f.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/b8fd5e49-bf85-4742-b756-af3db55e8a5e.jpg","likes":22,"dislikes":2,"views":3756,"release_date":"1000425600000","length":6019,"description":"An asbestos abatement crew wins the bid for an abandoned insane asylum. What should be a straightforward, if rather rushed, job, is complicated by the personal histories of the crew. In particular, Hank is dating Phil's old girlfriend, and Gordon's new baby seems to be unnerving him more than should be expected. Things get more complicated as would-be lawyer Mike plays the tapes from a former patient with multiple personalities, including the mysterious Simon who does not appear until Session 9, and as Hank disappears after finding some old coins.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"episode_id":9917,"content_control":"NORMAL"}}