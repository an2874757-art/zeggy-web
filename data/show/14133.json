"},{"data":[{"items":[],"id":14133,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy","Drama","Romance","Comedy","Animation"],"id":14133,"type":"SERIES","title":"Kanokon","logo":"","image":"https://cdn6.albox.co/storage/disk59/seasons/ec6b86e7-a5ca-4dcb-93a2-836434ce44b5.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/093256d5-3758-4448-8b95-4faae59df227.jpg","likes":100,"dislikes":24,"views":22845,"release_date":"1207353600000","season_number":1,"description":"Kouta, a country boy who lives with his grandfather, is now moving to the city to attend high school. Changes come with his new home and new school, but nothing could have prepared the gentle young man for girls, specifically a bombshell fox spirit named Chizuru. As if her aggressive advances weren't enough, he also catches the attention of a frosty wolf spirit named Nozomu. Kouta is dragged into supernatural events as a result of his contact with the two girls, and his school life only gets more chaotic by the day. But with a girl who gives \"foxy\" new meaning and another howling after him, things are looking up for his love life.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"R"},"current_season_id":852,"content_control":"NORMAL"}}