hing_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3909,"title":"","description":"34","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":3909,"type":"MOVIE","title":"Kal Ho Naa Ho","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/9377465f-0773-4927-9999-acbfe1bf8cfa.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/4f7959d3-736e-4875-9c16-dadf6fa4555c.jpg","likes":498,"dislikes":8,"views":41602,"release_date":"1069977600000","length":11254,"description":"The film's female lead, Naina (Preity Zinta) narrates the story. Her father had committed suicide years ago which left a deep impact on her heart. Her family is dysfunctional since her mother and grandmother just cannot stop arguing. But when Aman (Shahrukh Khan) arrives next door, the whole gloomy conditions change. Aman infuses life in skeptical and overtly serious Naina, and she falls in love with him. But Aman knows that he cannot marry Naina because of a secret which he cannot divulge to her. So he intends upon setting her up with her best pal Rohit (Saif Ali Khan).","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"episode_id":3909,"content_control":"FAMILY"}}