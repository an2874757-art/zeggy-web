"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["School"," Romance"," Historical"],"id":23669,"type":"SERIES","title":"Celestial Authority Academy","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/0eea3c49-89eb-45d5-a9b1-ab2aa070c24c.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/5de56029-bc9d-4708-910f-a584938ed25e.jpg","likes":19,"dislikes":0,"views":1475,"release_date":"1614211200000","season_number":1,"description":"تدور أحداث القصة في عهد الأسرة السماوية المزدهرة والمسالمة. تم بناء أكاديمية السلطة السماوية من قبل العائلات الإمبراطورية الأربع التي تحاول تعزيز مكانة أسرتها على الرغم من ذلك. وتتقاتل العائلات الإمبراطورية مع بعضها البعض للحصول على مكان فيها. كاتب مشهور وموهوب ومحبوب (الإمبراطورة هي واحدة من معجبيه المتحمسين!) يلتحق بالأكاديمية بصفته الشخصية ودون اجتياز امتحان القبول. بشكل غير متوقع ، تبين أن هذا الشاب الموهوب حسن المظهر فتاة. وكثير من الرجال يقعون في حبها في النهاية. ما يلي هو قصة حب رائعة بجنون في الحرم الجامعي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"R"},"background_color":"","current_season_id":12198,"content_control":"NORMAL"}}