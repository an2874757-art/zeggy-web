ما يكتشف ملعب جولف كاملًا صنعه سكان الجزيرة. باستخدام التضاريس الساحلية لصالحهم، اعتمد الناس هناك لعبة الجولف كهواية لهم.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"background_color":"","current_season_id":18720,"content_control":"NORMAL"}}