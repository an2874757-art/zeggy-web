ion_type":"normalPoster"},{"data":[{"items":[],"id":4402,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Mystery"],"id":4402,"type":"MOVIE","title":"7 Khoon Maaf","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/38c8e25a-44be-47cd-92c4-dfb73d35347a.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/7e7109ed-9454-4768-925c-eecb0336e891.jpg","likes":33,"dislikes":1,"views":5762,"release_date":"1297987200000","length":8874,"description":"After the passing of his Pondicherry-born mentor, Susanna, Mumbai-based Dr. Arun Kumar Singh narrates his story to his wife, Nalini. With photographs from an old album that he has never shared with anyone, he informs her as to how Susanna caught him stealing; got him to quit his job & enrolled in a Panchgani school, as well as arranged for further education in St. Petersburg. While Susanna herself searched for true love and her marriages with six deceased men - including the abusive Major Edwin Rodrigies; drug-addicted and womanizer guitarist-singer Jamshed Singh Rathore; impotent and abusive Mohammad Wasiullah Khan; bigamist/spy Nicolai Vronski; Inspector Keemat Lal; and Dr. Modhusodon Tarafdar - men who influenced her life, broke her heart - and met with sudden and mysterious deaths.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"episode_id":4402,"content_control":"NORMAL"}}