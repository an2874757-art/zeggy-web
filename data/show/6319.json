"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6319,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime"],"id":6319,"type":"MOVIE","title":"Wall Street","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/e5ec3d3f-eb21-4c81-8220-d975c50cd97b.jpg","background_image":"","likes":34,"dislikes":0,"views":4418,"release_date":"566179200000","length":7544,"description":"Bud Fox is a Wall Street stockbroker in early 1980's New York with a strong desire to get to the top. Working for his firm during the day, he spends his spare time working an on angle with the high-powered, extremely successful (but ruthless and greedy) broker Gordon Gekko. Fox finally meets with Gekko, who takes the youth under his wing and explains his philosophy that \"Greed is Good\". Taking the advice and working closely with Gekko, Fox soon finds himself swept into a world of \"yuppies\", shady business deals, the \"good life\", fast money, and fast women; something which is at odds with his family including his estranged father and the blue-collared way Fox was brought up.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"episode_id":6319,"content_control":"FAMILY"}}