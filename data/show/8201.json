g"},"length":0,"continue_watching_progress":0},{"items":[],"id":13350,"title":"Me Before You","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/653b5544-0b70-435c-90fc-055780415c8f.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":39688,"title":"The Wrecking Crew","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/d882a5e2-268d-4785-bbb6-13c98e0a5dcd.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10265,"title":"Harry Potter and the Deathly Hallows: Part 1","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/34bd8a97-04b8-489e-bed6-7907d133eff0.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36375,"title":"Havoc","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/181c4c6d-efcc-4ef3-9d3d-8ff7705f9804.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":24078,"title":"Dune","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/413afb33-5fd0-4e12-86b4-4d70d68b463c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8201,"title":"","description":"20","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":8201,"type":"MOVIE","title":"Wild Strawberries","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/416b501b-8e03-4b2e-8059-d2b8fb23a87f.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/5409c5c2-0757-4aa4-826e-a5f5e6f183eb.jpg","likes":64,"dislikes":3,"views":6270,"release_date":"-332294400000","length":5553,"description":"With the exception of his elderly housekeeper Miss Agda who he treats almost like a surrogate platonic wife, widowed seventy-eight year old Dr. Isak Borg, a former medical doctor and professor, has retreated from any human contact, partly his own want but partly the decision of others who do not want to spend time with him because of his cold demeanor. He is traveling from his home in Stockholm to Lund to accept an honorary degree. Instead of flying as was the original plan, he decides to take the day long drive instead. Along for the ride is his daughter-in-law Marianne, who had been staying with him for the month but has now decided to go home. The many stops and encounters along the way make him reminisce about various parts of his life. Those stops which make him reminisce directly are at his childhood summer home, at the home of his equally emotionally cold mother, and at a gas station where the attendants praise him as a man for his work. But the lives of other people they encounter almost mirror his own, including hitchhikers Sara, Viktor and Anders - who remind him of his cousin Sara who he was going to marry, himself and his irresponsible brother Sigfrid who Sara eventually married - a bickering married couple Sten and Berit Alman, and Marianne and her husband and Isak's son Evald, whose marriage is as strained as was his own.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"r"},"episode_id":8201,"content_control":"FAMILY"}}