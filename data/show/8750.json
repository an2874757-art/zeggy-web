ata":[{"items":[],"id":8750,"title":"","description":"17","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi"],"id":8750,"type":"MOVIE","title":"The Matrix Reloaded","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/99ef43e1-df52-4941-b994-8004e5ecef0b.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/dee31077-066b-4b80-b0a7-9ae035aa6196.jpg","likes":301,"dislikes":10,"views":42041,"release_date":"1052956800000","length":8295,"description":"Six months after the events depicted in The Matrix, Neo has proved to be a good omen for the free humans, as more and more humans are being freed from the matrix and brought to Zion, the one and only stronghold of the Resistance. Neo himself has discovered his superpowers including super speed, ability to see the codes of the things inside the matrix, and a certain degree of precognition. But a nasty piece of news hits the human resistance: 250,000 machine sentinels are digging to Zion and would reach them in 72 hours. As Zion prepares for the ultimate war, Neo, Morpheus and Trinity are advised by the Oracle to find the Keymaker who would help them reach the Source. Meanwhile Neo's recurrent dreams depicting Trinity's death have got him worried and as if it was not enough, Agent Smith has somehow escaped deletion, has become more powerful than before and has chosen Neo as his next target.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":8750,"content_control":"FAMILY"}}