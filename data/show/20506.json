style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Animation"],"id":20506,"type":"SERIES","title":"Fuse  Memoirs of a Huntress","logo":"","image":"https://cdn6.albox.co/storage/disk48/seasons/1d2242ce-690c-41a9-b7e1-08d702f92e9f.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/6668c453-506c-4bad-9044-478616833d42.gif","likes":14,"dislikes":0,"views":1761,"release_date":"1350691200000","season_number":1,"description":"Fuse are hybrids between humans and dogs, who live in Japan in the Edo period. It was said that they kill people to feed themselves with their souls. Due to this rumors, the Shogun put a price on their heads. Hamaji is a young huntress, who lives in a rural area of Mutsu. When her grandfather dies, she receives a letter from her brother, who lives in Edo; he says to her to go to live with him and help him in the hunt of the Fuse. But, when Hamaji comes to Edo, she meets a mysterious young guy with white hair, who is being pursued by some men... His name is Shino...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"N/A"},"current_season_id":9492,"content_control":"NORMAL"}}