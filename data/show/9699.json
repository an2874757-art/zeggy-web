Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9699,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi"],"id":9699,"type":"MOVIE","title":"Dasavatharam","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/80f80d15-c5b2-4347-8be0-4896da921074.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/1571c6c4-308c-4474-be9d-2759f334cf18.jpg","likes":3,"dislikes":0,"views":1326,"release_date":"1213315200000","length":11062,"description":"U.S.-based Bio-technologist, Govind K. Somaiyya, narrates from a stadium a tale of religious conflict in India - even before the appearance of Jesus and Allah. This conflict was between worshipers of Bhagwan Shri Shiv and Bhagwan Shri Vishnu - with devotees of the latter being put to death. Now in post-9/11 era President George W. Bush invests heavily in biological research but things get out of control when a vial containing a deadly chemical is inadvertently dispatched via courier to Tamil Nadu, India. In order to retrieve it, Govind must face heavy odds, including a deadly CIA Agent, Chris Fletcher; a killer named Jasmine; RAW Officer Pranab Kundu, as well as a martial-arts artist from Tokyo.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"r"},"episode_id":9699,"content_control":"NORMAL"}}