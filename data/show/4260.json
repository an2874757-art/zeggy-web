//cdn6.albox.co/storage/disk42/shows/c06c894d-312a-401b-91e5-10680fdebfe3.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4260,"title":"","description":"12","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Romance","Comedy","Family","Sport"],"id":4260,"type":"MOVIE","title":"Herbie Fully Loaded","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/757a872e-0934-4ede-b648-df12283eff71.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/5e7b6cc7-5678-4db8-8165-1ab85c38077d.jpg","likes":105,"dislikes":0,"views":6848,"release_date":"1119398400000","length":6052,"description":"Maggie Peyton is the new owner of Number 53--the free wheelin' Volkswagen bug with a mind of its own; she puts the car through its paces on the road to becoming a NASCAR competitor. As a third generation member of a NASCAR family, racing is in Maggie Peyton's blood, but she is forbidden from pursuing her dream by her overprotective father, Ray Peyton, Sr. When Ray Sr. offers Maggie a car as a college graduation present, he takes her to a junkyard to choose one from an assortment of very used cars. Maggie has her eye on an old Nissan, but a certain rusty, banged up '63 VW Bug seems to be clamoring for her attention. To her surprise, Maggie leaves the lot with Herbie. As she prepares to leave town for a position with ESPN News, Maggie discovers that Herbie has a mind of his own--and an alternate route for her future.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.8}],"value":4.8,"age":"PG-13"},"episode_id":4260,"background_color":"","content_control":"FAMILY"}}