بمساعدة يان لين كجنرال، استولى المتمردون على العاصمة وقاموا بإبادة العائلة المالكة بأكملها بلا رحمة. في آخر عمل يائس لها، طلبت جيانغ شيويه نينغ استبدال حياتها بحرية تشانغ زهي، الرجل الذي أظهر لطفها دائمًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"PG-13"},"background_color":"","current_season_id":18635,"content_control":"FAMILY"}}