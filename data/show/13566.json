:13566,"title":"","description":"55","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Thriller","Animation"],"id":13566,"type":"SERIES","title":"دراغون بول زد مدبلج","logo":"","image":"https://cloud02.albox.co/seasons/6b975e88-549f-4a4e-867c-0ef04847c42d.png","background_image":"https://cloud02.albox.co/seasons/5684a72d-8609-4475-9930-be1af08e2784.jpg","likes":2199,"dislikes":62,"views":351583,"release_date":"842572800000","season_number":1,"description":"في الإصدار المعروض على YTV في كندا ، تبدأ القصة في منتصف الطريق عبر سلسلة Dragon Ball Z. راديتز ، شقيق جوكو سافر إلى الأرض لاكتشاف سبب عدم تدمير جوكو للكوكب بعد كما كان من المفترض أن يفعل. لكن أثناء طفولته ، سقط جوكو (أسفل منحدر ضخم) ونسي مهمته الحقيقية. كاكاروت ، اسم جوكو الحقيقي يقاتل شقيقه راديتز مع العدو السابق بيكولو وصديقه كريلين. وفي الوقت نفسه ، غوهان ؛ يكشف ابن جوكو عن قواه الخفية ضد راديتز ويكاد يقتل راديتز. ومع ذلك ، قُتل جوكو في النهاية ، لكن راديتز هزم في النهاية من قبل بيكولو. قبل أن يموت ، أخبرهم أن اثنين من Saiyans الشريرين أقوى مما هو عليه ، في طريقهما إلى الأرض. يبدأ المقاتلون المتبقون ، كريلين ، يامشا ، تيان ، وتشياوتسو تدريبهم لمحاربة الأشرار سايان ، بينما ينطلق بيكولو مع غوهان لتدريبه على استخدام قوته الجديدة المكتشفة. في هذه الأثناء ، يتعين على جوكو العودة إلى طريق Snake Way إلى King Kai's حيث يدرب نفسه على الفن السري لـ Kaio-ken.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"TV-PG"},"background_color":"","current_season_id":23012,"content_control":"NORMAL"}}