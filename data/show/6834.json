items":[],"id":6834,"title":"","description":"12","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Animation","Family"],"id":6834,"type":"MOVIE","title":"Beauty and the Beast","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/84054061-6aee-48ce-904b-a294bc0c4e65.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/0e2f54f6-7d64-4f08-b51f-556c61669df5.jpg","likes":393,"dislikes":5,"views":61498,"release_date":"690768000000","length":5505,"description":"Having lived a life in selfishness, a young prince is cursed by a mysterious enchantress to having the appearance of a monstrous beast. His only hope is to learn to love a young woman and earn her love in return in order to redeem himself. Years later, his chance shows itself when a young maiden named Belle offers to take her ill father's place as his prisoner. With help from the castle's enchanted staff, Belle learns to appreciate her captor and immediately falls in love with him. Back in the village however, an unscrupulous hunter has his own plans for Belle.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"G"},"episode_id":6834,"content_control":"NORMAL"}}