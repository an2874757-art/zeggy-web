lPoster"},{"data":[{"items":[],"id":41969,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Romance","History"],"id":41969,"type":"SERIES","title":"Spring Over Phoenix Pond","logo":"https://cloud02.albox.co/shows/2bc8c541-875a-4178-b5a3-de85ef47e4b4.jpg","image":"https://cloud02.albox.co/seasons/1bbf2448-a844-40ca-a74a-197d437d4d4e.jpg","background_image":"https://cloud02.albox.co/seasons/e1d8a4df-bdac-428b-9f88-ee8a4dd22ea6.jpg","likes":31,"dislikes":0,"views":8304,"release_date":"1784851200000","season_number":1,"description":"كانت تشي يوان، ابنة الجزار، الوريثة الحقيقية لمقر الماركيز، والتي تم استبدالها عند الولادة. قامت الوريثة المزيفة بتلفيق تهمة لها وإذلالها لحماية نفسها. أُجبرت تشي يوان على أن تصبح الحارسة السرية للأمير جينغ شياو يون تينغ، ونشأت بينهما علاقة حب تدريجية. في ليلة زفافهما، اقتحم الأمير تشي المنزل بتهور. ماتت تشي يوان معه، لتكتشف لاحقًا أنها قد بُعثت من جديد. في هذه الحياة، لن تدع أحدًا يقف في طريقها...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"NC-17"},"background_color":"#fff0c8","current_season_id":24473,"content_control":"NORMAL"}}