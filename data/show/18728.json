nd-up comedy profession, and transforms from uptown housewife to East Village club performer.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"TV-MA"},"current_season_id":7092,"content_control":"NORMAL"}}