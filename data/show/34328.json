ows/0e9d8ac5-326b-42dd-b56c-9bc4a83284a1.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38835,"title":"Arafta - الأعراف","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/e98a400c-9bb2-4170-aad4-0fc9ab3740e5.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":34328,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":34328,"type":"SERIES","title":"حكاية حب","logo":"","image":"https://cloud02.albox.co/seasons/7f9b0127-8a79-423b-a1f5-9dfeb1f5791d.jpg","background_image":"https://cloud02.albox.co/seasons/6e6a32e5-1297-4248-a5d0-c9b689500e5c.jpg","likes":167,"dislikes":5,"views":22204,"release_date":"1364256000000","season_number":1,"description":"شاب تركي ( كوركوت علي ) يعيش فئ شتوتجارت يتحدث مع والدته التي تركته قبل سنين عن طريق كاميرات وثائقية . من طرف يقول ''انتظريني يا أمي سأعثر عليك '' ومن طرف آخر يحلم بالزواج من حبيبته. ولكنه لم يكن على دراية بان الفراق مكتوب في قدره مرة أخرى. كما ايضا لم يكن على دراية بان مغني البوب الشهير تولجا ومساعده جيلان واللذان اتيا للمدينة من اجل تصوير كليب موسيقي سيكونان اهم شخصان في حياته. ستعم الفوضى عندنا ترى جيلان والتي تحب تولجا بدون مقابل كوركوت علي الذي انقذها في شوراع المانيا ، في اسطنبول ، وفوق كل هذا ستكون شريكة اكبر اسرار والدة علي التي يبحث عنها لسنين.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"background_color":"","current_season_id":19306,"content_control":"NORMAL"}}