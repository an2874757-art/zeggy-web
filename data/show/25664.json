background_image":"https://cdn8.albox.co/storage/CLOUD00/shows/b5dc888b-2a7e-4582-89a4-895e7a17d088.jpg","likes":138,"dislikes":2,"views":9065,"release_date":"1636675200000","length":2373,"description":"هل سمعت عن Summer Ghosts؟ \"Tomoya و Aoi و Ryo هم طلاب مدرسة ثانوية التقوا عبر الإنترنت. الأسطورة الحضرية لـ Summer Ghost هي أنه شبح لامرأة شابة تظهر عندما تضاء الألعاب النارية. Tomoya هو غير قادر على الخروج إلى الحياة التي يريدها. Aoi غير قادرة على العثور على مكانها في العالم. مستقبل ريو المشرق مغلق فجأة أمامه. كل واحد منهم لديه أسبابه الخاصة لمقابلة شبح الصيف. في ليلة صيف عندما تكون الحياة و يتقاطع الموت ، فإلى أين تذهب أفكارهم؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG-13"},"episode_id":471717,"content_control":"FAMILY"}}