s://cdn6.albox.co/storage/disk50/shows/2fa7a0ad-a1b6-4591-8803-9bfabd1d7a9a.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":7911,"title":"The Meg","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk50/shows/913bd4dd-ad2c-485f-b585-bfbab86ad2cd.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35870,"title":"Love Hurts","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/f3e89d3e-4b6a-48c2-86f5-8b7e49ba1a94.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10265,"title":"Harry Potter and the Deathly Hallows: Part 1","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/34bd8a97-04b8-489e-bed6-7907d133eff0.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10442,"title":"Divergent","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk43/shows/d9711466-6613-4a33-953c-7f7d80a0b4ad.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":3705,"title":"After","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk55/shows/16a00b59-7355-4cfe-9875-5c851ffef26c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7131,"title":"","description":"51","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":7131,"type":"MOVIE","title":"Lost in Translation","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/56314a58-56e4-478e-9802-db7953dd81b8.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/3b549c01-f7ed-4e11-93cb-342ffba3f24d.jpg","likes":199,"dislikes":13,"views":12755,"release_date":"1065139200000","length":6107,"description":"Middle-aged American movie star Bob Harris is in Tokyo to film a personal endorsement Suntory whiskey ad solely for the Japanese market. He is past his movie star prime, but his name and image still have enough cachet for him to have gotten this lucrative $2 million job. He has an unsatisfying home life where his wife Lydia follows him wherever he goes - in the form of messages and faxes - for him to deal with the minutiae of their everyday lives, while she stays at home to look after their kids. Staying at the same upscale hotel is fellow American, twenty-something recent Yale Philosophy graduate Charlotte, her husband John, an entertainment still photographer, who is on assignment in Japan. As such, she is largely left to her own devices in the city, especially when his job takes him out of Tokyo. Both Bob and Charlotte are feeling lost by their current situations, which are not helped by the cultural barriers they feel in Tokyo, those cultural barriers extending far beyond just not knowing the language. After a few chance encounters in the hotel, they end up spending much of their time hanging out together, each helping the other deal with their feelings of loss in their current lives. The friendship that develops between the two, which is not always a bumpy-free one, may be just for this specific place and time, but it may also have long lasting implications.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"R"},"episode_id":7131,"content_control":"NORMAL"}}