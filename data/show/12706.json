 Nina might become La Muerte Roja's next victim.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.1}],"value":4.1,"age":"r"},"episode_id":12706,"content_control":"NORMAL"}}