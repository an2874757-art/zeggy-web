},{"data":[{"items":[],"id":5821,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Comedy"],"id":5821,"type":"MOVIE","title":"The World's End","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/9e1d2c9d-785e-4ab4-a19c-f3a6c9413775.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/12828c55-de39-4141-a4c4-19df30102c79.jpg","likes":48,"dislikes":2,"views":5292,"release_date":"1377216000000","length":6543,"description":"20 years after attempting an epic pub crawl, five childhood friends reunite when one of them becomes hell bent on trying the drinking marathon again. They are convinced to stage an encore by mate Gary King, a 40-year old man trapped at the cigarette end of his teens, who drags his reluctant pals to their home town and once again attempts to reach the fabled pub, The World's End. As they attempt to reconcile the past and present, they realize the real struggle is for the future, not just theirs but humankind's. Reaching The World's End is the least of their worries.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":5821,"content_control":"FAMILY"}}