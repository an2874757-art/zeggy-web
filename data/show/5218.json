inue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5218,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","Horror"],"id":5218,"type":"MOVIE","title":"Voodoo Possession","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/e225d76a-e86f-4855-8cc8-2e2da547ec19.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/641e10c9-d609-4220-8ef9-3918acde500e.jpg","likes":19,"dislikes":1,"views":4087,"release_date":"1389657600000","length":5459,"description":"Imagine an insatiable demon that feeds on blood, thrives on pain, and reaches from beyond the grave to torment the living...and the dead. For believers and skeptics alike, there is nothing in this world or the next to rival the relentless evil of a Voodoo Possession. Burdened since childhood with a gnawing sense of guilt, cynical Aiden Chase journeys to a Haitian insane asylum in search of his missing brother. Upon arriving, he discovers all the inmates and the hospital administrator (Danny Trejo, Machete) are seemingly possessed by a bloodthirsty voodoo spirit. Now, Aiden must abandon reality and descend into a terrifying spirit world to try to rescue his brother - or they will both be damned for eternity.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":2.5}],"value":2.5,"age":"R"},"episode_id":5218,"content_control":"NORMAL"}}