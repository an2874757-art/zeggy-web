65.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":12067,"title":"","description":"95","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Animation"],"id":12067,"type":"MOVIE","title":"Princess Mononoke","logo":"https://cdn6.albox.co/storage/CLOUD00/shows/315347dd-eaba-4886-94f1-7c558e5e2868.png","image":"https://cdn6.albox.co/storage/disk42/shows/90d9589a-e764-48ff-9206-b169860b3956.png","background_image":"https://cdn6.albox.co/storage/disk55/shows/9523ff38-3378-4aa9-95eb-90d0464ee60f.jpg","likes":1404,"dislikes":25,"views":85091,"release_date":"882489600000","length":8003,"description":"قرية صغيرة لا تكاد ترى يعيش فيها (أشيتاكا) بهدوء ونعيم، وهذه القبيلة هي من القبائل التي قام الإمبراطور بنفيها، وحكم عليها بالنسيان إلى الأبد، وبذلك تنفى هذه القبيلة، وتختفي عن الأنظار، وهكذا لم يعرف الناس بهم، ولم يعرفوا قدرهم، ومن قوانين هذه القبيلة أن أي شخص لا يمكنه مغادرتها، والذي يغادرها لا يعود أبدا، (أشيتاكا) أميرها، وهو يقوم بحمايتهم جميعا من المصاعب التي تواجههم . في أحد الأيام بينما كان (أشيتاكا) في الجوار مع غزاله الأحمر ، صدر صوت غريب يشبه جلبة، وفجأة يظهر حيوان غريب كبير ، وبذلك تتغير حياة (أشيتاكا) للأبد منذ تلك اللحظة .","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"PG-13"},"episode_id":12067,"background_color":"","content_control":"FAMILY"}}