alPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/dc7ae5c7-bca6-4975-b27c-b6f235e8ea9a.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16286,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Sci-Fi","Romance","Comedy","School","Shounen","Supernatural","Magic"],"id":16286,"type":"SERIES","title":"Mahou Sensei Negima!","logo":"","image":"https://cdn6.albox.co/storage/disk44/seasons/d5561426-2c39-4b36-bac6-963418bfca3d.jpg","background_image":"https://cdn6.albox.co/storage/disk44/seasons/1c3237a2-b1d8-4f93-9a29-e33920e48f88.jpg","likes":21,"dislikes":0,"views":2705,"release_date":"1104969600000","season_number":1,"description":"10-year-old Negi Springfield is a wizard-in-training, and needs only to pass one more test in order to become a Master Wizard. Unfortunately, his final task is a bizarre one—to become a English teacher at an all-females boarding school. As soon as he arrives, he completely embarrasses one of his students, Asuna Kagurazaka, and replaces the teacher she loves, which garners her hatred. To make matters worse, Asuna learns that Negi is a wizard, and promises to tell unless he helps her out. But unfortunately, circumstances force them to work together to do many things, from fighting evil wizards to helping the class pass their final exam, with a lot of humor, magic, and romances thrown in.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"current_season_id":3889,"content_control":"NORMAL"}}