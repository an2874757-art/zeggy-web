tching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7610,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":7610,"type":"MOVIE","title":"Cop Land","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/0b241b9d-d79f-4367-b967-a2d30fcf9095.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/9b927594-ef3a-4885-8cd7-a3a53a882528.jpg","likes":103,"dislikes":2,"views":9274,"release_date":"871603200000","length":6291,"description":"Sometime in the 1970's, police officers from New York City wanted a safe haven to live, away from the dangers of the streets of New York City, this is when they established a \"Cop Land\" in the small New Jersey town of Garrison. Freddy Heflin who was always admired by the New York cops wanted to become one, but because he was deaf in one ear this prevents him from achieving his goal, but has become sheriff of Garrison. Recently there have been a dark omen surrounding the NYPD, and Freddy is now investigating on this case, then Internal Affairs officer Mo Tilden is also on the case and asks Freddy for help, but Freddy could not. Now Freddy suspects that a New York City cop named Ray Donlan might be one of the many cops who is corrupted by the mob and other criminals. Now, Freddy must find a cop who is nicknamed \"Superboy\" who can testify against Donlan and protect him, before Donlan finds Superboy and kills him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"R"},"episode_id":7610,"content_control":"FAMILY"}}