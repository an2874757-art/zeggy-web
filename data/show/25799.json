:0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"," Action"],"id":25799,"type":"SERIES","title":"Spy x Family","logo":"https://cdn8.albox.co/storage/CLOUD00/shows/07d9ce72-beb3-4727-931f-a7f6802d8416.png","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/1462338b-f36f-42f7-b985-26703def4e85.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/7e7c23fe-05f7-4659-9867-b296c85745f8.jpg","likes":6845,"dislikes":113,"views":975789,"release_date":"1649462400000","season_number":1,"description":"بالنسبة للوكيل المعروف باسم \"توايلايت\" ، لا يوجد أمر طويل جدًا إذا كان من أجل السلام. يعمل توايلايت كجاسوس ويستاليس الرئيسي ، ويعمل بلا كلل لمنع المتطرفين من إشعال حرب مع الدولة المجاورة أوستانيا. في مهمته الأخيرة ، يجب عليه التحقيق مع السياسي الأوستاني دونوفان ديزموند من خلال التسلل إلى مدرسة ابنه: أكاديمية إيدن المرموقة. وبالتالي ، يواجه الوكيل أصعب مهمة في حياته المهنية: الزواج وإنجاب طفل ولعب الأسرة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":9}],"value":9,"age":"PG-13"},"background_color":"#f9b94b","current_season_id":13777,"content_control":"FAMILY"}}