gth":0,"continue_watching_progress":0},{"items":[],"id":19200,"title":"Seishun Buta Yarō","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/bc4d3f0c-5001-4c17-adfc-fd6c7eb2ab0d.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":21029,"title":"Dragon Ball Z Movies","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/c1ae0752-8909-49db-8a2a-8ae25b68288c.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":39483,"title":"Uruwashi no Yoi no Tsuki","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/ea151de5-60eb-4951-8e3c-0415ba73509c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18316,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Mystery","Shounen","Supernatural"],"id":18316,"type":"SERIES","title":"Cuticle Detective Inaba","logo":"","image":"https://cdn6.albox.co/storage/disk45/seasons/06217b02-3b3e-4b72-bf38-007e4f989401.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/1af03d63-d401-4a9c-9896-7964e46ba923.jpg","likes":35,"dislikes":0,"views":2633,"release_date":"1357257600000","season_number":1,"description":"In a world where half-human, half-animal chimeras live and work alongside normal people, there are sure to be a few bad apples in the bunch. Unfortunately, half-human criminals means non-human clues that often leave the police stumped. That's where lone wolf detectives like Hiroshi Inaba come in. He's literally part wolf and has the amazing ability to extract critical information just by examining or tasting a sample of someone's hair! Of course, that ability has also resulted in Inaba having a little bit of a hair fetish, but that doesn't seem to be a problem for his two assistants. (Well, at least the cross-dressing one isn't complaining much.) And it's nothing compared to the strange tastes of Inaba's nemesis, the omnivorous (and half goat) crime boss Don Valentino, who has an appetite for green legal tender instead of tender young greens! Inaba's sworn to cut Valentino out of the criminal flock before the Don can wolf down more ill-gotten dough, but he's going to have to chew his way through a lot of evidence to get his goat. Can sheer dogged detective work put the baaaaad guys behind bars?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"current_season_id":6578,"content_control":"NORMAL"}}