":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":18462,"type":"SERIES","title":"She Was Pretty","logo":"","image":"https://cdn6.albox.co/storage/disk46/seasons/241db188-43aa-4920-b1d9-574ec134d858.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/25fa4b49-750d-4886-87ad-7bda5f934acb.jpg","likes":273,"dislikes":1,"views":24603,"release_date":"1442361600000","season_number":1,"description":"As a young girl, Hye Jin was impossibly cute and had a comfortable life with her wealthy parents but since her teens, her looks and fortune changed abruptly and now she is living with her friend rent-free and working as a part-time clerk at a convenience store. One day, her childhood first love, Sung Joon, contacts her wishing to meet her, but recognizing Sung Joon has grown into a handsome and fit man, she quickly hatches a plan to have her pretty friend meet him in her place instead. After luckily landing a full-time job, Hye Jin is surprised to find Sung Joon as her boss, who is adding insult to injury, treating her with disdain and contempt.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"current_season_id":6760,"content_control":"NORMAL"}}