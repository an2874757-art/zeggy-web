le":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":9035,"type":"MOVIE","title":"Pay It Forward","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/1fb31cf1-d948-4b7b-b075-54ee014334aa.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/3bc4fb94-8992-4df3-b13e-859edbc78360.jpg","likes":56,"dislikes":2,"views":4015,"release_date":"972000000000","length":7401,"description":"Young Trevor McKinney, troubled by his mother's alcoholism and fears of his abusive but absent father, is caught up by an intriguing assignment from his new social studies teacher, Mr. Simonet. The assignment: think of something to change the world and put it into action. Trevor conjures the notion of paying a favor not back, but forward--repaying good deeds not with payback, but with new good deeds done to three new people. Trevor's efforts to make good on his idea bring a revolution not only in the lives of himself, his mother and his physically and emotionally scarred teacher, but in those of an ever-widening circle of people completely unknown to him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"episode_id":9035,"content_control":"FAMILY"}}