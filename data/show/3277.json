lated","section_type":"normalPoster"},{"data":[{"items":[],"id":3277,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":3277,"type":"MOVIE","title":"The Man Without a Face","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/9c80f0b2-17c9-49b3-bc54-45b093623bff.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/264cd3f5-7a58-4b18-9557-d6340a7847f3.jpg","likes":12,"dislikes":1,"views":2772,"release_date":"746236800000","length":6883,"description":"The story of a relationship between a teacher and his troubled pupil. Justin McLeod is a former teacher who lives as a recluse on the edge of town. His face is disfigured from an automobile accident and fire ten years before in which a boy was incinerated and for which he was convicted of involuntary manslaughter. He is also suspected of being a pedophile. He is befriended by Chuck, igniting the town's suspicion and hostility. McLeod instills in his protégé a love of justice and freedom from prejudice which sustains Chuck beyond the end of the film.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"episode_id":3277,"content_control":"FAMILY"}}