د المعلم أبو سريع، يقوم المعلم الضبع بتحذير المعلم أبو سريع باتفاق تفاحة معه فيحرضه على قتلها، يتم القبض على فكيهة صاحبة المقهى الذى يتناول فيه أهل الحى المخدرات، ينتحر أبو سريع وتقوم تفاحة بقتل الضبع ويتم القبض عليها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"N/A"},"episode_id":7786,"content_control":"NORMAL"}}