torage/disk41/shows/46d2849d-a49d-4c04-ad4a-bd94608f67b6.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3808,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","War"],"id":3808,"type":"MOVIE","title":"Force 10 from Navarone","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/6e5a1fb1-d0d8-4706-a5b1-4e3ea7a5604b.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/b53ed488-3752-47de-bebe-e01db1aa2f48.jpg","likes":16,"dislikes":1,"views":4563,"release_date":"281923200000","length":7115,"description":"Mallory and Miller are back. It seems that there was traitor with them at Navarone, whom they thought was executed. But it seems that not only was he not executed, and he was not a traitor but a German spy. Intelligence believes he made it to Yugoslavia and is now with the Partisans. So, Mallory and Miller being the only ones who can positively identify him are sent along with a unit called Force 10, which is led by Colonel Barnsby, who objects to their presence. It seems that Force 10 has a mission of their own which Mallory and Miller know nothing about. When their plane is shot and most of the team is killed, they mistakenly believe that some of the locals they meet are Partisans but in reality are German Allies, so they are taken prisoner, and have to convince the German commander that they are not spies or else they will be killed.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"PG"},"episode_id":3808,"content_control":"FAMILY"}}