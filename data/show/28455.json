":17814,"title":"ماذا اسمي هذه العلاقة","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/a7bbf414-8e82-4990-acc9-1684fb387f4e.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16452,"title":"هوس مايا","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk42/shows/65b31c97-a069-4ce3-bae6-40942b0f6de4.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19243,"title":"حبيبي دائما (مدبلج)","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/4ef6a78f-3d07-4af8-af2c-df214fb5d979.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36800,"title":"بارينيتي مدبلج","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/17919c3e-0006-44fd-a0a3-5073cb48dd6a.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":39375,"title":"لدي عشق مدبلج","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/4d843e0c-55a5-4ae9-9c60-121eaab47265.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":17844,"title":"فير فايلز","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/378e90e4-5944-407d-a1e8-eab76c1cf123.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16560,"title":"قدري انت","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/a3557c4f-33d4-47c8-8582-35adf0fc2ce3.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":25554,"title":" علاء الدين","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/5c183b3a-7cd2-4a84-882b-ec165a72ce50.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":28455,"title":"","description":"51","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Drama"],"id":28455,"type":"SERIES","title":"حياتي بدونك","logo":"","image":"https://cloud01.albox.co/seasons/07cb1bfc-e957-4267-8974-829148e6ddbf.jpg","background_image":"https://cloud01.albox.co/seasons/8383cdfd-8238-4d5c-aae8-62406d39bcae.jpg","likes":601,"dislikes":14,"views":106451,"release_date":"1672185600000","season_number":1,"description":"ميراب فتاة طموحة وجميلة ترغب في متابعة دراستها العليا. يدور عالمها كله حول والديها وهي تؤمن بهما أكثر. شخصيتها القوية والواثقة تجعلها تقف ضد الظلم الاجتماعي من حولها. على العكس من ذلك ، ينحدر مرتسم من عائلة قوية وذات نفوذ. يحترم ويقدر أخلاق عائلته وتقاليدها ويرفض خذلان الأسرة. تأخذ حياة ميراب منعطفًا غير متوقع عندما تكتشف قرار عائلتها بشأن حياتها وحياة مرتسم. تستمر كراهية ميراب تجاه مرتسم في النمو باعتبارها سرًا عائليًا من الماضي. يأتي مرتسم من خلفيات وعقليات مختلفة ، ويبدأ في إدراك سلوك ميراب المتغطرس تجاهه ويبدأ في اعتبارها تحديًا لنفسه. من ناحية أخرى ، ميراب التي اعتادت أن تعيش حياتها بشروطها الخاصة ترفض قبول تقاليد عائلة مرتسم والحواجز الاجتماعية غير الضرورية. سرعان ما تمر حياتهم بسلسلة من المعاناة العاطفية وسوء الفهم حيث يصعب عليهم التعايش. على الرغم من كراهيتهما تجاه بعضهما البعض ، هل سيقبل ميراب ومرتسم مشاعرهما الحقيقية أم أن ديناميكيات الأنا واحترام الذات ستجبرهما على الابتعاد عن بعضهما البعض؟\r\n\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"","current_season_id":15843,"content_control":"NORMAL"}}