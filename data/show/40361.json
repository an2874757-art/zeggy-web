omments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Animation","Family","Science Fiction","Children"],"id":40361,"type":"SERIES","title":"Thunderbirds Are Go! مدبلج","logo":"https://cloud02.albox.co/shows/6e19712a-6561-4841-8bdf-34150e3758ba.png","image":"https://cloud02.albox.co/seasons/b69d9b6a-161a-4c6b-9a97-e02971bf8c84.jpg","background_image":"https://cloud02.albox.co/seasons/063b6303-5570-4ce5-b74d-799ce6de15e9.jpg","likes":15,"dislikes":0,"views":687,"release_date":"1428105600000","season_number":1,"description":"في القرن الحادي والعشرين، أنشأ جيف تريسي فريق استجابة طارئ فريد: الإنقاذ الدولي. مجهزة بمركبات خاصة تمكن المنظمة من الاستجابة لأي أزمة، سواء كانت في أي مكان على الأرض أو في الفضاء. أبناء جيف الخمسة يديرون طائرات Thunderbirds من 1 إلى 5 بمساعدة المهندس برينز وكايو، طيار Thunderbird Shadow. الليدي بينيلوب والسائق باركر هما فريق الاستخبارات العملي على الأرض. معا ينقذان أي شخص محتاج، بينما يحاولان العثور على الإرهابي المعروف باسم هود والقبض عليه.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"TV-G"},"background_color":"","current_season_id":23541,"content_control":"NORMAL"}}