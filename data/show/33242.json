le":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/bca64378-13c2-4062-9eb0-7aab2b3b0bb4.jpeg"},"length":0,"continue_watching_progress":0},{"items":[],"id":22232,"title":"للموت","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/80c16db8-6682-4cdd-b4bf-b8bc24724df2.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":22235,"title":"أمينة حاف","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/4d6ee5aa-1d97-44f1-bc30-35e54b9df4ef.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":33242,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":33242,"type":"SERIES","title":"خلف القضبان","logo":"","image":"https://cloud02.albox.co/seasons/aaea7f8c-98fb-4989-8a01-bb43dfafd477.jpg","background_image":"https://cloud02.albox.co/seasons/474beb14-df81-4b06-a331-1786fb32fcca.jpg","likes":9,"dislikes":0,"views":2183,"release_date":"1128384000000","season_number":1,"description":"تدور أحداث المسلسل في إطار اجتماعي، حول أشخاص من طبقات اجتماعية مختلفة، وعن الصراع الإنساني والتأرجح بين القيمة والمادة، حيث ناجي السعيد (بسام كوسا) رجل الأعمال الذي يملك مفاتيح كل الأمور، ويحل أعقد المشكلات بكلمة، قد وصل إلى ذلك عبر القفز على أنقاض الآخرين،‏ وهناك أيضا نادر زهدي (باسم ياخور) الذي ذهب بقدميه إلى (ناجي السعيد) تحكمه الحاجة المادية، واثقا أنه يمتلك مفاتيح العودة، وعندما تتشابك الخيوط ويريد العودة يجد نفسه في السجن، ودانة (صبا مبارك) مساعدة (ناجي السعيد) التي وقعت في غرام (نادر زهدي) وظنت أنها تملك إنسانيتها ومشاعرها فاكتشفت العكس، وأنها أينما ذهبت ستبقى أحد أملاك (ناجي السعيد)، حتى عندما لجأت لمن يفوقه قوة وقذارة دفعت الثمن حياتها، وهكذا تتشعب الشخصيات وتتنوع بمحتواها وأبعادها لتعكس زخما من المحاكاة الفكرية والسلوكية.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"background_color":"","current_season_id":18718,"content_control":"NORMAL"}}