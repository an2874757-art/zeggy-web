0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7211,"title":"","description":"24","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Romance"],"id":7211,"type":"MOVIE","title":"Belle","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/e49c4dc5-7ad5-4974-9e44-bd65b7fa8784.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/b014bdb1-deb6-4d2f-a62c-105f24baa4e6.jpg","likes":131,"dislikes":2,"views":11522,"release_date":"1402617600000","length":6230,"description":"BELLE is inspired by the true story of Dido Elizabeth Belle (Gugu Mbatha-Raw), the illegitimate mixed race daughter of a Royal Navy Captain. Raised by her aristocratic great-uncle Lord Mansfield (Tom Wilkinson) and his wife (Emily Watson), Belle's lineage affords her certain privileges, yet the color of her skin prevents her from fully participating in the traditions of her social standing. Left to wonder if she will ever find love, Belle falls for an idealistic young vicar's son bent on change who, with her help, shapes Lord Mansfield's role as Lord Chief Justice to end slavery in England.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":7211,"background_color":"","content_control":"NORMAL"}}