type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk54/shows/7149d16e-6de7-4deb-922a-b14028ad7339.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2832,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":2832,"type":"MOVIE","title":"Elena","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/3d3e21e4-1734-4298-87cc-2102f13030bc.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/3406a47d-3d30-47cf-89de-99f280c8d83d.jpg","likes":14,"dislikes":2,"views":4477,"release_date":"1317254400000","length":6551,"description":"Elena and Vladimir are an older couple, they come from different backgrounds. Vladimir is a wealthy and cold man, Elena comes from a modest milieu and is a docile wife. They have met late in life and each one has children from previous marriages. Elena's son is unemployed, unable to support his own family and he is constantly asking Elena for money. Vladimir's daughter is a careless young woman who has a distant relationship with her father. A heart attack puts Vladimir in hospital, where he realizes that his remaining time is limited. A brief but somehow tender reunion with his daughter leads him to make an important decision: she will be the only heiress of his wealth. Back home he announces it to Elena. Her hopes to financially help her son suddenly vanish. The shy and submissive housewife then comes up with a plan to give her son and grandchildren a real chance in life.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"episode_id":2832,"content_control":"NORMAL"}}