cloud01.albox.co/seasons/b3fc64f4-fd2c-416a-a511-e764f1d3989d.jpg","background_image":"https://cloud01.albox.co/seasons/6debde63-1d8f-41bb-8fa9-52f5c1bee6c4.jpg","likes":81,"dislikes":4,"views":6999,"release_date":"1695081600000","season_number":1,"description":"يتمتع لين لو شياو بمهارات استثنائية في مكافحة الحرائق وخبرة واسعة. وهو رئيس محطة العمليات الخاصة على طريق Heping في مدينة Beixun. وبمحض الصدفة، تم اختياره ليصبح مدربًا لبرنامج واقعي يهدف إلى تعزيز المعرفة في مجال مكافحة الحرائق. خلال العرض، واجه لين لو شياو بالصدفة نان تشو، راقصة أنقذها من حريق منذ سنوات. يطور نان تشو ولعًا بـ Lin Lu Xiao، لكنه يحافظ على مسافة بسبب المخاطر الكامنة في مهنته.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"background_color":"","current_season_id":17404,"content_control":"NORMAL"}}