":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Horror","Supernatural"],"id":29872,"type":"SERIES","title":"Dark Gathering","logo":"","image":"https://cloud01.albox.co/seasons/47a95d02-79bb-4304-982d-59869e98f927.jpg","background_image":"https://cloud01.albox.co/seasons/115eca07-0346-4b59-991b-deda947a7fe5.jpg","likes":154,"dislikes":5,"views":13675,"release_date":"1688947200000","season_number":1,"description":"Keitarou Gentouga هو طالب جامعي يكره الأشباح. لسوء حظه ، لديه موهبة في جذب الأرواح. قبل عامين ، أدى هذا الارتباط إلى تعرضه لإصابة روحية في يده اليمنى ، حيث وقع صديقه في مرمى النيران. تسبب له الحدث في أن يصبح منغلقًا ، مما تركه بمهارات اجتماعية سيئة للغاية. لحسن الحظ ، بدأ كيتارو ببطء في الاختلاط بالمجتمع ، بفضل مساعدة صديق طفولته إيكو هوزوكي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"R"},"background_color":"","current_season_id":16971,"content_control":"NORMAL"}}