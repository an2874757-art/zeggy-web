ments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Family"],"id":18611,"type":"SERIES","title":"Malcolm in the Middle","logo":"","image":"https://cdn6.albox.co/storage/disk53/seasons/e77c8fc2-5f9b-46db-9842-a02203729b7f.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/c890e062-4339-451c-b16f-d51ff6bc2c09.jpg","likes":540,"dislikes":5,"views":139338,"release_date":"947376000000","season_number":1,"description":"An offbeat, laugh track-lacking sitcom about a bizarrely dysfunctional family, the center of which is Malcolm, the middle of the two brothers who still live at home. His eldest (and favorite) sibling, Francis, boards at military school because his parents believe it will reform him and keep him out of trouble. Malcolm often has a hard time coping with his family life, but he has more troubles to contend with when he starts receiving special treatment at school after being diagnosed as an intellectually advanced genius.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"pg-13"},"current_season_id":6946,"content_control":"NORMAL"}}