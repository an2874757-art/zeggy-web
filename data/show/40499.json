او يو سي المستشفى وبدأت تخطط بدقة لانتقامها، متعهدة بكشف حقيقة باي جينغ جينغ وفضح أفعالها الشريرة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"NC-17"},"background_color":"","current_season_id":23613,"content_control":"FAMILY"}}