iption":"65","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Sport"],"id":14917,"type":"SERIES","title":"One Tree Hill","logo":"","image":"https://cdn6.albox.co/storage/disk54/seasons/99e4a19b-e9aa-4e0d-8f1b-51fb1b63bc28.jpg","background_image":"https://cdn6.albox.co/storage/disk45/seasons/5754a6f7-a373-4629-b441-bc261f2d0586.jpg","likes":421,"dislikes":23,"views":106728,"release_date":"1064275200000","season_number":1,"description":"تتبع هذه السلسلة الحياة المليئة بالأحداث لبعض أطفال المدارس الثانوية في تري هيل ، وهي بلدة صغيرة ولكنها ليست هادئة جدًا في ولاية كارولينا الشمالية ، حيث يكون أكبر مصدر للفخر هو فريق كرة السلة في المدرسة الثانوية ، رافينز ، منذ الذاكرة الحية التي دربها العجوز ويتي دورهام. كانت أعظم موهبتها على الإطلاق هي دان سكوت ، الذي يدير الآن وكالة سيارات ناجحة. المواهب الحالية هي ولديه ، ناثان سكوت ، رياضي جميل وشعبي ، النجم المطلق ، الذي تم تشكيله وخنقه من قبل والده الفخور ، الطموح دان سكوت ، الذي دفعه بقوة أكبر حتى قبل أن يوافق عليه المدرب ، ولكن تم إهماله من قبل والدته المدللة والمندفعة ديب ، وهو مدمن على الكحول ، ولوكاس ، حيث تم التخلي عنه عند ولادته مع والدته المخلصه ، كارو الذي يعمل بجد مع والدته المخلص ، كارو الذي يعمل بجد. رفض اجتماعي ، يلعب فقط الأطواق في ساحة عامة في الحديقة مع أطفال الشوارع ، وشغفه هو القراءة ؛ عندما تجبر إحدى الحوادث المدرب على استبدال اللاعبين الموقوفين ، سرعان ما يثبت لوكاس هذا الوحي ، وبعد فترة يتم قبوله ويطور ديناميكية ، على المدى الطويل علاقة جيدة مع شقيقه ، الذي ينقلب على والده. بالطبع ، الأولاد المراهقون لديهم أصدقاء ، وخاصة سلسلة محيرة من علاقات الحب `` الأبدي '' القصيرة المحبوبة عادةً مع المواهب الموسيقية بيتون وهالي ، وهو أيضًا مدرس ، ورجل لا يقاوم بروك ","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"PG-13"},"background_color":"#000","current_season_id":2004,"content_control":"NORMAL"}}