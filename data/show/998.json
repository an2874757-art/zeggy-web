tle":"","description":"21","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Romance","Animation","Family"],"id":998,"type":"MOVIE","title":"طرزان","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/469dec3b-84b7-4f25-b984-412415e0c235.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/d8d07988-4d83-4a8e-8d5f-cf266ad86efc.jpg","likes":605,"dislikes":15,"views":59988,"release_date":"929664000000","length":5312,"description":"تدور القصة حول طرزان، الشاب الذي نشأ في وسط عائلة من الغوريلات، والذي أُُطلق عليه لقب (الرجل القرد)، بدأت القصة عندما جنحت مركب والدي الرضيع طرزان وغرقت، وتمكن والده ووالدته من النجاة بعد توجههما إلى سواحل القارة الإفريقية لبدء حياة جديدة، وسط بقية مخلوقات الغابة، ومنها الغوريلات التي تتخذ الغابة كمأوى لها. ليموت الوالدان على يد الفهد سابور وتأخذه الغوريلات وتربيه لينشأ في وسطهم، ويصبح بطلهم بعد قتله للفهد سابور.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"G"},"episode_id":998,"background_color":"","content_control":"NORMAL"}}