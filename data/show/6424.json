],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6424,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Comedy","Animation","Family"],"id":6424,"type":"MOVIE","title":"ParaNorman","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/77d9f21e-43f8-407c-9f2d-1d2edc1d515f.jpeg","background_image":"https://cdn6.albox.co/storage/disk44/shows/a11d5b8a-0804-47d9-88d4-f1ce90653757.jpeg","likes":114,"dislikes":3,"views":6061,"release_date":"1345161600000","length":5535,"description":"In the town of Blithe Hollow, Norman Babcock is a boy who can speak to the dead, but no one besides his eccentric new friend, Neil, believes his ability is real. One day, Norman's estranged eccentric uncle tells him of an important annual ritual he must take up to protect the town from a curse cast by a witch it condemned centuries ago. Eventually, Norman decides to cooperate, but things don't go according to plan. Now, a magic storm of the witch threatens Blithe Hollow as the accursed dead rise. Together with unexpected new companions, Norman struggles to save his town, only to discover the horrific truth of the curse. With that insight, Norman must resolve the crisis for good as only he can.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG"},"episode_id":6424,"content_control":"FAMILY"}}