comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":5787,"type":"MOVIE","title":"Late Spring","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/d3659d17-a041-4aba-baa1-b278d6c6e06e.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/74bce84f-f67f-4707-a9eb-9872f2e81ca0.png","likes":13,"dislikes":0,"views":1119,"release_date":"80524800000","length":6603,"description":"Noriko is 27 years old and is still living with her father Somiya, a widower. Noriko just recovered from an illness she developed in the war, and now the important question pops up: when will Noriko start thinking about marriage? Everybody who is important in her life tries to talk her into it: her father, her aunt, a girlfriend. But Noriko doesn't want to get married, she seems extremely happy with her life. She wants to stay with her father to take care of him. After all, she knows best of his manners and peculiarities. But Noriko's aunt doesn't want to give up. She arranges a partner for her and thinks of a plan that will convince Noriko her father can be left alone.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"episode_id":5787,"content_control":"FAMILY"}}