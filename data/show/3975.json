":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3975,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Romance","Comedy","Family"],"id":3975,"type":"MOVIE","title":"The Three Musketeers","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/52391b56-3c33-42db-b3c7-b1bc1fb45bed.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/070be37a-9d46-422a-9076-f5044d967701.jpg","likes":24,"dislikes":0,"views":3657,"release_date":"753062400000","length":6348,"description":"The three best of the disbanded Musketeers - Athos, Porthos, and Aramis - join a young hotheaded would-be-Musketeer, D'Artagnan, to stop the Cardinal Richelieu's evil plot: to form an alliance with enemy England by way of the mysterious Milady. Rochefort, the Cardinal's right-hand man, announces the official disbanding of the King's Musketeers. Three, however, refuse to throw down their swords - Athos the fighter and drinker, Porthos the pirate and lover, and Aramis the priest and poet. Arriving in Paris to join the Musketeers, D'Artagnan uncovers the Cardinal's plans, and the four set out on a mission to protect King and Country.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"PG"},"episode_id":3975,"content_control":"NORMAL"}}