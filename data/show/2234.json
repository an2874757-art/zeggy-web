ster"},{"data":[{"items":[],"id":2234,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","War"],"id":2234,"type":"MOVIE","title":"Pork Chop Hill","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/f628aac0-ce77-411a-8608-d4c7997d0eea.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/969e8b0d-d425-492a-bac9-cbc320afbc75.jpg","likes":8,"dislikes":0,"views":5317,"release_date":"-332985600000","length":5876,"description":"Grim story of one of the major battles of the Korean War. While negotiators are at work in Panmunjom trying to bring the conflict to a negotiated end, Lt. Joe Clemons is ordered to launch an attack and retake Pork Cop Hill. It's tough on the soldiers who know that the negotiations are under way and no one wants to die when they think it will all soon be over. The hill is of no particular strategic military value but all part of showing resolve during the negotiations. Under the impression that the battle has been won, battalion headquarters orders some of the men withdrawn when in fact they are in dire need of reinforcements and supplies. As the Chinese prepare to counterattack and broadcast propaganda over loudspeakers, the men prepare for what may be their last battle.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"PG-13"},"episode_id":2234,"content_control":"NORMAL"}}