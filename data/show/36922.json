,"description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk57/shows/a56c1727-f68b-4592-866e-c25c806d7c32.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":27368,"title":"Yali Çapkini - طائر الرفراف","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/c68e1fed-73fc-419e-8402-42f4ef374312.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":40411,"title":"اخي مدبلج","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/7baf4438-f020-462d-a9b5-1989c8f90e0b.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":20634,"title":"انت وطني","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/fe1d7cd5-b37d-474d-a5d5-7a37a7152ef6.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":34867,"title":"Distant City - المدينة البعيدة","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/9b85f8a4-19b0-400a-bd9c-099719868193.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36922,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":36922,"type":"SERIES","title":"زوجة الأب مدبلج","logo":"","image":"https://cloud02.albox.co/seasons/d7bdc885-9873-4a3a-a23a-1830c6e6ce18.jpg","background_image":"https://cloud02.albox.co/seasons/37ac2a61-e6d6-44ee-a011-fa7e789d090d.jpg","likes":74,"dislikes":2,"views":10660,"release_date":"1687132800000","season_number":1,"description":"يتعافى فاروق من فقدان زوجته ، ويجد العزاء في مساعدته سيراب ، غير مدرك لنواياها الحقيقية. في الواقع ، قبلت سيراب المهمة في البداية لأن رئيسها فاروق كان بحاجة إلى شخص مدرب على رعاية الأطفال في المنزل. بعد كل شيء ، كانت تعرف بنات فاروق جينسر نيسان وناز وابنه عمر جيدا وكانت محبوبة من قبلهن. ولكن عندما استقرت سيراب ، التي ولدت في المباني الملحقة لمنزل والدة إفسون بيراي بيزاده في موغلا ، في قصر فاروق ، سألت نفسها \"لماذا؟\". \"لماذا لا أستطيع الحصول على كل شيء؟\" بعد كل شيء ، بدأت حياتها بصفر عجز. لكن الآن فاروق جينسر ، الذي كانت تعرفه جيدا ، كان فرصة عظيمة لها لسد هذه الفجوة! نعم ، لم يحلم سيراب أبدا بالزواج من رجل لديه ثلاثة أطفال. لكن هذه كانت قضية لاحقة. الآن كان عليها أن تدخل ليس فقط المنزل ولكن أيضا قلب هذا الرجل الذي كان مخلصا جدا لأطفاله ، وكان عليها أن تشمر عن سواعدها في أسرع وقت ممكن لتصبح سيراب جينسر!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4}],"value":4,"age":"TV-PG"},"background_color":"","current_season_id":21332,"content_control":"NORMAL"}}