omments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy"],"id":8361,"type":"MOVIE","title":"Season of the Witch","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk56/shows/4cfc4788-7c60-4287-a4d5-d9e6e93f5eca.jpg","likes":69,"dislikes":1,"views":13266,"release_date":"1294358400000","length":5695,"description":"A 14th century Crusader returns to a homeland devastated by the Black Plague. A beleaguered church, deeming sorcery the culprit of the plague, commands the two knights to transport an accused witch to a remote abbey, where monks will perform a ritual in hopes of ending the pestilence. A priest, a grieving knight, a disgraced itinerant and a headstrong youth who can only dream of becoming a knight join a mission troubled by mythically hostile wilderness and fierce contention over the fate of the girl. When the embattled party arrives at the abbey, a horrific discovery jeopardises the knight's pledge to ensure the girl fair treatment, and pits them against an inexplicably powerful and destructive force.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.4}],"value":5.4,"age":"PG-13"},"episode_id":8361,"content_control":"FAMILY"}}