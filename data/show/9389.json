ction_type":"normalPoster"},{"data":[{"items":[],"id":9389,"title":"","description":"51","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":9389,"type":"MOVIE","title":"Notting Hill","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/7a3b9209-f491-42f6-b306-558282b32371.jpeg","background_image":"https://cdn6.albox.co/storage/disk53/shows/fd97b717-3fdd-4655-9cd2-5b40bec8b302.jpeg","likes":306,"dislikes":13,"views":20579,"release_date":"927849600000","length":7437,"description":"Every man's dream comes true for William Thacker, an unsuccessful Notting Hill bookstore owner, when Anna Scott, the world's most beautiful woman and best-liked actress, enters his shop. A little later, he still can't believe it himself, William runs into her again - this time spilling orange juice over her. Anna accepts his offer to change in his nearby apartment, and thanks him with a kiss, which seems to surprise her even more than him. Eventually, Anna and William get to know each other better over the months, but being together with the world's most wanted woman is not easy - neither around your closest friends, nor in front of the all-devouring press.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"PG-13"},"episode_id":9389,"content_control":"NORMAL"}}