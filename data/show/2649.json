,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2649,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":2649,"type":"MOVIE","title":"The Sisterhood of the Traveling Pants 2","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/25a26926-451a-4919-b12e-06525ad6a9a0.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/c4927079-1b95-4485-a783-0efb7c50e9f3.jpg","likes":63,"dislikes":1,"views":7467,"release_date":"1217980800000","length":7174,"description":"Carmen Lowell is working on the backstage of a play at Yale. When the lead actress, her friend Julia, invites her to Vermont with her to work on a play with a professional cast, she decides to stay with her friends and her pregnant mother. However, she changes her mind after she finds that her friends will all leave for the summer: Lena Kaligaris will travel to a drawing course, Bridget Vreeland, who is in an existential crisis, missing her mother, will travel to an archaeological dig in Turkey, and Tibby Tomko-Rollins is working in a rental and still editing her documentary. Carmen grows a crush on the lead actor Ian, who convinces her to participate in an audition, and she is then invited by the director Bill Kerr to perform the lead female role. Later she finds the truth about the friendship of Julia. The broken-hearted Lena finds that Kostas has just married, and she dates the model of her drawing class. Bridget finds letters addressed to her from her grandmother that her father has hidden, and decides to visit her, discovering information about her mother. Tibby makes love with her boyfriend Brian McBrian and gets scared of a possible pregnancy. In the end, the girlfriends discover that their friendship is real and amounts to more than just a pair of jeans.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"PG-13"},"episode_id":2649,"content_control":"FAMILY"}}