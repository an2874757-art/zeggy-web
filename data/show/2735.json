length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2735,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Thriller"],"id":2735,"type":"MOVIE","title":"The Human Stain","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/e3f6c7cd-72c1-42e9-9558-8dce6f2d9ceb.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/d6a2e8bb-18f7-4385-99dd-1df2a1aa3a5a.jpg","likes":63,"dislikes":5,"views":17385,"release_date":"1067385600000","length":6466,"description":"The Human Stain is the story of Coleman Silk (Hopkins), a classics professor with a terrible secret that is about to shatter his life in a small New England town. When his affair with a young troubled janitor (Kidman) is uncovered, the secret Silk had harbored for over fifty years from his wife, his children and colleague, writer Nathan Zuckerman, fast explodes in a conflagration of devastating consequences. It is Zuckerman who stumbles upon Silk's secret and sets out to reconstruct the unknown biography of this eminent, upright man, esteemed as an educator for nearly all his life, and to understand how this ingeniously contrived life came unraveled.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"R"},"episode_id":2735,"content_control":"FAMILY"}}