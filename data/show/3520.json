box.co/storage/disk48/shows/4082a390-0541-42e3-8392-cdc1375babc1.png"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3520,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Horror"],"id":3520,"type":"MOVIE","title":"Christine","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/7f149e1b-8693-4bb3-8be3-7371753be497.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/0f5cb725-7e1b-4487-9f64-5e6c4b62314a.jpg","likes":28,"dislikes":1,"views":3101,"release_date":"439776000000","length":6600,"description":"In 1957, in Detroit, a red Plymouth Fury is built and is the cause of two accidents, one of them fatal, still in the assembly line. Twenty-one years later, the outcast and bullied nerd Arnold \"Arnie\" Cunningham is getting a ride with his best and only friend Dennis Guilder and he sees the wrecked car for sale in a garden. Arnie immediately falls in love with the car. The car was given the name Christine by it's first owner. He brings the car to a repair shop of the despicable Will Darnell and works hard to restore the classic car. While he works in the restoration, he changes his personality to a cocky teenager and he dates the most beautiful girl in the high-school, Leigh Cabot. Soon Arnie becomes selfish and jealous of the supernatural Christine that kills everyone that is a threat to them.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":3520,"content_control":"NORMAL"}}