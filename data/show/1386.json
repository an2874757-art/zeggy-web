omments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Crime","Mystery"],"id":1386,"type":"MOVIE","title":"Echelon Conspiracy","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/7c8c5c5d-0553-4fc0-a015-b96b086a2534.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/b3e12fc2-29a4-4477-b36a-00c87567562b.jpg","likes":29,"dislikes":1,"views":4454,"release_date":"1235692800000","length":6317,"description":"Max Peterson is a globe-trotting techno-whiz who installs security systems on computers. He receives an anonymous gift: a phone which sends messages that enable him to win at a casino. Max soon finds himself pursed by hit men, the casino's security chief, and a CIA operative. Who's sending Max messages? Previous recipients of similar windfalls have ended up dead. After a couple of close scrapes, Max realizes he's in danger, so he tries to find out the root of the conspiracy - which seems to have access to every security camera in the world - before he's the next victim. Why is this happening to him, and who can he trust?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"PG-13"},"episode_id":1386,"content_control":"NORMAL"}}