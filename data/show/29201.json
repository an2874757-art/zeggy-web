,"length":0,"continue_watching_progress":0},{"items":[],"id":37403,"title":"WWE: Unreal","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/9d2feed8-5353-4006-b8ae-d47a204a6079.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36592,"title":"Genghis Khan: The Secret History of the Mongols","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/4c237cc0-2eec-4e32-a97b-12eab1f086c5.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":31141,"title":"الدحيح فلسطين حكاية الارض","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/979b4ea6-5fd3-4553-af4d-4fe6f836b29a.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":29201,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Documentary "],"id":29201,"type":"SERIES","title":"ارض السواد","logo":"","image":"https://cloud01.albox.co/seasons/4666b9c8-c38b-45d6-b6c0-bc15bb1b80eb.jpeg","background_image":"https://cloud01.albox.co/seasons/526e688f-0894-4bb8-a9cc-657b3bb6e0b5.jpeg","likes":66,"dislikes":16,"views":8812,"release_date":"0","season_number":1,"description":"برنامج ارض السواد هو مجموعة حلقات يقدمها الأستاذ فائق الشيخ علي، النائب السابق في البرلمان العراقي، يستعرض فيها الحقبة التاريخية التي مرت بها ارض السواد، وهو العراق، خلال القرنين السابقين من هذا التاريخ. ويعرض فيها احاديث ومعلومات مهمة وخطيرة من تاريخ ارض السواد.\r\n\r\nمن خلال حلقات ارض السواد، لن يكون هناك حديث عن تاريخ حضارة العراق القديمة، وانما سوف يقتصر الحديث عن القرن التاسع عشر والقرن العشرين، وربطهما بالوضع الحالي للعراق.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"","current_season_id":16473,"content_control":"NORMAL"}}