hows/2d903fb9-ea29-4e94-9034-1fe567c497ce.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14310,"title":"المؤسس عثمان","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/cad53745-2d89-495a-a8b2-3e0a7eb59b42.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":20466,"title":"وادي الذئاب","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk60/shows/6288d105-2fb9-49bc-aa84-f7b48a4b22aa.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":13801,"title":"الصيف الاخير","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/f1c2d558-a4fe-44a0-8387-f99328d57efa.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15077,"title":"بنات الشمس مدبلج","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/69433743-ee0e-4022-b8f6-5e4dd3a27f7d.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15645,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":15645,"type":"SERIES","title":" Bir Aşk Hikayesi - قصة عشق","logo":"","image":"https://cdn6.albox.co/storage/disk42/seasons/73425876-0928-4241-bd2c-3714ea87a15c.jpg","background_image":"https://cdn6.albox.co/storage/disk54/seasons/afa5a085-e757-493e-b481-30afb5213e3c.jpg","likes":54,"dislikes":3,"views":16048,"release_date":"1364256000000","season_number":1,"description":"His name is Korkut Ali - He is the only young man talking highly of his real biological family in front of the cameras on a TV Show of adopted young people in Germany. He lives on believing that his mother had to give him away until he gets shot in an assault and begins awaiting his death with a bullet in his brain. He goes back to his home country - First, he finds his sister who was abandoned like him - She is a young mother suffering from learning difficulty after an accident she had - Young man gets all the more disappointed when he finds her mother. Unlike his belief that she gave them away because of poverty, his mother is a famous actress and has a famous singer son. Anger and hatred replace the longing for his mother and the grief in his heart. He somehow manages to get into their life without telling them the truth. While on the one hand he is angry with his mother, on the other hand he is in need of her love. His ceaseless longing for his mother is coupled now with love pain. Ceylan whom he met and helped in abroad runs into him when he goes back to his home country. Ceylan's family is working at his mother's house. Moreover, she in in love with his step-brother Tolga. Although he is so much close to death, he falls madly in love with her. So much that he begins to pray \"God, if you let me live with her for the rest of my life, I will stop this anger and hatred to my mother, and end this vengeance\". Ceylan begins to love Korkut Ali however she cannot get Tolga out of her life. They become heroes of an epic love affair and the young girl begins suffering between the loves of two men having separate places in her heart.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-13"},"background_color":"","current_season_id":2994,"content_control":"NORMAL"}}