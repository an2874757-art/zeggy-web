ing_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9808,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Horror"],"id":9808,"type":"MOVIE","title":"Vamp U","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/cd4a1766-54d3-4fd2-9289-02bf0e5a0617.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/147ba618-e049-4e26-a232-00ce4a4653ff.jpg","likes":62,"dislikes":11,"views":18448,"release_date":"1361923200000","length":5769,"description":"Wayne Gretzky (no relation) is a vampire who can't grow his teeth. His impotence began when he inadvertently killed Mary Lipinsky, the love of his life, 300 years ago. To take his mind off the pain, he teaches college history - who better? Attempting to regain his full power, he enlists help from his friend and colleague, Dr. Levine (Gary Cole). Nothing works until a new semester brings freshman Chris Keller. She's a dead ringer for Mary and they have a lurid affair, while rumors fly around the campus. But it all sours when he turns Chris into a vampire and her newfound bloodlust spins out of control in a bloody rampage, making the rumors a little too real.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4}],"value":4,"age":"r"},"episode_id":9808,"content_control":"FAMILY"}}