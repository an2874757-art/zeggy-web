":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller"],"id":2364,"type":"MOVIE","title":"The Experiment","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/4aef03d8-5690-41e2-945b-f4b481a8a0a5.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/7f52e5c3-8847-4449-bf78-b7bd42c143e8.jpg","likes":17,"dislikes":2,"views":4528,"release_date":"984009600000","length":7127,"description":"The movie is based on the infamous \"Stanford Prison Experiment\" conducted in 1971. A makeshift prison is set up in a research lab, complete with cells, bars and surveillance cameras. For two weeks 20 male participants are hired to play prisoners and guards. The 'prisoners' are locked up and have to follow seemingly mild rules, and the 'guards' are told simply to retain order without using physical violence. Everybody is free to quit at any time, thereby forfeiting payment. In the beginning the mood between both groups is insecure and rather emphatic. But soon quarrels arise and the wardens employ ever more drastic sanctions to confirm their authority.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"episode_id":2364,"content_control":"NORMAL"}}