oster"},{"data":[{"items":[],"id":8709,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Comedy","Family"],"id":8709,"type":"MOVIE","title":"Doctor Dolittle","logo":"https://cloud01.albox.co/shows/6ca37ef0-6992-43bd-bf91-febd5147465f.png","image":"https://cdn6.albox.co/storage/disk59/shows/6191b3e9-21b4-4cbf-a6d9-ed85c609d208.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/8474ca29-0777-417a-a660-6f1b12542108.jpg","likes":416,"dislikes":3,"views":24654,"release_date":"898819200000","length":5122,"description":"Dr. John Dolittle has the world in his hands: A beautiful wife at his side, two adorable daughters and a career that could not go better. One night, he nearly runs over a dog with his car. The dog yells \"bonehead\" and disappears. From then on, his childhood ability is back: To communicate with animals. Unfortunately, the word of Dolittle's ability is spreading quickly. Soon, many animals from rat to horse flock to his place to get medical advice. But his colleagues suspect he's going mad, and as the clinic Dolittle used to work for is about to being taken over for a huge amount of money, many decisions have to be made. Believe him? Put him into a mental institution? Sell the clinic? But also his family is close to breaking apart. Until a circus tiger falls seriously ill.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.4}],"value":5.4,"age":"PG-13"},"episode_id":8709,"background_color":"#dc3444","content_control":"FAMILY"}}