ng_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Comedy","Animation","Family","Children"],"id":32793,"type":"SERIES","title":"Jackie Chan Adventures","logo":"https://cloud02.albox.co/shows/bbcf2f79-38f0-4cbd-a696-d26127797447.png","image":"https://cloud01.albox.co/seasons/f0e51812-cbdf-44a4-bcb3-3218d6f015c8.jpg","background_image":"https://cloud01.albox.co/seasons/b4e05376-9b9b-4859-a6ee-1ebd2958fda3.jpg","likes":203,"dislikes":2,"views":20787,"release_date":"968457600000","season_number":1,"description":"\"مغامرات جاكي تشان\" هو مسلسل الرسوم المتحركة المثير الجديد من البطل العالمي المشهور جاكي تشان. لم ترى جاكي بهذا الشكل من قبل! يثبت العالم الآثار جاكي تشان والدة أخته البالغة من العمر 11 عامًا جيد أن العمل الشاق موروث عندما تصل من هونغ كونغ لتعيش مع جاكي وعمه الحكيم في سان فرانسيسكو. وفي الوقت نفسه، يجد جاكي تاليسمان صيني قديم، والآن لديه وكلاء حكوميين وعصابات تطارده. قريبًا، يتعلم جاكي وجيد القوى السرية لتاليسمان الديك ويجب عليهما استخدام السحر وفنون الدفاع عن النفس لإيقاف الشرير فالمونت وعصابته من سرقة الجائزة القوية لأغراضهم الخاصة. عندما يسافر جاكي وجيد إلى المكسيك للعثور على التاليسمان التالي، يجد جاكي نفسه في الحلبة مع المصارع العالمي الممتاز إل تورو فورتي. سرعان ما يكتشف التاليسمان الثور ولكن أتباع فالمونت على عقبه. يتحالف جاكي وجيد مع المصارع القوي لمحاربة الأشرار في مباراة بطولة من الخير مقابل الشر.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"TV-PG"},"background_color":"#ab3a1f","current_season_id":18491,"content_control":"NORMAL"}}