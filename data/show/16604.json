1/shows/a7bbf414-8e82-4990-acc9-1684fb387f4e.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16917,"title":"الله سندي","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/7283aca3-b20a-4896-8c3a-d60615435b48.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":18716,"title":"بلا ملجأ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/a499e8a3-e8cd-4a28-85e4-87411d122086.png"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16604,"title":"","description":"37","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Action","Adventure"],"id":16604,"type":"SERIES","title":"ملكة جانسي","logo":"","image":"https://cdn6.albox.co/storage/disk47/seasons/808542a7-9b4a-4c6a-81de-9706aec51306.jpg","background_image":"https://cdn6.albox.co/storage/disk60/seasons/83c76d2c-9589-4517-8c7a-28ea9f48a7b5.jpg","likes":568,"dislikes":27,"views":180050,"release_date":"-2208988800000","season_number":1,"description":"يبدأ المسلسل مع مانيكارنيكا (مانو) و هي في سن الـ 14. و تعيش مع والدها موروبانت تامبي الذي يعمل في بلاط الملك بيشوا باجي راو الثاني و نانا صاحب في بيتهور. تدربت على فنون القتال و الحرب على يد تاتيا توبي، و تكره رؤية البريطانيين يحكمون الهند لذلك تتنكر بزي زعيمة الثورة للتصدي لهم، و تصبح ندّا لمسؤول بريطاني يدعى مانسون و الذي يخلق مشاكل مختلفة لها. طلب زواج يصل من ملك جانسي غانغدهار راو و يتم الموافقة عليها، عندئذٍ تتغير حياتها من امرأة عادية إلى ملكة و يعطى لها اسم جديد هو لاكشمي باي. في جانسي خادمة تدعى موتي باي تقوم بالتآمر سرا مع ضابط بريطاني يدعى الكابتن فريزر و لكنها أخيرا تقوم بالتخلي عن أعمالها السيئة بعد أن ترى مواقف الملكة المتسامحة و النبيلة. يتم إرسال ضابط آخر يدعى الكابتن مارشال بهدف القضاء على الملكة و يقتل براتشي ابنة باجي راو الثاني و التي كانت بمثابة أخت الملكة فتقوم الملكة بالتنكر في صورة زعيمة الثورة و تنتقم من الكابتن مارشال بقتله. الملك غانغدهار راو يكتشف أن زعيمة الثورة هي نفسها الملكة فتضعف العلاقة بينهما، و لكنه يعقد صفقة مع أحد الضباط الإنكليز بعدم إلقاء اللوم على زعيمة الثورة في قضية مقتل مارشال بشرط تسليم سمر سينغ و الذي كان مطلوبا للبريطانيين و كان صديقا مخلصا للملكة، فتقوم الملكة بإنقاذ سمر سينغ من أيدي البريطانيين و لكن الملك يقوم بطردها و تجريدها من حقوقها الملكية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"TV-14"},"current_season_id":4325,"content_control":"NORMAL"}}