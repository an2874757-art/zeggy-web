,"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6636,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":6636,"type":"MOVIE","title":"The Heartbreak Kid","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/f44560ba-67a8-4215-90b3-16dc8d06f696.png","background_image":"https://cdn6.albox.co/storage/disk55/shows/4df19aa6-90ed-48f8-9b39-6e31aced7289.png","likes":22,"dislikes":0,"views":4158,"release_date":"1191542400000","length":6933,"description":"Eddie is forty, owns a sporting-goods store, and is still single. After watching his ex-fiancée walk down the aisle, he meets Lila, an environmental researcher, who seems too good to be true. Pressured by his father and best friend, Eddie pops the question and marries Lila after only 6 weeks. However, as he almost instantly discovers, his new bride is a nightmare with more baggage than he can handle. She's immature, foolish, a monster in bed, owes a tremendous amount of money to various sources, and as it turns out, is only a volunteer and doesn't actually have a job. While on their honeymoon in Cabo, Eddie meets Miranda, a down-to-earth lacrosse coach who is visiting with her family. Sparks fly, and Eddie falls for her. Now comes the tricky part of breaking off his marriage to crazy Lila, all while keeping the truth from Miranda about why he's in Cabo in the first place...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"R"},"episode_id":6636,"content_control":"NORMAL"}}