s://cdn6.albox.co/storage/disk53/shows/539ba89d-f2f2-4ec8-9984-2a6914a4ae8e.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5397,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi","Drama","Thriller","Horror"],"id":5397,"type":"MOVIE","title":"Tell Tale","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk44/shows/218f69b5-4387-4d45-b646-d4fe588af100.jpg","likes":13,"dislikes":1,"views":4415,"release_date":"1262217600000","length":5550,"description":"In Providence, a husband and wife die in a botched robbery; we see flickers of his last memories. His heart goes to Terry Bernard, a single father raising a girl with a rare degenerative disease. After the operation, Terry has flashes of memory from the last moments of the dead donor's life. Then, he recognizes one of the donor's killers and follows him into an alley. Within days, Terry becomes an unwilling avenger, with a police detective on his trail. Meanwhile, he begins a romance with his daughter's doctor, his moods complicated by memory flashes, the donor's deepening presence in both Terry's mind and body, and the unexplained bond among the donor's killers. Can this end well?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.5}],"value":5.5,"age":"R"},"episode_id":5397,"content_control":"NORMAL"}}