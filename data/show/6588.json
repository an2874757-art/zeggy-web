rage/CLOUD00/shows/6b415889-8a20-477f-ac91-a38acae7f902.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6588,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Thriller","Crime"],"id":6588,"type":"MOVIE","title":"Demolition Man","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk58/shows/7fa28396-dc14-4756-938c-b1b61f789b52.jpg","likes":47,"dislikes":3,"views":8364,"release_date":"750038400000","length":6903,"description":"Frozen in 1996, Simon Phoenix, a convicted crime lord, is revived for a parole hearing well into the 21st century. Revived into a society free from crime, Phoenix resumes his murderous rampage, and no one can stop him. John Spartan, the police officer who captured Phoenix in 1996, has also been cryogenically frozen, this time for a crime he did not commit. In 2032, the former cities of Los Angeles, San Diego and Santa Barbara have merged into peaceful, utopian San Angeles. Unable to stop him with their non-violent solutions, the police release Spartan to help recapture Phoenix. Now after 36 years, Spartan has to adapt himself to the future society he has no knowledge about.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"R"},"episode_id":6588,"content_control":"NORMAL"}}