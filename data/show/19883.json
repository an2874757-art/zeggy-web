ttps://cloud01.albox.co/shows/1287aff1-aeaf-4a54-a4d7-85c8c566ff10.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":17739,"title":"كلبش","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/7458c253-6210-4338-9e3d-686c78b6cbbb.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":28892,"title":"بابا المجال","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/baaa7941-36e9-4f24-8cd7-590db641eb1c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19883,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":19883,"type":"SERIES","title":"أناشيد المطر الموسم الثاني (رائحة المطر)","logo":"","image":"https://cdn6.albox.co/storage/disk54/seasons/b6e404f7-81a0-4f07-b790-8dcc3b0b9224.png","background_image":"https://cdn6.albox.co/storage/disk45/seasons/0940488b-32fc-4839-b62b-533812431775.png","likes":5,"dislikes":1,"views":3461,"release_date":"-2208988800000","season_number":1,"description":"الجزء الأول يدعى «مطر الربيع» وهو من بطولة ورد صالح وغسان مسعود وكندة صالح وسمر سامي ورامي حنا وخالد القيش وقمر خلف وأسعد الجابر وأسامة حلال. وهو من اخراج سيف الدين سبيعي وكتب القصة والسيناريو والحوار الكاتبة المعروفة أمل حنّا. \r\nالجزء الثاني يدعى «رائحة المطر» وهو من اخراج ايناس حقي - ابنة المخرج السوري المبدع هيثم حقي - وكتابة غسان زكريا. والعمل من بطولة سعد لوستان وجهاد سعد وسوسن أرشيد ونضال نجم وأمانة والي وفاتن شاهين وضحى الدبس ورغد مخلوف و صبحي الرفاعي. \r\nأما الجزء الثالث والأخير والذي يدعى «موعد مع المطر» فهو من بطولة فرح بسيسو وطلحت حمدي ورافي وهبة وعبد الهادي الصباغ. وهو من اخراج ناجي طعمة وكتابة رافي وهبة.","rating":{"sources":[],"value":0,"age":""},"current_season_id":8681,"content_control":"NORMAL"}}