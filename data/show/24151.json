s://cdn7.albox.co/storage/CLOUD00/shows/fb1cf55e-ffc3-4c21-8a31-e1c2204358b5.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19633,"title":"زهرة القصر","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk60/shows/6c81f3ba-d89b-4569-ab22-79ad3f4f64f1.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":24151,"title":"","description":"12","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":24151,"type":"SERIES","title":"بويراز كارايل","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/799a4c90-529d-45e8-8a6e-e5e62319ecab.png","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/022c8f00-0a75-4bee-a04a-0ce78ca19868.png","likes":253,"dislikes":11,"views":77734,"release_date":"1561075200000","season_number":1,"description":"أحمد بويراز كارايل  رجل مطلق وشرطي نزيه طرد من عمله بتهمه أخذ رشوة ظلماً وقضى سنة كاملة في السجن كعقاب\r\nفقد أغلى شي بحياته وهو ابنه  سنان ، ثم أصبح يعمل كسائق أجرة ليستعيد ابنه مرة أخرى\r\nحتى يستعيد ابنه تلقى بويراز عرضاً من قائده القديم ممتاز وهو العمل على أن يكون جاسوساً في المافيا التي\r\nيديرها بحري أومان والحصول على معلومات عنها ومقابل العمل ستكون وصاية سنان له\r\nفيقبل بويراز العرض فوراً وفي الوقت نفسه يلتقى بـ عائشة جول وهي دكتورة وامرأة مستقلة\r\nتعيش وحدها بعيداً عن عائلتها ويحبها بويراز من دون أن يعرف أنها ابنة رجل مافيا ومنذ اللحظة التي يلتقي بها الإثنان تبدأ وجود مشاعر لبعضهما البعض\r\nولكن حبهما يبدو أنه سيكون مستحيلاً لأن عائشة جول هي ابنة بحري أومان رجل المافيا الذي يعمل عنده كسائق وجاسوس\r\nولكن للأسف بويراز يجب أن يخفي حقيقته عن عائشة جول ولكن بطريقة أو بأخرى ينجح بتوريط عائشة جول بالمشاكل\r\nثم تبدأ الأحداث في التوالي، وتنكشف وجوه وخيانات لم تكن متوقعة في حياة بويراز كارايل","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"background_color":"null","current_season_id":12541,"content_control":"FAMILY"}}