d":18608,"title":"Hunter x Hunter 1999","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk48/shows/a4583678-aae9-49a2-86bd-ba8fbdd9cbcc.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":21150,"title":"","description":"16","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Animation"],"id":21150,"type":"SERIES","title":"Kill La Kill","logo":"","image":"https://cdn6.albox.co/storage/disk42/seasons/b50682fc-b788-4da8-907f-da2ab110cffa.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/be67762b-014f-46df-9e43-3db12785401c.jpg","likes":176,"dislikes":2,"views":13287,"release_date":"1423353600000","season_number":1,"description":"Honnouji Academy is forcefully ruled by the iron-fisted control of its student council and its president, Satsuki Kiryuuin. Transfer student, Ryuuko Matoi, arrives on campus carrying a giant sword, that is actually half of a scissor. She is looking for the woman who holds the other half of her sword who killed her father. It is said that Satsuki Kiryuuin knows the identity of the killer but when Ryuuko confronts her she is beaten by the student council and their powerful \"goku uniforms\" whom she cannot match in strength. However, once Ryuuko receives her own \"Kamui\" by the name of Senketsu , the odds are lifted in her favor.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"pg-13"},"current_season_id":10429,"content_control":"NORMAL"}}