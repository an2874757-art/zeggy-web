rd_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk57/shows/e8642230-4944-44dd-bfed-ae60ce44adbf.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19240,"title":"ريمي","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/6b332056-8f13-49a2-ae66-64df62fca428.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":17817,"title":"دانية","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk45/shows/9cdd4e2a-a627-4380-8e0a-99af4034358b.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":30255,"title":"بن 10 اومنيفرس","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/988d17eb-f75e-402e-8c90-d9ab7c1c56e2.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":28240,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","اكشن"],"id":28240,"type":"SERIES","title":"تصنيف الملوك","logo":"","image":"https://cloud01.albox.co/seasons/b8d8658a-71cd-41c7-b79d-ef9c525392a1.png","background_image":"https://cloud01.albox.co/seasons/65875c40-a407-4851-ade8-05501da4920c.jpg","likes":96,"dislikes":5,"views":10207,"release_date":"1633996800000","season_number":1,"description":"تحكي عن “بوجي”، هو أمير أصم ضعيف ولا يستطيع حتى استخدام سيف الأطفال.\r\nبصفته الابن البكر، فهو يسعى جاهداً ويحلم بأن يصبح أعظم ملك في العالم.\r\nومع ذلك، يتمتم الناس حوله من وراء ظهره على أنه “أمير لا قيمة له” و “لا يمكن لهذا أن يكون ملكًا”.\r\n“بوجي” تمكن من تكوين صداقته الأولى، “كاغي”\r\n(بمعنى الظل). ظل حرفيا، على الأرض،من عشيرة الظلال وبطريقة ما يفهم “بوجي” جيدًا.\r\nوهو أحد الناجين من عشيرة “كاغي” للقتلة التي تم القضاء عليها بالكامل.\r\nلم يعد قاتلًا، و“كاغي” الآن يكسب عيشه بالسرقة.\r\nتتبع القصة “بوجي” حيث يلتقي بالعديد من الأشخاص في حياته، ويبدأ لقائه المصيري مع “كاغي","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG"},"background_color":"","current_season_id":15638,"content_control":"NORMAL"}}