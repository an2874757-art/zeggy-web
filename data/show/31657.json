to Shikabane no Yuusha","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/cbdf103f-ac33-4d6d-8286-d3fcd363f925.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19157,"title":"Fairy Tail","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":""},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":31657,"title":"","description":"190","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"],"id":31657,"type":"SERIES","title":"Yubisaki to Renren","logo":"","image":"https://cloud01.albox.co/seasons/873120bd-d2eb-409b-a78d-cea38e3a2b24.jpg","background_image":"https://cloud01.albox.co/seasons/59c6896a-36c5-4dd9-855f-38f1c276695f.jpg","likes":1098,"dislikes":19,"views":48738,"release_date":"1704499200000","season_number":1,"description":"يوكي إيتوسي هو طالب جامعي يعاني من ضعف السمع وقد كان عالمه محاطًا بالصمت منذ ولادته. لقد عاشت في نفس المكان طوال حياتها، ونادرًا ما تتفاعل مع الآخرين باستثناء صديقتها المفضلة، رين فوجيشيرو. أثناء تنقلاتها ذات يوم، التقت بإيتسومي ناجي ذو الشعر الفضي ومتعدد اللغات، وهو صديق مشترك لرين. على عكس معظم الأشخاص، لا يتزعزع إيتسوومي عندما يعلم بضعف يوكي؛ وهذا إلى جانب تجاربه في الخارج يبهرها ويمسها. بعد أن افترقوا، بدأ ولعها به ينمو. يبدأ عالم جديد في الانفتاح أمام كل من Yuki وItsuomi عندما يتعرفان على حياة بعضهما البعض المختلفة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"background_color":"","current_season_id":17790,"content_control":"NORMAL"}}