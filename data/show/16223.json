":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Romance","Animation"],"id":16223,"type":"SERIES","title":"Freezing","logo":"","image":"https://cdn6.albox.co/storage/disk48/seasons/e708fcff-8737-44b0-b0e2-273a50b86888.jpg","background_image":"https://cdn6.albox.co/storage/disk45/seasons/fd296e3f-6dbf-44b8-996b-eb8d81e93a77.jpg","likes":29,"dislikes":0,"views":5840,"release_date":"1294444800000","season_number":1,"description":"Earth in the near future has become threatened by other dimensional beings called the NOVA. The only way to defeat these creatures has turned out to be by using genetically altered girls (Pandora's). They are paired up with boys (Limiters) who are granted the ability to undo the freezing effect cast by the NOVA, hence allowing the Pandora's to fight freely against them. Bridget is one such Pandora and is the best in her class, however due to her aphephobia does not have a limiter. Despite all the warnings, Kazuya Aoi decides to be her Limiter and friend.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"R"},"current_season_id":3812,"content_control":"NORMAL"}}