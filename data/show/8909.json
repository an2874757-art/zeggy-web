":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8909,"title":"","description":"28","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Crime"],"id":8909,"type":"MOVIE","title":"Safe.","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/9c4b6cc7-b1ae-4a80-af94-3b85f2c4a831.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/a7368562-0327-43a3-ada3-6620125a9f01.jpg","likes":426,"dislikes":18,"views":50324,"release_date":"1335484800000","length":5651,"description":"In China, the girl Mei is a genius that looks like a computer in numbers. She is abducted by the Chinese Triads and the boss Han Jiao ends Mei to Chinatown, in New York, to help him in the control of his activities. Meanwhile, the fighter Luke Wright has his life destroyed when he wins a fight against the will of the Russian Mafia and accidentally kills his opponent. The Russian mobsters kill his wife and the alcoholic Luke wanders on the streets and hostels with no objective in life. One day, Han Jiao asks Mei to memorize a long number and soon the Russian Mafia abducts the girl from the Chinese mobs. She escapes from the mobsters and is chased by the Russians; by the corrupt detectives from the NYPD; and by the Triads. When Luke sees the girl fleeing from the Russian mobs in the subway, he protects the girl and discovers that the number she had memorized is the combination of a safe where the Triads keep 30 million dollars. Luke is an elite agent and uses his skills to protect the girl.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"episode_id":8909,"content_control":"NORMAL"}}