pe":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/c8632403-79f5-4385-af94-81e812613f7c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":13683,"title":"The Seven Deadly Sins","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/9b3605b2-03af-44ee-8ba5-9b143767b1a9.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14049,"title":"Seraph of the End","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/3a765914-c3cc-4cc0-bd00-1dc196f87d34.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":23507,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Slice of Life"," Comedy"],"id":23507,"type":"SERIES","title":"Amaama to Inazuma","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/ed2d4ec7-cbf7-413e-8450-6346bf2cdc3e.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/7a563857-426c-4dfe-adc5-b49211ddfdc9.jpg","likes":95,"dislikes":0,"views":3323,"release_date":"1467676800000","season_number":1,"description":"منذ وفاة زوجته ، كان كوهي إينوزوكا يرعى ابنته الصغيرة تسوموجي بأفضل ما لديه من قدرات. ومع ذلك ، مع افتقاره إلى المعرفة بالطهي ووظيفته المزدحمة كمدرس ، يُترك معتمداً على الوجبات الجاهزة من المتاجر الصغيرة لإطعام الفتاة الصغيرة. محبطًا بسبب عدم قدرته على توفير وجبة طازجة ومغذية لابنته ، يأخذ كوهي عرضًا من تلميذه ، كوتوري إيدا ، للحضور لتناول العشاء في مطعم عائلتها. ولكن في زيارتهما الأولى ، اكتشف الأب وابنته أن المطعم غالبًا ما يكون مغلقًا بسبب غياب والدة كوتوري للعمل وأن كوتوري غالبًا ما يأكل بمفرده. بعد الكثير من التوسل من تلميذه ، قرر Kouhei الاستمرار في الذهاب إلى المطعم مع Tsumugi لطهي الطعام اللذيذ محلي الصنع ومشاركته مع Kotori.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG-13"},"background_color":"","current_season_id":12105,"content_control":"NORMAL"}}