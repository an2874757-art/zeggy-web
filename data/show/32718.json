ontinue_watching_progress":0},{"items":[],"id":13602,"title":"Jurassic World: Camp Cretaceous","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/a5a02d75-4520-486f-b9d6-2b18d2dc0737.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":32718,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller","Animation","Science Fiction"],"id":32718,"type":"SERIES","title":"Black Panther","logo":"","image":"https://cloud01.albox.co/seasons/fa416d20-ea4d-47c9-8363-37d7a8cce06c.jpg","background_image":"https://cloud01.albox.co/seasons/9b214818-b247-418d-b9dc-319eef96dec3.jpg","likes":77,"dislikes":2,"views":10932,"release_date":"1263600000000","season_number":1,"description":"في أعماق قلب أفريقيا تقع واكاندا، حضارة متقدمة وغير قابلة للغزو. عائلة من ملوك المحاربين الذين يمتلكون سرعة وقوة ورشاقة فائقة حكمت هذه الأمة الغامضة منذ بداية الزمان. آخر من هذه السلالة الشهيرة هو الملك الشاب تشالا، البطل العظيم المعروف عالميًا بالفهد الأسود (بصوت دجيمون هونسو، من فيلم Blood Diamond وGladiator).\r\n\r\nالآن، يجتمع الغرباء مرة أخرى لغزو ونهب واكاندا. يقود هذا الهجوم الوحشي كلاو، قاتل مميت بدماء والد تشالا المقتول على يديه، الذي يحضر معه جيشًا قويًا من المرتزقة ذوي القدرات الخارقة. حتى مع قوة واكاندا ومهاراته الفائقة، هل يمكن للفهد الأسود الانتصار ضد هذه القوة الغازية المغزوة؟\r\n\r\nتعاونت شركة Marvel Animation وشبكة BET Networks لإنشاء هذه السلسلة الكرتونية الملحمية. يتضمن الفهد الأسود شخصيات كلاسيكية من مارفل مثل الكابتن أمريكا والجوجرنوت في قصة إثارة سياسية مشددة. لقد انتظر عشاق السلسلة تكييفًا للبطل الخارق الأسود الأول لأكثر من أربعة عقود!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-13"},"background_color":"#a24b15","current_season_id":18446,"content_control":"NORMAL"}}