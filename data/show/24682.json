:"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Psychological","Life"],"id":24682,"type":"SERIES","title":"The Sweetest Secret","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/7906d078-32af-4fe6-b388-79c1b71a9cc9.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/72d373fc-9b5a-4583-80e8-bdcfcdc9d894.jpg","likes":54,"dislikes":1,"views":3741,"release_date":"1639526400000","season_number":1,"description":"طالبة الدراسات العليا البالغة من العمر 27 عامًا والمتخصصة في علم النفس ، لم تستطع Tang Wei Wei متابعة أحلامها بسبب معارضة أسرتها. قصد والدها أن تتزوج قبل أن تبلغ 28 عامًا. في مواجهة ضغوط من والدها وأحلامها الأكاديمية المتوقفة ، تعاني من الاكتئاب وترفض فكرة الزواج. في قرار تعسفي لتعديل حالتها العقلية ، فتحت محل حلويات. في هذا الوقت ، تظهر لين ران ، البالغة من العمر 5 سنوات ، وهي تصغرها ، وتضيء عالمها بالدفء وأشعة الشمس.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"background_color":"","current_season_id":12937,"content_control":"NORMAL"}}