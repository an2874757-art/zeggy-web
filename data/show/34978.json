tching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":34978,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Mystery"," Action"," Historical "],"id":34978,"type":"SERIES","title":"False Face and True Feelings ","logo":"","image":"https://cloud02.albox.co/seasons/3fc9a04e-8f58-4ea7-af27-1fc58cea0039.jpg","background_image":"https://cloud02.albox.co/seasons/d7b8301a-0be0-4106-87b5-0f95c61ce1ad.jpg","likes":21,"dislikes":1,"views":3230,"release_date":"1712880000000","season_number":1,"description":"يي يي فان، الذي كان شابًا بريئًا ذات يوم، يقسم على الانتقام بعد ذبح عائلته، ويتحول إلى زعيم الجريمة القاسي والغامض المعروف باسم \"السيد مو\". في هذا المظهر، يلتقي بـ Xia Zhi Qiu، الراقصة. وهكذا تبدأ لعبة الحب بين الصياد والفريسة. يقع Ye Yi Fan تدريجيًا في حب Xia Zhi Qiu بسبب إغوائها، لكنه يكتشف أن هويتها الحقيقية هي Gu Qing Yan، ابنة عدوه. وفي الوقت نفسه، للانتقام لوالدها، تضع Gu Qing Yan الفخاخ التي يقع فيها Ye Yi Fan طواعية من أجل الحب.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"R"},"background_color":"","current_season_id":19826,"content_control":"NORMAL"}}