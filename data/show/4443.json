ments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller","Crime"],"id":4443,"type":"MOVIE","title":"Dragged Across Concrete","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/d842a529-cecd-4b4a-bb3f-7df0e2e631f8.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/3ab1ad98-1d4a-4a87-8cd1-adabad15a29c.jpg","likes":91,"dislikes":8,"views":13198,"release_date":"1550707200000","length":9502,"description":"بريت ريدجمان (ميل جيبسون) وأنتوني لوراستي (فينيس فوجان) شرطيان، حيث أولهما - بريت - من طراز الشرطي الكلاسيكي، بينما الآخر - أنتوني - هو شريكه العنيف الأصغر سنًا. يجدان أنفسهما موقوفيّن عن العمل بسبب تسجيل ينُشر لهما ويفضح أساليبهما العنيفة في التعامل؛ وسُرعان ما يصبح التسجيل قضية إعلامية متداولة بين الجميع.. مع وقفهما عن العمل وتدهور أحوالهما يصبحان بحاجة ماسة إلى النقود، ويتحولان من شرطييْن إلى متمرسيْن في عالم الجريمة، حيث يجدان أكثر مما توقعاه ينتظرهما في الظلال.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":4443,"content_control":"NORMAL"}}