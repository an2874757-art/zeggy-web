age":"https://cdn6.albox.co/storage/disk53/shows/539ba89d-f2f2-4ec8-9984-2a6914a4ae8e.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8599,"title":"","description":"18","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Romance"],"id":8599,"type":"MOVIE","title":"Top Gun","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/85e5323d-89d7-4c5e-bb23-83de74e2f9f1.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/1d7f2dd8-de1e-466b-ae94-614ed75a35b1.jpg","likes":250,"dislikes":6,"views":27534,"release_date":"516585600000","length":6575,"description":"Lieutenant Pete \"Maverick\" Mitchell is an expert United States Naval Aviator. When he encounters a pair of MiGs over the Persian Gulf, his wingman is clearly outflown and freaks. On almost no fuel, Maverick is able to talk him back down to the carrier. When his wingman turns in his wings, Maverick is moved up in the standings and sent to the Top Gun Naval Flying School. There he fights the attitudes of the other pilots and an old story of his father's death in combat that killed others due to his father's error. Maverick struggles to be the best pilot, stepping on the toes of his other students and in another way to Charlie Blackwood, a civilian instructor to whom he is strongly attracted.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"episode_id":8599,"background_color":"","content_control":"FAMILY"}}