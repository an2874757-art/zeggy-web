اهمت عقله فكرة و هي أن يكتب رسالة إلى الله و يشكو حاله إليه!\r\n\r\nالشيخ نظر علي الطالقاني هو عالم عارف حكيم فقيه متبحر حافظ للقرآن كان مقيما في طهران، له كتاب كاشف الأسرار في مجلد كبير يشتمل على أصول الدين وعلى فن الأخلاق والمواعظ، توفي في المشهد الرضوي سنة 1306.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"R"},"episode_id":919707,"background_color":"","content_control":"FAMILY"}}