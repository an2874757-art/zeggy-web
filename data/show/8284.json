,{"data":[{"items":[],"id":8284,"title":"","description":"15","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Music"],"id":8284,"type":"MOVIE","title":"La Vie en Rose","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/7ac152bc-2dea-4fcb-9fa5-81cb902d321d.jpeg","background_image":"https://cdn6.albox.co/storage/disk45/shows/a0e5968f-98db-4a22-9ff4-002e1ee5bcf7.jpeg","likes":53,"dislikes":1,"views":8272,"release_date":"1184889600000","length":8433,"description":"An un-chronological look at the life of the Little Sparrow, Édith Piaf (1915-1963). Her mother is an alcoholic street singer, her father a circus performer, her paternal grandmother a madam. During childhood she lives with each of them. At 20, she's a street singer discovered by a club owner who's soon murdered, coached by a musician who brings her to concert halls, and then quickly famous. Constant companions are alcohol and heartache. The tragedies of her love affair with Marcel Cerdan and the death of her only child belie the words of one of her signature songs, \"Non, je ne regrette rien.\" The back and forth nature of the narrative suggests the patterns of memory and association.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"PG-13"},"episode_id":8284,"content_control":"FAMILY"}}