ms":[],"id":24664,"title":"Bad and Crazy","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/42b5ed92-56fb-4f3d-95b5-53f68e64e9a9.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36584,"title":"","description":"104","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Historical"," Political"],"id":36584,"type":"SERIES","title":"The Prisoner of Beauty","logo":"","image":"https://cloud02.albox.co/seasons/fe031aa7-d277-46c5-acd5-13a65f9d99a2.Jpg","background_image":"https://cloud02.albox.co/seasons/ccb5d546-c3d0-488e-a30f-51396e476ef3.Jpg","likes":403,"dislikes":9,"views":31063,"release_date":"1747094400000","season_number":1,"description":"شياو تشياو، فتاة ذكية من عائلة تشياو، تتزوج وي شاو، سيد عائلة وي الحاد واللطيف، في إطار تحالف عائلي. بسبب الخلافات بين عشيرتيهما، يبدأ الاثنان بحذر من بعضهما البعض، ويختبران الحدود باستمرار بطرق مضحكة ومتوترة. مع مرور الوقت، يبدأان بتقدير مواهب بعضهما البعض. وعبر التقلبات، يتعلمان العمل كفريق واحد، ويواجهان مشاكل عائلية وقضايا أكبر لإحلال السلام في عالمهما. إنها قصة شراكة مبنية على التجربة والخطأ وقليل من الفوضى.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"R"},"background_color":"","current_season_id":21110,"content_control":"NORMAL"}}