itle":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Historical","Romance "],"id":37660,"type":"SERIES","title":"Everbloom Dynasty","logo":"","image":"https://cloud02.albox.co/seasons/a13a5a64-28ba-44bf-82e1-f666c7b8336a.jpg","background_image":"https://cloud02.albox.co/seasons/bf3d8670-1800-442e-8daa-763f03a54d51.jpg","likes":16,"dislikes":1,"views":3909,"release_date":"1755561600000","season_number":1,"description":"بعد نفيها إلى الجبال لمدة سبعة عشر عامًا، تعود يان جي هوان إلى منزلها للاحتفال بعيد ميلاد والدها، لتجد نفسها مُلفّقة لقتله. تستخدم ذكائها للهروب من اتهامات باطلة، فتكشف مؤامرة أعمق متجذّرة في البلاط الملكي. متنكرةً وعازمةً، تدخل القصر وتتحد مع الأمير جينغ، الذي يتشارك معه الماضي. معًا، يسعيان إلى الحقيقة، ويكشفان الفساد، ويناضلان من أجل العدالة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"background_color":"","current_season_id":21829,"content_control":"NORMAL"}}