ess":0},{"items":[],"id":24662,"title":"بليتش","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/53489fb5-41e1-4c80-b004-c6028f12f9bf.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":34486,"title":"Dandadan","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/32ae44b7-0f3c-45e6-bbf0-35f6c9c36439.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":34809,"title":"One Piece: Gyojin Tou-hen","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/58e72925-71ea-4607-a586-9558f0acc505.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":27469,"title":"The Eminence in Shadow","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/d3a59883-2c5c-431d-886c-47d3e357023b.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":20982,"title":"Boruto: Naruto the Movie","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":""},"length":0,"continue_watching_progress":0},{"items":[],"id":38336,"title":"My Status as an Assassin Obviously Exceeds the Hero’s","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/333f5c51-d12c-4f60-81c5-66bbf1a2541b.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15970,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Animation","War"],"id":15970,"type":"SERIES","title":"Sengoku Basara","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/e798579f-ec0a-4074-985d-054c231f7c5f.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/7d79dcef-d708-48ea-a2b0-f84b66d9e524.jpg","likes":19,"dislikes":1,"views":6068,"release_date":"1238544000000","season_number":1,"description":"In the age of the Warring Countries, Japan was fragmented in semi-independent provinces, governed by feudal lords or daimyo, who confronted each other in an endless struggle for power. Ambitious daimyos from every corner of the Archipelago had shouted their battle cry. They were Takeda Shingen from Kai, Sanada Yukimura, Uesugi Kenshin from Echigo, Azai Nagamasa from Omi, Tokugawa Ieyasu from Mikawa, and many more... Those were days of unrest and chaos. As war spread throughout the country, the map of power underwent rapid and dramatic changes. In this never-ending conflict, one man finally seemed to be just one step from establishing total control over the country. He was the lord of Owari, the Sixth Heavenly Devil King. His name was Oda Nobunaga. But now, a young general clad in azure makes his unexpected appearance in this confused scenario, heading a huge army of cavalrymen from the Northern provinces. He is known as Date Masamune, the One-Eyed Dragon. And he is coming for Oda Nobunaga's head, and for ultimate supremacy!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG-13"},"current_season_id":3438,"content_control":"NORMAL"}}