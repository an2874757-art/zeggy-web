ogress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":25927,"title":"","description":"46","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"," Romance"],"id":25927,"type":"SERIES","title":"Kakkou no Iinazuke","logo":"","image":"https://cloud.albox.co/seasons/b4e0f3a2-3e86-45fe-9ab6-0588fac0aee8.jpg","background_image":"https://cloud.albox.co/seasons/1d80c425-9a13-4333-9268-d69ed4b00494.jpg","likes":486,"dislikes":21,"views":90069,"release_date":"1650758400000","season_number":1,"description":"تم تغيير ناجي أومينو البالغ من العمر 16 عامًا ، وهو طالب في السنة الثانية في مدرسة Meguro River Academy الثانوية ، عند الولادة. في طريقه إلى العشاء لمقابلة والديه ، التقى بالصدفة إيريكا أمانو الصريحة ، المصممة على جعل ناجي صديقها المزيف لأنها لا تريد الزواج فعليًا. ولكن بمجرد أن يصل ناجي إلى العشاء ، وجد والديه قد قررا حل تغيير المستشفى من خلال جعله يتزوج بسهولة من الابنة التي رعاها والداها ... التي تبين أنها ليست سوى إيريكا نفسها!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"current_season_id":13863,"content_control":"NORMAL"}}