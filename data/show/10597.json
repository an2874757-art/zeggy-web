ue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10597,"title":"","description":"13","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":10597,"type":"MOVIE","title":"Bad Teacher","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/71cfcf60-d9da-4c4e-b131-a2d179eedbbf.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/91e2e12a-16c5-4d6e-a834-92a1b1d49626.jpg","likes":145,"dislikes":15,"views":28260,"release_date":"1308873600000","length":5858,"description":"When her wealthy fiancé breaks it off, gold digger Elizabeth Halsey returns to middle school: she's an awful teacher but wants to save for breast-implant surgery. She brightens when Scott, a new teacher, turns out to be rich, and she stops showing films and sleeping in class when told there's a bonus for the teacher whose class scores highest on the state exam. Her competition for Scott and the bonus is cheery and tightly wound Amy. Amy digs for dirt on Elizabeth who cheats her way toward Scott's bed and the money. Honesty with students seems to be her only skill. She ignores Russell, a droll gym teacher, who looks on. Will she succeed with Scott and get those new breasts?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"R"},"episode_id":10597,"content_control":"FAMILY"}}