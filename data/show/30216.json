ددين أعداء أقوياء بشكل متزايد للدفاع عن العالم ضد الشر. هل يستطيع المدافع عن الأرض هزيمة الشياطين والأجانب والأشرار الآخرين؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"TV-14"},"background_color":"#42ccfa","current_season_id":17152,"content_control":"NORMAL"}}