:0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4424,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Animation"],"id":4424,"type":"MOVIE","title":"Beowulf","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/616b028b-deb0-478d-91ce-a0d3e1b4dd13.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/3dad1188-731c-4a60-be1c-9eb1e96d3654.jpg","likes":55,"dislikes":4,"views":7634,"release_date":"1195171200000","length":6883,"description":"Set against the coming of Christianity, this is the story of the last hero: in 507, a monstrous troll wreaks havoc in the mead hall of the Danish king, Hrothgar. He offers rewards for the death of Grendel, so Beowulf, a great and boastful Geat warrior, arrives with his thanes. Beowulf sets aside his armor and awaits the monster; a fierce battle ensues that leads to Beowolf's entering the watery lair of Grendel's mother, where a devil's bargain awaits. Beowulf returns to Herot, the castle, and becomes king. Jump ahead many years, and the sins of the father are visited upon Beowulf and his kingdom. The hero must face his weakness and be heroic once again. Is the age of demons over?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"PG-13"},"episode_id":4424,"content_control":"FAMILY"}}