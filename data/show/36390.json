e_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36390,"title":"","description":"64","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Historical"],"id":36390,"type":"SERIES","title":"Nami Uraraka ni, Meoto Biyori","logo":"","image":"https://cloud02.albox.co/seasons/ff40e946-99bc-44f2-b4ac-1b4e1bca81ef.jpg","background_image":"https://cloud02.albox.co/seasons/13dc2b60-26b6-4b50-99c9-cca471551489.jpg","likes":189,"dislikes":5,"views":22789,"release_date":"1745452800000","season_number":1,"description":"في عام 1936، كانت ناتسومي هي الثالثة من بين أربع بنات من عائلة سيكيا. في أحد الأيام، أخبرها والد ناتسومي فجأة أن زواجها قد تقرر وأن زوجها سيكون تاكيماسا إيباتا، وهو ضابط في البحرية الإمبراطورية. فوجئت بإعلان والدها. لم تكن لها علاقة رومانسية من قبل ولم تقابل تاكيماسا إيباتا من قبل. حتى في حفل زفافهما، لم يتمكن تاكيماسا إيباتا من الحضور بسبب تدريبه البحري. أقامت ناتسومي حفل الزفاف بصورة تاكيماسا إيباتا. لم تستطع إخفاء إحراجها من الطريقة التي بدأ بها زواجهما. لاحقًا، بعد انتهاء تدريب تاكيماسا إيباتا البحري، قابلته لأول مرة. شعرت بعدم الارتياح لأنه لا يعبر عما يفكر فيه أو يشعر به. ومع ذلك، تدعمه ناتسومي كزوجة وتعمل بجد في الأعمال المنزلية. بمرور الوقت، لاحظت لطفه وانفتحت عليه تدريجيًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"background_color":"","current_season_id":20966,"content_control":"NORMAL"}}