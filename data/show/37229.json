inue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Historical"],"id":37229,"type":"SERIES","title":"Royal Upstart","logo":"","image":"https://cloud02.albox.co/seasons/3ed38ffe-e8a2-496d-bffa-3625a32656ef.jpg","background_image":"https://cloud02.albox.co/seasons/187e687f-42fe-4e59-b8ff-66cd4bc1f113.jpg","likes":37,"dislikes":0,"views":9579,"release_date":"1751932800000","season_number":1,"description":"بعد حادث غريب يُحوّل شياو نينغ إلى سلالة جينغ العظيمة، صهر عائلة سو المُهان، يُحدث ثورة في الإمبراطورية بفنونه المنسية، مُحوّلاً الشاي إلى طعام شهي، ومُحوّلاً النبيذ إلى ذهب سائل. وبينما يُطالب العامة بإبداعاته، يُحطم التقاليد بتأسيس أول صحيفة في المملكة، مُحشداً العباقرة لتمكين أميرة من الصعود السياسي. عندما تُسخر منه ملكات التجار وتُحتقره زوجته السابقة، يُوظّف شياو نينغ التجارة كأداة لقطع تحيزاته الراسخة، بينما ينحت أسطورة من الازدراء.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"R"},"background_color":"","current_season_id":21548,"content_control":"NORMAL"}}