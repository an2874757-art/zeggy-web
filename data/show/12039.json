_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/9cec91d1-4184-494d-aa4a-e387a925e1ed.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":40090,"title":"The Bluff","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/eff38218-28c1-45af-a2dd-2df637c8e8c8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10585,"title":"The Lord of the Rings: The Two Towers","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/67a71a6b-b56e-4cbd-aaaf-1409f0dd414c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":41195,"title":"In the Grey","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/3f4f86a3-50cd-46f5-844b-7d22c2051efd.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":40635,"title":"Ready or Not: Here I Come","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/787f79dc-f0b4-4176-b961-ee25e42dae42.JPG"},"length":0,"continue_watching_progress":0},{"items":[],"id":36661,"title":"Fountain of Youth","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/4a4d1449-49bf-4380-a466-bf1409f6a8a8.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":12039,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","Horror"],"id":12039,"type":"MOVIE","title":"The Rite","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/41837ad9-4b8a-4106-9252-1ef78373503e.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/24f8172a-603b-4a00-97d7-6c052f964104.jpg","likes":54,"dislikes":1,"views":5803,"release_date":"1296172800000","length":6822,"description":"Michael, the son of a funeral director grows indifferent to his father and joins a Seminary. On his way to the course completion, he is overwhelmed by a strong lack of faith. His religious beliefs are further jolted when he sees a young girl haplessly dying in a road accident for whom he reluctantly performs the ritual to absolve her sins. His mentor still believes in him and urges him to go to Italy to take an exorcism course hoping that he it would strengthen his faith in Christianity. In Italy he attends a session from Father Xavier who soon becomes aware of his skepticism. As a result he sends him to an eminent Jesuit exorcist, Father Lucas, whose ways though questionable are quite effective. He witnesses the exorcism of a sixteen year old girl but still seems unconvinced. Father Lucas explains to him that it takes multiple sessions over a long stretch of time to completely free a victim from the demon. Despite witnessing some supernatural occurrences during the aforesaid exorcism, Michael is as skeptical as ever. After the second exorcism, the girls condition becomes quite critical as she is moved to a hospital. She soon dies and the demon finds a new victim. As the moment of reckoning draws near, Micheal may be the only hope left but first he must overcome his own doubts and apprehensions in order to fight and destroy the ominous forces.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-13"},"episode_id":12039,"content_control":"FAMILY"}}