cd27210f-569d-43cf-948b-3825ac9c14db.jpg","background_image":"https://cloud02.albox.co/seasons/33c2cf51-40ad-4142-a7ff-e729e08ba9c3.jpg","likes":48,"dislikes":4,"views":10092,"release_date":"1752364800000","season_number":1,"description":"يعمل توكوشيغي أكيرا طبيبًا عامًا في قسم طب عام حديث الإنشاء في أحد المستشفيات. يُعدّ تخصص الطب العام الفرع التاسع عشر الجديد في النظام الطبي الياباني، والذي كان يُصنّف سابقًا إلى ثمانية عشر تخصصًا. يفحص الدكتور توكوشيغي أكيرا مرضاه ويراعي أنماط حياتهم وبيئتهم المنزلية وحالتهم النفسية، بغض النظر عن جنسهم أو أعمارهم. ليس سلاحه الأبرز مهاراته الجراحية أو قدرته على اكتشاف المرض فورًا، بل استجوابه للمرضى والاستماع إلى آرائهم. أحيانًا يكشف زيف قصة المريض. من خلال الحوارات المتكررة، يتمكن من إيجاد الحل الأمثل ومساعدة المرضى على تحسين حياتهم.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"background_color":"","current_season_id":21836,"content_control":"NORMAL"}}