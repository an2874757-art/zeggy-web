id":7886,"title":"","description":"29","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller"],"id":7886,"type":"MOVIE","title":"No Tears for the Dead","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/8cf511e5-978d-4c57-a16a-26032d890d18.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/f0671be4-c4ce-451e-9136-0e9cad65bd88.jpg","likes":151,"dislikes":2,"views":12972,"release_date":"1401840000000","length":6986,"description":"Abandoned by his mother shortly after immigrating to America, Gon is raised by the mafia and grows up to become a cold-blooded hit-man. Though usually flawless in taking out his targets, Gon makes a terrible mistake of killing an innocent young girl. A flood of guilt takes over his life and the situation becomes worse when his boss assigns him the job of killing the young girl's mother. Gon's new target, Mogyeong, is a risk manager at an investment firm and has buried herself in work to bury her grief. She is completely unaware of her role at the heart of a dangerous conspiracy. Finally, she meets the man who wants to tell her the truth behind the death of her child.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"R"},"episode_id":7886,"content_control":"NORMAL"}}