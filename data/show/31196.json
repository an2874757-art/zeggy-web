ural"],"id":31196,"type":"MOVIE","title":"Sarusuberi: Miss Hokusai","logo":"","image":"https://cloud01.albox.co/shows/7f548ff8-b8fd-4051-b72d-251d60ef4739.jpg","background_image":"https://cloud01.albox.co/shows/703c16bf-381c-48ee-8acb-68b5a543c424.jpg","likes":17,"dislikes":1,"views":989,"release_date":"1431129600000","length":5384,"description":"كان تيتسوزو فنانًا بارعًا في عصره وهو الآن في منتصف الخمسينيات من عمره، ويمكنه التفاخر بعملائه من جميع أنحاء اليابان، ويعمل بلا كلل في الفوضى المليئة بالقمامة في مشغل منزله. يقضي أيامه في إنشاء قطع فنية مذهلة، بدءًا من تمثال بوديدارما ضخم الحجم مرسومًا على ورقة يبلغ عرضها 180 مترًا مربعًا، إلى زوج من العصافير المرسومة على حبة أرز صغيرة. سريع الغضب، ساخر تمامًا، ليس لديه أي شغف بالسعادة أو المال، كان يتقاضى ثروة مقابل أي وظيفة لا يهتم بها حقًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"episode_id":896609,"background_color":"","content_control":"NORMAL"}}