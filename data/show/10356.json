,"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10356,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Crime"],"id":10356,"type":"MOVIE","title":"The Taking of Pelham 123","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/7ecfe1e0-5b85-4fbf-98dc-94b6d434a351.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/482b0efd-4542-4b70-8aec-dec9d73f95e1.jpg","likes":38,"dislikes":0,"views":5223,"release_date":"1244764800000","length":6355,"description":"In early afternoon, four armed men hijack a subway train in Manhattan. They stop on a slight incline, decoupling the first car to let the rest of the train coast back. Their leader is Ryder; he connects by phone with Walter Garber, the dispatcher watching that line. Garber is a supervisor temporarily demoted while being investigated for bribery. Ryder demands $10 million within an hour, or he'll start shooting hostages. He'll deal only with Garber. The mayor okays the payoff, the news of the hostage situation sends the stock market tumbling, and it's unclear what Ryder really wants or if Garber is part of the deal. Will hostages, kidnappers, and negotiators live through this?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"R"},"episode_id":10356,"content_control":"FAMILY"}}