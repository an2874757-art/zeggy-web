":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/54fdf2a2-6446-4e29-bfbe-a9ba17a468df.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":20248,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Crime","Mystery"],"id":20248,"type":"SERIES","title":"Ouroboros","logo":"","image":"https://cdn6.albox.co/storage/disk48/seasons/1a30aaaa-c574-440b-ac91-8be1002771bc.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/bd7fa512-97ce-41f1-a1db-8912b70cbb5f.png","likes":12,"dislikes":0,"views":1162,"release_date":"1421366400000","season_number":1,"description":"Ikuo and Tatsuya are orphans. They live at Mahoroba's house which is a child and family services home. At their elementary school, they see Teacher Yuko, who took good care of them like a real older sister, killed right in front of them. Ikuo and Tatsuya tell the police what they saw, but the case is covered by a police officer wearing a gold watch. 15 years later, Ikuo (Toma Ikuta) now works as a detective. He is a good person and his arrest rate is the highest at the police station. Meanwhile, using his handsome appearance and cleverness, Tatsuya (Shun Oguri) becomes a high ranking yakuza. Detective Ikuo and Yakuza Tatsuya have a singular purpose, which is to find the man wearing the gold watch, dig out the truth and reveal the dark side of the police organization.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"N/A"},"current_season_id":9167,"content_control":"NORMAL"}}