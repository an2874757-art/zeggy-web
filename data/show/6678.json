omments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Comedy","Horror","Family"],"id":6678,"type":"MOVIE","title":"Goosebumps","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/04d6bd47-573a-4933-9f81-3a0c4c6930b4.png","background_image":"https://cdn6.albox.co/storage/disk56/shows/c09223bc-6d2e-42ff-a5d6-792b56984de6.png","likes":218,"dislikes":2,"views":15923,"release_date":"1444953600000","length":6196,"description":"First this is all about monsters and any kind of supernatural .After going to a new small town,the teenager boy Zach Cooper (Dylan Minnette) he meets the beautiful girl, Hannah (Odeya Rush), living right next door. But every silver lining has a cloud, and Zach's comes when he learns that Hannah has a mysterious dad who is revealed to be R. L. Stine (Jack Black), the author of the bestselling Goosebumps series. It turns out that there is a reason why Stine is so strange... he is a prisoner of his own imagination - the monsters that his books made famous are real, and Stine protects his readers by keeping them locked up in their books. Zach unintentionally unleashes the monsters from their manuscripts and they begin to terrorize the town, it's suddenly up to Stine, Zach, Hannah, and Zach's friend Champ (Ryan Lee) they all do their best to back all of the monsters in the book.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":6678,"content_control":"NORMAL"}}