ontinue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8163,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime","Mystery"],"id":8163,"type":"MOVIE","title":"Secret in Their Eyes","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/596bb91a-f16e-46bd-80bd-6a67f2cc0c38.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/109a432d-9cfc-4aae-8dcd-4db48e1f3bc7.jpg","likes":35,"dislikes":1,"views":7263,"release_date":"1447977600000","length":6699,"description":"2002: Ray Kasten (Chiwetel Ejiofor) and Jess Cobb (Julia Roberts) are two investigators in a private police unit led by the DA. When they receive an anonymous tip about a girl raped and killed, they rush to the scene. Ray realizes it is Jess' daughter and the team falls apart due to the grief. In 2015, Ray comes back to LA, and says that after 13 years, he has found a lead and convinces the DA to reopen the case. They find clues and leads unknown to them, and secrets from the past come to light as they start discovering the real, chilling truth. Meanwhile, Jess, dissatisfied with the law, decides to take matters into her own hands and track down the killer, no matter what lengths she has to go to.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":8163,"content_control":"FAMILY"}}