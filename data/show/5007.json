items":[],"id":5007,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Mystery","Horror"],"id":5007,"type":"MOVIE","title":"The Ward","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/8a5a6844-b6ac-46cd-8939-a68681aa972c.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/60525afb-c34f-4b51-88b7-7fffd174eb72.jpg","likes":48,"dislikes":6,"views":10834,"release_date":"1310083200000","length":5335,"description":"In 1966, in North Bend, Oregon, the runaway Kristen is captured by the police after burning down a farmhouse and is locked in the North Bend Psychiatric Hospital. Kristen is introduced to Dr. Gerald Stringer, who uses experimental therapy. Then she meets the inmates Emily, Sarah, Zoey and Iris and the tough nurse Lundt. During the night and in the shower later, Kristen sees the ghost of a woman and she learns that she is Alice Leigh Hudson, a mysterious wicked intern that has disappeared. When Iris is ready to go home, she is attacked by the ghost of Alice in the basement and murdered. She vanishes and the inmates decide to seek Iris out. Then Sarah is abducted by the Alice and also killed; the next one is Emily. Meanwhile Kristen escapes from her room and meets Zoey, expecting to protect her. However, Zoey is kidnapped by Alice and Kristen runs to Dr. Stringer's office. She snoops his desk and finds a report with the truth about Alice.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"R"},"episode_id":5007,"content_control":"NORMAL"}}