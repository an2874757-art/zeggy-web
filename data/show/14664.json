itle":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":14664,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Animation","Family"],"id":14664,"type":"SERIES","title":"Wakfu","logo":"","image":"https://cdn6.albox.co/storage/disk48/seasons/99541ca4-d4b4-4f03-83ee-65a66a80c05d.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/0556b8f6-5fef-43e8-9378-7933d40ec7ce.jpg","likes":61,"dislikes":0,"views":8437,"release_date":"1225324800000","season_number":1,"description":"In a fantasy world, a mysterious figure leaves a baby boy with a retired bounty hunter in a small village with instructions to raise him until the time is right for him to find his biological family. Years later, that boy named Yugo discovers he has powerful magic abilities using the power of Wakfu even as his village is threatened. Working with a bunch of newfound friends, Yugo is able to help save his home and discover his quest. However, there are villains who know about the boy too and are determined to gain his power for their own ends. Regardless, Yugo is on that quest with his friends to find his family and answers about his past with greater implications concerning both he is only beginning to understand.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"TV-Y7-FV"},"current_season_id":1638,"content_control":"NORMAL"}}