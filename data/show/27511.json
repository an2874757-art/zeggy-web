"style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Action"," Fantasy"," Adventure"],"id":27511,"type":"SERIES","title":"Magi: The Labyrinth of Magic","logo":"https://cloud01.albox.co/shows/2ece3553-39d5-42fb-8540-24a21aabd25f.png","image":"https://cloud01.albox.co/seasons/c21b9525-516b-4101-8580-eee985612adf.jpg","background_image":"https://cloud01.albox.co/seasons/9b8d8090-6c10-475f-849a-9788a7704612.jpg","likes":296,"dislikes":6,"views":20462,"release_date":"1349568000000","season_number":1,"description":"المجوس هو ساحر ميله نحو السحر هائل لدرجة أنه يمكن القول إنهم يشكلون العالم. مع تأثيرهم الكبير ، يختار كل مجوس مرشحًا جديرًا ليصبح ملكًا ، ثم يساعدهم في التغلب على متاهات غريبة تسمى \"الزنزانات\" واكتساب قوة الجن الأسطورية في الداخل. قبل كل شيء ، يشرف المجوس على ممثلهم المنتخب وهم يبنون دولة قد تجعل العالم يومًا ما يجثو على ركبتيه.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"background_color":"#edcc5d","current_season_id":15094,"content_control":"NORMAL"}}