.co/shows/a2f2d126-0b06-432e-8aaa-00fcf9517269.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6823,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Romance","Thriller","Comedy","Crime"],"id":6823,"type":"MOVIE","title":"One for the Money","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/9dfa5be0-8b77-4b84-8e33-c534e38d96df.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/7f905319-6a4d-4c02-ab7a-1aac89bb0a3e.jpg","likes":62,"dislikes":2,"views":8112,"release_date":"1327622400000","length":5473,"description":"After losing her job, Jersey girl Stephanie Plum is broke. Needing a job she is told that her cousin, a bail bondsman, needs someone to help out in the office. But the only job openings he has are for skip tracers. She learns that Joe Morelli, a guy she knew intimately years ago, is one of the \"skips\". She eventually finds him but wasn't really prepared so he gets away. Another bounty hunter, Ranger, tries to teach her. Eventually she finds Morelli again, but he claims he is innocent of the crime he is accused of and he is trying to prove his innocence. Eventually Stephanie thinks he's telling the truth so she stakes out the person who can help him. She only finds herself in trouble and Morelli saves her. She tries to find someone who can prove his innocence, but the problem is that shortly after meeting with them they're killed or attacked.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"episode_id":6823,"content_control":"FAMILY"}}