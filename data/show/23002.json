ب منه، وتعامله بخوف لاعتقادهم أنه الوحش، فيحاول (زكى) أن يصل الى الوحش لحل مشاكله.\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"PG-13"},"episode_id":408922,"content_control":"NORMAL"}}