c-7f039cbf37dd.jpg","image":"https://cloud02.albox.co/seasons/9b31caa8-71a5-4c9e-945c-5eefb3e6a6f2.png","background_image":"https://cloud02.albox.co/seasons/634d90a4-a3f1-4980-905d-80817022af17.jpg","likes":254,"dislikes":16,"views":49149,"release_date":"1775952000000","season_number":1,"description":"أكاديمية ديانا الملكية مدرسة مرموقة تقبل الأفراد ذوي القدرات السحرية الفائقة. بعد التخرج، يجد هؤلاء الطلاب أنفسهم في قمة مجالهم أو يعملون لدى العائلة المالكة. تحلم سبيكا فيرجو بالدراسة في الأكاديمية، ساعيةً لأن تصبح ساحرةً بارعةً مثل قدوتها كلود سيريوس. كلود ساحر عالمي شهير أصبح أصغر مُدرّس في الأكاديمية، لكنه اختفى في ظروف غامضة بعد ذلك بوقت قصير.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"NC-17"},"background_color":"#c8c8c8","current_season_id":23746,"content_control":"NORMAL"}}