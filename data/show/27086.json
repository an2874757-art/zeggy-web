escription":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/f12725cb-3633-4826-b7c9-b6fa035043dc.PNG"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":27086,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":27086,"type":"SERIES","title":"فخامة الشك","logo":"","image":"https://cloud01.albox.co/seasons/a983cb79-4eae-41c9-b335-b27c336ada6a.jpg","background_image":"https://cloud01.albox.co/seasons/d3d737da-9d4d-47df-8e1e-e05cc40b364d.jpg","likes":7,"dislikes":1,"views":1621,"release_date":"1484524800000","season_number":1,"description":"يتناول المسلسل اللبناني الاجتماعي الجديد “فخامة الشك” للمخرج السوري أسامة الحمد قصة أسرة ثرية تتعرض لمؤامرة من صديق الأب، ما يدفع بها إلى الإفلاس وعرض ممتلكاتها في المزاد العلني.\r\n\r\nويقرر أحد أبناء العائلة أن ينتقم من إحدى العائلات الغنية التي تدور حولها الشكوك بتسببها في النكبة التي تجرعتها الأسرة، ويواجه الابن صراعات ومشكلات لإثبات هذه الشكوك والثأر من الأشخاص الذين يقفون وراء أزمة عائلته. ويركز المسلسل على الصراعات الحادة التي تدور بين أطراف نافذة، وتتضمن الأحداث أيضا خطوطا أخرى للقصة تتشكل من خلال علاقات حب معقدة، وأغلب الشخصيات تدور في فلك الانتقام الذي يحكمه العبث والفوضى، ولكنه مرتبط دائما بالشك.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-13"},"background_color":"","current_season_id":14684,"content_control":"NORMAL"}}