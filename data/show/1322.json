ster"},{"data":[{"items":[],"id":1322,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"],"id":1322,"type":"MOVIE","title":"Brewster's Millions","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/6c981f7d-4d2a-4d56-b96b-b789e3d0e767.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/1b311c19-5fd1-45f3-aa9a-4502ae987699.jpg","likes":75,"dislikes":1,"views":3326,"release_date":"485568000000","length":6069,"description":"Brewster is a minor league baseball player. Unknown to him, he had a (recently deceased) rich relative. In order to test if Brewster knows the value of money, he is given the task of disposing of $30m in 30 days. Brewster isn't allowed to have any assets to show for the $30m or waste the money in any way. If successful, Brewster gets to inherit $300m. The biggest problem of all however, is that Brewster can't tell anyone what he's doing, so everyone thinks he's crazy. Add to this the fact that if he fails, two scheming trustees will get their hands on the money, Brewster's task is not an easy one.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG"},"episode_id":1322,"content_control":"NORMAL"}}