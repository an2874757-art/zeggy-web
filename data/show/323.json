":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":323,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller"],"id":323,"type":"MOVIE","title":"The Hunt","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/a756ae97-5d0b-442f-bd06-074c1d6e2e4d.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/38da246f-4c5e-4675-b5b1-86fd3d948b66.jpg","likes":34,"dislikes":0,"views":5047,"release_date":"1467158400000","length":5557,"description":"Ki-Sung is suffering from the aftereffects of a coal mine incident. Now he goes to the mountain everyday to hunt for a living. But on this particular day, he sees a suspicious group of hunters and chases them. The group is lead by the business-man Park who has found a claim of gold at the mountain-site. But while trying to buy the area from the old woman who owns it, they got into an argument and Park kills her furiously. Ki-Sung tried to stop them, but now they are after him to erase the only witness of their crime. The beginning of a brutal fight for survival.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.1}],"value":5.1,"age":"R"},"episode_id":323,"content_control":"NORMAL"}}