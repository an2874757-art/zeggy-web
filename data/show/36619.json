 ممكن وتبرئة ساحة المحكمة، تطوع جيانغ شو للزواج من مينغ تان، وهو جنرال أيضًا، حتى لا تُستغل عائلة مينغ.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"R"},"background_color":"","current_season_id":21145,"content_control":"NORMAL"}}