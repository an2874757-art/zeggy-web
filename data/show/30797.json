watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":30797,"title":"","description":"73","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"," Thriller"," Mystery"," Crime"],"id":30797,"type":"SERIES","title":"Evilive","logo":"","image":"https://cloud01.albox.co/seasons/2a24dce0-643c-40eb-8d37-479f410dbd28.jpg","background_image":"https://cloud01.albox.co/seasons/29c3886f-121e-4c9a-887c-77cc30850a2a.jpg","likes":675,"dislikes":5,"views":42288,"release_date":"1697241600000","season_number":1,"description":"هان دونغ سو محامي سبل العيش. يختار بشكل عشوائي سجينًا لزيارته ويرفع القضية. عادة ما يكون عقلانيًا ومعقولًا، ولكن في أعماق عقله يوجد جانب مظلم. شيء ما يدفعه إلى تجاوز الحدود والدخول إلى عالم الشر. أخوه الأصغر غير الشقيق هو هان بيوم جاي. يعمل هان بيوم جاي في متجر لأجهزة الكمبيوتر المستعملة ويعمل أيضًا كوسيط لقضايا هان دونج سو، حيث يجلب له العملاء. في أحد الأيام، لاحظ هان بيوم جاي أن هان دونغ سو قد تغير منذ أن رفع له قضية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"R"},"background_color":"","current_season_id":17440,"content_control":"NORMAL"}}