عد ذلك ، لن يكون هناك شيء كما كان من قبل.\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"current_season_id":12025,"content_control":"NORMAL"}}