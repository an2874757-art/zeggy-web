"continue_watching_progress":0},{"items":[],"id":36098,"title":"Last Breath","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/9296bcac-aa4d-4cc9-a93c-828ff20fb903.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":800,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime"],"id":800,"type":"MOVIE","title":"Breathless","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/6f5bfec2-d1ba-48c0-bcd9-ca9586d2d758.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/e292e089-d1a0-47af-ba00-e1283bbfcb66.jpg","likes":26,"dislikes":0,"views":2814,"release_date":"-280800000000","length":5425,"description":"Michel Poiccard, an irresponsible sociopath and small-time thief, steals a car and impulsively murders the motorcycle policeman who pursues him. Now wanted by the authorities, he renews his relationship with Patricia Franchini, a hip American girl studying journalism at the Sorbonne, whom he had met in Nice a few weeks earlier. Before leaving Paris, he plans to collect a debt from an underworld acquaintance and expects her to accompany him on his planned getaway to Italy. Even with his face in the local papers and media, Poiccard seems oblivious to the dragnet that is slowly closing around him as he recklessly pursues his love of American movies and libidinous interest in the beautiful American.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"episode_id":800,"content_control":"NORMAL"}}