tion_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":9688,"type":"MOVIE","title":"Laggies","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/9ed60182-a466-4e99-8c63-3ad5653c0e23.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/c3dd370f-2bf6-4381-aef3-59ccbbae8ea9.jpg","likes":47,"dislikes":3,"views":8720,"release_date":"1414108800000","length":5964,"description":"Megan's approaching 30 with a good degree and a boyfriend in hand, but when he proposes at her friend's wedding and everyone seems to think that the best way to advance in her career is to take a seminar where you find out what animal you are, Megan's understandably feeling lost. After meeting teenagers who want her to buy them beer, Megan is drawn into 16-year-old Annika's simpler life. She ends up moving in with Annika and her single father, juggling the life of a teen and that of an adult, two romantic interests, and the feeling of lagging behind.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"R"},"episode_id":9688,"content_control":"FAMILY"}}