n_type":"comments"}],"post_info":{"genres":["Romance"," Drama"," Melodrama"],"id":26218,"type":"SERIES","title":"Eve","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/728bcdf9-1fb8-4ca5-adcd-cd7b606c9951.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/5582f10f-085b-46ca-8b67-194dbf09e1b1.jpeg","likes":361,"dislikes":5,"views":28651,"release_date":"1654041600000","season_number":1,"description":"كانت Lee Ra El فتاة قدّمت والديها المحبين - أب ذكي للغاية وأم جميلة بشكل مذهل. ولكن عندما تتسبب قوى قاسية خارجة عن إرادتهم في وفاة والدها ، تنهار عائلتها. بعد أن شعرت بالمرارة من هذه التجربة المروعة ، تعهدت بالانتقام من فاحشي الثراء الذين دبروا هذه المأساة الرهيبة. هدفها الرئيسي هو Kang Yoon Kyum ، الرئيس التنفيذي لإمبراطورية أعمال LY Group المربحة ، وأحد زعماء المؤامرة التي دمرت عائلتها في النهاية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"PG-13"},"current_season_id":14066,"content_control":"NORMAL"}}