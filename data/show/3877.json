{"items":[],"id":24528,"title":"موسى","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/16bfcd4e-d8ec-4647-a4f9-f0d20fb55cbb.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":6758,"title":"ليلة هنا وسرور","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk42/shows/e41d4352-59fc-4f67-96d7-64845a4c026e.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":1819,"title":"سبع البرمبة","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/e07773bb-e290-42fa-9332-e65452f318b8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":2960,"title":"قلب الاسد","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/140372ee-93bf-48fc-8a60-15444f4ffdc5.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3877,"title":"","description":"28","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":3877,"type":"MOVIE","title":"عاد لينتقم","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk49/shows/267e7e36-5658-4db5-be61-bce23dc48700.jpg","likes":56,"dislikes":1,"views":5075,"release_date":"575510400000","length":6297,"description":"الدكتور هاشم يعانى من أزمة، لأنه فقد ابنته الطفلة فى حادث سيارة، نتيجة إهماله، ينتابه الاحساس بالذنب، لا يدهش حين يسمع أصواتًا غريبة من الفيلا الجديدة التى استأجرها لكى يبتعد عن ذكريات بيته القديم، ويتصور أن روح ابنته تلاحقه. ولكنه يكتشف أن الروح لطفل وليست لطفلة، وأن هذا الطفل يتصل به اتصالا مباشرا من خلال جهاز التسجيل الموجود فى الفيلا، وبذلك يستطيع التحدث إليه وإعطاءه بعض الجمل القصيرة التى تصلح مفاتيح لحل اللغز، وتقوده هذه التفاصيل إلى أحد رجال المجتمع البارزين الذى يتطابق اسمه مع اسم الطفل، ونفهم أن هذا الرجل مزور انتحل اسم الطفل لكى يرث ثروته الكبيرة ومنها ذلك القصر والعزبة التى دفن فيها الطفل. ينكر الرجل فى أول الأمر، لكنه يرسل رجاله إلى الدكتور هاشم لكى يحاولوا تخويفه حتى يبتعد عن هذا الموضوع، لكن الدكتور هاشم يمضى فى خطته مدفوعا بتشجيع صاحبة الفيلا التى استأجرها لأنها تريد أن تعرف سر الأرواح التى تسكن القصر وايضا بسبب الحاح روح الطفل التى تدوام على الاتصال بالطبيب حتى يتم الثأر له، الطبيب يرى وهو فى القصر مشهدا كأنه حلم يسقط فيه رجل الأعمال القاتل صريعا بسبب اختناق غريب، يكتم انفاسه ويجرى الطبيب إلى بيت رجل الأعمال، ليكتشف أن فعلا قد مات.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.4}],"value":4.4,"age":"PG-13"},"episode_id":3877,"content_control":"NORMAL"}}