0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6970,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Animation","Crime"],"id":6970,"type":"MOVIE","title":"Batman: Year One","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/080d5253-9637-4f9e-9004-a531c1cb4802.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/eb21388f-25c1-4236-b04f-e8f97772b436.jpg","likes":98,"dislikes":2,"views":7647,"release_date":"1318896000000","length":3850,"description":"Two men come to Gotham City: Bruce Wayne after years abroad feeding his lifelong obsession for justice and Jim Gordon after being too honest a cop with the wrong people elsewhere. After learning painful lessons about the city's corruption on its streets and police department respectively, this pair learn how to fight back their own way. With that, Gotham's evildoers from top to bottom are terrorized by the mysterious Batman and the equally heroic Gordon is assigned to catch him by comrades who both hate and fear him themselves. In the ensuing manhunt, both find much in common as the seeds of an unexpected friendship are laid with additional friends and rivals helping to start the legend.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":6970,"content_control":"NORMAL"}}