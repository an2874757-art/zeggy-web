tems":[],"id":1619,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Crime"],"id":1619,"type":"MOVIE","title":"The Divine Move","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/9c224ac7-9d7d-45b3-8fb7-184b8d1338cc.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/8ebd9a09-96ea-4ceb-904f-a467b730869e.jpg","likes":60,"dislikes":0,"views":6270,"release_date":"1406246400000","length":7064,"description":"Professional baduk player Tae-seok loses a high-stakes game to infamous underground gambler Sal-soo, and ends up framed for the murder of his own brother and locked up in prison. He vows revenge and trains ferociously. After serving his seven-year sentence, he gets in touch with his brother's former associate \"Tricks,\" hermit and blind master player \"The Lord,\" and skillful junkyard owner Mok-su; together, they begin formulating a plan to get back at Sal-soo and his men. Tae-seok slowly penetrates Sal-soo's inner circle and his gambling joint, and eliminates Sal-soo's men one by one. But Sal-soo discovers Tae-seok's true identity and engages him in one final game that will seal the fates of the two men involved.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":1619,"content_control":"FAMILY"}}