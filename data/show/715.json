ogress":0},{"items":[],"id":10226,"title":"The Avengers","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/88d67035-c070-4881-b4ea-0d3dccfb3fd6.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":715,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","War"],"id":715,"type":"MOVIE","title":"White Tiger","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/182117af-755a-4955-8810-0612c51ff463.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/a7eeb517-5351-4161-9340-b17bf6d9d7ba.jpg","likes":83,"dislikes":1,"views":9603,"release_date":"1336003200000","length":6513,"description":"In WW2, after a tank battle, a wounded Soviet tank driver and mechanic is taken to the hospital. He suffers from amnesia and has severe burns on his body. He secretly believes he can communicate with any tank, as if the tank were human. After being returned to duty, the tank-man proves to be one of the best tank-men in his unit. Rumors about a new, invincible Nazi tank, circulate. It's said that a huge Nazi tank often appears out of nowhere on the battlefield and it destroys dozens of Soviet tanks. The mysterious enemy tank is nicknamed White Tiger by the Soviet soldiers. Our tank-man, Naydenov, is convinced that it was the White Tiger that destroyed his Soviet tank and he wants revenge. Naydenov is ordered to find and destroy the White Tiger. But how can one find and destroy a ghost of war?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"episode_id":715,"content_control":"FAMILY"}}