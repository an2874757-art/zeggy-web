gth":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":38774,"title":"","description":"12","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Political"],"id":38774,"type":"SERIES","title":"Love and Crown","logo":"https://cloud02.albox.co/shows/3ba6fb12-dcff-47f8-8f27-98bb3794320e.jpg","image":"https://cloud02.albox.co/seasons/1d3e6bf2-7fd9-4568-9246-f4fcea5c2411.jpg","background_image":"https://cloud02.albox.co/seasons/bbd286b2-792a-45b9-9e1b-e1995c419962.jpg","likes":93,"dislikes":3,"views":12316,"release_date":"1763078400000","season_number":1,"description":"لينغ كانغ كانغ، فنان قتال ماهر ومؤسس جناح فنغلاي، يُناضل من أجل العدالة في عالمٍ يُعاني من فساد المسؤولين وقوات جيانغهو. شياو هوان، الإمبراطور الشاب من سلالة نانكي، يتبنى سرًا اسم \"باي تشي فان\" للسفر ومساعدة الشعب. ينضم إلى لينغ كانغ كانغ لمواجهة الفساد والفوضى، غير مدرك أنها ابنة رئيس الوزراء ومُقدّر لها أن تكون ملكته. معًا، يُناضلان من أجل العدالة، ويُخففان معاناة الشعب، ويُعيدان السلام، مُكتشفين في خضم ذلك هدفهما الحقيقي: خدمة الشعب وحمايته.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"NC-17"},"background_color":"#e3ac4c","current_season_id":22554,"content_control":"NORMAL"}}