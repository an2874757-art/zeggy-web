ormalPoster"},{"data":[{"items":[],"id":42747,"title":"","description":"24","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"],"id":42747,"type":"SERIES","title":"Yowaki Max ","logo":"","image":"https://cloud02.albox.co/shows/46896952-58f7-4635-ab33-0bde1eebb9fc.jpg","background_image":"https://cloud02.albox.co/shows/8b3b343d-162b-48d4-89b3-05ee8e5c7cdc.jpg","likes":116,"dislikes":5,"views":11225,"release_date":"1791072000000","season_number":1,"description":"بعد إصابتها بحمى شديدة في سن العاشرة، تذكرت بيا روكويل فجأة حياتها السابقة كطالبة جامعية في اليابان. لكن بعيدًا عن أن تصبح شريرة، كل ما تريده هذه الفتاة الخجولة هو أن تستخدم أخيرًا معرفتها التي اكتسبتها خلال دراستها العليا للحصول على شهادة الدكتوراه في علم الأحياء القديمة. هدفها الأسمى هو أن تصبح شخصًا عاديًا، وتنقب عن الأحافير، وتبني متحفًا، ثم تصبح أمينة متحف.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"NC-17"},"background_color":"","current_season_id":25001,"content_control":"NORMAL"}}