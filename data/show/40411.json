th":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":40411,"title":"","description":"129","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":40411,"type":"SERIES","title":"اخي مدبلج","logo":"","image":"https://cloud02.albox.co/seasons/e052a781-f77f-4603-9a52-e9a7dea6768a.jpg","background_image":"https://cloud02.albox.co/seasons/afb72936-8855-4252-9760-8ea1f5e753fb.jpg","likes":1694,"dislikes":88,"views":518542,"release_date":"1768262400000","season_number":1,"description":"دوغان جراح ناجح في إزمير. عندما كان صغيرا، تسبب حادثة صادمة مع والده، طاهر هانجي أوغلو، في انفصاله عن عائلته. الآن مكرس لإنقاذ الأرواح، لا علاقة له تقريبا بعائلته سوى أخته الصغرى ملك. وبإصرار من ملك، يعود دوغان إلى إسطنبول لحضور زفاف أخته غولوسان. عودته تعيد صدمات دفنت منذ زمن طويل وجرائم خفية. يلتقي دوغان بكاغلا، المحامي القوي والمصمم. ماضيهم المؤلم يخلق ارتباطا عميقا. عدو العائلة، بهرام، يراقب من الظلال، منتظرا اللحظة المناسبة لمواجهة الماضي. محاولة قتل في ليلة الزفاف تغير كل شيء. تظهر أسرار قديمة ويظهر أفراد من عائلته بين المشتبه بهم. يجب على دوغان أن يتخذ قرارا: إما أن يغادر ويعود إلى حياته القديمة، أو يبقى ويواجه الحقيقة من خلال كشف الأسرار في قلب عائلته.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-14"},"background_color":"","current_season_id":23565,"content_control":"NORMAL"}}