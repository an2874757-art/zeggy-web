ection_type":"normalPoster"},{"data":[{"items":[],"id":16338,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["School","Slice of Life","Game"],"id":16338,"type":"SERIES","title":"Saki","logo":"","image":"https://cdn6.albox.co/storage/disk56/seasons/6e5e657c-42dc-47ed-ae87-a98a26773468.jpg","background_image":"https://cdn6.albox.co/storage/disk54/seasons/206ddff6-5bcb-4345-bbc2-8f92225ccbd3.jpg","likes":22,"dislikes":0,"views":2561,"release_date":"1238976000000","season_number":1,"description":"Saki Miyanaga is a high school freshman who doesn't like mahjong. Ever since she was a child, she would lose her New Year's gift money during her family mahjong game. If she won, her parents would be upset, and if she lost, well, she lost. As a result, she's learned to play in such a way that her score differential always remains ±0: not good enough to win, but not bad enough to lose. When we meet her, she's being dragged to her school's mahjong club by an old friend. How will a girl who hates mahjong, yet has become adept at the game as a result of her upbringing, survive in this environment?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG-13"},"current_season_id":3954,"content_control":"NORMAL"}}