lmetal Alchemist: Brotherhood","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/c9bef33f-ec86-41b8-a2b6-795d845a72cf.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":20238,"title":"","description":"22","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy","Animation"],"id":20238,"type":"SERIES","title":"Shingeki no Bahamut ","logo":"","image":"https://cdn6.albox.co/storage/disk54/seasons/30ea79ef-a5b9-47c2-9f1d-2b438e57ed92.jpg","background_image":"https://cdn6.albox.co/storage/disk55/seasons/84513739-7623-4947-9589-6dfa2fe342e3.jpg","likes":308,"dislikes":5,"views":27138,"release_date":"1491609600000","season_number":1,"description":"Mistarcia is a magical world where humans, gods, and demons mingle together. In the past, the black-and-silver winged Bahamut has threatened to destroy the land, but humans, gods, and demons overcame their differences to fight together and seal its power. The key to that seal was split in two, one half given to the gods and the other to demons, so that they would never be united and Bahamut never released. Now, two thousand years later, the world is in an era of peace - until the day a woman steals the gods' half of the key.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"N/A"},"current_season_id":9155,"content_control":"NORMAL"}}