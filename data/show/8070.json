ن بسميحة ويتفقان على الزواج رغم تحذير حسن له، يتعرف كرم بحسن ويبوح له بحقيقة سميحة فيواجهها فلا تنكر وتنهار وتصاب بالجنون.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":8070,"background_color":"","content_control":"NORMAL"}}