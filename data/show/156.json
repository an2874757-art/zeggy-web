mage":"https://cdn6.albox.co/storage/disk57/shows/e3a9c67e-ebbf-41c1-90e0-3f0d1a74ff36.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":156,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Romance","Comedy","Animation","Family"],"id":156,"type":"MOVIE","title":"Alpha and Omega","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/e23f2c33-ddae-4a64-9fc4-e5727f0ae9d6.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/6fb0bbd3-d2d4-4e9e-b256-e72ccea1ed7b.jpg","likes":109,"dislikes":1,"views":7563,"release_date":"1284681600000","length":5276,"description":"In Jasper National Park, the wolves, Kate and Humphrey, have known each other since puppyhood, but they are on the oppose ends of the Western Pack's social structure with Kate as the energetic Alpha daughter of the pack leader and Humphrey being the good humoured Omega. That social structure forces Kate to accept an arranged marriage with Garth of the Eastern Pack to unite the packs for peace, regardless of Humphrey's hopeless attraction for her. Before that union can occur, Kate and Humphrey are captured by the park's rangers and sent to an Idaho park as part of a wolf repopulation project. Mindful of her duties, Kate is determined to return to Jasper and Humphrey offers to help with the assistance of two odd geese. However, as this disparate pair struggle through the dangers to get home, a growing mutual appreciation of their talents and then a deeper love threatens to disastrously complicate everything if they make it back.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.2}],"value":5.2,"age":"PG"},"episode_id":156,"conten