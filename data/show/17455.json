ormalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/ba8c026e-d2c6-44b3-b782-c4c59dae1443.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17455,"title":"","description":"18","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":17455,"type":"SERIES","title":"أحلام مراهقتين","logo":"","image":"https://cdn6.albox.co/storage/disk57/seasons/08e708e2-f4fc-4fe6-ae61-929748ec1b93.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/801eb2a2-6863-4236-b797-86d8c25b0be0.jpg","likes":446,"dislikes":19,"views":111555,"release_date":"-2208988800000","season_number":1,"description":"يدور المسلسل حول بنتين هما ارشنا ( نجاح ) وبنت عمها جونجان وهم فى سن الـ 16 سنة ، ارشنا هى فتاة بسيطة ، تقرر جونجان ان تاتى الى مومباى لكى تعيش مع عائلة ارشنا بعد وفاة والدتها ، مايانك هو يكون ابن عمة ارشنا ويعود بعد الانتهاء من دراسته ويلتقى بجونجان ولكنهم دائما كانوا يتشاجرو وفى وقت لاحق يقرر زواجه من شارو ابن خالته ولكنه ببطئ يشعر بمشاعره اتجاه جونجان ، وبعد مرور الوقت بعد ان اعترف لها بحبه تعترف هى ايضا ، اما عن ارشنا فهى كانت تحب شخص اسمه راجيف وكان مدرب الهوكى ولكن راجيف ليس لديه اى مشاعر تجاهها ثم يحاول كابير مساعدتها بعد ان يشعر بخيبة الامل نحوها تجاه راجيف ومع الوقت ارشنا يكون لديها المشاعر ايضا ولكن تجاه كابير ويبين ان كابير يكون شقيق راجيف ولكن دون علم ارشنا وارشنا سعيدة بمجرد كونها مع كابير .وفى يوم من الايام رأي جونجان وكابير معا جالسين فى مقهي ليلي ولكن ساء فهم مايانك جونجان تحاول بجميع الطرق انتفهمه ولكنه رفض وفى النهاية يقرر مايانك ان يتزوج شارو ووافق على الزواج وكسر قلب جونجان ، ووالدة مايانك هى امراة انانية وكانت تريد ان تتخلص من جونجان وقد فعلت بينهم سوء تفاهم كبير وفى النهاية يتزووج مايانك شارو وجونجان تتالم وحزينة وفى نظر مايانك ان جونجان فتاة سيئة وانانية","rating":{"sources":[],"value":0,"age":"TV-14"},"current_season_id":5504,"content_control":"NORMAL"}}