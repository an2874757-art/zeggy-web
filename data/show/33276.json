الفضاء. الآن يواجه العزلة والكراهية من أولئك الذين ساعد في تدمير كواكبهم، والتهديد الدائم من جالاكتوس، يتجول سيلفر سيرفر عبر الفضاء بحثًا عن منزله ومساعدة أولئك الذين يقابلهم على طول الطريق.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"#79bed3","current_season_id":18748,"content_control":"NORMAL"}}