d","section_type":"normalPoster"},{"data":[{"items":[],"id":35680,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":35680,"type":"SERIES","title":"Watashi wa Seikei Bijin","logo":"","image":"https://cloud02.albox.co/seasons/0e40ee71-6dec-46cb-8afd-c31677dd3bba.jpg","background_image":"https://cloud02.albox.co/seasons/59fa1d60-0bd1-4347-95c4-2ff63d25bc08.jpg","likes":68,"dislikes":1,"views":8294,"release_date":"1736985600000","season_number":1,"description":"تتعرض كاتاجيري ميري للتنمر باستمرار بسبب مظهرها. تقرر اغتنام الفرصة لإجراء جراحة تجميلية والحصول على وجه جميل قبل دخول الكلية. أثناء التوجيه المدرسي، تتلقى ميري العديد من المجاملات على مظهرها من زملائها في الفصل، وبينما هي مرتبكة، فهي مسرورة سراً. ومع ذلك، فإن فرحتها قصيرة الأمد عندما يؤدي حادث إلى اكتشاف الجميع أنها أجرت جراحة تجميلية. في نفس الوقت، تلتقي ميري بساكاجوتشي كي، زميلها الوسيم من مدرستها الإعدادية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"background_color":"","current_season_id":20324,"content_control":"NORMAL"}}