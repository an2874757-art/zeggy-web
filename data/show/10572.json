ype":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/fba5f13f-990e-4fa0-8e6e-99555a0d7876.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":37663,"title":"F1: The Movie","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/e63c4124-897c-4b62-9c20-4566ab50f93c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":3705,"title":"After","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk55/shows/16a00b59-7355-4cfe-9875-5c851ffef26c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10584,"title":"The Lord of the Rings: The Return of the King","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/9fdaf2f4-cb42-41e5-acda-a6d593b47e90.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":40600,"title":"Thrash","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/47f4a1a0-3a3f-449c-8944-8d1cf8325f17.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":39751,"title":"The Housemaid","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/21b0ba56-210b-4a04-867e-40aa89c2f677.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10572,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Crime"],"id":10572,"type":"MOVIE","title":"Sin City: A Dame to Kill For","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/6cbf44da-d7b9-44fa-91a9-41a87959acf0.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/8efd1a3d-5e38-4b88-a3ab-1e59686a2dc2.jpg","likes":30,"dislikes":0,"views":3165,"release_date":"1408665600000","length":6128,"description":"Marv is unconscious on a highway surrounded by corpses. When he awakes, he has amnesia and tries to recall his last steps from the Kadie's saloon on the Saturday night. He recalls that he found four playboys burning a homeless man alive and defended the poor man. Marv hunts them down and kills the group. The cocky gambler Johnny hits jackpot in slot machines in the Kadie's saloon and invites the waitress Marcie to go with him to play poker game against the powerful Senator Roark. He wins the game and suffers the consequence of his arrogance. The private detective Dwight McCarthy is contacted by his former lover Ava Lord that asks to meet him at the Kadie's saloon. Ava asks him for forgiveness for leaving him to marry the wealthy Damian Lord. However her strong chauffeur Manute takes her home. Dwight snoops around Ava's house but is found and beaten by Manute and the bodyguards. When he returns home, Ava is waiting for him naked in the bed and seduces him again. Then she tells that Damian and Manute torture her and soon she will be killed. Once again Manute takes Ava with him and hits Dwight that invites Marv to help him to rescue Ava. Damian denies the accusation but Dwight beats him to death while Marv tear Manute's eye out. But soon Dwight finds that he was lured by Ava that shoots him. Marv rescues Dwight and takes him to the Old Town where Dwight finds his former lover Gail that helps him to recover while Dwight plots revenge against Ava.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"episode_id":10572,"content_control":"FAMILY"}}