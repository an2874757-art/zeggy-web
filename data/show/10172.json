8b3b88a5e.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10172,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy"],"id":10172,"type":"MOVIE","title":"The Mummy: Tomb of the Dragon Emperor","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/fcf660a6-06aa-4967-a59a-b967583e2cf1.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/f5073147-9b69-4729-98c2-1a163496775f.jpg","likes":145,"dislikes":5,"views":15099,"release_date":"1217548800000","length":6700,"description":"Centuries ago, the evil Emperor Han was cursed by the sorceress Zi Yuan who transformed him and his army into mummies. In 1946, the explorer Rick O'Connell and his wife Evelyn O'Connell are invited by the British government to take a relic, the diamond \"The Eye of Shangri-La\" to China. The ancient stone is capable of resurrecting the Emperor Han and of pointing the way to Shangri-La and the eternal pool of life. When the couple reaches China, they meet their son Alex O'Connell, who has discovered the tomb of Han, and Evelyn's brother Jonathan Carnahan. The O'Connells are betrayed by their friend Prof. Roger Wilson, who is associated with General Yang. Yang wants to serve Emperor Han, so he resurrects the mummy and they head for Shangri-La. The guardian of Han's tomb (and Zi's daughter) Lin tells them that the only ways to destroy Han are to prevent him from reaching Shangri-La or by stabbing his heart with a cursed dagger.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.2}],"value":5.2,"age":"PG-13"},"episode_id":10172,"content_control":"NORMAL"}}