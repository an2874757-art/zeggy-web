اته المشبوهة، ولكن بعدما يُظلم أحد الأبرياء بالجمرك نتيجة فساد حسونة، ثم يموت كمدا، يستيقظ ضميره، ويسلم نفسه، ويبلغ عن شاهين وبقية شركاءه من الفاسدين ليطهر نفسه، ويرد اعتبار زميله المتوفى.\r\n\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"episode_id":896107,"background_color":"","content_control":"FAMILY"}}