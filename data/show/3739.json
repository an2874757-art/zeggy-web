s":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3739,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Thriller"],"id":3739,"type":"MOVIE","title":"Broken Embraces","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/6aed03fc-ea68-44c4-8aec-76bba412355f.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/36679d2b-38a7-4dad-877f-dd7683a0e30a.jpg","likes":20,"dislikes":1,"views":4705,"release_date":"1263513600000","length":7634,"description":"Passion, obsession, wealth, jealousy, family, guilt, and creativity. In Madrid, Harry Caine is a blind screenwriter, assisted by Judit and her son Diego. The past comes rushing in when Harry learns of the death of Ernesto Martel, a wealthy businessman, and Ernesto's son pays Harry a visit. In a series of flashbacks to the 1990s, we see Harry, who was then Mateo Blanco, a director; he falls in love with Ernesto's mistress, Lena, and casts her in a film, which Ernesto finances. Ernesto is jealous and obsessive, sending his son to film the making of the movie, to follow Lena and Mateo, and to give him the daily footage. Judit doesn't like Lena. It's a collision course.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":3739,"content_control":"NORMAL"}}