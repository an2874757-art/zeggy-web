dn8.albox.co/storage/CLOUD00/shows/dc60d377-5642-4937-b440-612607b992fe.png","image":"https://cdn8.albox.co/storage/CLOUD00/shows/5a3c03ad-b28a-416e-9ede-4c70ab724109.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/shows/25846f5d-1d96-4080-8617-234de59b790e.jpg","likes":68,"dislikes":0,"views":2809,"release_date":"1317427200000","length":5976,"description":"كانت الحرب بين إمبراطورية Levamme و Amatsukami Imperium مستعرة منذ سنوات. في خضم هذا الصراع ، يعلن أمير إمبراطورية ليفام حبه لخوانا ديل مورال ويتعهد بإنهاء الحرب في غضون عام واحد ، كجزء من عرض زواجه. عندما اصطدمت عائلة أماتسوكامي بالرياح ، هاجموا منزل ديل مورال ، مستهدفين حياة جوانا. كمحاولة أخيرة لجلب الأمير عروسه ، استأجرت القوات الجوية في سان مالتيليا مرتزقًا من الدم المختلط - بيستادو - للطيران خوانا إلى عاصمة ليفامي سراً. يقبل الطيار ، تشارلز ، المهمة ... لكن عبور المحيط وحده ، إلى أراضي العدو ، يثبت أنه محنة أكثر خطورة بكثير مما كان يمكن لأي شخص أن يتوقعه.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"PG-13"},"episode_id":497876,"content_control":"NORMAL"}}