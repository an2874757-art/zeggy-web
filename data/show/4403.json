tems":[],"id":7784,"title":"Don 2","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk45/shows/c515d21a-7559-4820-8f92-9c50c90c5ad9.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38648,"title":"Kantara: Chapter 1","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/a3137aee-5320-4420-a8fd-21fb32910d7d.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35683,"title":"Baby John","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/4ef0df79-d31d-4acd-93fe-87ec484be285.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4403,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Music"],"id":4403,"type":"MOVIE","title":"Saawariya","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/b17a3da9-d2c5-4493-b043-9f63d8c16337.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/31ca6046-a010-4d9a-9769-d05d523656ad.jpg","likes":18,"dislikes":1,"views":3908,"release_date":"1194566400000","length":8267,"description":"Orphaned and homeless Ranbir Raj re-locates to a small town and orders a glass of milk in the RK Bar. He befriends a prostitute by the name of Gulabji, who invites him to spend the night with her, and when he refuses, she re-directs him to Lillian who rents out rooms. Ranbir meets with Lillian, who has been living alone for 37 years after her son, Vincent, left to join the army and did not return, charms her, and rents a room from her. He gets a job as a singer in a local restaurant. On the occasion of Eid, while returning home, he comes across a woman standing on the bridge. He finds her very attractive, befriends her, walks her home, finds out her name is Sakina, who is a carpet weaver and lives with her aunt and blind grandma. Just when Ranbir is about to confess his love, she tells him that she has already given her heart to Imaan, a former tenant of her grandmother's. Imaan had left, promising to return on Eid, but has not done so. She finds out that he may be staying at the Momim Lodge and asks Ranbir to deliver a letter to him. A crestfallen Ranbir destroys the letter, but does go to Momim Lodge, and this is where he finds that no one by the name of Imaan had ever lived there. Encouraged by this news, he returns back and attempts to win Sakina's heart. The question remains will he succeed or will Sakina spend the rest of her life waiting for Imaan's return?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.4}],"value":5.4,"age":"PG-13"},"episode_id":4403,"background_color":"","content_control":"NORMAL"}}