s/08b53b9f-b4dd-4b60-810e-8aed122f8605.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":14842,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Mystery","Horror"],"id":14842,"type":"SERIES","title":"The Returned","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/ff7470d9-927c-4126-a049-47080b9f4b3c.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/e0361992-4084-4808-bfb4-f3b5bd27ee6b.jpg","likes":40,"dislikes":2,"views":9387,"release_date":"1383177600000","season_number":1,"description":"The Returned opens in a small mountain community which is rocked to its core when several local people who are presumed dead suddenly re-appear at their homes. Despite having passed away some years earlier, these ghostly characters appear in human form, they have not aged, and they are completely unaware of their own fatality. Determined to reclaim their lives and start over, they slowly come to realize that they are not the only ones to have been brought back from the dead. Their return augers torment for their community when a gruesome murder attempt bears a chilling resemblance to the work of a serial killer from the past. This is a homecoming like no other.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"R"},"current_season_id":1866,"content_control":"NORMAL"}}