"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Family","Life","Suspense"],"id":14231,"type":"SERIES","title":"The Penthouse: War in Life","logo":"","image":"https://cdn6.albox.co/storage/disk58/seasons/10e9b261-c12e-4ed0-b471-55d2388732ad.jpg","background_image":"https://cdn6.albox.co/storage/disk57/seasons/5aea6376-03ec-4a0f-8012-7323f0930a1f.jpg","likes":1659,"dislikes":53,"views":221699,"release_date":"1603670400000","season_number":1,"description":"The residents of Hera Palace, a luxury penthouse apartment with 100 floors, have many secrets and hidden ambitions. Sim Su Ryeon, who was born into wealth, is the queen of the penthouse apartment. Cheon Seo Jin, the prima donna of the residence, does all she can to give everything to her daughter. Oh Yoon Hee comes from a poor family background, but she strives to enter high society by becoming the queen of the penthouse, the pinnacle of success in her eyes. A battle for wealth, power, and prestige at Seoul’s most coveted penthouse begins.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"PG-13"},"current_season_id":991,"content_control":"NORMAL"}}