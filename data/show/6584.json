ype":"normalPoster"},{"data":[{"items":[],"id":6584,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Animation"],"id":6584,"type":"MOVIE","title":"Green Lantern: Emerald Knights","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/47634f28-52de-4ec9-84ad-b4fd37d50cff.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/06eccb84-595c-4ecc-bb56-5f08d49628ad.jpg","likes":70,"dislikes":1,"views":13116,"release_date":"1307404800000","length":5021,"description":"On Oa, the headquarters planet of the intergalactic police force, the Green Lantern Corps, the Guardians of the Universe see alarming evidence that the feared villain, Krona, is coming to destroy the planet. While the Guardians move to evacuate, Green Lantern Hal Jordan helps the unsure new recruit, Arisia, by telling her several stories of fellow Lanterns and the challenges they faced. Through him, we see the adventures of Avra the first Lantern, Princess Laira, Kilowog, the unsociable Mogo and Jordan's immediate predecessor, Abin Sur. When Krona arrives, those stories prove more valuable than anyone expects as Arisia draws a special inspiration from them.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG"},"episode_id":6584,"content_control":"NORMAL"}}