:10344,"title":"","description":"29","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Drama"],"id":10344,"type":"MOVIE","title":"King Arthur: Legend of the Sword","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/22b54f8a-7bd1-44aa-88c6-d7b5b93de22c.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/531424b3-150a-4df4-98f8-025c366b8efc.jpg","likes":572,"dislikes":11,"views":35880,"release_date":"1494547200000","length":7574,"description":"تدور أحداث الفيلم حول القصة الكلاسيكية للسير (لانسلوت)، أحد فرسان المائدة المستديرة وأهم أتباع الملك (آرثر) المخلصين، والذي يقع في غرام الملكة (جوينيفير)، مما يهدد المملكة بالانهيار، حيث يعود الفيلم من جديد لقصة الملك آرثر حينما كان في ريعان الشباب، والذي نجح في الحصول على سيف إكساليبور القوي الذي كان مغروسًا في قلب صخرة صلدة، وعليه أن يحكم سيطرته على سيفه وأن يوحد الشعب تحت راية واحدة من أجل هزيمة (فورتيجرين) المستبد الذي قتل والديه واستولى على عرشه في السابق.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"episode_id":10344,"content_control":"FAMILY"}}