ress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":27728,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"," Comedy"," Sci-Fi"],"id":27728,"type":"SERIES","title":"Urusei Yatsura","logo":"","image":"https://cloud01.albox.co/seasons/3e9470a1-3c5e-4afa-9b24-9ecc24f67d30.jpg","background_image":"https://cloud01.albox.co/seasons/30866ab0-5cc2-47b3-abd1-16489dd801c7.jpg","likes":75,"dislikes":9,"views":12234,"release_date":"1665705600000","season_number":1,"description":"لا يلاحظ الكثير عن أتارو موروبوشي الفاسد ، لكن حظه السيئ غير العادي يبرز مثل الأبواق في رأس كائن فضائي. عندما تتعرض الأرض للتهديد من قبل أسطول من الغزاة الفضائيين المعروف باسم أوني ، يتم اختيار أتارو لتمثيل البشرية في مبارزة ضد أحدهم. إنها ضربة حظ نادرة لـ Ataru أن المبارزة هي في الواقع لعبة علامة ، وأن خصمه هو Lum ، ابنة زعيم Oni ، الذي يضع كرامتها الشخصية فوق النصر - كما اكتشف Ataru بالاستيلاء على قمة Lum البيكيني ومعها النصر.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"background_color":"","current_season_id":15273,"content_control":"NORMAL"}}