ذا ابنة خالته عالية (رحاب الجمل). يحاول البلطجي عبده (محمد رمضان) أن يستغل ذلك في بدء الأمر حتى يقرر أن يغير محور حياته نهائيا، ولكن لكل شر نهاية حتمية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"N/A"},"episode_id":8459,"content_control":"NORMAL"}}