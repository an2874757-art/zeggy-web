mments"}],"post_info":{"genres":["Thriller","Mystery"],"id":24240,"type":"SERIES","title":"Chimera","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/2c3a9518-93d3-44d5-bd1d-3ce34b82196c.jpeg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/98c18a6c-07f0-4e89-9d15-8ae46f301219.jpg","likes":175,"dislikes":1,"views":9987,"release_date":"1635552000000","season_number":1,"description":"تقع حادثة Chimera ، وهي جريمة قتل متسلسلة وجريمة انفجار هزت عام 1984 ، تمامًا بعد خمسة وثلاثين عامًا في عام 2019. تمامًا مثل الانفجار الرهيب في الماضي ، يُطلق على جريمة القتل اسم Chimera ، وحش في أسطورة يونانية برأس أسد ، والجسد مثل عنزة ، والذيل كالثعبان الذي يطلق النار في حلقه. تتبع القصة محققًا في جرائم عنف يُدعى جاي هوان ، ومحلل جنائي يُدعى يو جين ، وجراح يُدعى جونغ يوب ، أثناء تعقبهم للمجرم وكشف الأسرار بين القضيتين.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"background_color":"","current_season_id":12625,"content_control":"NORMAL"}}