s/5ce243b3-b031-483f-93e6-8d61cd8d778b.jpg","background_image":"https://cloud02.albox.co/seasons/99bfc129-bf12-4723-960b-772eedb771b2.jpg","likes":13,"dislikes":5,"views":4703,"release_date":"1617148800000","season_number":1,"description":"تشجع عائلته وبيئته دوغو على إنهاء قسم الهندسة الذي يدرسه منذ 7 سنوات، والحصول على مهنة مع تأمين يقبلها الجميع، والذهاب إلى العمل من الساعة 9 صباحًا حتى 6 مساءً، والعثور على زوجة مناسبة وإنجاب أطفال. في أقرب وقت ممكن. ومع ذلك، فإن Doğu، الذي يعيش حياة عادية للغاية، يريد فقط أن يصبح ممثلًا كوميديًا. هذه هي القصة المأساوية لـ Doğu، الذي يحاول إعادة حياته إلى المسار الصحيح وتحقيق حلم طفولته في أن يصبح ممثلًا كوميديًا، على الرغم من برنامج هندسة الكمبيوتر الذي حصل عليه والذي لم يتخرج منه أبدًا، ووالديه الذين يقولون 'لن تتمكن من ذلك' 'أن تكون جيم يلماز'، أخته الكبرى، التي تسحق Doğu باستمرار بإنجازاتها، وصديقه المتشائم أوزغور، الذي حلمه الوحيد هو شراء سيارة BMW، وعلاقاته العاطفية الفاشلة، وأقرانه، وجميعهم لديهم وظائف وعائلات منتظمة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"TV-PG"},"background_color":"#000","current_season_id":19275,"content_control":"NORMAL"}}