4dda-94a0-59a68ce54287.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7953,"title":"","description":"202","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":7953,"type":"MOVIE","title":"Detachment","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/ab923622-c152-4e80-8cd8-382d23c321fb.png","background_image":"https://cdn6.albox.co/storage/disk49/shows/4039dd81-4738-4245-af04-d28e4d076abc.png","likes":1543,"dislikes":33,"views":52233,"release_date":"1328054400000","length":5866,"description":"Detachment is a chronicle of three weeks in the lives of several high school teachers, administrators and students through the eyes of a substitute teacher named Henry Barthes. Henry roams from school to school, imparting modes of knowledge, but never staying long enough to form any semblance of sentient attachment. A perfect profession for one seeking to hide out in the open. One day Henry arrives at his next assignment. Upon his entry into this particular school, a secret world of emotion is awakened within him by three women. A girl named Meredith in his first period. A fellow teacher Ms. Madison, and a street hooker named Erica, whom Henry has personally granted brief shelter from the streets. Each one of these women, like Henry, are in a life and death struggle to find beauty in a seemingly vicious and loveless world.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"r"},"episode_id":7953,"content_control":"NORMAL"}}