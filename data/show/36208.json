,"url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Supernatural"," Comedy"],"id":36208,"type":"SERIES","title":"Witch Watch ","logo":"","image":"https://cloud02.albox.co/seasons/3f9f4145-e9fb-4e6f-aaf2-4660eaac3a46.jpg","background_image":"https://cloud02.albox.co/seasons/ed5a8484-d53d-47f5-bb66-1cb9dc5d9aac.jpg","likes":535,"dislikes":26,"views":71833,"release_date":"1743984000000","season_number":1,"description":"أنهت نيكو واكاتسوكي تدريبها على السحر لمدة ست سنوات، وهي الآن تعود إلى المدينة بمفردها. وبصفتها ساحرة جديدة، عليها اختيار رفيقة لمرافقتها. ومع ذلك، وخلافًا للساحرات الأخريات، ترغب في اختيار رفيقة غير حيوانية. لا يوجد رفيق أفضل من موريهيتو \"موي\" أوتوجي، صديق طفولتها الذي صادف أنه غول. يعارض موريهيتو بشدة أن يكون خادمها، لكنه يقبل مصيره على مضض بعد أن علم أن لعنة ستحوله إلى هجين غريب بين البقرة والنمر إذا عصى أمر الساحرة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG-13"},"background_color":"","current_season_id":20805,"content_control":"NORMAL"}}