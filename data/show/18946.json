e Sylvester from sabotaging the choir.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"pg-13"},"current_season_id":7379,"content_control":"NORMAL"}}