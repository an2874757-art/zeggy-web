,"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10473,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi","Thriller","Mystery"],"id":10473,"type":"MOVIE","title":"Twelve Monkeys","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/76988ea6-06eb-4898-a69d-0df6130d7d0f.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/d7088fa0-24d4-42e8-aec2-67f3e19b3500.jpg","likes":90,"dislikes":5,"views":7919,"release_date":"820800000000","length":7771,"description":"An unknown and lethal virus has wiped out five billion people in 1996. Only 1% of the population has survived by the year 2035, and is forced to live underground. A convict (James Cole) reluctantly volunteers to be sent back in time to 1996 to gather information about the origin of the epidemic (who he's told was spread by a mysterious \"Army of the Twelve Monkeys\") and locate the virus before it mutates so that scientists can study it. Unfortunately Cole is mistakenly sent to 1990, six years earlier than expected, and is arrested and locked up in a mental institution, where he meets Dr. Kathryn Railly, a psychiatrist, and Jeffrey Goines, the insane son of a famous scientist and virus expert.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"R"},"episode_id":10473,"content_control":"NORMAL"}}