ster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/7d4093e3-c761-4f76-b53a-aa8fb21c277e.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3689,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller","Animation","Crime","Mystery","Family"],"id":3689,"type":"MOVIE","title":"Detective Conan Movie 20: The Darkest Nightmare","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/11fce614-893c-4e40-baab-da8e863badaa.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/6cb52e2f-414b-4c49-a8e3-0787298a311b.jpg","likes":237,"dislikes":1,"views":21670,"release_date":"1460764800000","length":6692,"description":"في ليلة مظلمة ، داهم جاسوس الشرطة اليابانية. سيتم أخذ وكالات استخبارات دول مختلفة - مثل MI6 في إنجلترا ، و BND الألمانية ، و CIA الأمريكية - بالإضافة إلى الملفات السرية لمكتب التحقيقات الفيدرالي ، لكن ضباط السلامة العامة بقيادة تورو أمورو يصلون في الوقت المناسب. الجاسوس يسرق سيارة ويهرب. يتم بعد ذلك حبس الجاسوس و Amuro في حرارة شديدة على الطريق السريع ، ومثلما هو على وشك التسبب في حادث بسيارات متعددة ، أصيبت سيارة الجاسوس برصاصة بندقية عميل مكتب التحقيقات الفيدرالي Shuichi Akai وسقطت على الطريق.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG-13"},"episode_id":3689,"background_color":"","content_control":"NORMAL"}}