pe":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/d0cad950-3b6f-4b02-af0f-d362c7b691a3.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":34070,"title":"متاهة الحب","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/4b2c77cc-213b-45c4-8489-6989ae5bed85.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35428,"title":"","description":"34","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Family"],"id":35428,"type":"SERIES","title":"عائلة شاكر باشا مدبلج","logo":"https://cloud02.albox.co/shows/b00a3fa2-4cb0-4ceb-a4df-b1b1292d255c.png","image":"https://cloud02.albox.co/seasons/270e599b-ac5f-4b34-bda7-7ca7804f41f6.jpg","background_image":"https://cloud02.albox.co/seasons/fae2bb20-93c0-4d91-9834-c06fe1930709.jpg","likes":428,"dislikes":33,"views":107160,"release_date":"1734307200000","season_number":1,"description":"تبدأ قصة المسلسل، الذي يحكي حياة عائلة شاكر باشا المليئة بالمكائد والأسرار، الذين عاشوا حياة سابقة لعصرهم، في عام 1912. إن عودة سيفات شاكر كاباغاجلي، الذي جلب بودروم إلى شهرتها الحالية كصياد هاليكارناسوس، إلى منزل عائلته في بويوكادا مع زوجته الإيطالية سوف تغير حياة الجميع بشكل جذري. لن يؤثر هذا التغيير على الفترة التي يحدث فيها فقط؛ كما سيؤدي ذلك إلى ظهور أسماء ناجحة من العائلة، مثل الأميرة فخر النساء زيد، أستاذة الرسم الحديث، وعلي بيرغر، أول فنانة نقش تركية، وفوريا كورال، أول فنانة خزف تركية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-14"},"background_color":"#edb554","current_season_id":21343,"content_control":"NORMAL"}}