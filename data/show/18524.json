"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18524,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Mystery"],"id":18524,"type":"SERIES","title":"انتقام","logo":"","image":"https://cdn6.albox.co/storage/disk44/seasons/87e58e26-7d3f-45cd-b2d3-c86373783afd.jpg","background_image":"https://cdn6.albox.co/storage/disk58/seasons/d51a90a9-d162-449a-938c-6a3aea40b59c.jpg","likes":90,"dislikes":2,"views":53721,"release_date":"1357171200000","season_number":1,"description":"\"Intikam\" is the Turkish version of the ABC TV series \"Revenge\". Yagmur Ozden moves to a yali (Bosphorus mansion) at a rich neighborhood on the shore of the Bosphorus in Istanbul. Her real name is Derin Celik. Her father, Adil was framed for a crime he didn't commit and sent to prison. Derin was sent to an orphanage and believed that her father was guilty. Adil wanted her daughter to learn the truth and kept a diary to be given to her. Derin learned the truth about her father when she was 18. But it was too late. He died in jail as an innocent man. Derin comes to her childhood neighborhood with a different identity to seek revenge against the people who betrayed her father.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"N/A"},"current_season_id":6840,"content_control":"NORMAL"}}