,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2812,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Horror"],"id":2812,"type":"MOVIE","title":"Evil Ed","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/ee20c6d2-aff5-4909-b089-d449f3d42ffd.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/fc2c530e-aca5-49c0-b07e-38a907096824.jpg","likes":10,"dislikes":0,"views":2966,"release_date":"862531200000","length":5930,"description":"Eddie Tor Swenson is a mild-mannered film editor with a wife, child, and a comfortable job editing art and drama films for a major studio. Following the suicide of their editor, heartless studio exec Sam Campbell transfers Ed to his department, the Splatter & Gore Department, to finish what the original editor was doing: editing the highly profitable but extremely violent Loose Limbs series of slashers. Sam allows Ed the use of his secluded country cottage so Ed can go about his work undisturbed, or so he thinks. The seclusion and the constant exposure to the violent nature and content of the films he's editing start to drive Ed insane. What begins as hallucinations leads to Ed's darker, murderous side emerging, and it puts the lives of everyone around him in danger: whether it be the film-buff studio warehouse man, or even Ed's family...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"R"},"episode_id":2812,"content_control":"NORMAL"}}