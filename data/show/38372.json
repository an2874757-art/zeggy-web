yle":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/361658b5-fa25-4c8f-a5ba-98d993824b46.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19784,"title":"The K2","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk47/shows/b9d0987a-843f-4428-b1c1-dd404867d6be.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":38372,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":38372,"type":"SERIES","title":"Rescued the Lost Times","logo":"","image":"https://cloud02.albox.co/seasons/da02c47b-15ec-4180-adc9-ba0fadb3a355.jpg","background_image":"https://cloud02.albox.co/seasons/85d0c2ab-b24a-4236-980c-0159986ebe5e.jpg","likes":11,"dislikes":0,"views":2225,"release_date":"1760054400000","season_number":1,"description":"خلال السنة الرابعة عشرة من حكم إمبراطور تيانباو، اندلعت ثورة آن-شي، مما أجبر الإمبراطور على الفرار غربًا. سيطر الخصي تشن جينغ بيان على تشانغآن. تحمل خريطة \"اليراع الليلي المظلم\" الخاصة به أسرار حياة شخصيات مهمة، مما دفع موجة من الجواسيس إلى استهدافه. في هذه الأثناء، تغامر فنغ ين نيانغ، ابنة عائلة عسكرية، بالدخول إلى تشانغآن، متظاهرة بشخصية طبيبة، ساعيًا إلى فرصة الاستيلاء على خريطة \"اليراع\" لكشف الجاني الحقيقي وراء جريمة قتل عائلة فنغ.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-14"},"background_color":"#000","current_season_id":22279,"content_control":"NORMAL"}}