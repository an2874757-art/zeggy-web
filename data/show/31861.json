","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk55/shows/5d0deec3-bad1-4372-9767-ea3615ba3f35.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16950,"title":"زهرة الثالوث","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/f877e5fe-f866-4a93-87c7-07193200770c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":31861,"title":"","description":"28","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":31861,"type":"SERIES","title":"Kopuk-المتشرد","logo":"","image":"https://cloud01.albox.co/seasons/f9a669bf-1e3f-4417-8b97-2fcd46e42a61.jpg","background_image":"https://cloud01.albox.co/seasons/84cca549-5dbb-4b4c-a197-a6f2c27c8691.jpg","likes":347,"dislikes":14,"views":79632,"release_date":"1706313600000","season_number":1,"description":"يسرق فرحان أموال المسؤولين الفاسدين والمحتالين ومن أصبحوا أثرياء بوسائل غير عادلة ويمد يد العون للشباب الفقراء في حيه ويوفر التعليم والمساعدة لأسرهم. موت غير متوقع سوف يهز حياته كلها. لن يختبره هذا الحدث بمثله العليا فحسب، بل أيضًا بحبه، وسيبحث عن طرق لاجتياز هذا الاختبار. عندما يدرك أنه لا يستطيع محاربة الظلم مثل فرحان وحده، يتبنى هوية أورهان. وهكذا، بينما يتصارع فرحان مع والد مجدي، المرأة التي يحبها ولكن يجب أن يبتعد عنها، تحت ستار المحامي أورهان، يتقاطع طريقه مع إيبيك، وريث العائلة الذي يحاول السيطرة على الحي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"#e21818","current_season_id":17906,"content_control":"FAMILY"}}