"card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime"],"id":10747,"type":"MOVIE","title":"American Hustle","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/c5dbf506-da0e-46a2-8cf7-16c46d82c4f2.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/99482a45-cfaa-447b-b3b3-0f07cb2470e3.jpg","likes":87,"dislikes":2,"views":10315,"release_date":"1387497600000","length":8284,"description":"A fictional film set in the alluring world of one of the most stunning scandals to rock our nation, American Hustle tells the story of brilliant con man Irving Rosenfeld (Christian Bale), who along with his equally cunning and seductive British partner Sydney Prosser (Amy Adams) is forced to work for a wild FBI agent Richie DiMaso (Bradley Cooper). DiMaso pushes them into a world of Jersey powerbrokers and mafia that's as dangerous as it is enchanting. Jeremy Renner is Carmine Polito, the passionate, volatile, New Jersey political operator caught between the con-artists and Feds. Irving's unpredictable wife Rosalyn (Jennifer Lawrence) could be the one to pull the thread that brings the entire world crashing down.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":10747,"content_control":"NORMAL"}}