":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Animation","Science Fiction"],"id":33253,"type":"SERIES","title":"Iron Man","logo":"https://cloud02.albox.co/shows/25ed3a5c-839f-4b5b-95d2-19d0454133fc.png","image":"https://cloud02.albox.co/seasons/97e63888-d96b-47ed-8272-eb2702704fa3.jpg","background_image":"https://cloud02.albox.co/seasons/6d2e6cf0-542c-4417-8285-0e90cf8089df.jpg","likes":41,"dislikes":2,"views":7955,"release_date":"780364800000","season_number":1,"description":"\"Iron Man\"، المعروف أيضًا باسم \"Iron Man: The Animated Series\"، هو مسلسل تلفزيوني رسوم متحركة أمريكي مبني على شخصية البطل الخارق من مارفل كوميكس، آيرون مان. عُرض المسلسل من عام 1994 إلى عام 1996 في التوزيع المتزامن كجزء من \"The Marvel Action Hour\"، الذي يجمع آيرون مان مع مسلسل آخر مبني على خصائص مارفل، فانتاستيك فور، مع عرض حلقة لكل من المسلسلين مدة نصف ساعة متتالية. تم دعم العرض بخط لعب يتضمن العديد من النماذج المختلفة للدروع.\r\n\r\n\r\n\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG"},"background_color":"#9f401e","current_season_id":18730,"content_control":"NORMAL"}}