ال عن الأعشاب، اكتشف طفلًا مهجورًا. معتقدًا أنه لا يستطيع ترك الطفلة، أخذها إلى المنزل وقام بتربيتها حتى اقترب عمره من الأربعين.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-13"},"background_color":"#a79274","current_season_id":17369,"content_control":"NORMAL"}}