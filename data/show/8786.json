omments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Crime","Mystery"],"id":8786,"type":"MOVIE","title":"The Usual Suspects","logo":"","image":"https://cdn6.albox.co/storage/disk41/shows/b0aac9b8-4baa-4ee2-bafe-4c80a6d3a4a4.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/1f032c70-72b0-4f2d-8cc6-646996b6bdee.jpg","likes":690,"dislikes":9,"views":53609,"release_date":"811123200000","length":6364,"description":"Following a truck hijack in New York, five conmen are arrested and brought together for questioning. As none of them are guilty, they plan a revenge operation against the police. The operation goes well, but then the influence of a legendary mastermind criminal called Keyser Söze is felt. It becomes clear that each one of them has wronged Söze at some point and must pay back now. The payback job leaves 27 men dead in a boat explosion, but the real question arises now: Who actually is Keyser Söze?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"R"},"episode_id":8786,"background_color":"","content_control":"FAMILY"}}