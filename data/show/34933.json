o/seasons/c40f4427-2e44-4287-a499-8eed6890257b.jpg","background_image":"https://cloud02.albox.co/seasons/2f31c450-2808-4626-8de3-64da00138300.jpg","likes":31,"dislikes":0,"views":2768,"release_date":"1687910400000","season_number":1,"description":"لين يي تشنغ جاء من خلفية فقيرة وأصبح مراسلًا تلفزيونيًا كما تمنى بعد التخرج. لقد أصبح تدريجيًا وبضمير حي العمود الفقري لفريق شبكة التلفزيون. لديه مبادئ وأسس معينة، وقد شهد قصصًا مختلفة للشباب على طول الطريق. إنه مهذب للغاية ومسؤول ولديه شعور قوي بتقدير الذات. وانج ران، امرأة عالية الذكاء، وباحثة عن الذهب، ولكنها أيضًا من النخبة المهنية التي صنعت نفسها، ولدت في عائلة فقيرة. تحت مظهرها الجميل، فهي جيدة في الاعتماد على الجمال للحصول على الموارد لنفسها ومساعدة أصدقائها على تمزيق \"قناع الرجال\".","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"background_color":"","current_season_id":19797,"content_control":"FAMILY"}}