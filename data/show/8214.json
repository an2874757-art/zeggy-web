enres":["Action","Adventure","Western"],"id":8214,"type":"MOVIE","title":"The Lone Ranger","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/51e62538-0d6f-46af-8262-ebdac4c28cd2.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/70fe0f64-9b7e-475a-9781-e1105f327e61.jpg","likes":138,"dislikes":2,"views":13915,"release_date":"1372809600000","length":8972,"description":"In the 1930s, an elderly Tonto tells a young boy the tale of John Reid, the Lone Ranger. An idealistic lawyer, he rides with his brother and fellow Texas Rangers in pursuit of the notorious Butch Cavendish. Ambushed by the outlaw and left for dead, John Reid is rescued by the renegade Comanche, Tonto, at the insistence of a mysterious white horse and offers to help him to bring Cavendish to justice. Becoming a reluctant masked rider with a seemingly incomprehensible partner, Reid pursues the criminal against all obstacles. However, John and Tonto learn that Cavendish is only part of a far greater injustice and the pair must fight it in an adventure that would make them a legend.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":8214,"content_control":"FAMILY"}}