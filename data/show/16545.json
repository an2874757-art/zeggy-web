ription":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/03264ad8-7a30-4b49-a0a5-4f44e5e9e437.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":30901,"title":"Kusuriya no Hitorigoto","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/6cb50e77-9151-4f73-b912-643a1761aeaa.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":27469,"title":"The Eminence in Shadow","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/d3a59883-2c5c-431d-886c-47d3e357023b.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14359,"title":"Kimi to Boku no Saigo no Senjou Aruiwa Sekai ga Hajimaru Seisen","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/95718224-0919-498d-9996-30f0518adc03.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16545,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Romance","Comedy","Shounen"],"id":16545,"type":"SERIES","title":"Rave Master","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/9711d72f-b5dc-4b40-b487-1ae715d789c2.jpg","background_image":"https://cdn6.albox.co/storage/disk46/seasons/f19728ed-e2fc-449f-8ca3-720062d45b19.jpg","likes":21,"dislikes":0,"views":2792,"release_date":"1002931200000","season_number":1,"description":"Haru Glory is a boy who lives with his sister, Cattleya, in Garage Island. After fishing out a.... thing called Plue, he meets Shiba who entrusted him with Rave Stone or more known as Holy Bring. From there on, he embarks on a quest leaving his sister at Garage Island like his father who went to find Rave 15 years ago. He meets Elie, a girl who loves to gamble but has lost her memory. They met up with Musica at Punk Street. They have to eliminate Demon Card using Rave and is helped by Elie's uncontrollable Ethelion and Musica's ability of controlling silver as a Silver-Claimer. Unfortunately, they had to collect 4 more Raves in order to eliminate the mother of all dark brings, Sinclair. Together, they find out their past including Haru and Musica who both do not know their parents very well. They also find out the connection between Ethelion and Rave.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"current_season_id":4241,"content_control":"NORMAL"}}