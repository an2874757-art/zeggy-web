stament of Sister New Devil","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/1148cb19-7887-40da-91b5-afc0cc02d480.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15868,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Romance","Comedy","Animation"],"id":15868,"type":"SERIES","title":"Midori Days","logo":"","image":"https://cdn6.albox.co/storage/disk50/seasons/a2f2f886-c9db-4ce0-ac4f-99bc3cd683e5.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/2bd1111d-b222-431c-a6f2-3743e23e2e39.jpg","likes":94,"dislikes":0,"views":6005,"release_date":"1080950400000","season_number":1,"description":"\"Midori No Hibi\", also known as \"Midori Days\" is a story about a boy and a girl. Not a normal story, however, but one very entertaining story if anything. Seiji, who was known for his \"Demon Right Hand\" particularly named that for his keen sense of fighting skills and long streak of getting his way by clocking a guy in the face, woke up one morning to find his right hand was now a woman. A girl, rather, and one that loved him so much she had wished so hard to be close to him, she got her wish. Imagine what could transpire if you have a tiny woman for a hand, and you are in high school. That is Midori No Hibi.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"current_season_id":3314,"content_control":"NORMAL"}}