pg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6114,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Comedy","Crime"],"id":6114,"type":"MOVIE","title":"Stand Up Guys","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/f8d2f271-ff55-4556-9825-2405809efcb4.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/44586530-5969-4f5a-b868-dfd9f74bbd8e.jpg","likes":29,"dislikes":0,"views":4252,"release_date":"1359676800000","length":5698,"description":"After 28 years, Val gets out of prison, and his friend Doc picks him up. The local mob boss, Claphands, wants Val dead (Claphands' son died in a robbery and he blames Val) and Doc has until morning to kill him. It's a long night: Val wants to party - they visit a cat house, Val needs Viagra, they break into a pharmacy. After midnight, they pick up Hirsch, their old wheelman, drive the city in a stolen car. They visit the cat house, help a woman in distress, bury a body, and eat at Doc's hangout, a café where the waitress, Alex, is cheerful. The sun rises, Claphands wants Val dead, and Val, who has figured out his fate, is resigned. Is there anything left to take care of?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"episode_id":6114,"content_control":"FAMILY"}}