tching_progress":0},{"items":[],"id":24428,"title":"سيمبا","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/d4b82111-ff68-493d-8a00-a7588c7f9dd8.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":19418,"title":"سالي","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/f43c7da3-12f3-4336-b880-fe743912bd6a.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":24637,"title":"مارتن ميستري‎ ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/32c0e7c3-f328-49cb-b620-87d77e994ee4.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":26482,"title":"","description":"86","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Drama","اكشن"],"id":26482,"type":"SERIES","title":"ون بيس  (مدبلج)","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/846a4d3a-13b9-4f8e-8188-513c961f8fe1.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/568883ac-81fe-44ec-8989-a02e46737bc5.jpg","likes":4461,"dislikes":177,"views":361793,"release_date":"882057600000","season_number":1,"description":"حُوِّلت الفصول إلى رسوم متحركة أصلية للفيديو (أوفا) من إنتاج برودكشن آي جي في 1998، ومُسلسل أنمي من إنتاج توي أنميشن، الَّذي بدأ بثه في اليابان في 1999. مُنذ ذلك الحين، بثُّ المسلسل الَّذي لا يزال مُستمرًا بمجموع 1,018 حلقة. إضافةً لذلك، أصدرت توي أنميشن خمسة عشر فلمًا، أوفا، وخمس حلقات خاصة. وكما قد أنشأت شركات متعددة أنواع كثيرة من السلع مثل بطاقات الورق التِّجارية، وعدد كبير من ألعاب الفيديو. دخلت موسوعة غينيس للأرقام القياسية بـ«أكثر سلسلة قصص مصورة تم نشرها وطباعتها من مؤلف واحد” وذلك بعد أرقام ديسمبر 2014 والَّتي حققت المانغا فيها 320,866,000 نسخة مطبوعة عالميًا. في 2008، صارت ون بيس سلسلة المانغا الأكثر انتشارًا. في 2010، أعلنت شوئيشا أنَّها باعت ما يفوق 260 مليون نسخة مطبوعة من مانغا ون بيس حتَّى ذلك الحد؛ سجل المجلد 61 بعنوان (معركة المارينفورد) رقمًا قياسيًا جديدًا كأعلى سلعة لطبعة أولى من أي كتاب في اليابان بـ3.8 مليون نسخة (الرقم السابق يعود للمجلد 60 بـ3.4 مليون نسخة). المجلد 60 كان أول كتاب يبيع أكثر من مليوني نسخة في أُسبوعه الافتتاحي في تصنيفات كُتُب أوريكون اليابان. ون بيس حاليًا مصنفة كأفضل سلاسل المانغا مبيعًا. بحلول 2013، حصلت السلسلة على أكثر من 345 مليون منشور حول العالم، منها 300 مليون بيعت في اليابان فقط. وفي أبريل 2022 حقَّقت المانغا مبيعات تقدر بـ500 مليون نسخة حول العالم، مما يجعلها أفضل مانغا تحقيقًا للمبيعات في التاريخ.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG-13"},"background_color":"","current_season_id":14240,"content_control":"NORMAL"}}