n_type":"normalPoster"},{"data":[{"items":[],"id":5096,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy"],"id":5096,"type":"MOVIE","title":"St. Vincent","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/09b165c7-1b84-494c-8191-46d79442f1cc.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/c77690bd-e335-4993-88f6-cc1dff05c43a.jpg","likes":58,"dislikes":2,"views":5149,"release_date":"1414108800000","length":6146,"description":"Vincent is an old Vietnam vet whose stubbornly hedonistic ways have left him without money or a future. Things change when his new next-door neighbor's son, Oliver, needs a babysitter and Vince is willing enough for a fee. From that self-serving act, an unexpected friendship forms as Vincent and Oliver find so much of each other's needs through each other. As Vincent mentors Oliver in street survival and other worldly ways, Oliver begins to see more in the old man than just his foibles. When life takes a turn for the worse for Vincent, both them find the best in each other than no one around them suspects.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG-13"},"episode_id":5096,"content_control":"FAMILY"}}