"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7079,"title":"","description":"29","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Comedy","Animation","Family"],"id":7079,"type":"MOVIE","title":"Finding Nemo","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/b59e3ec6-f46d-43a4-b982-648701534721.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/25447270-fc83-46f1-b22a-b5105cdabdf2.jpg","likes":727,"dislikes":19,"views":88184,"release_date":"1054252800000","length":6054,"description":"A clown fish named Marlin lives in the Great Barrier Reef loses his son, Nemo. After he ventures into the open sea, despite his father's constant warnings about many of the ocean's dangers. Nemo is abducted by a boat and netted up and sent to a dentist's office in Sydney. So, while Marlin ventures off to try to retrieve Nemo, Marlin meets a fish named Dory, a blue tang suffering from short-term memory loss. The companions travel a great distance, encountering various dangerous sea creatures such as sharks, anglerfish and jellyfish, in order to rescue Nemo from the dentist's office, which is situated by Sydney Harbor. While the two are doing this, Nemo and the other sea animals in the dentist's fish tank plot a way to return to Sydney Harbor to live their lives free again.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"G"},"episode_id":7079,"content_control":"FAMILY"}}