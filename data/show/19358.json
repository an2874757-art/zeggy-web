اروتو","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/4fd498cc-59ab-42a0-86a7-64e3969876b8.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19358,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Sci-Fi","Animation"],"id":19358,"type":"SERIES","title":"فارس الفضاء","logo":"","image":"https://cdn6.albox.co/storage/disk48/seasons/ad22fe38-1e4b-42ff-b776-6a3eec30c74b.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/819ebcfc-c36b-4977-a187-fabe7c6f62bb.jpg","likes":49,"dislikes":0,"views":7222,"release_date":"279244800000","season_number":1,"description":"Google مكتمل CAPTAIN FUTURE مشاهدة وتحميل  المدة : 24min عدد الحلقات : مكتمل صاحب الموضوع : AnimeKom ولد فارس الفضاء على احد الاقمار الصناعية وكان والداه قد توفيان عندما كان فارس الفضاء طفلا رضيعا والده كان عالما مشهورا وعندما تزوج قرر ان يهاجر الى القمر الصناعي في سبيل ابحاثه مصطحبا معه زوجته وصديق له الذي كان الاخير عالم ومخترع عبقري واسمه الدكتور(Simon Wright) والد فارس الفضاء كان قد صمم اثنان من الرجال الاليين اللذان يتميزان بعقلهما المتطور ولديهما احاسيس وشعور مثل باقي البشر فكانت هذه ثمرة العلم التي قضى فيها حياته على هذا القمر وعندما توفي اوصت والدته قبل ان تلفظ انفاسها الاخيرة للرجلين الاليين ان يعتنوا بابنها بعد وفاتها ولما ماتت نشأ فارس الفضاء في كنف الرجلين الاليين وكانا قد علماه كل شيء من قتال ومبارزة وعلم وغيره من الامور الهامة التي يجب ان يتعلمها حتى غدا رجلا قويا محب لكل الخير وقد قرر ان يكرس حياته كلها في محاربة الاشرار الذين باتوا يهددون المجرة كلها بالتعاون مع الرجلين الاليين ورجل الي طائر الذي يشبه الطبق الطائر الصغير وتحقيق العدالة والخير والامن والسلام للكواكب الاخرى.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"N/A"},"current_season_id":7911,"content_control":"NORMAL"}}