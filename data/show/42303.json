 حياة أربعة شبان، منذ طفولتهم خلال الحرب الكورية، وحتى حياتهم المهنية والعاطفية في مرحلة البلوغ. ويُجسد المسلسل شغف المرأة بالموضة.…","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"NC-17"},"background_color":"","current_season_id":24691,"content_control":"NORMAL"}}