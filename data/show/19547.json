":{"image":"https://cloud01.albox.co/shows/2566e12d-a1c7-40d9-9a9f-de0de9c6db32.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19547,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Game"],"id":19547,"type":"SERIES","title":"Netojuu no Susume","logo":"","image":"https://cdn6.albox.co/storage/disk46/seasons/d5e911eb-a908-4a68-8504-d8cd28cb280b.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/2f53c489-bbd5-440d-866b-b181d21d31bc.jpg","likes":61,"dislikes":1,"views":13115,"release_date":"1507593600000","season_number":1,"description":"For the first time since graduating high school, 30-year-old Moriko Morioka is unemployed—and she couldn't be happier. Having quit her long-standing job of over 11 years, Moriko quickly turns to online games to pass her now-plentiful free time, reinventing herself as the handsome and dashing male hero \"Hayashi\" in the MMO Fruits de Mer. With the pesky societal obligations of the real world out of the way, she blissfully dives headfirst into the realm of the game, where she promptly meets the kind and adorable healer Lily. Befriending each other almost instantly, the two become inseparable just as Moriko herself becomes more and more engrossed in her new \"life\" as Hayashi. Eventually, Moriko adopts the reclusive lifestyle in its entirety, venturing out from the safety of her apartment only when absolutely necessary.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"N/A"},"current_season_id":8196,"content_control":"NORMAL"}}