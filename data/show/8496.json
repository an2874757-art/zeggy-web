nue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8496,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy","Animation"],"id":8496,"type":"MOVIE","title":"Madagascar 3: Europe's Most Wanted","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/4abf2233-b243-45ab-9c74-46e21c639a73.png","background_image":"https://cdn6.albox.co/storage/disk59/shows/46eb4ef7-f2d1-4e78-a02b-c9ff35852494.png","likes":107,"dislikes":1,"views":10934,"release_date":"1339113600000","length":5604,"description":"Alex, Marty, Gloria and Melman are still trying to get back to the Big Apple and their beloved Central Park zoo, but first they need to find the penguins. When they travel to Monte Carlo, they attract the attention of Animal Control after gate crashing a party and are joined by the penguins, King Julian and Co., and the monkeys. How do a lion, zebra, hippo, giraffe, four penguins, two monkeys, three lemurs travel through Europe without attracting attention and get back to New York? They join a traveling circus. Their attempts to get back to New York are consistently hampered by the Captain of Animal Control who wants to make Alex part of her collection. Once they make it back to New York Marty, Alex, Gloria and Melman realize that they want to be part of the traveling circus.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG"},"episode_id":8496,"content_control":"FAMILY"}}