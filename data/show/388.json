},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":388,"title":"","description":"58","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":388,"type":"MOVIE","title":"Confessions of a Shopaholic","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/c27606b8-6a8e-4c14-967d-f5fff1f15d05.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/142ae1ec-4886-439b-900d-378e4e126197.jpg","likes":355,"dislikes":11,"views":20516,"release_date":"1234483200000","length":6253,"description":"Struggling with her debilitating obsession with shopping and the sudden collapse of her income source, Rebecca Bloomwood unintentionally lands a job writing for a financial magazine after a drunken letter-mailing mix-up. Ironically writing about the very consumer caution of which she herself has not abided, Rebecca's innovative comparisons and unconventional metaphors for economics grants her critical acclaim, public success, and the admiration of her supportive boss Luke. But as she draws closer to her ultimate goal of writing for renowned fashion magazine Alette, she questions her true ambitions and must determine if overcoming her \"shopaholic\" condition will bring her real happiness.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":388,"background_color":"","content_control":"FAMILY"}}