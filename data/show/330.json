://cloud02.albox.co/shows/3f4f86a3-50cd-46f5-844b-7d22c2051efd.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":330,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Action","Drama","Thriller","Crime","History"],"id":330,"type":"MOVIE","title":"The Baader Meinhof Complex","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/7619b3be-e329-4121-afa3-1d3fb6dd1bd1.jpg","background_image":"","likes":18,"dislikes":2,"views":5323,"release_date":"1222300800000","length":8974,"description":"Germany in the 1970s: Murderous bomb attacks, the threat of terrorism and the fear of the enemy inside are rocking the very foundations of the yet fragile German democracy. The radicalised children of the Nazi generation lead by Andreas Baader, Ulrike Meinhof and Gudrun Ensslin are fighting a violent war against what they perceive as the new face of fascism: American imperialism supported by the German establishment, many of whom have a Nazi past. Their aim is to create a more human society but by employing inhuman means they not only spread terror and bloodshed, they also lose their own humanity. The man who understands them is also their hunter: the head of the German police force Horst Herold. And while he succeeds in his relentless pursuit of the young terrorists, he knows he's only dealing with the tip of the iceberg.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"episode_id":330,"content_control":"FAMILY"}}