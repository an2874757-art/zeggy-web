rl":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/ec3cc304-7dac-42cd-bef9-d97235cd8f42.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":41067,"title":"Tom Clancy's Jack Ryan: Ghost War","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/d8419c33-4cfb-45b3-b8f7-c310777948b0.JPG"},"length":0,"continue_watching_progress":0},{"items":[],"id":39751,"title":"The Housemaid","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/21b0ba56-210b-4a04-867e-40aa89c2f677.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":39530,"title":"The Rip","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/ba53e211-6880-454c-aa19-0b876104315b.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":40344,"title":"Peaky Blinders: The Immortal Man","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/21f8ea2a-70ec-490e-b5b0-c24e12ef5eae.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10226,"title":"The Avengers","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/88d67035-c070-4881-b4ea-0d3dccfb3fd6.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10558,"title":"","description":"114","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":10558,"type":"MOVIE","title":"There Will Be Blood","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/ce19b24e-9ab9-4da0-8f45-9122a41f3711.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/41615aaa-802b-4d6e-9f74-5bfa0642e385.jpg","likes":828,"dislikes":13,"views":57308,"release_date":"1201219200000","length":9506,"description":"The intersecting life stories of Daniel Plainview and Eli Sunday in early twentieth century California presents miner-turned-oilman Daniel Plainview, a driven man who will do whatever it takes to achieve his goals. He works hard but also takes advantage of those around him at their expense if need be. His business partner/son (H.W.) is, in reality, an \"acquired\" child whose true biological single-parent father (working on one of Daniel's rigs) died in a workplace accident. Daniel is deeply protective of H.W. if only for what H.W. brings to the partnership. Eli Sunday is one in a pair of twins whose family farm Daniel purchases for the major oil deposit located on it. Eli, a local preacher and a self-proclaimed faith healer, wants the money from the sale of the property to finance his own church. The lives of the two competitive men often clash as Daniel pumps oil off the property and tries to acquire all the surrounding land at bargain prices to be able to build a pipeline to the coast, and as Eli tries to build his own religious empire.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"R"},"episode_id":10558,"content_control":"FAMILY"}}