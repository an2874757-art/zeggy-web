nfo":{"genres":["Sci-Fi","Drama","Mystery"],"id":34240,"type":"SERIES","title":"The Prisoner","logo":"https://cloud02.albox.co/shows/8c28e8e5-1a84-4651-8d21-6873657fcaad.png","image":"https://cloud02.albox.co/seasons/525f23a9-4262-449c-87dc-535de70b079f.jpg","background_image":"https://cloud02.albox.co/seasons/10d76162-136f-4a41-b66e-d13e11383d63.jpg","likes":10,"dislikes":2,"views":3360,"release_date":"-71280000000","season_number":1,"description":"The series follows a British former secret agent who is held prisoner in a mysterious coastal village resort where his captors try to find out why he abruptly resigned from his job. Although sold as a thriller in the mould of the previous series starring McGoohan, Danger Man (1960–68), the show's combination of 1960s countercultural themes and surreal setting had a far-reaching effect on science fiction/fantasy programming, and on popular culture in general.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.5}],"value":8.5,"age":"TV-PG"},"background_color":"#000000","current_season_id":19259,"content_control":"FAMILY"}}