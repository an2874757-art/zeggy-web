hing_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5101,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":5101,"type":"MOVIE","title":"Playing by Heart","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/d1f058c8-734a-4f8f-839f-7dd5dd46ec18.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/2d1024c6-c54d-44af-90b0-1f38fee406f6.jpg","likes":21,"dislikes":4,"views":6843,"release_date":"916963200000","length":7244,"description":"Eleven articulate people work through affairs of the heart in L.A. Paul produces Hannah's TV cooking show, and they must move beyond gentle barbs when she wants to know about an affair of his years ago. Mark is dying of AIDS, and his mother comes to his bedside: they must talk truthfully. Men have scalded Meredith so she rebuffs Trent's charm, but he persists. The trendy, prolix Joan tries to pull the solitary Keenan into her orbit: why is he reluctant? An adulterous couple meet at hotels for evening sex, but she is unwilling for the relationship to grow. Hugh tells tall tales, usually tragic, to women in bars. By the week's end, their parallel stories converge.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"R"},"episode_id":5101,"content_control":"NORMAL"}}