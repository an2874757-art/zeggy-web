rogress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6822,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime","Mystery"],"id":6822,"type":"MOVIE","title":"Out of Time","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/f5e461d0-160d-4a0f-8987-9a73ffc08bf1.gif","background_image":"https://cdn6.albox.co/storage/disk57/shows/e9180288-e12b-423c-9a36-1ddd91d022b9.gif","likes":33,"dislikes":2,"views":4549,"release_date":"1065139200000","length":6324,"description":"Matt Whitlock, the police chief of the small town of Banyan Key, Florida, is separated from his wife, Alex, a police homicide detective in MIami. Matt's been having an affair with Ann Merai Harrison, a woman who's separated from her abusive husband, Chris, and who says that she has cancer. When her doctor tells her of a new expensive treatment, Matt decides to give her the nearly half a million dollars in an evidence lock up that he seized from a local drug bust. When Ann and her husband turn up dead only days after naming Chief Whitlock as beneficiary on a million dollar Life insurance policy, things start heating up for Whitlock as the evidence his wife Alex is gathering stacks up against him. And as if things couldn't get worse, the D.E.A. now want the drug money a.s.a.p. Anxiety runs high for Whitlock as he scrambles to figure out who has set him up and also recover half a million dollars all while trying not to break a sweat or draw any suspicions. He's a man who is way out of his depth, nearly out of luck, and desperately close to being out of time.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":6822,"content_control":"FAMILY"}}