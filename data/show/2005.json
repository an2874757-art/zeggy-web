gress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2005,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":2005,"type":"MOVIE","title":"Alex & Emma","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/2c71eb02-787e-44a7-a985-1b42b1fc2453.png","background_image":"https://cdn6.albox.co/storage/disk43/shows/faccf6ac-5f5f-44bd-b17f-cfc1a6efddfa.png","likes":8,"dislikes":2,"views":2899,"release_date":"1056067200000","length":5757,"description":"A romantic comedy: Alex is an author whose writer's block and gambling debts have landed him in a jam. In order get loan sharks off his back, he must finish his novel in 30 days or wind up dead. To help him complete his manuscript he hires stenographer Emma. As Alex begins to dictate his tale of a romantic love triangle to the charming yet somewhat opinionated stenographer, Emma challenges his ideas at every turn. Her unsolicited yet intriguing input begins to inadvertently influence Alex and his story and soon real life begins to imitate art.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"PG-13"},"episode_id":2005,"content_control":"NORMAL"}}