ion_type":"comments"}],"post_info":{"genres":["Action","Drama","Comedy","Crime","Mystery","Investigation"],"id":15459,"type":"SERIES","title":"Good Casting","logo":"","image":"https://cdn6.albox.co/storage/disk46/seasons/000abeb2-ec2e-43c9-9db2-cef03503a407.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/d49cd3f4-20c6-4849-8ad4-c1c8df99fe0f.jpeg","likes":50,"dislikes":2,"views":6096,"release_date":"1587945600000","season_number":1,"description":"Baek Chan Mi is a legendary agent for the National Intelligence Service. However, due to an excessive operation, one of her subordinates passes away. After this incident, she takes back all hope of returning to the field when she gets an order to go undercover. She begins working as a secretary for Ilkwang Hitech under the name, Baek Jang Mi. She is joined by a single mother, Im Ye Eun, who has the beauty of a girl group member, and Hwang Mi Soon, a housewife of 18 years whose family believes her to be an insurance salesperson. These three women begin to work together. Meanwhile, Ilkwang Hitech’s CEO, Yoon Seok Ho, knew Chan Mi as his tutor and had a crush on her. He can’t help but think that his new secretary, who looks exactly like his first love but has a different name and age, is a bit suspicious.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":9}],"value":9,"age":"PG-13"},"current_season_id":2767,"content_control":"NORMAL"}}