co/shows/e2b70a3c-a4f7-4126-99c0-24cdc78d533f.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2089,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Romance","Thriller","Comedy","Crime","Family"],"id":2089,"type":"MOVIE","title":"Agent Cody Banks","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/30ac9d93-6836-410c-875c-126581f47be2.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/e941c710-2cab-432b-b80e-eb39d9965a9b.jpg","likes":22,"dislikes":1,"views":3808,"release_date":"1047600000000","length":6128,"description":"A government agent trains a typical teenager Cody Banks who loves to skateboard, hates math, and feels like a complete idiot around girls, in the ways of covert operations that require younger participants. But Cody's got a secret--he's actually part of a secret teen CIA program. Cody's living every boy's dream life--he can drive like a stunt man, has an incredible arsenal of cool gadgets, and his agency mentor, Ronica Miles, is totally hot. But Cody's training is put to the test when he's sent to pose as a prep school student and befriend fellow teen Natalie Connors in order to gain access to her father--a scientist unknowingly developing a fleet of deadly pair of twisted villains called the nanobots for the evil organization ERIS, which can destroy any carbon or silicon-based substance-to destroy the world's defense systems so he can threaten anyone who opposes him. From runaway cars and high-speed snowboard chases to a spectacular final mountaintop showdown, Cody has to use everything he's learned to prove himself as an agent and stop ERIS from completing their mission before their mission fails.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"episode_id":2089,"background_color":"","content_control":"NORMAL"}}