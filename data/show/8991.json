ة القدم والنادي الأهلي أما الثالث فهو سمسم الضعيف والمنطوي على نفسه دائما. يتعرف الثلاثة على ندى (منة شلبي) ويقع ثلاثتهم في حبها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"N/A"},"episode_id":8991,"content_control":"NORMAL"}}