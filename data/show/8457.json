":[{"items":[],"id":8457,"title":"","description":"52","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Comedy","Family"],"id":8457,"type":"MOVIE","title":"Ella Enchanted","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/22fda8af-4912-4088-84f7-f1718b363b97.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/22909414-7d24-4e63-8ecc-10a59d0c2b43.jpg","likes":630,"dislikes":8,"views":36604,"release_date":"0","length":5773,"description":"Based on Gail Carson Levine's award winning novel, this is the story of Ella, a young woman who was given a \"gift\" of obedience by a fairy named Lucinda. She must obey anything anyone tells her to do. When her mother passes away, she is cared for by her thoughtless and greedy father who remarries a loathsome woman with two treacherous daughters. This modern-day, fantasy Cinderella story features fairies, ogres and elves...as well as a hero in the guise of Prince Charmont, whom Ella falls in love with. Unlike Cinderella though, she must depend on herself and her intelligence to get her through her troubles and find Lucinda in order for her \"curse\" to be broken!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":8457,"background_color":"","content_control":"FAMILY"}}