e":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/ee295e3c-3d00-4e33-aced-85c8d7d2c820.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":37790,"title":"كان انسان","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/4fe2089a-4679-485a-8c85-4468b103145a.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19882,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":19882,"type":"SERIES","title":"أناشيد المطر الموسم الثالث (موعد مع المطر)","logo":"","image":"https://cdn6.albox.co/storage/disk58/seasons/2fbccb56-8ab8-43a8-9a6f-c0e777bd1c39.png","background_image":"https://cdn6.albox.co/storage/disk50/seasons/d8ca74af-7532-448c-a692-c4f28bf002ee.png","likes":7,"dislikes":0,"views":2245,"release_date":"-2208988800000","season_number":1,"description":"الجزء الأول يدعى «مطر الربيع» وهو من بطولة ورد صالح وغسان مسعود وكندة صالح وسمر سامي ورامي حنا وخالد القيش وقمر خلف وأسعد الجابر وأسامة حلال. وهو من اخراج سيف الدين سبيعي وكتب القصة والسيناريو والحوار الكاتبة المعروفة أمل حنّا. \r\nالجزء الثاني يدعى «رائحة المطر» وهو من اخراج ايناس حقي - ابنة المخرج السوري المبدع هيثم حقي - وكتابة غسان زكريا. والعمل من بطولة سعد لوستان وجهاد سعد وسوسن أرشيد ونضال نجم وأمانة والي وفاتن شاهين وضحى الدبس ورغد مخلوف و صبحي الرفاعي. \r\nأما الجزء الثالث والأخير والذي يدعى «موعد مع المطر» فهو من بطولة فرح بسيسو وطلحت حمدي ورافي وهبة وعبد الهادي الصباغ. وهو من اخراج ناجي طعمة وكتابة رافي وهبة.","rating":{"sources":[],"value":0,"age":""},"current_season_id":8680,"content_control":"NORMAL"}}