n_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Magic"],"id":16824,"type":"SERIES","title":"Radiant","logo":"","image":"https://cdn6.albox.co/storage/disk52/seasons/4e38e704-d5ec-468d-8a47-aaa37a9c9bb0.jpg","background_image":"https://cdn6.albox.co/storage/disk53/seasons/fed4724f-a18e-4162-b770-c9e406b6ca28.jpg","likes":124,"dislikes":5,"views":20363,"release_date":"1538784000000","season_number":1,"description":"Seth is an aspiring sorcerer from the Pompo Hills area. Like all wizards, he is an \"infected,\" one of the few living beings who survived the contact of the Nemesis—creatures fallen from the sky that contaminate and decimate all those they touch. Being immune to them, Seth wants to become a Hunter and fight the Nemesis. But more than that, Seth wants to engage in a quest that goes beyond the simple hunt for monsters. He wants to find the Radiant, their presumed cradle. Aided by a faction of fellow sorcerers, he travels the world in search of the Radiant, under the harsh scrutiny of the Inquisition.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"current_season_id":4664,"content_control":"NORMAL"}}