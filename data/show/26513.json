ching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["","","","",""],"id":26513,"type":"SERIES","title":"Teppen!!!!!!!!!!!!!!!","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/4f3e1329-b8ad-4ecb-abcd-58d4d38deba6.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/a56f4349-59da-4fec-91eb-dd3547d558c1.jpg","likes":7,"dislikes":0,"views":1345,"release_date":"1656720000000","season_number":1,"description":"ساكاموتو يايوي ، من أشد المعجبين بالكوميديين والأعمال الكوميدية ، التحق بمدرسة كازوكي الثانوية الخاصة في نانبا (منطقة الترفيه بأوساكا الشهيرة كنقطة انطلاق لكثير من الكوميديين). تلتقي مع تاكاهاشي يوموجي ، صديقة الطفولة التي شكلت ذات مرة الثنائي الكوميدي \"كونامونزو\" معها عندما كانا صغيرين. قبل مضي وقت طويل ، وجدوا أنفسهم يضعون روتينًا في حديقة كما فعلوا من قبل ، من أجل الدخول في مسابقة منطقة تسوق محلية. في تلك اللحظة ، تناديهم فتاة غامضة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"current_season_id":14265,"content_control":"NORMAL"}}