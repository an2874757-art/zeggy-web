فلةٍ جميلةٍ تعود سارة لمنزلها لتكتشف كارثةً حقيقيةً تهدد حياتها وأنهت حياة حبيبها.\n\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"R"},"episode_id":5324,"background_color":"#667cb2","content_control":"NORMAL"}}