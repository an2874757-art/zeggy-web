3bece-d85f-4a23-9d9d-8b202db30848.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2217,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Horror"],"id":2217,"type":"MOVIE","title":"Quarantine","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/264cd355-cf26-4cea-8e9d-b957a532d5d5.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/196a70e9-e45d-4538-9b0d-dda26c2e1fc6.jpg","likes":65,"dislikes":1,"views":8026,"release_date":"1223596800000","length":5355,"description":"A television reporter and her cameraman are assigned to spend the night shift with a Los Angeles Fire Station. After a routine 911 call takes them to a small apartment building, they find police officers already on the scene in response to blood curdling screams coming from one of the apartment units. They soon learn that a woman living in the building has been infected by something unknown. After a few of the residents are viciously attacked, they try to escape with the news crew in tow, only to find that the CDC has quarantined the building. Phones, internet, televisions and cell phone access have been cut-off, and officials are not relaying information to those locked inside. When the quarantine is finally lifted, the only evidence of what took place is the news crew's videotape.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"R"},"episode_id":2217,"content_control":"FAMILY"}}