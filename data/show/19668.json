4833-ae49-d1fab76b8041.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19710,"title":"Prison Break","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/f060e3ca-609d-48b4-99d6-7b630344435e.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19668,"title":"","description":"457","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Mystery","Horror"],"id":19668,"type":"SERIES","title":"The Originals","logo":"","image":"https://cdn6.albox.co/storage/disk56/seasons/652854e8-e786-4bf9-9ccb-f15bf8e6d059.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/ebcc4945-5d39-4a1c-8eda-adc0c36ac46a.jpg","likes":2173,"dislikes":59,"views":445172,"release_date":"1363478400000","season_number":1,"description":"جزء من The Vampire Diaries والذي تم وضعه في New Orleans ، تركز The Originals على أشقاء Mikaelson ، المعروفين باسم مصاصي الدماء الأصليين في العالم: Klaus (Joseph Morgan) ، Elijah (Daniel Gillies) ، و Rebekah (Claire Holt). الآن يجب على كلاوس أن يقضي على تلميذه مارسيل (تشارلز مايكل ديفيس) ، المسؤول الآن عن نيو أورلينز ، من أجل استعادة مدينته ، حيث بنى نيو أورلينز في الأصل. غادر كلاوس المدينة بعد أن طارده والده ميكائيل أثناء بنائه وتولى مارسيل زمام الأمور. بعد أن عاد كلاوس بعد سنوات عديدة ، استفزته غروره ليصبح ملكًا للمدينة. \"كل ملك يحتاج إلى وريث\" ، قال كلاوس ، متقبلاً الطفل الذي لم يولد بعد. الطفل هو أول مولود لهجين (جزء منه مصاص دماء ، وجزء بالذئب) وذئب (هايلي).","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG-13"},"background_color":"","current_season_id":8366,"content_control":"NORMAL"}}