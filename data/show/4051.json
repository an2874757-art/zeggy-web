on_type":"normalPoster"},{"data":[{"items":[],"id":4051,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":4051,"type":"MOVIE","title":"The House of the Spirits","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/25942205-efb9-46a1-8496-615d5d57b257.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/86a7d8a5-829e-4f8a-81e0-25797e451e83.jpg","likes":52,"dislikes":1,"views":7495,"release_date":"765158400000","length":8768,"description":"Chile, second half of the 20th century. The poor Esteban marries Clara and they get a daughter, Blanca. Esteban works hard and eventually gets money to buy a hacienda, eventually to become a local patriarch. He becomes very conservative and is feared by his workers. When Blanca grows up, she falls in love with a young revolutionary, Pedro, who urges the workers to fight for socialism. It is unavoidable that Pedro and Esteban are pitted against each other. Esteban tries to stop the love affair between Pedro and his daughter by all means possible but soon Blanca becomes pregnant and has a daughter. The void between father and daughter seems unbridgeable when Blanca moves in with Pedro.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"R"},"episode_id":4051,"content_control":"NORMAL"}}