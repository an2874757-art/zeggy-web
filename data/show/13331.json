/storage/disk49/shows/a5224e9e-de9a-4af7-be9d-81bbaba53f97.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":13331,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":13331,"type":"MOVIE","title":"The Babysitters","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/54bdeab7-2bb9-426c-ab10-62d77481ea78.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/cc417fb0-13da-4bf3-966e-3805d69d29a3.jpg","likes":133,"dislikes":14,"views":36478,"release_date":"1305244800000","length":5301,"description":"At 17, high-school junior Shirley Lyner is thinking about college and running a babysitting service that provides teen call girls to the dads of young children. In a long flashback, we see what brought her from being a babysitter to organizing and running the service. It starts with Michael, the father of children she baby-sits. A cup of coffee on the way home from his house, a night visit to a train yard, and one thing leads to another. Shirley can be ruthless, and tension builds when some of the clients take the girls to a mountain cabin and bring drugs. Then, one of the girls tries to freelance. Can this end well: is it a tragedy in the making? Do we all have secrets?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"R"},"episode_id":13331,"content_control":"FAMILY"}}