ود دائما على حق؟ تظهر الدراما كيف يكتشف القضاة حقيقة الناس في المحكمة. يتمحور الأمر حول رئيس قضاة لا يؤمن بالعدالة ، ولكنه يصدر فقط أحكاما ترضى بها الحشود. يبدأ مساعد القاضي في التشكيك في دوافعه ويحاول العثور على الحقيقة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"TV-14"},"background_color":"","current_season_id":22177,"content_control":"FAMILY"}}