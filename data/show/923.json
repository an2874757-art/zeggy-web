gress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Horror"],"id":923,"type":"MOVIE","title":"Kristy","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/05249f67-df42-4323-8dcf-6cecea749187.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/e23993a5-0013-40ab-ba03-c041015e9beb.jpg","likes":71,"dislikes":4,"views":9979,"release_date":"1446681600000","length":5126,"description":"College girl Justine works hard to support herself at Bryce College, where she studies. During Thanksgiving, her boyfriend Aaron goes home and Justine has plans to stay on campus with her roommate, Nicole. Out of the blue, Nicole's father invites her to Aspen, while Justine remains in the dorm. One night, Justine drives to a convenience store to buy supplies and meets Violet, who threatens her. Shaken, Justine returns to campus, where she soon finds herself being hunted down by Violet and three hoodlums from a cult. Justine has to fight to survive.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"R"},"episode_id":923,"content_control":"NORMAL"}}