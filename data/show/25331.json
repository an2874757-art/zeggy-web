ype":"normalPoster"},{"data":[{"items":[],"id":25331,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"," Action"," Comedy"," Adventure"],"id":25331,"type":"SERIES","title":"Saiyuuki Reload: Zeroin","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/d95ecce1-332e-4e05-b0a1-374b706ead5c.jpeg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/b5b72999-005b-40e3-9c7f-8a8a53b46532.jpg","likes":13,"dislikes":0,"views":2113,"release_date":"1641427200000","season_number":1,"description":"إن الوقوع في كمين من قبل الشياطين المارقة على الطريق هو عمل كالمعتاد لحزب سانزو. ولكن عندما يتبين أن أحدث مهاجميهم هم بشر ، فإن المجموعة تُصاب بالذهول. يتعمق اللغز فقط عندما يواجهون كاهنًا متجولًا ، هازل جروس ، وحارسه الشخصي المهيب ، غاتي نيني هوك. ينحدر الزوجان من أقصى الغرب ، حيث استخدم هازل قوته في القيامة لمساعدة القرى المنكوبة. في حين أن قدرته موضع ترحيب كبير من قبل الناس ، فإن الحقيقة وراءها أقل معجزية مما تبدو عليه. علاوة على ذلك ، يكتسب البشر القائمون من الموت عيونًا ذهبية ، وهي سمة يشاركونها مع مهاجمي الجماعة مؤخرًا. يبدو أن نوايا الكاهن الودود ليست سخية كما قد يتوقع المرء - وحزب سانزو على بعد خطوة من تفكيكها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"PG-13"},"current_season_id":13398,"content_control":"NORMAL"}}