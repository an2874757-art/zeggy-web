7254,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Crime"],"id":7254,"type":"MOVIE","title":"Until Death","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/3f416a31-8eda-4962-86cb-6ac192c07c57.png","background_image":"","likes":43,"dislikes":5,"views":8090,"release_date":"1182297600000","length":6426,"description":"Anthony Stowe is a down-and-out detective addicted to heroine whose days always seem to go from bad to worse. Stowe is coming off of a drug deal, in which two officers were killed, and the primary villain, the drugs, the money and the surveillance tapes are still at large. He is also dealing with his wife, who has just informed him that she is pregnant - but the child is not his. After a gunfight in which Stowe comes very close to death, After being severely wounded and losing all will to live, His body gives up and falls into a coma. After an inner battle with himself, He gains again the spirit to live again. While on the road to recovery, Stowe finds himself in a very personal battle to make amends with his kidnapped wife and to take revenge on his assailant once and for all.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"R"},"episode_id":7254,"content_control":"NORMAL"}}