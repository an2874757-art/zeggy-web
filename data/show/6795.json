":"normalPoster"},{"data":[{"items":[],"id":6795,"title":"","description":"31","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime","Mystery"],"id":6795,"type":"MOVIE","title":"Fracture","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/97d388cb-7c9b-4eda-9be0-14fc66c9cd86.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/dea34a9a-2c2f-4da3-8459-7d08a8925884.jpg","likes":155,"dislikes":7,"views":16982,"release_date":"1177027200000","length":6807,"description":"Wealthy, brilliant, and meticulous Ted Crawford, a structural engineer in Los Angeles, shoots his wife and entraps her lover. He signs a confession; at the arraignment, he asserts his rights to represent himself and asks the court to move immediately to trial. The prosecutor is Willy Beachum, a hotshot who's soon to join a fancy civil-law firm, told by everyone it's an open and shut case. Crawford sees Beachum's weakness, the hairline fracture of his character: Willy's a winner. The engineer sets in motion a clockwork crime with all the objects moving in ways he predicts.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":6795,"content_control":"NORMAL"}}