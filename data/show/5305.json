ength":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5305,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Sci-Fi","Thriller","Horror"],"id":5305,"type":"MOVIE","title":"Stay Alive","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/55932b31-ebcd-48ee-81e7-7a02bed14ac0.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/442d6bf9-a5c9-4f32-b0c3-32607f735287.jpg","likes":45,"dislikes":4,"views":4701,"release_date":"1143158400000","length":5158,"description":"Loomis Crowley is testing the underground game Stay Alive with his friends Sarah and Rex. When the game is over, Loomis finds Rex and Sarah dead in their room, and he is pushed by a shadow from the staircase, breaking the banister and hanging the same way he died in the game. Loomis' sister, Emma, gives his game to his best friend, Hutch. They, and his friends Miller, Phineus with his sister October, Swink and Abigail play the game together. When Miller and Phineus die the same way they died in the game, the survivors disclose that the game is based on the life of the evil Countess Elizabeth Bathory. She was buried alive in the tower of her real state in the Geronge Plantation. With the police chasing them, and after the death of October, the survivors reach the house and try to find the corpse of the Countess to destroy her fiend.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.1}],"value":5.1,"age":"PG-13"},"episode_id":5305,"content_control":"NORMAL"}}