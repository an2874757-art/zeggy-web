s":[],"id":20637,"title":"Healer","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/7e2ed34a-26f0-430c-a0b9-4089435188cc.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36903,"title":"Hunter with a Scalpel","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/1674626e-377c-4ae1-88e1-9cf679260569.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":29380,"title":"XO, Kitty","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/41a09c3a-b9c0-4090-add3-8f3c20e4c820.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":39868,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":39868,"type":"SERIES","title":"Love is Panacea","logo":"","image":"https://cloud02.albox.co/seasons/8d2a4639-4567-48f0-8aa4-685f3c5d65d5.jpg","background_image":"https://cloud02.albox.co/seasons/4419c7b1-0c2d-4097-b500-1af7a3560f1a.jpg","likes":26,"dislikes":1,"views":1709,"release_date":"1698883200000","season_number":1,"description":"عندما يذهب غو يون تشنغ، الأستاذ المساعد في جراحة الأعصاب، في مهمة إغاثة طبية إلى دولة لاكايا (الخيالية) في شمال أفريقيا، يلتقي بطالبته السابقة سو وي آن، وهي فتاة تركت دراستها الطبية لتصبح سيدة أعمال. يتطور الأمر من مشادات كلامية مستمرة إلى قصة حب، ليكتشف تدريجيًا أن سلوكها الغريب ومقاومتها لتقربه منها يعودان إلى حملها لجين مرض هنتنغتون، وهو مرض عضال يتركها بلا أمل. فيقرر التخلي عن مسيرته المهنية الواعدة وتكريس حياته للبحث عن علاج لمرض هنتنغتون، مكافحًا جنبًا إلى جنب مع حبيبته لرسم بصيص أمل في هذا العالم المظلم.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"NC-17"},"background_color":"","current_season_id":23260,"content_control":"NORMAL"}}