ments"}],"post_info":{"genres":["Action","Comedy","Animation"],"id":21108,"type":"SERIES","title":"Assassination Classroom","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/0c4e24f5-d04b-4af1-959f-a9990455d3a2.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/a7574747-359a-4688-849a-f5aee87b1c13.jpeg","likes":573,"dislikes":8,"views":53881,"release_date":"1420848000000","season_number":1,"description":"The Earth is threatened by a powerful creature who destroyed 70% of the Moon with its power, rendering into the shape of a crescent moon forever. The creature claims that within a year, Earth will also be destroyed by him, but he offers mankind a chance to avert this fate. In class 3-E at Kunugigaoka Junior High School, he starts working as a homeroom teacher where he teaches his students not only regular subjects, but the ways of assassination. The Japanese government promises a reward of ¥10 billion (i.e. 100 million USD) to whoever among the students succeeds to kill their teacher, whom they have named \"Korosensei\" . However, this has proven to be an almost impossible task, as he has several inhuman abilities at his disposal, including the capacity of moving at Mach 20.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"pg-13"},"current_season_id":10367,"content_control":"NORMAL"}}