ching_progress":0},{"items":[],"id":40179,"title":"War Machine","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/e6499b35-1d7d-4747-b693-76adf78374c4.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":13363,"title":"The Conjuring","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/6d409d76-483b-4e6c-bf97-b9aa1e80f747.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":2628,"title":"Rambo: Last Blood","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/4ba79592-dc06-41fe-814c-d5b69f305cf0.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2927,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller"],"id":2927,"type":"MOVIE","title":"Requiem for a Killer","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk50/shows/4e0d6679-7b1d-48e7-ae91-14524e55d73e.jpg","likes":12,"dislikes":3,"views":3879,"release_date":"1298419200000","length":5557,"description":"Lucrèce is a contract killer in search of a new life. Specialized in the use of poisons and enamored with opera, she accepts a difficult, final hit in a castle in the heart of the Swiss Alps. Posing as a soprano, Lucrèce must perform on stage during the very prestigious Festival of Ermeux and slaughter one of her co-performers, British baritone Alexander Child, who recently bought a distillery in Scotland, and thus became the only obstacle to a strategic pipeline project with considerable financial ramifications. He just won a long legal battle against British Oil, who now has no other choice but to eliminate him. To complicate things, French counter-espionage learns of the hit and sends Rico, a reinstated former agent, to infiltrate the orchestra, unmask and terminate all who wish harm to Alexander Child. Rico has no information on the killer and has a lot of trouble identifying her amid a horde of suspicious characters: an obnoxious conductor, a particularly proud tenor and a strangely stressed festival director... Throughout rehearsals of Haendel's sublime Messiah, a breathless intrigue begins...and could end in a Requiem...for a killer!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.1}],"value":5.1,"age":"R"},"episode_id":2927,"content_control":"FAMILY"}}