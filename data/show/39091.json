],"id":27453,"title":"Cheer Up","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/fd4355a1-dc6f-4759-bd00-8a1c7249ecf4.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":39091,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","History"],"id":39091,"type":"SERIES","title":"The Vendetta of An","logo":"https://cloud02.albox.co/shows/a61d376c-201c-46d9-977b-7e33aae0fe74.jpg","image":"https://cloud02.albox.co/seasons/02e32aed-bebd-4948-a2ad-28bf25ac0355.jpg","background_image":"https://cloud02.albox.co/seasons/8c9bb5af-6205-40c0-909f-6c93f738d9bb.jpg","likes":73,"dislikes":3,"views":9981,"release_date":"1765497600000","season_number":1,"description":"خلال عهد وودي، حكم الحرس المظلم هوبن تشانغآن، ولكن عندما استولى الإقطاعي شياو وو يانغ على السلطة، اختفوا مع الإمبراطور المخلوع. زعمت الشائعات أن زعيمهم، يان فنغ شان، سعى لاستغلال الحاكم المخلوع لمصلحته الشخصية. كلف شياو وو يانغ، المسؤول اللامع من هواينان، بالقضاء على هوبن، فرأى في ذلك فرصة للانتقام - فقد قتل يان فنغ شان والده، وكان قد أمضى عقدًا من الزمن في التحضير لذلك. وباستخدام الإمبراطور المخلوع كأداة، عقد شي هواينان تحالفًا مع الجنرال غو يو، والمبارز يي تشنغ، والخبير الاستراتيجي هان زي لينغ. معًا، شنوا حربًا خفية ضد هوبن، معركة ستحدد مصير الإمبراطورية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"NC-17"},"background_color":"#ffffff","current_season_id":22730,"content_control":"NORMAL"}}