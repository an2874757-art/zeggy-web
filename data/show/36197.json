.co/shows/667e1c23-9767-4a60-ace4-c7c3c24ba757.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19742,"title":"Grand Blue","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/7471b965-d88c-475a-b422-fc14cc1dfb33.jpeg"},"length":0,"continue_watching_progress":0},{"items":[],"id":31928,"title":"Ninja Kamui","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/c8632403-79f5-4385-af94-81e812613f7c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":23182,"title":"Tsuki ga Michibiku Isekai Douchuu","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/90ed4b13-5abd-4580-908a-42bab159e624.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":20418,"title":"Overlord ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk42/shows/3ccb48e7-b3d1-48f0-84dc-2165ee353f9f.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36197,"title":"","description":"50","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action"," Fantasy"," Adventure"],"id":36197,"type":"SERIES","title":"Katainaka no Ossan, Kensei ni Naru","logo":"","image":"https://cloud02.albox.co/seasons/ae5f26ea-6bb9-44c8-b85f-6dcdbf41da1a.jpeg","background_image":"https://cloud02.albox.co/seasons/4e810f53-d096-482c-b6e7-428272a93028.jpg","likes":519,"dislikes":21,"views":119700,"release_date":"1743897600000","season_number":1,"description":"بيريل غاردينانت، الذي يُطلق على نفسه لقب \"الرجل العجوز المتواضع\"، هو مُدرب سيوف في دوجو خاص به في قرية ريفية نائية. في شبابه، كان يحلم بالمجد كمُبارز سيوف، لكن تلك الأيام ولت منذ زمن بعيد. فجأةً، يتلقى زيارة من تلميذ سابق مشهور يحمل له خبرًا مُفاجئًا: عُيّن مُدربًا خاصًا لفرسان منظمة ليبريون! بعد أن انقلبت حياته رأسًا على عقب، يسافر بيريل إلى العاصمة ويلتقي ببعض طلابه السابقين: فرسان من النخبة، وساحر ماهر، وحتى مغامر بلغ أعلى رتبة في النقابة. لكن لماذا يريدون جميعًا تعليمه؟! بالنسبة له، من الواضح أنهم لم يعودوا بحاجة إليه. هل سيُصبح بيريل على قدر منصبه الجديد؟ وهل سيحظى ولو بلحظة من الهدوء بعيدًا عن طلابه المُعجبين؟!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"background_color":"","current_season_id":20791,"content_control":"NORMAL"}}