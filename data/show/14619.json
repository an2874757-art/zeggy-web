type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":14619,"type":"SERIES","title":"ماريا ومصطفى","logo":"","image":"https://cdn6.albox.co/storage/disk53/seasons/20bcbd29-3908-40b6-8bf4-7f04208cfb77.jpeg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/2aaa622b-4f16-4c95-9362-76c30bcf3e35.jpeg","likes":46,"dislikes":1,"views":22921,"release_date":"1599350400000","season_number":1,"description":"يدور المسلسل حول أثنين من العشاق، الذي بدأ عشقهم بعد كره ثم أصبحت كل تلك المشاعر السيئة مليئة بالحب والعشق، لكن عشقهما مستحيل، فلكل منهما بيئة مختلفة وديانة مختلفة، مصطفى شاب وسيم وقوي من عائلة مسلمة متحفظة من عائلة متوسطة تعيش في وسط متوسط مثلهم، أما ماريا فهي فتاة جميلة يعشقها الجميع بسبب رقتها وعقلها وجمالها، لكن يشاء القدر في وقوعهم بالحب وقد نسوا أن لكل منهما حياة مختلفة تمنع قربهما من بعض، سنرى حربهما مع التقاليد والناس والعائلة وكيف أنهم سيقفون ضد التيار من أجل حبهم.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"current_season_id":1584,"content_control":"NORMAL"}}