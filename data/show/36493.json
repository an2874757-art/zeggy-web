":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/aa9c5fa4-1843-43c0-872f-8a579eec44ea.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36493,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Historical"," Fantasy"],"id":36493,"type":"SERIES","title":"Madam","logo":"","image":"https://cloud02.albox.co/seasons/706405b6-7764-406e-a76c-1db98241088b.jpg","background_image":"https://cloud02.albox.co/seasons/18d18e9b-a1b9-472b-b219-6ec86c070118.jpg","likes":38,"dislikes":0,"views":7257,"release_date":"1746489600000","season_number":1,"description":"خلال العصر الجمهوري، فقدت وريثة ثرية عائلتها بأكملها في مذبحة. بعد عشرين عامًا، عادت بصفتها السيدة الأولى لمدينة مو. في طريقها للانتقام، عقدت ميثاق صداقة مع أمير تنين فخور وتنين جياو ماكر. أصبح الاثنان حمايتها ووقعا في حبها سرًا. لاحقًا، انضم محقق وسيم إلى سباق الفوز بقلبها. مع تنافس ثلاثة رجال على عاطفتها، أعادت فتح التحقيق في مأساة عائلتها. وهكذا بدأت قصة حب وانتقام أسطورية في العصر الجمهوري.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"background_color":"","current_season_id":21039,"content_control":"NORMAL"}}