c9ce75e5-26a0-4fae-92f8-225d5c39e91c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4438,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Western"],"id":4438,"type":"MOVIE","title":"Dead Man","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/4c9d0f55-9580-4e97-92cc-e6d8077557ae.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/13a36a1b-e223-4625-94ba-a4f32f62f6f3.jpg","likes":70,"dislikes":2,"views":7756,"release_date":"831686400000","length":7265,"description":"Dead Man is the story of a young man's journey, both physically and spiritually, into very unfamiliar terrain. William Blake travels to the extreme western frontiers of America sometime in the 2nd half of the 19th century. Lost and badly wounded, he encounters a very odd, outcast Native American, named \"Nobody\", who believes Blake is actually the dead English poet of the same name. The story, with Nobody's help, leads William Blake through situations that are in turn comical and violent. Contrary to his nature, circumstances transform Blake into a hunted outlaw, a killer, and a man whose physical existence is slowly slipping away. Thrown into a world that is cruel and chaotic, his eyes are opened to the fragility that defines the realm of the living. It is as though he passes through the surface of a mirror, and emerges into a previously-unknown world that exists on the other side.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"episode_id":4438,"content_control":"NORMAL"}}