يرًا المربية التي كانت تبحث عنها: نازلي. لكن المرأة الغامضة والمقلقة بشكل متزايد سرعان ما تبدأ في تعطيل حياة فوندا وزوجها إيلكر التي تبدو سلمية. ما يبدأ كترتيب توظيف بسيط يتطور إلى لعبة نفسية خطيرة يتم فيها اختبار الرغبة والأسرار والولاء.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-14"},"background_color":"","current_season_id":24878,"content_control":"NORMAL"}}