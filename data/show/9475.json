0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9475,"title":"","description":"32","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Mystery"],"id":9475,"type":"MOVIE","title":"Ghajini","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/6dc69c18-1a70-4fa6-8c40-9bcfc1e3378c.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/fd143bb0-91ba-4207-bbb5-94c7cb653763.jpg","likes":287,"dislikes":4,"views":21703,"release_date":"1230163200000","length":11105,"description":"Medical student, Sunita, is driven by curiosity to study the case of Sanjay Singhania, who is afflicted with short-term memory loss. She runs into him, befriends him, and finds out that he is out to kill a seemingly benevolent citizen, Ghajini Dharmatma. After warning the latter of the impending danger, she subsequently comes across a number of diaries written by Sanjay and attempts to put together a jigsaw puzzle as to how a successful and wealthy businessman became a crazed recluse, who re-lives his past through tattoos on his body, notes and Polaroid photographs on the wall of his Hiranandani Complex flat, and his sole obsession of carrying out his deadly mission - little knowing that Ghajini and his goons are out to erase every bit of evidence he has gathered and thus ensure that he ends up remembering nothing.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"N/A"},"episode_id":9475,"content_control":"FAMILY"}}