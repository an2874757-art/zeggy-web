://cdn6.albox.co/storage/disk47/shows/713cc832-5f11-4725-99e5-57e2eda34c82.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6132,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Comedy"],"id":6132,"type":"MOVIE","title":"Charlie's Angels: Full Throttle","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/5bca0e60-1f74-4806-8e52-e8b9039699c6.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/c5ed4d35-dcd6-4f6c-9ff3-0533efbba0aa.jpg","likes":76,"dislikes":1,"views":9387,"release_date":"1056672000000","length":6426,"description":"The Angels--Natalie, Dylan, and Alex are back again but this time they're preparing for a strike without even warning as they go undercover to retrieve two missing silver bands. These are no ordinary rings. They contain valuable encrypted information that reveal the new identities of every person in the Federal Witness Protection Program. When witnesses start turning up dead, only the Angels, using their expertise as masters of disguise, espionage and martial arts can stop the perpetrator, a mysterious \"fallen\" Angel. Aided by their trusty colleague, Jimmy Bosley, the Angels' adventure begins at a remote Mongolian outpost and ends only after Dylan is forced to face a dark secret from her past--a secret that puts the lives of her two best friends in danger.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.9}],"value":4.9,"age":"PG-13"},"episode_id":6132,"content_control":"NORMAL"}}