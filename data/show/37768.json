ari و Zenjirou.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"TV-PG"},"background_color":"","current_season_id":21895,"content_control":"NORMAL"}}