comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Animation"],"id":20756,"type":"SERIES","title":"The Wind Rises","logo":"","image":"https://cdn6.albox.co/storage/disk44/seasons/7502f9c8-a805-4e7e-83c3-ad036286c310.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/039c0aba-cbe7-4e50-9322-56b2dca3fa66.jpg","likes":551,"dislikes":7,"views":18660,"release_date":"1392940800000","season_number":1,"description":"Jiro dreams of flying and designing beautiful airplanes, inspired by the famous Italian aeronautical designer Caproni. Nearsighted from a young age and unable to be a pilot, Jiro joins a major Japanese engineering company in 1927 and becomes one of the world's most innovative and accomplished airplane designers. The film chronicles much of his life, depicting key historical events, including the Great Kanto Earthquake of 1923, the Great Depression, the tuberculosis epidemic and Japan's plunge into war. Jiro meets and falls in love with Nahoko, and grows and cherishes his friendship with his colleague Honjo.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"current_season_id":9803,"content_control":"NORMAL"}}