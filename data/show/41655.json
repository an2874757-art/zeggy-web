ing_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Animation"],"id":41655,"type":"SERIES","title":"زم الفضائي","logo":"","image":"https://cloud02.albox.co/seasons/aefc35cd-03a1-4e06-bd14-7a13cbf16247.jpg","background_image":"https://cloud02.albox.co/seasons/b1ba179b-6e5d-4249-bed8-0554fcfe0b27.jpg","likes":2,"dislikes":1,"views":257,"release_date":"985910400000","season_number":1,"description":"زيم يحلم بالعظمة. لكن للأسف، هو غير كفء تماما كغزاة فضائي. يائسا للتخلص من زيم المزعج، يرسله قادة كوكبه في مهمة للتسلل إلى الأرض، موفرين له معدات متراكمة متبقية. ولدهشتهم، ينجح زيم في إقامة قاعدة على الأرض والتسلل إلى الثقافة البشرية، متظاهرا بأنه طفل بشري أثناء تخطيطه لسقوط الكوكب. فقط عدو زيم اللدود، ديب، يدرك أن زيم كائن فضائي، وبالطبع، لا أحد يصدق ادعاءات ديب.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"TV-PG"},"background_color":"","current_season_id":24276,"content_control":"NORMAL"}}