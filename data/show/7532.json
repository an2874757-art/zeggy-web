isk57/shows/29e8daba-bfb8-4356-a62b-aed759318ac3.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7532,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Crime"],"id":7532,"type":"MOVIE","title":"The Invisible","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/1bcfaf95-cc19-472a-9dc3-95f06dbbe86a.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/386daf77-ce70-4d64-80a2-c9ca90fb208b.jpg","likes":50,"dislikes":3,"views":8881,"release_date":"1177632000000","length":6142,"description":"Nick Powell is an excellent high-school student who raises money by selling homework and results of quizzes to his schoolmates. He aims to travel to London for a writer's course - telling his best friend, Pete Egan, that he has already bought the airplane ticket but he has not told to his mother yet. Annie Newton has a problem with Pete, who owes money to her. As events unfold, due to a case of mistaken identity Nick takes a severe beating from Annie and her gang, his body dumped in a sewer. The next morning, he discovers he cannot be seen - he is now a spirit in a state of limbo and can only observe as the events of that day unfold.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":7532,"content_control":"NORMAL"}}