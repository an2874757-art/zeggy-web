normalPoster"},{"data":[{"items":[],"id":4843,"title":"","description":"79","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":4843,"type":"MOVIE","title":"The Holiday","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/73221dac-0dff-4935-992b-12b960c3252a.jpg","background_image":"","likes":506,"dislikes":8,"views":42037,"release_date":"1165536000000","length":8146,"description":"In London, Iris Simpkins writes a wedding column in a newspaper and nurtures an unrequited love for her colleague Jasper Bloom. Near Christmas, she is informed that Jasper is engaged to marry another colleague, and her life turns upside down. In Los Angeles, the movie-trailers maker Amanda Woods has just split with her unfaithful boyfriend Ethan and wants to forget him. Through a house exchange website, Amanda impulsively swaps her mansion for Iris' cottage in Surrey for the holidays. While in Surrey, Amanda meets Iris' brother and book editor Graham and they fall in love with each other. Meanwhile, Iris meets her new next door neighbor the ninety year old screenplay writer Arthur, who helps her retrieve her self-esteem, and the film composer Miles, with whom she falls in love.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"episode_id":4843,"content_control":"NORMAL"}}