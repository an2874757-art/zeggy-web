":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/7c5b40ec-9935-48c7-bc53-66475596db20.jpeg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14468,"title":"Tehran","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk60/shows/2e1aa8b5-970d-44d2-aa4a-4c264da7bb41.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16808,"title":"The Flash","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk43/shows/e50cbb4c-c2d4-4ec8-9f08-5b275d92d42d.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15495,"title":"The Last Kingdom","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/3a08060b-1847-46fc-8e12-5d4d73ebf640.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":31446,"title":"Percy Jackson and the Olympians","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/7348a6fc-7783-461d-9bc5-189f3b01241d.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17205,"title":"","description":"41","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Drama","Thriller","War"],"id":17205,"type":"SERIES","title":"The Last Ship","logo":"","image":"https://cdn6.albox.co/storage/disk42/seasons/20415a03-3476-41ee-8966-8b7522c27280.jpeg","background_image":"https://cdn6.albox.co/storage/disk53/seasons/27f88281-1194-442a-892c-a8f91093d0c2.jpeg","likes":277,"dislikes":12,"views":72347,"release_date":"1403395200000","season_number":1,"description":"Naval Destroyer Nathan James is sent on what they're told is a research mission in the Arctic. Accompanying them is scientist, Rachel Scott. After a few months in the Arctic while Scott is on the ice doing research, some men attack them. They get back to the ship and the Commander, Tom Chandler asks the doctor what's going on. She says that a deadly disease broke out a few months ago. At first, they thought it was contained but they had no cure. They felt that the cure was in the Arctic which why she's here. But she has since received word that it has now spread to most of the globe. Chandler tries to call the President but learns the President and Vice President are dead and the US government might not have long to survive. The current President tells him that the Nathan James was not in the hot zone so he and his crew are OK. But now it's up to them to safeguard Scott because she holds the key to the planet's survival. But there are those who want the cure too and they will do whatever they have to, to get it. So they keep going and trying to find supplies and what they need so Scott can make the cure.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"pg-13"},"current_season_id":5204,"content_control":"NORMAL"}}