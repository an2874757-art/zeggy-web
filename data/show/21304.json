itle":"The Punisher","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/dee3ebb7-5109-4833-ae49-d1fab76b8041.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":21304,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy","Crime","Mystery"],"id":21304,"type":"SERIES","title":"Imposters","logo":"","image":"https://cdn6.albox.co/storage/disk57/seasons/41d73eb8-0ab1-4ad5-a05a-e003889582ce.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/628a4292-b8ad-46b9-92b6-db44d9c03e63.jpg","likes":15,"dislikes":0,"views":3961,"release_date":"1486425600000","season_number":1,"description":"Con artist Maddie is as beautiful as she is dangerous. Over the years, she has left a trail of unwitting victims who become tormented upon realizing that they have been used and robbed of everything -- including their hearts. Her latest assignment threatens to be derailed, though, when she meets Patrick, a potential love interest. Further complicating Maddie's work are three former targets -- Ezra, Richard and Jules -- who realize they have been scammed by the same woman and team up to track her down. When the victims choose to embark on the quest, they don't realize that they must face their own truths and find new versions of themselves along the way.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"current_season_id":10650,"content_control":"NORMAL"}}