ress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":42856,"title":"","description":"14","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy"],"id":42856,"type":"SERIES","title":"Romelia War Chronicle","logo":"https://cloud02.albox.co/shows/012fd7d3-3052-40d3-9b94-7e5645bab1ef.jpg","image":"https://cloud02.albox.co/seasons/8c2a3702-a2d3-4be9-b9b1-83c504dd5be4.jpg","background_image":"https://cloud02.albox.co/seasons/8937f0ae-7b3c-4bc2-b827-c3f1881a2231.jpg","likes":93,"dislikes":2,"views":11845,"release_date":"1791158400000","season_number":1,"description":"بعد هزيمة ملك الشياطين، تحطمت حياة الكونتيسة روميليا عندما فسخ خطيبها الأمير هنري خطوبتهما علنًا، واصفًا إياها بـ\"عديمة الفائدة\" إلى جانب حلفائه الجدد: القديسة إليزابيث، والحكيمة إيكاترينا، والمبارزة لو هيمي. ما لم يدركوه هو أن روميليا تمتلك قوة سرية تُدعى \"النعمة\"، والتي تجلب لها حظًا استثنائيًا. ورغم شعورها بالهجران والإذلال، رفضت روميليا الاستسلام. فوطنها لا يزال تحت حصار فلول الشيطان.…","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"NC-17"},"background_color":"#a0783c","current_season_id":25089,"content_control":"NORMAL"}}