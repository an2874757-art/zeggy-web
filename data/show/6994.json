:0},{"items":[],"id":34125,"title":"Borderlands","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/df58a327-0635-46e8-8f0c-7521724d49e9.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10046,"title":"Maze Runner: The Death Cure","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk45/shows/27167bc4-45da-4cb1-b7be-4a531b341ad8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":41580,"title":"Obsession","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/fddcf11c-27f0-4337-ba93-40d1cc2510b7.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35197,"title":"Red One","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/cb5ce371-7310-4cdf-bbd4-edbca9c57bac.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":73,"title":"Outside the Wire","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/58d9c2c3-62db-44eb-94d3-f6a9ab7ef4b1.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6994,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi","Drama","Romance"],"id":6994,"type":"MOVIE","title":"Another Earth","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/3ddcfd07-aa86-41a6-b096-c4b4593a2b4f.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/42afb68f-d958-4367-8e52-d0b6216ea654.jpg","likes":31,"dislikes":2,"views":4254,"release_date":"1318377600000","length":5545,"description":"SPOILER: Seventeen year-old Rhoda Williams receives an acceptance letter from MIT and she celebrates with her friends. On the same night, a planet similar and close to Earth is discovered and called Earth 2. Rhoda drives her car looking at Earth 2 and crashes with composer John Burroughs, killing his pregnant wife and his baby son. Rhoda goes to prison and four years later she is released and moves to her parents' house. She finds a job as high-school janitor, but tries to commit suicide. She survives, however, and submits an essay to a contest where the prize is a ticket to travel to Earth 2. Meanwhile the scientists discover that Earth 2 is a mirror of Earth and the synchronicity between the dwellers was interrupted when the planets were seen by each other. One day, Rhoda decides to visit John Burroughs, whose life was destroyed after the death of his family, to admit to him that she had killed his family. However she does not have the nerve to tell him the truth. So she lies and tells him he has won a free cleaning service of his home. Rhoda wins the writing contest, but meanwhile John and she have fallen in love with each other. Rhoda has to take a decision whether she goes or stays, but she wants to tell John the truth first.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"episode_id":6994,"content_control":"FAMILY"}}