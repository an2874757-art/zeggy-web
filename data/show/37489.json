gress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":37489,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance ","drama ","life "],"id":37489,"type":"SERIES","title":"Sunshine by My Side","logo":"","image":"https://cloud02.albox.co/seasons/b74bedc3-9dc7-4fb5-9cc4-6f50c02e0e08.jpg","background_image":"https://cloud02.albox.co/seasons/c15f1cb7-da5c-487b-bf21-d4abc39cabea.jpg","likes":37,"dislikes":0,"views":3322,"release_date":"1693526400000","season_number":1,"description":"في أحد الأيام، التقى جيان بينغ، مخرج إعلانات مشهور، وشنغ يانغ، الوافد الجديد إلى هذا المجال، صدفةً داخل مطعم. كان أحدهما قد أنهى زواجه للتو، بينما كان الآخر ينتظر نهاية حبه. في النهاية، نشأت بينهما علاقة وطيدة، وبدأ كل منهما رحلة نموّ رائعة ورومانسية ناشئة. بصحبة شنغ يانغ، استعادت جيان بينغ ثقتها بنفسها، في الحياة وفي الحب، بينما نضجت شنغ يانغ من شابة طليقة إلى شابة طموحة بفضل توجيه وتشجيع جيان بينغ. تعافى كل منهما من حزنه، ونشأ معًا، ومع مرور الوقت، تعلما أن يحبا بعضهما البعض.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"background_color":"","current_season_id":21728,"content_control":"NORMAL"}}