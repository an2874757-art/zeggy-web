rogress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":24340,"title":"","description":"73","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Historical"," Romance"," Drama"],"id":24340,"type":"SERIES","title":"The Red Sleeve","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/cb7b7aa5-23e8-42e5-ae6a-620832eb573e.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/e56caf87-813d-466a-bab5-3a743faf53eb.jpg","likes":280,"dislikes":2,"views":21090,"release_date":"1636675200000","season_number":1,"description":"في كوريا خلال النصف الأول من القرن الثامن عشر الميلادي ، كان يي سان أميرًا شابًا منعزلًا ومحبًا للكمال. يطارده مقتل والده ، على الرغم من أنه يتركه في وضع يسمح له بتولي العرش بمجرد وفاة جده - الملك الحالي القاسي والقاسي المسؤول عن وفاة والد يي سان. لقد عقد العزم على أن يصبح ملكًا خيرًا من شأنه أن يصلح القانون عندما يتولى العرش في النهاية ، لكن الطريقة التي قُتل بها والده أثرت عليه عاطفيًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"R"},"background_color":"","current_season_id":12700,"content_control":"NORMAL"}}