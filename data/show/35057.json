ons/363713d8-abff-4784-be4f-a3736d90a885.jpg","background_image":"https://cloud02.albox.co/seasons/38753b73-1b11-46da-bc00-91c37d86a222.jpg","likes":17,"dislikes":0,"views":1129,"release_date":"1655856000000","season_number":1,"description":"كوراتا سوي رجل يبلغ من العمر 30 عامًا، صادق ولطيف مع الناس. ركب الطائرة لأول مرة عندما كان طالبًا في المدرسة الإعدادية. بعد ذلك، كان يرغب دائمًا في أن يصبح طيارًا للطائرات. أخيرًا، بعد الخضوع لتدريب صارم، تمت ترقيته إلى أول ضابط في شركة طيران. في أحد الأيام، بصفته أول ضابط في الرحلة، واجه وقتًا عصيبًا بسبب سوء الأحوال الجوية. وبفضل العمل الممتاز لمراقب الحركة الجوية، تمكن كوراتا سوي والكابتن من هبوط الطائرة بأمان في مطار هانيدا. منذ ذلك الحين، على الرغم من أنه لا يعرف اسمها أو شكلها، فقد وقع كوراتا سوي في حب مراقب الحركة الجوية بمجرد الاستماع إلى صوتها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"background_color":"","current_season_id":19881,"content_control":"FAMILY"}}