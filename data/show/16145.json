n6.albox.co/storage/disk51/shows/6efdbe7b-1516-447e-81ff-23137d4fce48.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16145,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi","Thriller"],"id":16145,"type":"SERIES","title":"Killjoys","logo":"","image":"https://cdn6.albox.co/storage/disk42/seasons/8fbef4bf-9a47-448d-b0da-0613f641519e.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/b28cfeb4-2959-4c15-b74d-f5f3f54f3469.jpg","likes":7,"dislikes":0,"views":2363,"release_date":"1434672000000","season_number":3,"description":"Killjoys is a fast paced space adventure about a trio of hard-living, party-loving bounty hunters working for the R.A.C (Recovery and Apprehension Coalition). An Independent interplanetary organization of assassins and retrieval experts, who are known across the J cluster as Killjoys. The show centers on their lives and activities in the Quad, a heavily populated solar system, ruled by a tyrannical class based corporation known as the company. With the whole system verging on revolutionary war and their own bloody pasts finally catching up with them. The three struggle daily to maintain their R.A.C neutrality by focusing on the only law a Killjoy won't break \"The Warrant is all\".","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"current_season_id":3697,"content_control":"NORMAL"}}