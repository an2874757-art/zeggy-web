//cloud01.albox.co/shows/65601b8e-e25b-4287-a9a8-51b29ed73fb6.jpg","background_image":"https://cloud01.albox.co/shows/05c5d4c7-e8c3-4e72-9a39-4d83035dd64e.jpg","likes":27,"dislikes":2,"views":9032,"release_date":"1713484800000","length":6067,"description":"ريكي المتهور يحقق أموالاً جادة من تجارة الأسلحة غير المشروعة في منطقة ثلاث ولايات، ويحب أن يتباهى بها. كليف، بائع متجول، يغطي نفس المنطقة التي يدير فيها ريكي تهريب الأسلحة. يوافق كليف، الذي يبحث عن بعض الراحة المالية لعائلته المكافحة، على التعاون مع ريكي للقيام بتوصيلات عبر الولايات للمخدرات والأسلحة بالنيابة عن زعيم عصابة متوسط المستوى يدعى جون. عندما يتحول التبادل البسيط إلى مجزرة بعد أن يقتل ريكي الجميع في محاولة للاستيلاء على الأراضي، يجد الزوجان أنفسهما في موقف صعب حيث يجب على كليف، الذي يبدو غير مرجح أن يكون تاجرًا للمخدرات، أن يقاتل بكل ما لديه للبقاء على قيد الحياة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":920027,"background_color":"#c4a296","content_control":"FAMILY"}}