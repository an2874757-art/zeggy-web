n_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":41815,"type":"SERIES","title":"Xiao Fang","logo":"","image":"https://cloud02.albox.co/shows/73fb4600-db4e-41ab-ae1f-982bf8a995e6.jpg","background_image":"https://cloud02.albox.co/shows/8f6d47bd-44c1-42a1-9015-81c8463a9895.jpg","likes":18,"dislikes":1,"views":2423,"release_date":"1783900800000","season_number":1,"description":"It tells the story of Yang Xiaofang and Qi Xiaowei from the same village, who become pregnant before marriage. Yang's family rushes back to the village to strategize for Xiaofang. The Qi and Yang families have completely different attitudes, unexpectedly sparking a \"marital storm.\" After negotiations between the two families fail, Xiaofang starts \"blind dates while pregnant\" — and surprisingly finds herself courted by the whole village, setting off a series of hilarious and laugh-out-loud events.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"NC-17"},"background_color":"#000","current_season_id":24387,"content_control":"NORMAL"}}