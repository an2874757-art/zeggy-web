ype":"normalPoster"},{"data":[{"items":[],"id":18870,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller","Crime"],"id":18870,"type":"SERIES","title":"Nikita","logo":"","image":"https://cdn6.albox.co/storage/disk48/seasons/acbb9bc7-8ee2-417b-b258-481af668bde7.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/8d2e2674-413e-4d8c-86b8-98f5aefc39d9.jpg","likes":71,"dislikes":3,"views":26784,"release_date":"1283990400000","season_number":1,"description":"When she was a deeply troubled teenager, Nikita was rescued from death row by a secret U.S. agency known only as Division, who faked her execution and told her she was being given a second chance to start a new life and serve her country. What they didn't tell her was that she was being trained as a spy and assassin. Throughout her grueling training at Division, Nikita never lost her humanity, even falling in love with a civilian. When her fiancé was murdered, Nikita realized she had been betrayed and her dreams shattered by the only people she thought she could trust, so she did what no one else before her had been able to do: she escaped. Now, after three years in hiding, Nikita is seeking retribution and making it clear to her former bosses that she will stop at nothing to expose and destroy their covert operation.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"current_season_id":7269,"content_control":"NORMAL"}}