id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18772,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","School","Martial Arts"],"id":18772,"type":"SERIES","title":"Natsuki Crisis","logo":"","image":"https://cdn6.albox.co/storage/disk55/seasons/6ceb7357-c59b-44db-9977-4dc4c85267c1.jpg","background_image":"https://cdn6.albox.co/storage/disk45/seasons/3e1e9313-5afe-411b-a123-d0f159dbc598.jpg","likes":8,"dislikes":3,"views":4325,"release_date":"761961600000","season_number":1,"description":"Natsuki is the top female karateka in her high school. Beautiful and cheerful, she charms most people she meets. Most of the young men in her class would dearly like to be the object of her affection but she saves her passion for karate. Unfortunately, all the big ugly thugs she comes across want to fight her so she's always finding practical application for her karate skills. As the series continues and her opponents get grimmer, Natsuki learns techniques from Akido and Judo and develops a special Ki energy blast that doubles the strength of her punches. She may not be able to smash walls like some of her opponents but her special N.G. Bomber usually sends her opponents flying.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"current_season_id":7142,"content_control":"NORMAL"}}