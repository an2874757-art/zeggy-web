box.co/shows/775dfb9e-d2e7-4244-b053-4b97aec40160.png","image":"https://cloud02.albox.co/seasons/250f7a7a-ad26-437c-8821-0c0b40e3393e.jpg","background_image":"https://cloud02.albox.co/seasons/bdd72054-4f28-4919-acaa-f79864111a75.jpg","likes":105,"dislikes":4,"views":8574,"release_date":"1587772800000","season_number":1,"description":"هناك طبيبة روحية قوية، مشهورة في عالم الياوجاي (الأرواح الواعية/الشياطين/الحيوانات/قوى الطبيعة)، ترتدي جرسًا صامتًا، على الرغم من أن قِلة من الناس يعرفون شكلها. تسافر حول العالم لمساعدة الياوجاي الذين يعانون من أمراض روحية مختلفة، وأحيانًا تساعد البشر على طول الطريق. يرافقها راهب شاب وشيطان ثعبان في هيئة رجل. نلقي نظرة على قصص الياوجاي المختلفة ومصادر معاناتهم.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG-13"},"background_color":"#000000","current_season_id":19854,"content_control":"NORMAL"}}