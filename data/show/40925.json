,"title":"Witch Hat Atelier","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/b065cf1e-23aa-4dbd-b6eb-acec0e204cb6.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":40925,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action"],"id":40925,"type":"SERIES","title":"Dead Account مدبلج","logo":"","image":"https://cloud02.albox.co/seasons/fd77ed6d-59c4-4be9-9f58-581bbc942ed4.jpg","background_image":"https://cloud02.albox.co/seasons/7c873349-4aa4-418f-88d1-d1ff496b0ed3.jpg","likes":50,"dislikes":1,"views":4118,"release_date":"1768003200000","season_number":1,"description":"مستعدٌ دائمًا للمواجهة! الدمار لمجرد الدمار! أورينغو، مقدم البث المباشر على الإنترنت، مُثيرٌ للمشاكل، يُقدم أسوأ أنواع المحتوى الاستفزازي المُثير للجدل، ويجني أرباحًا طائلة من مُشاهديه الكارهين. قد تظن أنه مُجرد شخصٍ انتهازي وعبءٍ على المجتمع، لكن في الحقيقة، هو سوجي إنيشيرو، طالبٌ مُتسربٌ من المدرسة الثانوية، أخٌ أكبر مُحبٌ للحلويات، لا يُحب شيئًا أكثر من أخته الصغيرة. فيديوهاته الفيروسية؟ مجرد وسيلةٍ لدفع فواتير علاج أخته. وحتى لو كرهه جميع البشر، فهو لا يُبالي، طالما أن أخته الصغيرة تتعافى. ولكن فجأةً، يبدأ شيءٌ غريبٌ جدًا بالحدوث... لا تفوتوا الظهور الأول لهذه المانغا الحديثة عن طرد الأرواح الشريرة!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-14"},"background_color":"","current_season_id":23866,"content_control":"NORMAL"}}