_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":29814,"title":"","description":"42","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Youth"," Thriller"," Mystery"],"id":29814,"type":"SERIES","title":"Home School","logo":"","image":"https://cloud01.albox.co/seasons/479692a4-18ca-4ed7-9cf6-38f859deee65.jpg","background_image":"https://cloud01.albox.co/seasons/46898436-88f6-4e04-b652-bfcc25333755.jpg","likes":427,"dislikes":6,"views":26132,"release_date":"1686268800000","season_number":1,"description":"Home School هي مدرسة داخلية في وسط غابة نائية. كل ثلاث سنوات ، تختار المدرسة الطلاب الجدد الذين يستوفون معاييرهم ، ولا يضم كل جيل أكثر من ثلاثة عشر طالبًا. يقضي الطلاب ما مجموعه ثلاث سنوات في المدرسة. تهدف المدرسة إلى جذب الطلاب الأثرياء بمنهجها الفريد وجميع وسائل الراحة المنزلية. ومع ذلك ، فإن Home School تبدو وكأنها سجن أكثر من كونها مدرسة بقواعدها الصارمة وعزلتها الصارمة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"background_color":"","current_season_id":16935,"content_control":"NORMAL"}}