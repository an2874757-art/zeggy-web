le":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":20958,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Mystery","Horror"],"id":20958,"type":"SERIES","title":"Scream Queens","logo":"","image":"https://cdn6.albox.co/storage/disk53/seasons/88da3930-e57a-456c-83a6-ffef5043c2f7.jpg","background_image":"https://cdn6.albox.co/storage/disk55/seasons/24ec788a-b33b-4abb-a623-5d7a32614151.jpg","likes":197,"dislikes":4,"views":27746,"release_date":"1474329600000","season_number":1,"description":"Wallace University is rocked by a string of murders. Kappa House, the most sought-after sorority for pledges, is ruled with an iron fist (in a pink glove) by its Queen Bitch, Chanel Oberlin (Emma Roberts). But when anti-Kappa Dean Cathy Munsch (Jamie Lee Curtis) decrees that sorority pledging must be open to all students, and not just the school's silver-spooned elite, all hell is about to break loose, as a devil-clad killer begins wreaking havoc, claiming one victim, one episode at a time. Part black comedy, part slasher flick, SCREAM QUEENS is a modern take on the classic whodunit, in which every character has a motive for murder... Or could easily be the next blood-soaked casualty.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"PG-13"},"current_season_id":10119,"content_control":"NORMAL"}}