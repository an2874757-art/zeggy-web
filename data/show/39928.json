sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4}],"value":4,"age":"PG-14"},"background_color":"","current_season_id":23289,"content_control":"NORMAL"}}