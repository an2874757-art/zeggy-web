tinue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Animation","Science Fiction"],"id":40134,"type":"MOVIE","title":"Star Wars: The Clone Wars","logo":"https://cloud02.albox.co/shows/a9ec2de7-7bbb-4707-bdae-13783169d958.png","image":"https://cloud02.albox.co/shows/f693e836-b302-4131-bda9-967e4949dfb5.jpg","background_image":"https://cloud02.albox.co/shows/5ebee5f0-eb03-4994-9e66-3c675b6ed249.jpg","likes":11,"dislikes":0,"views":2197,"release_date":"1217894400000","length":5905,"description":"بينما تجتاح حروب المستنسخين المجرة، يكافح فرسان الجيداي الأبطال للحفاظ على النظام واستعادة السلام. المزيد والمزيد من الأنظمة تقع فريسة لقوى الجانب المظلم بينما تنزلق الجمهورية المجرة أكثر فأكثر تحت تأثير الانفصاليين وجيشهم الروبوتي الذي لا ينتهي. يجد أناكين سكاي ووكر ومتعلمته المتعلمة أهسوكا تانو نفسيهما في مهمة ذات عواقب بعيدة المدى، تجعلهما يواجهان زعيم الجريمة جابا ذا هت. لكن الكونت دوكو وعملاؤه الأشرار، بمن فيهم أساج فينتريس الشريرة، لن يتوقفوا عند أي شيء لضمان فشل أنكين وأهسوكا في مهمتهم. وفي الوقت نفسه، على خطوط المواجهة لحروب المستنسخين، يقود أوبي-وان كينوبي والمعلم يودا جيش المستنسخين الضخم في جهد شجاع لمقاومة قوات الجانب المظلم...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.5}],"value":8.5,"age":"TV-PG"},"episode_id":1042406,"background_color":"#ffdc3c","content_control":"FAMILY"}}