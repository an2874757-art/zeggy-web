aped. She wants to leave Riga behind and travel with her brother Hengov to another place, but he does not agree with her intention.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"episode_id":1703,"content_control":"NORMAL"}}