_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6299,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Drama","Romance","Thriller"],"id":6299,"type":"MOVIE","title":"Deep Impact","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/ccb9bd77-cf40-4dd3-be4f-58b1ebea648a.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/dfb3a853-6972-47bd-99a4-5fe552f0a0f2.jpg","likes":60,"dislikes":5,"views":8880,"release_date":"894585600000","length":7271,"description":"Journalist Jenny Lerner is assigned to look into the background of Secretary Alan Rittenhouse who abruptly resigned from government citing his wife's ill health. She learns from his secretary that Rittenhouse was having an affair with someone named Ellie but when she confronts him, his strange reaction leads her to reconsider her story. In fact, a comet, discovered the previous year by high school student Leo Biederman and astronomer Dr. Marcus Wolf, is on a collision course with the Earth, an Extinction Level Event. A joint US-Russian team is sent to destroy the comet but should it fail, special measures are to be put in place to secure the future of mankind. As the space mission progresses, many individuals deal with their fears and ponder their future.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"PG-13"},"episode_id":6299,"content_control":"FAMILY"}}