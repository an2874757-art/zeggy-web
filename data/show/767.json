eapons. When Marianne is chased by terrorists, they decide to travel to the beach without any money, leaving Paris and his family behind in a crazy journey to nowhere.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"episode_id":767,"content_control":"NORMAL"}}