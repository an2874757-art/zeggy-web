ows/61702929-d41a-476d-8c62-79af1a32afec.jpg","background_image":"https://cloud02.albox.co/seasons/56de35ed-a826-4795-b6e8-9988a0d01011.jpg","likes":31,"dislikes":0,"views":1609,"release_date":"1167609600000","season_number":1,"description":"تدور الأحداث حول (أوتيس) البقرة، الذي يتولى مسئولية رعاية المزرعة والحفاظ على نظامها بكل ما فيها من حيوانات، ورغم هذه المسئولية الكبيرة، لا يستطيع (أوتيس) مقاومة رغبته في اللعب والمرح طوال الوقت مع أصدقائه الفأر \"بيب\"، والخنزير \"بيج\"، والنِّمس \"فريدي\"، والبقرة \"بيسي\"، والديك \"بيك\"، والذين يساعدونه في رعاية المزرعة وحمايتها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"TV-PG"},"background_color":"","current_season_id":23296,"content_control":"NORMAL"}}