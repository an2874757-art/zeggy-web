rogress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9552,"title":"","description":"1165","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy"],"id":9552,"type":"MOVIE","title":"Men, Women & Children","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/7d469eb2-4328-40c3-98f0-e99d2087f5e3.jpg","background_image":"","likes":95,"dislikes":4,"views":10736,"release_date":"1413504000000","length":7167,"description":"Men, Women and Children follows the story of a group of high school teenagers and their parents as they attempt to navigate the many ways the internet has changed their relationships, their communication, their self-image, and their love lives. The film attempts to stare down social issues such as video game culture, anorexia, infidelity, fame hunting, and the proliferation of illicit material on the internet. As each character and each relationship is tested, we are shown the variety of roads people choose - some tragic, some hopeful - as it becomes clear that no one is immune to this enormous social change that has come through our phones, our tablets, and our computers.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":9552,"content_control":"FAMILY"}}