ES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/323945be-3148-4a28-b411-7ef7213e7d39.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":23734,"title":"ديون الحب ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/d755d5d6-3cde-4bc7-80c4-9688eb0a58ed.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17603,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":17603,"type":"SERIES","title":"وهم الكمال","logo":"","image":"https://cdn6.albox.co/storage/disk51/seasons/ad39bac0-1aab-43d8-b47e-3e851a798a06.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/6a063bf4-9c96-4815-a059-52ace6c0ffda.jpg","likes":44,"dislikes":0,"views":17019,"release_date":"-2208988800000","season_number":1,"description":"عندما يصل الإنسان حد الكمال ويتضح أن هذا الكمال مجرد وهم هكذا تكون قصتنا مع جانفي فليس كل ما تراه العين حقيقي فيمكن أن ننخدع أيضاً فيما نراه ، جانفي هي كنة عائلة مرموقة ونموذج مثالي للكنة فالجميع يتمني أن يصبح مثلها في كمالها ومثاليتها فهي يمكنها أن تفعل أي شئ من أجل عائلتها ويمكنها أن تضحي بكل حياتها لحماية زوجها وعائلتها فهي معروفة بالقلب النقي والطيبة والحب الذي تنشره في كل أرجاء المنزل وتعامل كل عائلتها بحب ولكن لا أحد يعرف أن جانفي لديها وجه آخر لا أحد يعرف به ، يخفي أسرار ودوافع شريرة تجاه عائلتها فهي ترغب دائماً بالتخلص من تلك العائلة وتخطط للأنتقام منها فهي كالسم في العسل ولكن ما الذي يدفع جانفي لحمل الأحقاد تجاه تلك العائلة ؟ ولماذا تريد التخلص منهم ؟ وهل هناك سر بينها وبين أخيها في القانون وشقيق زوجها ، كابير ؟ أم إنها تظهر حقاً ما تُعنيه ؟ تُري ماذا ستفعل جانفي بهذه العائلة ؟ وهل سيكتشف أفراد عائلتها بدوافعها الخفية أم سيظلوا في وهم إنها مثالية وكاملة الأوصاف ؟ وهل ستنجح جانفي في خططها وتستمر بالتظاهر أم ستفشل ؟ فماذا يخبئ القدر لجانفي وعائلتها وماذا ستفعل لهم ؟ ، كل هذا سنعرفه مع وهم الكمال ، لنري ماذا سيحدث ؟!","rating":{"sources":[],"value":0,"age":"PG-13"},"current_season_id":5712,"content_control":"NORMAL"}}