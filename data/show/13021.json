ited between two misfits longing for acceptance and true love.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"R"},"episode_id":13021,"content_control":"NORMAL"}}