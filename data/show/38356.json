ckground_image":"https://cloud02.albox.co/seasons/f2de9022-d020-4464-93ba-cb86c46bd56d.jpg","likes":42,"dislikes":3,"views":7541,"release_date":"1759968000000","season_number":1,"description":"تدور أحداث رواية \"البعث\" في مدينة بنكا الخيالية، وتدور أحداثها حول أمّين تجمعهما الكراهية، تسعيان للانتقام لابنتيهما المتورطتين في قضية احتيال واختطاف. بمساعدة إلهة غامضة، تُعيدان زعيم عصابة الاحتيال المتوفى إلى الحياة لمعاقبته. ومع ذلك، ورغم الألم الشديد الذي يُلحقانه، يبقى غضبهما عارمًا. ومع انكشاف الأسرار المظلمة، يُختبر تحالفهما، مما يُجبرهما على مواجهة حدود العدالة وأخلاقياتهما.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"NC-17"},"background_color":"#787878","current_season_id":22267,"content_control":"FAMILY"}}