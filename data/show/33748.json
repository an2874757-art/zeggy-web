ormalPoster"},{"data":[{"items":[],"id":33748,"title":"","description":"12","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Western"],"id":33748,"type":"MOVIE","title":"Horizon: An American Saga - Chapter 1","logo":"https://cloud02.albox.co/shows/284fe3fb-425c-4e8c-8b7e-dc0d0100feeb.png","image":"https://cloud02.albox.co/shows/7cf191c0-4ef3-4a7b-9efd-c09f02158480.jpg","background_image":"https://cloud02.albox.co/shows/8c5d9f16-55fe-4c75-adf5-88bce7faa139.jpg","likes":59,"dislikes":5,"views":11227,"release_date":"1719360000000","length":10884,"description":"اكتشف إغراء الغرب القديم وكيف تم الفوز به - وخسره - من خلال دماء وعرق ودموع الكثيرين. تمتد أحداث الفيلم على مدى 15 عامًا قبل الحرب الأهلية وأثناءها وبعدها، من عام 1859 إلى عام 1874، وتبدأ في رحلة عاطفية عبر بلد في حالة حرب مع نفسها، وتختبرها من خلال عدسة العائلات والأصدقاء والأعداء الذين يحاولون اكتشاف ما يعنيه حقًا أن تكون الولايات المتحدة الأمريكية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":932166,"background_color":"#ede7d3","content_control":"NORMAL"}}