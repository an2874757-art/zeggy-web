":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"NC-17"},"background_color":"#ffffff","current_season_id":23143,"content_control":"NORMAL"}}