.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8280,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":8280,"type":"MOVIE","title":"The Switch","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/6326a77c-96c7-4b15-892f-25b81ee519c2.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/59294b8f-e3cc-4740-ab20-19245aa97cdc.jpg","likes":20,"dislikes":1,"views":4085,"release_date":"1282262400000","length":6083,"description":"Kassie (Jennifer Aniston) and Wally (Jason Bateman) are best friends. Being unlucky in love, Kassie has decided to have a child using artificial insemination. Wally doesn't like this idea, but he isn't capable of admitting to himself, let alone to Kassie, that he's in love with her. At Kassie's artificial insemination party, Wally gets very drunk and spies the sperm donor's sample in the bathroom. Wally was way too drunk to know what he did that night, and Kassie has moved away because she doesn't feel that New York City is a place to raise a child. Now 7 years later, Kassie has moved back with her son Sebastian. While she is looking to get Roland (the sperm donor) more involved in their lives, Wally can't help but notice the many striking similarities that he and Sebastian share.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":8280,"content_control":"FAMILY"}}