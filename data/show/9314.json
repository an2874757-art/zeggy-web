":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/d7f0b353-c56f-451f-acb5-4729afb92a30.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9314,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy","Crime"],"id":9314,"type":"MOVIE","title":"The Mexican","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/a9035f98-6105-4bd1-9124-b4e301b04ef5.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/bc55d27b-eedc-456c-80df-b6342a8d4415.jpg","likes":57,"dislikes":1,"views":9253,"release_date":"983491200000","length":7409,"description":"Jerry Welbach is given two ultimatums. His mob boss wants him to travel to Mexico to get a priceless antique pistol called \"The Mexican\" or he will suffer the consequences. The other ultimatum comes from his girlfriend Samantha, who wants him to end his association with the mob. Jerry figures that being alive, although in trouble with his girlfriend is the better alternative so he heads south of the border. Finding the pistol is easy but getting it home is a whole other matter. The pistol supposedly carries a curse - a curse Jerry is given every reason to believe, especially when Samantha is held hostage by the gay hit man Leroy to ensure the safe return of the pistol.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"episode_id":9314,"content_control":"NORMAL"}}