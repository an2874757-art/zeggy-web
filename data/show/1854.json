alPoster"},{"data":[{"items":[],"id":1854,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy"],"id":1854,"type":"MOVIE","title":"Twinkle Twinkle Lucky Stars","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/4edba5c0-068a-4068-ba58-5b28a12d617b.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/34bdeff7-fed2-4826-8a08-2c403b6d1363.jpg","likes":44,"dislikes":4,"views":7287,"release_date":"492912000000","length":5668,"description":"A police informant sent a letter containing sensitive information on an illegal drug operation to his friend, Yi-Ching. While on vacation in Thailand, the informant is assassinated by the drug lord's henchmen and, to cover-up their operation, they attempt to eliminate Yi-Ching and double-agent Lau. Back in Hong Kong, police detectives Muscles and Ricky Fung are assigned to protect Lau and Inspector Barbara Woo is assigned to protect Yi-Ching. She takes her to the hideout of the \"Five Lucky Stars\" and also enlists their help in bringing down the drug operation.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"PG-13"},"episode_id":1854,"content_control":"NORMAL"}}