3620,"title":"","description":"14","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Family"],"id":3620,"type":"MOVIE","title":"Problem Child","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/57076e5d-d1b1-4b3e-b38c-fb8da0e75cb0.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/eb822762-8e8c-4b00-ac29-f86999eba140.jpg","likes":131,"dislikes":6,"views":8003,"release_date":"649036800000","length":4847,"description":"The story of a seven-year-old mischievous orphan boy named Junior. He is hardly a model child; mean-spirited and incorrigible. One day, he is adopted by a loving man along with his obnoxious wife named Ben Healy and Flo Healy. Ever since Junior comes into their lives, he turns ordinary days into full-scale comic nightmares! He also leaves a path of serious destruction in his wake, and is even pen pals with Martin Beck (A.K.A. The Bow Tie Killer, a notorious serial killer who kidnaps his faithful correspondent, along with Flo). And now it's up to Ben as he undertakes a rescue mission to get Junior back from Beck before he plans on hurting him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"episode_id":3620,"background_color":"","content_control":"FAMILY"}}