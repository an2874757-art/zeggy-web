s":[],"id":5191,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","History","War"],"id":5191,"type":"MOVIE","title":"Midway","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/483a1692-c97f-4fe1-9e9e-0213734d3556.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/b02db63b-4ec1-42e7-96b1-0fdd01958569.jpg","likes":7,"dislikes":0,"views":2875,"release_date":"203904000000","length":7888,"description":"The summer of 1942 brought Naval stalemate to the Pacific as the American and Japanese fleets stood at even numbers each waiting for the other to begin a renewed offensive. \"Midway\" tells the story of this historic June battle where a Japanese carrier force, in an attempt to occupy Midway island and lure the American fleet to destruction, was meet valiently by US forces operating off of three aircraft carriers and numerous escort ships. It was the first battle in which naval air power was extensivly used, and at its conclusion the Japanese Carrier force had been completly destroyed which lead the way for the US 1943 and 44 offensives which would eventually bring the Pacific War to a close.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG"},"episode_id":5191,"content_control":"NORMAL"}}