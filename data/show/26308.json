ard_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":26308,"type":"SERIES","title":"جولبيري (مدبلج)","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/0690233e-8708-42c2-a066-84ee3d2e0047.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/db3dfcb4-96d5-4d95-99e8-9d6ecc989987.jpg","likes":178,"dislikes":3,"views":42089,"release_date":"1529712000000","season_number":1,"description":"تدور أحداث المسلسل حول الأم جولبيري التي تقوم بدورها الممثلة نور غول يشيلتشاي والتي تُفجَع بوفاة زوجها وتبقى لرعاية أبنائها، ولكن عائلة زوجها لا تساندها وتقف عائقًا بينها وبين أبنائها ويكون والد زوجها يعقوب الذي يقوم بدوره الممثل طارق بابوكوغلو، إذ يحرمونها منهم بعد معاناة شديدة خلال حياتها بينهم فيتهمونها بمحاولة قتل أحد أبنائهم -عم أبنائها- وتدخل السجن على إثر ذلك، وبعد خروجها تبدأ كفاحها لاستعادة أبنائها فتجد عملًا في إحدى دور الأزياء، كما أنّها تبحث عن محامٍ ليساعدها في حربها مع عائلة زوجها، بحيث تلتقي المحامي قادر أيدن الذي يقوم بدوره الممثل تيموشن إيسين وتجمعهما علاقة حب، فهل يستطيع المحامي استعادة أبنائها؟ ما ردة فعل الأبناء اتجاه أمهم؟\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"","current_season_id":14140,"content_control":"NORMAL"}}