albox.co/shows/2b2251df-0db4-4da7-ac93-587ab6575e97.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8380,"title":"","description":"13","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Romance","Comedy"],"id":8380,"type":"MOVIE","title":"Bewitched","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/0a80628d-dd9c-47f2-8a15-654f37330167.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/bf4ff933-e0c4-4920-8d31-6070b10dde8a.jpg","likes":111,"dislikes":5,"views":7684,"release_date":"1119571200000","length":6121,"description":"Out in California's San Fernando Valley, Isabel is trying to reinvent herself. A naïve, good-natured witch, she is determined to disavow her supernatural powers and lead a normal life. At the same time, across town, Jack Wyatt a tall, charming actor is trying to get his career back on track. He sets his sights on an updated version of the beloved 1960s situation comedy Bewitched, re-conceived as a starring vehicle for himself in the role of the mere-mortal Darrin. Fate steps in when Jack accidentally runs into Isabel. He is immediately attracted to her and her nose, which bears an uncanny resemblance to the nose of Elizabeth Montgomery, who played Samantha in the original TV version of Bewitched. He becomes convinced she could play the witch Samantha in his new series. Isabel is also taken with Jack, seeing him as the quintessential mortal man with whom she can settle down and lead the normal life she so desires. It turns out they're both right--but in ways neither of them ever imagined.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.8}],"value":4.8,"age":"PG-13"},"episode_id":8380,"content_control":"NORMAL"}}