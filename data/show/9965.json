:"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy","Animation"],"id":9965,"type":"MOVIE","title":"Paddington","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/ce7c311d-0603-4882-8f9c-a4524a9de201.jpg","background_image":"","likes":251,"dislikes":4,"views":17430,"release_date":"1421366400000","length":5712,"description":"A young Peruvian bear with a passion for all things British travels to London in search of a home. Finding himself lost and alone at Paddington Station, he begins to realize that city life is not all he had imagined - until he meets the kind Brown family, who read the label around his neck ('Please look after this bear. Thank you.') and offer him a temporary haven. It looks as though his luck has changed until this rarest of bears catches the eye of a museum taxidermist.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG"},"episode_id":9965,"content_control":"FAMILY"}}