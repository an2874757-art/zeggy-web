description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":20512,"type":"SERIES","title":"شخلول","logo":"","image":"https://cdn6.albox.co/storage/disk53/seasons/204f33ac-764c-4a95-9cbc-d9941b7add1a.jpg","background_image":"https://cdn6.albox.co/storage/disk47/seasons/9c582831-b1ca-4b32-9b1e-710fc060cbe9.jpg","likes":0,"dislikes":0,"views":520,"release_date":"-2208988800000","season_number":1,"description":"مسلسل شخلول : تدور الاحداث فى عصر ما قبل الثورة عن شخصية انتهازية وصولية تدعى شخلول الذى ورث عن ابيه محل تجارى متواضع فى الريف ثم توسع اكثر فى التجارة التى تتضاعف من خلال احتكار السلع الرئيسية مما دفعه الى مجالسة كبار رجال الدولة (العمدة و المأمور و مدير المديرية) و تطلع الى الزواج من \"عزيزة\" ابنه العمدة الجميلة رغم انفها لارتباطها بطبيب القرية فى احلامها لكن الازمة المالية التى مر بها والدها العمدة و بيع جزء كبير من ارضه استغل شخلول ذلك بشراء الارض ووضعها بين يدى العمدة مهراً لابنته التى استسلمت بعد ان لوح لها شخلول بالمال و الجواهر. و تحدث تغيرات سياسية للمناصب القيادية تؤثر على مسيرة \"شخلول\" فى حياته حيث يساعد احد المسؤولين طمعا فى زواج شقيقته ليدعم مركزه المالى و اعماله التجارية و عندما يرفض المسؤول هذا الـزواج النفعى يظهر شخلول وجهـه الحقـيقى و يتمكن من القضاء على مستقبلة السياسى بعد خطة جهنمية لفضحه . و تتوالى الاحداث و يصعد نجم شخلول السياسى مع مرور الزمن و الايام ...و يظل يتمتع بثروته و نفوذه التى نهبها من قوت الملايين فى عصر يسمح بالانتهازية و الوصولية و الفساد \r\n","rating":{"sources":[],"value":0,"age":"N/A"},"current_season_id":9498,"content_control":"NORMAL"}}