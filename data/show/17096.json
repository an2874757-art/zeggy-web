s":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17096,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Shoujo","Slice of Life"],"id":17096,"type":"SERIES","title":"Bonjour Sweet Love Patisserie","logo":"","image":"https://cdn6.albox.co/storage/disk50/seasons/0b70030f-47b6-4b1a-a9fd-46f94b28a564.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/addd2494-2458-49a4-8fc2-732f4e77d72e.jpg","likes":37,"dislikes":0,"views":3349,"release_date":"1412985600000","season_number":1,"description":"Sayuri Haruno dreams of becoming a pastry chef and enrolls in Fleurir Confectionary Academy, an elite school located in Tokyo's trendy Aoyama district. At Fleurir, she finds herself surrounded by charming boys, each one distinctly unique. Out of the entire class, Ryou Kouzuki's desire to become a pastry chef is the strongest. Blessed with unparalleled technique, instructor Mitsuki Aoi acts like a prince and is hugely popular at the school. Gilbert Hanafusa, the mood maker of the bunch, is a student from France. Yoshinosuke Suzumi is not very good at expressing his feelings, but underneath his stony exterior lies a wholehearted passion for wagashi (Japanese sweets).","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"current_season_id":5065,"content_control":"NORMAL"}}