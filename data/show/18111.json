,"style":{"image":"https://cloud02.albox.co/shows/b83d825c-443a-46e0-8ab5-88724e72bea2.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18111,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Romance","Supernatural","Martial Arts"],"id":18111,"type":"SERIES","title":"The Golden Eyes","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/b22c0164-e7be-45a5-8bc3-7ef86030e1ef.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/19837978-4911-4ac3-8a46-fb6e196d325c.jpg","likes":187,"dislikes":3,"views":15386,"release_date":"1551139200000","season_number":1,"description":"It is said that only individuals with the \"spirit language\" (言灵 in Chinese and Kotodama in Japanese) can possess a pair of Golden Eyes. A simple pawn shop worker, Zhuang Rui (Zhang Yixing) had his own eyes mutated after an accident while he was dealing with some ancient bronze and ceramic. His mutated eyes subsequently brought many changes to his life in many unexpected ways he could ever imagined. His new life started after he adopted the pair of special eyes and his spiritual adventure began. The dragon clan are the only individuals who have access to this power and Chuzi is the only person apart from the dragon clan who can utilise this magic power. However, Chuzi's level of mastery over the pair of golden eyes is not equal to that of the two brothers from the dragon clan, Lu Mingfei and Lu Weizhe, who are also bestowed with this magical gift","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"R"},"current_season_id":6338,"content_control":"NORMAL"}}