ents"}],"post_info":{"genres":["Drama"],"id":42011,"type":"SERIES","title":"Life’s Punchline","logo":"","image":"https://cloud02.albox.co/shows/0509ce19-0dfd-46e3-801f-c8294271db85.jpg","background_image":"https://cloud02.albox.co/shows/be5aca89-6575-46f2-93ac-822a50e89998.jpg","likes":1,"dislikes":0,"views":221,"release_date":"1780444800000","season_number":1,"description":"أمضى وانغ وكونغ وكواي عشر سنوات في بناء فرقتهم الكوميدية، مع الحرص على التوفيق بين مسؤولياتهم اليومية. وبعد اتفاقهم على حلّ الفرقة في حال فشلهم في تحقيق النجاح، يُثير اقتراب الموعد النهائي توترًا داخلها. تدخل فان، وهي معجبة متحمسة، حياتهم وتساعدهم في مواجهة التحديات الشخصية والمهنية. ومع ظهور الخلافات وتطور العلاقات، يتأمل الثلاثي رحلتهم وما اكتسبوه منها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"NC-17"},"background_color":"","current_season_id":24504,"content_control":"NORMAL"}}