th":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Documentary"],"id":33085,"type":"MOVIE","title":"Man on Wire","logo":"https://cloud02.albox.co/shows/bb36e4ba-af5d-4647-8b0c-3c6781f59bd2.png","image":"https://cloud02.albox.co/shows/ed217f40-f136-432e-acc1-7881f1c12c1a.jpg","background_image":"https://cloud02.albox.co/shows/ff37e457-f1ff-48c6-8986-5793625e0529.jpg","likes":9,"dislikes":0,"views":1836,"release_date":"1217548800000","length":5647,"description":"في 7 أغسطس 1974، خرج المشنقة الفرنسي فيليب بيتيه على سلك عالي، مركب بشكل غير قانوني بين برجي التجارة العالميين في نيويورك، واللذان كانا في ذلك الوقت أطول برجين في العالم. بعد ما يقرب من ساعة من الأداء على السلك، على ارتفاع 1350 قدمًا فوق رصيف مانهاتن، تم اعتقاله. يسجل هذا الفيلم الوثائقي الممتع والساحر إنجاز \"فيليب بيتيه\" الأعلى.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":924678,"background_color":"","content_control":"FAMILY"}}