ackground_image":"https://cloud02.albox.co/seasons/175e6dfb-a08a-4289-beb0-ad5605007597.jpg","likes":95,"dislikes":5,"views":16385,"release_date":"1723939200000","season_number":1,"description":"لذلك قررت جين، الباحثة الوراثية التي تحب الحمض النووي، إنهاء علاقتها مع صديقها المستهتر وتنطلق للبحث عن شريك متوافق وراثيًا لعلاقة سعيدة. من من بين الرجلين الذين تلتقي بهم سو جين، طبيب التوليد وأمراض النساء يون يو ورجل الإطفاء جانج هون، سيكون الشريك المثالي لها؟ قصة آسرة متشابكة مع علم الوراثة! تصور هذه القصة النضالات والحب والحياة اليومية للأصدقاء الشباب.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-13"},"background_color":"","current_season_id":19120,"content_control":"NORMAL"}}