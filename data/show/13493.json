ull,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Romance","Thriller"],"id":13493,"type":"MOVIE","title":"A Dangerous Method","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/0018e7a6-6312-4480-b1a6-c7efaf72e13b.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/0e26aeb6-c329-4038-b202-2ed55d1946b3.jpg","likes":98,"dislikes":7,"views":9364,"release_date":"1320883200000","length":5966,"description":"Suffering from hysteria, Sabina Spielrein is hospitalized under the care of Dr. Carl Jung who has begun using Dr. Sigmund Freud's talking cure with some of his patients. Spielrain's psychological problems are deeply rooted in her childhood and violent father. She is highly intelligent however and hopes to be a doctor, eventually becoming a psychiatrist in her own right. The married Jung and Spielrein eventually become lovers. Jung and Freud develop an almost father-son relationship with Freud seeing the young Jung as his likely successor as the standard-bearer of his beliefs. A deep rift develops between them when Jung diverges from Freud's belief that while psychoanalysis can reveal the cause of psychological problems it cannot cure the patient.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"R"},"episode_id":13493,"content_control":"FAMILY"}}