ard_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy","Animation"],"id":7562,"type":"MOVIE","title":"Bee Movie","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/432957b5-7f61-48fb-91f3-615241ab5b9b.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/28919b89-75d5-40f4-9712-1d34d104eadc.png","likes":150,"dislikes":5,"views":13566,"release_date":"1193961600000","length":5440,"description":"When the bee Barry B. Benson graduates from college, he finds that he will have only one job for his entire life, and absolutely disappointed, he joins the team responsible for bringing the honey and pollination of the flowers to visit the world outside the hive. Once in Manhattan, he is saved by the florist Vanessa and he breaks the bee law to thank Vanessa. They become friends and Barry discovers that humans exploit bees to sell the honey they produce. Barry decides to sue the human race, with destructive consequences to nature.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG"},"episode_id":7562,"content_control":"FAMILY"}}