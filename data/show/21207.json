ess":0},{"items":[],"id":13566,"title":"دراغون بول زد مدبلج","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/502fe958-a675-40b8-85e7-56709c8615a9.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":20995,"title":"Monster.","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/3b583302-0fc9-426a-9725-5fe061d2a6c2.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14049,"title":"Seraph of the End","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/3a765914-c3cc-4cc0-bd00-1dc196f87d34.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":21207,"title":"","description":"28","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Animation"],"id":21207,"type":"SERIES","title":"Mirai Nikki","logo":"","image":"https://cdn6.albox.co/storage/disk42/seasons/7c0439fb-b491-4cd4-9672-7ce9bc257190.jpg","background_image":"https://cdn6.albox.co/storage/disk55/seasons/0fba01d8-63ab-4b24-9d93-08d057bb65ec.jpg","likes":211,"dislikes":7,"views":21538,"release_date":"1318118400000","season_number":1,"description":"Yukiteru Amano is a 14-year old loner who spends much of his time dispassionately recording events around him in his cell phone \"diary.\" His only friends are imaginary ones: Dues ex Machina, the \"god of time and space,\" and Murmur, Dues's impish helper. Yukiteru's life takes a turn for the strange when his diary starts recording events before they happen and Dues announces that he's not so imaginary after all, and a turn for the sinister when his diary announces his own impending death. It turns out Yukiteru has become part of a survival game in order to determine who will succeed Dues as the god of time and space, competing with 11 others who also possess diaries that predict the future in various ways,. But Yukiteru does have at least one strong ally: Yuno Gasai, a fellow classmate who despite being a Future Diary holder herself is determined to protect Yukiteru at all costs. She's also an obsessive and possibly crazy stalker who's own Future Diary records Yukiteru's every move in ten minute intervals.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"r"},"current_season_id":10506,"content_control":"NORMAL"}}