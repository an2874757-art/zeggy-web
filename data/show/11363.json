MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/86b5cb4b-0729-4fce-854f-6e16a555f251.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":1905,"title":"Street Dancer 3D","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk54/shows/ed55f02b-9f2c-4af4-91df-18a2c5bd6da0.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":4425,"title":"Rowdy Rathore","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk60/shows/192f124d-ca65-4303-964d-2c37f0f9f66b.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":24554,"title":"Sooryavanshi","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/3660d9a1-bf9d-4ef4-ab75-ada2bc2b3ca1.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":22607,"title":"Radhe","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/3928c88e-bfb4-421e-817b-c303135a0ccc.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10792,"title":"Krrish 3","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk55/shows/a711fa72-b8a3-4287-9cb7-6b376c0f1aca.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":11363,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy","Music"],"id":11363,"type":"MOVIE","title":"Waqt: The Race Against Time","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/a72e1dda-1b98-45f9-a692-d0c8f578e39c.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/64848a97-91c1-48cd-a388-dbac0f4e0412.jpg","likes":13,"dislikes":0,"views":1925,"release_date":"1114128000000","length":9154,"description":"Waqt the race against time is the story of a father and a son between whom there is a special bond. Ishwarchand Thakur (Amitabh Bachchan) and Sumitra Thakur (Shefali Shah) are a married couple who run a toy factory together. They have a son called Aditya Thakur (Akshay Kumar) who does not have any interest in responsibility or what he wants to do in life. It gets even worse when he elopes with his girlfriend (Pooja, played by Priyanka Chopra), the daughter of Natu (Boman Irani). When Pooja gets pregnant, both Ishwar and Sumitra decide to make Aditya realize his responsibilities, as he will have to take care of his wife and child. Both take drastic measures and even chuck Aditya out the house along with Pooja. The farce becomes so bad that Aditya begins to hate his father and they do not speak to each other for a long time. At the same time Aditya becomes aware of his role in life. However, Ishwar has done all this for a reason and is hiding something from Aditya. Ishwar is trying to make sure that his son is secure but because he is suffering from lung cancer and he wants his son to be responsible. Aditya succeeds in becoming a responsible man and also finds out the truth about his father when his father comes for his performance on the stage. He steps on the stage but instead he asks the audience to pray to god to give a minute of their lives to keep his father alive until his son's birth. His father is alive until his son is born and he names the baby boy 'Ishwar' after himself and he dies.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"N/A"},"episode_id":11363,"content_control":"NORMAL"}}