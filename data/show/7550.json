,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Crime"],"id":7550,"type":"MOVIE","title":"Repo Men","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/3bbc8ad3-9bb1-4636-aa17-89d7ccea0faa.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/f37749fa-235c-4f8c-8305-f223aac23110.jpg","likes":28,"dislikes":1,"views":5418,"release_date":"1268956800000","length":7177,"description":"In the future humans have extended and improved our lives through highly sophisticated and expensive mechanical organs created by a company called \"The Union\". The dark side of these medical breakthroughs is that if you don't pay your bill, \"The Union\" sends its highly skilled repo men to take back its property... with no concern for your comfort or survival. Former soldier Remy is one of the best organ repo men in the business. But when he suffers a cardiac failure on the job, he awakens to find himself fitted with the company's top-of-the-line heart-replacement... as well as a hefty debt. But a side effect of the procedure is that his heart's no longer in the job. When he can't make the payments, The Union sends its toughest enforcer, Remy's former partner Jake, to track him down.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"R"},"episode_id":7550,"content_control":"FAMILY"}}