watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7437,"title":"","description":"58","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Animation","Family"],"id":7437,"type":"MOVIE","title":"Mulan","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/1cf297ff-271f-4ba1-ae8f-8c2a57e505d2.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/ad132450-b5f6-4d92-bdb8-0079dad12848.png","likes":997,"dislikes":15,"views":77508,"release_date":"898214400000","length":5270,"description":"This retelling of the old Chinese folktale is about the story of a young Chinese maiden who learns that her weakened and lame father is to be called up into the army in order to fight the invading Huns. Knowing that he would never survive the rigours of war in his state, she decides to disguise herself and join in his place. Unknown to her, her ancestors are aware of this and to prevent it, they order a tiny disgraced dragon, Mushu to join her in order to force her to abandon her plan. He agrees, but when he meets Mulan, he learns that she cannot be dissuaded and so decides to help her in the perilous times ahead.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"G"},"episode_id":7437,"content_control":"FAMILY"}}