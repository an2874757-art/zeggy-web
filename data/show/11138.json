":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller"],"id":11138,"type":"MOVIE","title":"American Assassin","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/65f4bc52-0275-4c44-9fb1-f63fedb8b7f5.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/24e0a54b-ae75-42ae-b69e-60d12bfbb832.jpg","likes":445,"dislikes":7,"views":26717,"release_date":"1505433600000","length":6698,"description":"Twenty three-year-old Mitch lost his parents to a tragic car accident at the age of fourteen, and his girlfriend to a terrorist attack just as they were engaged. Seeking revenge, he is enlisted by CIA Deputy Director Irene Kennedy as a black ops recruit. Kennedy then assigns Cold War veteran Stan Hurley to train Mitch. Together they will later on investigate a wave of apparently random attacks on military and civilian targets. The discovery of a pattern in the violence leads them to a joint mission with a lethal Turkish agent to stop a mysterious operative intent on starting a world war in the Middle East.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"R"},"episode_id":11138,"content_control":"FAMILY"}}