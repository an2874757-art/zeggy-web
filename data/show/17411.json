":[{"items":[],"id":17411,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":17411,"type":"SERIES","title":"متاهة الحب","logo":"","image":"https://cdn6.albox.co/storage/disk50/seasons/a4853a84-c348-4858-bae4-170c2f99a3eb.jpg","background_image":"https://cdn6.albox.co/storage/disk57/seasons/3c94197a-1f29-41d0-ae1e-41a30089ba12.jpg","likes":70,"dislikes":2,"views":16816,"release_date":"-2208988800000","season_number":1,"description":"تدور أحداث المسلسل حول الفتاة \"كول\" وصديقها المقرب \"راج\"، بينما يظهر الطالب المتفوق \"مادي\" الذي يقع في حب \"كول\" ويحاول التقرب منها بأي شكل ولفت انتباهها؛ لكن \"كول\" لا تعيره أي اهتمام وتعتبره مجرد زميل فقط، لأنها تحب زميلها \"راج\"؛ لكن بالنسبة إلى \"راج\" التمثيل والشهرة والنجومية أهم من الحب والعلاقات، ودائما ما ينظر إليها على أنها أقل منه ولن تستطيع أن تصل إلى نجوميته، فتقرر \"كول\" أن تتحدى نفسها وحبيبها \"راج\" وتبدأ مشوارها للبحث عن النجومية فتسافر إلى مومباي بحثا عن الشهرة، وتتوالى الأحداث المشوقة. متاهة الحب بطولة كل من النجم: جوتام جوبتا والفنانة أشا نيجي، علي جوني، أنكيتا شارما، روبا جانجولي، أنوراج شارما.","rating":{"sources":[],"value":0,"age":"TV-14"},"current_season_id":5447,"content_control":"NORMAL"}}