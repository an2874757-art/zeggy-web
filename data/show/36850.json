:"https://cloud02.albox.co/shows/4ed0a87e-0768-43f2-af65-2cf03a45fd39.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35898,"title":"بالدم","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/fbbd39bf-f488-4a4a-b1aa-22f4beb28b77.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35882,"title":"الكابتن","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/b3d973af-8b48-40fc-9813-0a8300f954db.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36850,"title":"","description":"79","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":36850,"type":"SERIES","title":"فات الميعاد","logo":"","image":"https://cloud02.albox.co/seasons/e6b3472c-f7f7-4cc7-ab16-95106979ed54.jpg","background_image":"https://cloud02.albox.co/seasons/7238e51c-5cf7-4baf-a5ee-0fe46d61ef32.jpg","likes":218,"dislikes":13,"views":128956,"release_date":"1749772800000","season_number":1,"description":"تدور أحدث سلسلة \"فات المداد\" حول إطار اجتماعي ودرامي مثير ضمن دراما اجتماعية من 30 حلقة. تبدأ القصة بحدث يبدو عاديا، مثل طلب الزوجة الطلاق من زوجها بسبب استحالة العيش معا. ومع ذلك ، يتحول هذا الطلب إلى كرة ثلجية تنمو وتفاقم تأثيرها على حياة جميع أبطال المسلسل. يصبحون جميعا متورطين في صراع دراماتيكي جذاب تتغير فيه حياتهم، ومع كل تطور في الأحداث يتم الكشف عن أسرار حول ما يخفيه كل منهم، كما لو أن ضغط الأحداث يلقي أضواء ساطعة على مناطق لم يتم اكتشافها أو ظهورها في كل شخصية من شخصياتهم أمام الآخرين، وربما حتى أمام أنفسهم. كل هذا يتكشف وسط عوالم مليئة بالرومانسية والحب، وما يفرضونه من المودة والشجاعة أحيانا، والخوف والجبن والتناقض في أوقات أخرى.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"","current_season_id":21383,"content_control":"NORMAL"}}