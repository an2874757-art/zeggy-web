2c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":31001,"title":"Fancy Nancy","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/f097b2e5-678e-4386-96ee-eaf20b5c37d8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":21977,"title":"Guardians of the Galaxy","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/7b41bea6-d2ab-4bce-aaf8-d5bf4d3ae88f.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":17311,"title":"سونيك اكس","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk44/shows/9ee2301c-4398-480e-8fc8-b36b1646f34c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":33262,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Animation","Science Fiction","Children"],"id":33262,"type":"SERIES","title":"The Incredible Hulk","logo":"https://cloud02.albox.co/shows/4ed35727-8cbd-4c75-969f-4baaca0312bc.png","image":"https://cloud02.albox.co/seasons/efec6940-9b55-4c5e-92d7-fe3e043c5a3b.jpg","background_image":"https://cloud02.albox.co/seasons/9e2b3eb0-833b-4cf4-9caf-b3f71868f96e.jpg","likes":26,"dislikes":2,"views":4536,"release_date":"842140800000","season_number":1,"description":"\"The Incredible Hulk\" هو مسلسل تلفزيوني رسوم متحركة أمريكي يقوم ببطولته شخصية مارفل كوميكس ذا هالك. عُرض لموسمين، مكونًا من 21 حلقة، على شبكة التلفزيون UPN من عام 1996 إلى عام 1997. قدم لو فيرينيو، الذي جسد شخصية الهالك في النسخة الحية التلفزيونية في سبعينيات القرن الماضي، صوت الهالك في هذا المسلسل. كانت العروض الحية من شخصيات مارفل الأخرى لهذه الفترة تظهر كثيرًا في المسلسل. في الموسم الثاني، تم تغيير شكل المسلسل بعد قرار UPN بأن الموسم الأول كان مظلمًا للغاية، ولإعطاء \"المشاهدين الأنثويين فرصة\"، طلبت الشبكة أن يتم جعل الهالكة (شي-هالك) زميلة دائمة في البطولة. ونتيجة لذلك، تم تغيير اسم المسلسل رسميًا إلى \"The Incredible Hulk and She-Hulk\". شهد الموسم الثاني أيضًا ظهور الهالك الرمادي.\r\n\r\n\r\n\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"R"},"background_color":"#1d3f2b","current_season_id":18735,"content_control":"NORMAL"}}