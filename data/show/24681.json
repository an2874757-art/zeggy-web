ng_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Life"," Romance"],"id":24681,"type":"SERIES","title":"Meeting You Loving You","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/196ef2c4-a1f9-4d15-a157-5c240ed4f553.jpeg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/9da177d5-cfb0-4e80-8ce4-ae039bd3ff78.jpg","likes":75,"dislikes":0,"views":9486,"release_date":"1638921600000","season_number":1,"description":"Su Zhi Nian هو طالب نقل غامض يتمتع بسلطات خاصة سرية اكتسبها خلال حادث طفولته. في يومه الأول في مدرسة جيانغ لي الثانوية رقم 1 ، تواجهه عصابة من المتنمرين ، وتطالبه بتسليم المال أو الضرب على أيديهم. يندفع زميل شجاع لم يلتق به من قبل اسمه Song Qing Chun للدفاع عنه ويدافع عنه. ولكن عندما لا يتمكنون من الهروب من المتنمرين ، يضطر لاستخدام سلطاته الخاصة لحماية نفسه - وسونغ تشينغ تشون. ومع ذلك ، أثناء المشاجرة ، أدرك أن قواه لا تعمل إذا لمسته ، وهو أمر لم يختبره من قبل.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"PG-13"},"background_color":"","current_season_id":12936,"content_control":"NORMAL"}}