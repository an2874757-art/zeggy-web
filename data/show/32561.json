":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"," Drama"," Fantasy"," Adventure"],"id":32561,"type":"SERIES","title":"Ookami to Koushinryou: Merchant Meets the Wise Wolf","logo":"","image":"https://cloud01.albox.co/seasons/9c1648fb-48e9-417a-909b-61f5bc69e4d0.jpg","background_image":"https://cloud01.albox.co/seasons/17399fd6-ada1-4e86-9b0f-d841407bd532.jpg","likes":135,"dislikes":6,"views":16106,"release_date":"1712016000000","season_number":1,"description":"هولو هو إله ذئب قوي يحظى بالتبجيل في بلدة باسلو الصغيرة لمباركة الحصاد السنوي. ومع ذلك، مع مرور السنين وأصبح القرويون أكثر اكتفاءً ذاتيًا، تحولت هولو إلى مجرد حكاية شعبية. عندما يتوقف تاجر متنقل يُدعى كرافت لورانس عند المستوطنة، تعرض هولو أن تصبح شريكته التجارية إذا أخذها إلى منزلها الشمالي في يويتسو. يدرك التاجر الذكي قدرة Holo غير العادية على تقييم شخصية الشخص ويقبل اقتراحها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"background_color":"","current_season_id":18367,"content_control":"NORMAL"}}