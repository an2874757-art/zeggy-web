ظ على الحب أصعب بكثير من الحفاظ على الحياة.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-14"},"background_color":"","current_season_id":23231,"content_control":"NORMAL"}}