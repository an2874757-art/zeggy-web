0},{"items":[],"id":33542,"title":"Tokidoki Bosotto Russia-go de Dereru Tonari no Alya-san","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/5f02b313-3bea-4283-915d-408743acfd63.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17571,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Romance","Comedy","Animation"],"id":17571,"type":"SERIES","title":"Ah My Goddess","logo":"","image":"https://cdn6.albox.co/storage/disk55/seasons/9e581825-3ad8-46e0-ad7d-413c3b9d2eda.jpg","background_image":"https://cdn6.albox.co/storage/disk56/seasons/ff0f8668-8aa8-4f69-9f9b-17aeeac595b5.jpg","likes":29,"dislikes":1,"views":9914,"release_date":"1104969600000","season_number":1,"description":"Nice Guy Keiichi is doing his best as a poor student at a tech college, but his good nature is taken advantage of relentlessly. One day he is attempting to order a pizza over the phone (being stuck at the dorm to take messages for upperclassmen) and by fate reaches the Goddess Help Line. Before he knows it he is presented with a real live goddess named Belldandy who will grant him one and only one wish. Still suspecting he is the butt of an elaborate joke, he wishes for her to be by his side forever. His wish is granted! It would seem his luck has changed, but he finds out that having a goddess is no way to avoid trouble.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG-13"},"current_season_id":5670,"content_control":"NORMAL"}}