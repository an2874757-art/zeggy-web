card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Mystery","Horror"],"id":7428,"type":"MOVIE","title":"House of Wax","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/075b0208-1253-4560-8d78-c07c5963c0b9.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/f6de2e9f-d428-479a-97ad-e5fbf6274b6e.jpg","likes":489,"dislikes":8,"views":30166,"release_date":"1115337600000","length":6764,"description":"Six friends are on their way to a football game. They decide to camp out for the night and continue driving the next day. The next day the friends find that they're having car troubles, so two of the friends accept a stranger's ride into a small town named Ambrose. The main attraction in Ambrose is the House of Wax. Except something is not right in this town, the wax figures are so realistic and the whole town is deserted - except for two murderous twin brothers. The six friends must fight to survive and escape from being the next exhibits in the House of Wax.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"R"},"episode_id":7428,"content_control":"FAMILY"}}