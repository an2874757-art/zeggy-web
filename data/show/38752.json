d","section_type":"normalPoster"},{"data":[{"items":[],"id":38752,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Mystery"],"id":38752,"type":"SERIES","title":"Treacherous Cases in Shendu","logo":"","image":"https://cloud02.albox.co/seasons/925d803a-9746-4e5c-8f34-3e2d03d20693.jpg","background_image":"https://cloud02.albox.co/seasons/49938a44-d153-4db5-9e03-6c2d35ad8377.jpg","likes":10,"dislikes":0,"views":4291,"release_date":"1762560000000","season_number":1,"description":"يتقدم لي يا إير لاستقبال عروس والده، لكن ليلة الزفاف تتحول إلى جحيم عندما تحترق العروس في ظروف غامضة، ويتركه القتلة مصابًا بفقدان الذاكرة، ويُباع عبدًا. وبينما تكشف مؤامرة خفية عن هويته الحقيقية، يتورط في قصة حب مضطربة بين سيد وخادم، مما يضعهما في طرفين متعارضين. معًا، يكشفان المؤامرة التي تهدد سلالة تانغ، ويقاتلان لحماية المملكة والرابطة الهشة بينهما.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"NC-17"},"background_color":"","current_season_id":22538,"content_control":"NORMAL"}}