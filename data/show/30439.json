3-79f5-4385-af94-81e812613f7c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":30439,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Supernatural"," Slice of Life"],"id":30439,"type":"SERIES","title":"Youkai Apartment no Yuuga na Nichijou","logo":"","image":"https://cloud01.albox.co/seasons/2c31e57d-7761-494d-be0f-db4afce40a14.jpg","background_image":"https://cloud01.albox.co/seasons/14e5dd75-7244-4364-8ade-46c56de83b9d.jpg","likes":24,"dislikes":0,"views":2208,"release_date":"1499040000000","season_number":1,"description":"توفي والدا إينابا يوشي في عامه الأول في المدرسة الإعدادية، وانتقل للعيش مع أقاربه. على الرغم من أنهم اهتموا به، إلا أنه كان بإمكانه أن يقول أنه كان عبئًا. بعد تخرجه، استعد بسعادة للانتقال إلى مدرسة ثانوية بها مسكن. لسوء الحظ، احترق المهجع وسوي بالأرض قبل أن يتمكن من الانتقال إليه! لا يريد Yuushi العيش مع أقاربه الحاقدين، ولكن من الصعب العثور على سكن كطالب يتيم مع القليل من المال. أخيرًا وجد غرفة في مبنى قديم جميل يبدو جيدًا جدًا لدرجة يصعب تصديقها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"background_color":"","current_season_id":17264,"content_control":"NORMAL"}}