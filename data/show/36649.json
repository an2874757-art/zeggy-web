رية. وبينما يواجهان هذا الموقف الغريب، تتعمق علاقتهما وتتحول إلى حب، بينما يعملان معًا على إحياء حمام عائلي متهالك وكشف مؤامرات خفية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"background_color":"","current_season_id":21172,"content_control":"NORMAL"}}