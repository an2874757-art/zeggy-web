ems":[],"id":8978,"title":"Inception","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/9374f481-376b-4c7a-8c8f-b7b238604ba1.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":875,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":875,"type":"MOVIE","title":"The Taste of Others","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/c80989d6-cee9-44b1-b551-3c8a1c2e6a0e.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/81752da9-e5a4-4b4f-97dc-e5747feb2d25.jpg","likes":17,"dislikes":1,"views":5159,"release_date":"951868800000","length":6742,"description":"Three men, three women, opposites, possibilities, and tastes. Castella owns a industrial steel barrel plant in Rouen; Bruno is his flute-playing driver, Franck is his temporary bodyguard while he negotiates a contract with Iranians, his wife Angélique does frou-frou interior decorating and loves her dog. The conventional Castella hires a forty-year-old actress, Clara, to tutor him in English, and he finds her and her Bohemian lifestyle fascinating. Is this love? What would she say if he declared himself? Through Bruno, Franck meets Manie, a barmaid who deals hash. They begin an affair. Are they in love? They joke about marriage. As the women hold back, the men must make decisions.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":875,"content_control":"FAMILY"}}