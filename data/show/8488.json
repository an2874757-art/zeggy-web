:0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8488,"title":"","description":"70","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Crime"],"id":8488,"type":"MOVIE","title":"Rush Hour 2","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/3177d9d9-cf80-4fbd-bd4f-6b3da088b325.png","background_image":"https://cdn6.albox.co/storage/disk54/shows/f06bb0a4-0ef1-4fd7-a23a-5b8485718906.png","likes":1474,"dislikes":17,"views":91864,"release_date":"996796800000","length":5407,"description":"It's vacation time for Det. James Carter and he finds himself alongside Det. Lee in Hong Kong wishing for more excitement. While Carter wants to party and meet the ladies, Lee is out to track down a Triad gang lord who may be responsible for killing two men at the American Embassy. Things get complicated as the pair stumble onto a counterfeiting plot by L.A. crime boss Steven Reign and Triad Ricky Tan, an ex-cop who played a mysterious part in the death of Det. Lee's father. Throw in a power struggle between Tan and the gorgeous but dangerous Hu Li and the boys are soon up to their necks in fist fights and life-threatening situations. A trip back to the U.S. may provide the answers about the bombing, the counterfeiting, and the true allegiance of sexy customs agent Isabella. Then again, it may turn up more excitement than Carter was looking for during his vacation.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"episode_id":8488,"content_control":"NORMAL"}}