on_type":"normalPoster"},{"data":[{"items":[],"id":23382,"title":"","description":"21","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"," Comedy"," Life"," Youth"],"id":23382,"type":"SERIES","title":"You Are My Glory","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/e6729f9c-25a9-43ad-93d0-c545024375e1.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/ca1d00d9-664d-4499-b568-decd45813eb2.jpg","likes":201,"dislikes":0,"views":15136,"release_date":"1627257600000","season_number":1,"description":"قصة تتبع مهندس الطيران يو تو والنجم اللامع تشياو جينغ جينغ. قرار بدء اللعب من أجل حفظ صفقة التأييد الخاصة بها يجعلها وجهًا لوجه مع سحق قديم. مع اقترابهما ، يتقدم الاثنان ليصبحا مجد بعضهما البعض. نظرًا لكونها من المشاهير المشهورين ، يتعين على Qiao Jing Jing مواكبة المظاهر للحفاظ على صورتها متعددة الأوجه. للأسف ، يبدأ المرء في الانهيار عندما يسرب شخص ما مقطع فيديو لها وهي تلعب لعبة على الإنترنت وتكون فظيعة في ذلك الأمر الذي يتعارض تمامًا مع الصورة التي أنشأتها لنفسها كسفيرة للعبة. وهكذا ، تنضم إلى مسابقة ألعاب لإثبات مهاراتها ولمنع نفسها من فقدان موافقاتها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"PG-13"},"current_season_id":12015,"content_control":"NORMAL"}}