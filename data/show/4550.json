items":[],"id":4550,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Comedy","Animation","Family"],"id":4550,"type":"MOVIE","title":"Flushed Away","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/b8bc7ca4-f5f6-475e-aff8-0c1d8c5ef9b8.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/717d2ec7-932f-4799-ad7f-ef0bc6b3f4ff.jpg","likes":81,"dislikes":1,"views":5486,"release_date":"1162512000000","length":5102,"description":"Roddy is a decidedly upper-crust \"society mouse\" who lives the life of a beloved pet in a posh Kensington flat. When a sewer rat named Sid comes spewing out of the sink and decides he's hit the jackpot, Roddy schemes to rid himself of the pest by luring him into the \"whirlpool.\" Sid may be an ignorant slob, but he's no fool, so it is Roddy who winds up being flushed away into the bustling sewer world of Ratropolis. There Roddy meets Rita, an enterprising scavenger who works the sewers in her faithful boat, the Jammy Dodger. Roddy immediately wants out, or rather, up; Rita wants to be paid for her trouble; and, speaking of trouble, the villainous Toad - who royally despises all rodents equally, making no distinction between mice and rats--wants them iced... literally. The Toad dispatches his two hapless hench-rats, Spike and Whitey, to get the job done. When they fail, the Toad has no choice but to send to France for his cousin - that dreaded mercenary, Le Frog.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG"},"episode_id":4550,"content_control":"NORMAL"}}