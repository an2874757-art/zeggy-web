ن ظلمه.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":3}],"value":3,"age":"PG-14"},"background_color":"","current_season_id":23288,"content_control":"NORMAL"}}