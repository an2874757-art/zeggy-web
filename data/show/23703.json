ud02.albox.co/shows/f9d6b744-64a1-4bf1-9f68-89e16422cd3c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":23703,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Drama"," Comedy"],"id":23703,"type":"SERIES","title":"Kotaro wa Hitorigurashi","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/1f6b5438-f615-43e8-9f06-7bf5695a6b71.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/442e6ae3-395d-4c76-9b70-c90e6288a383.jpg","likes":22,"dislikes":0,"views":1665,"release_date":"1619222400000","season_number":1,"description":"شين كارينو كاتب مانغا لا يحظى بشعبية وهو أعزب. يعيش في مجمع سكني به قاعدة تمنع الأطفال من العيش فيه. ذات يوم ، يرن جرس باب شين كارينو. عندما فتح باب شقته ، رأى ولدًا صغيرًا. الصبي هو كوتارو ساتو البالغ من العمر 5 سنوات. أخبر كوتارو ساتو شين كارينو أنه انتقل إلى الحي. شين كارينو يصنع وجهًا غريبًا ، بسبب حكم مجمع شقته. يقول كوتارو ساتو إنه يعيش بمفرده. في البداية ، انزعج شين كارينو من كوتارو ساتو ، لكن سكان المبنى السكني ، بما في ذلك شين كارينو ، أصبحوا مرتبطين بكوتارو ساتو.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"background_color":"","current_season_id":12225,"content_control":"NORMAL"}}