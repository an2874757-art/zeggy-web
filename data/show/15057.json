ter"},{"data":[{"items":[],"id":15057,"title":"","description":"41","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi","Animation"],"id":15057,"type":"SERIES","title":"سيف النار","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/276aa3d1-c7be-4b16-861b-474f27ff10d1.jpg","background_image":"https://cdn6.albox.co/storage/disk46/seasons/dcda6242-92a7-4a3d-8b2e-75f669915214.jpg","likes":873,"dislikes":14,"views":90740,"release_date":"465696000000","season_number":1,"description":"In the year 199X, human civilization has been all but destroyed by a nuclear holocaust. In an age where the strong rule over the weak, the survivors of the fallout struggle over the remaining supply food and water left. Kenshiro, successor to an ancient, deadly martial art known as Hokuto Shinken (Fist of the North Star), wanders the wasteland with seven scars in the shape of the Big Dipper on his chest. This infamous style uses the body's hidden 708 pressure points to destroy opponents from within and allows practitioners to unleash 100% of their humanly strength. Accompanied by a young thief and an orphan girl, this messiah brings justice to this lawless world with the strongest fist in the world.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"TV-14"},"current_season_id":2189,"content_control":"NORMAL"}}