progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9532,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller"],"id":9532,"type":"MOVIE","title":"Desperado","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/67d24be8-3a82-4140-b36f-c9653cfaebcb.png","background_image":"https://cdn6.albox.co/storage/disk51/shows/81013366-95cb-447b-a78d-bf1f85652ae7.png","likes":70,"dislikes":0,"views":7542,"release_date":"809308800000","length":6270,"description":"With this sequel to his prize-winning independent previous film, \"El Mariachi,\" director Robert Rodriquez joins the ranks of Sam Peckinpah and John Woo as a master of slick, glamorized ultra-violence. We pick up the story as a continuation of \"El Mariachi,\" where an itinerant musician, looking for work, gets mistaken for a hitman and thereby entangled in a web of love, corruption, and death. This time, he is out to avenge the murder of his lover and the maiming of his fretting hand, which occurred at the end of the earlier movie. However, the plot is recapitulated, and again, a case of mistaken identity leads to a very high body count, involvement with a beautiful woman who works for the local drug lord, and finally, the inevitable face-to-face confrontation and bloody showdown.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":9532,"content_control":"NORMAL"}}