.albox.co/seasons/7e295c1a-212f-423d-a4b2-58e9dd2d2865.jpg","likes":3032,"dislikes":31,"views":229247,"release_date":"1680220800000","season_number":1,"description":"يتلقى الطلاب والمعلمون في مدرسة Sungjin High School صدمة مرعبة عندما يشهدون بداية غزو أجنبي. قادمًا من السماء ، يفقس \"البيض\" المرعب مخلوقات عنيفة شبيهة بالحشرات تهاجم البشر. الغزو عالمي ، والجيش الكوري الجنوبي يخشى أن يطغى عليه. في حالة من اليأس ، أعلن الرئيس أن التجنيد الإجباري سيبدأ - وأن جميع طلاب السنة الثالثة الثانوية - ذكوراً وإناثاً - يجب أن ينضموا إلى القوات المسلحة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"background_color":"","current_season_id":16380,"content_control":"FAMILY"}}