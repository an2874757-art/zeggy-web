//cloud01.albox.co/seasons/9d908cf4-4dc5-4e4c-8a4b-ee622a1a23e6.jpg","background_image":"https://cloud01.albox.co/seasons/e6bf6eab-105c-493b-af12-dee223217a1e.jpg","likes":56,"dislikes":2,"views":3795,"release_date":"639964800000","season_number":1,"description":"تدور احداث المسلسل حول ماسة صغيرة صنعتها الحضارة القديمة لدولة أطلانتس، وتتوارثها الأسرة الحاكمة، هناك اثنتين منها فقط، واحدة عند (رولا)، وأخرى عند أبيها القبطان (عامر)، وهي غامضة جدا وتملك قدرات هائلة، ومهما عرفت عنها، ستظل غامضة، فهي إذا كانت بين كفي (رولا) تضيء عندما يقترب الخطر أو عندما يقترب شخص شرير، وتجعل الإنسان يفهم لغة الحيوانات والعكس.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG"},"background_color":"","current_season_id":16589,"content_control":"NORMAL"}}