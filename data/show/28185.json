","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/c053d840-eb79-4f48-adae-de0a4282f972.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":28185,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","اكشن"],"id":28185,"type":"SERIES","title":"غورميتي","logo":"","image":"https://cloud01.albox.co/seasons/cf205c17-c642-40c9-bc42-f43e8781a40f.jpg","background_image":"https://cloud01.albox.co/seasons/8a5ed326-9ea4-49a9-8a29-5a5c0fe6a668.jpg","likes":262,"dislikes":7,"views":22455,"release_date":"1538352000000","season_number":1,"description":"تدور أحداث القصة في جزيرة غورم وأبطالها الأربعة من العناصر المختلفة التي وهي: النار الجليد الصخر الرياح، يعيشون في جزيرة غورم، كسائر الأيام كان الأصدقاء الأربعة يتجولون في الغابة الا ان أتى هذا اليوم الاستثنائي اذ بهم يجدون برج غورم الأسطوري ثم تلاقيهم حارسة البرج إيوكي وعندما علمت أنهم حاملو أساور الطاقة الجدد لم تصدق لأنهم كانوا مجرد أطفالا في الحادية عشرة من عمرهم لايملكون من القوة والمؤهلات شيء، ولكنها صدقت فيما بعد أي بعدما أثبتوا جدارتهم واستحقاقهم لحمل أساور الطاقة، لكن بعد وقت قصير جدا حطم الشرير غريد تابع الزعيم فويتس النجم البلوري إلى أجزاء ونثره في كل أرجاء جزيرة غورم، وواجب أبطالنا الأربعة العثور على أجزائه قبل أن تقع في أيدي الأشرار.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG"},"background_color":"","current_season_id":15595,"content_control":"NORMAL"}}