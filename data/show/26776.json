c2d41051.png","image":"https://cdn8.albox.co/storage/CLOUD00/shows/6a66dac4-8e0c-4ec5-8c83-4a0169c3db2e.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/shows/baf42d80-bb8c-4a2d-8764-21f6b8b92648.jpg","likes":33,"dislikes":0,"views":2871,"release_date":"1560470400000","length":7058,"description":"تدور أحداث اللعبة في قارة بابل ، حيث يلوح برج بابل بشكل كبير على سبع دول. بعد أن أدى اختراع الخيمياء إلى استخدامها كأداة حرب دفعت البشرية إلى حافة الانقراض ، أبرمت الدول السبع سلامًا غير مستقر أدى إلى حظر الخيمياء لمئات السنين منذ ذلك الحين. في العام القاري 911 ، كسرت أمة Lustrice الاتفاقية من خلال تجميع جيش مدعوم بالكيمياء ، مع طموحات للغزو على القارة. بقيادة إنفيليا ، تحالفت الدول الست وضربت الأمة المارقة ، وألقوا الخيمياء مرة أخرى في الظلام. ولكن بعد مرور 20 عامًا على الحرب ، بدأت الخيمياء مرة أخرى في إحداث حالة من الفوضى في الأرض.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":500637,"background_color":"#bb743b","content_control":"NORMAL"}}