0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8135,"title":"","description":"63","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":8135,"type":"MOVIE","title":"The Reader","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/e09c185c-5f17-44bc-bb18-7199449130b5.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/db43cfcb-dfc9-419a-a680-8b3185cdcb1f.jpg","likes":504,"dislikes":34,"views":68637,"release_date":"1201651200000","length":7438,"description":"THE READER opens in post-war Germany when teenager Michael Berg becomes ill and is helped home by Hanna, a stranger twice his age. Michael recovers from scarlet fever and seeks out Hanna to thank her. The two are quickly drawn into a passionate but secretive affair. Michael discovers that Hanna loves being read to and their physical relationship deepens. Hanna is enthralled as Michael reads to her from \"The Odyssey,\" \"Huck Finn\" and \"The Lady with the Little Dog.\" Despite their intense bond, Hanna mysteriously disappears one day and Michael is left confused and heartbroken. Eight years later, while Michael is a law student observing the Nazi war crime trials, he is stunned to find Hanna back in his life - this time as a defendant in the courtroom. As Hanna's past is revealed, Michael uncovers a deep secret that will impact both of their lives. THE READER is a story about truth and reconciliation, about how one generation comes to terms with the crimes of another.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"episode_id":8135,"background_color":"","content_control":"FAMILY"}}