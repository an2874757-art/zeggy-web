hing_progress":0},{"items":[],"id":10225,"title":"Avengers: Age of Ultron","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/0e98ef48-e717-4960-92c4-1ee4ce5b8ddc.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38484,"title":"The Long Walk","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/51b3d91f-a0e2-4d0c-ac04-621ff7d2b5d8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35545,"title":"Alarum","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/da83bece-d85f-4a23-9d9d-8b202db30848.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7044,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Drama","War"],"id":7044,"type":"MOVIE","title":"The Bridge on the River Kwai","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/352845ae-1218-4403-82ab-9ae0f0d520d0.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/280adb42-0433-47c0-b50f-7c2bddadd169.jpg","likes":24,"dislikes":0,"views":5088,"release_date":"-380246400000","length":9689,"description":"The film deals with the situation of British prisoners of war during World War II who are ordered to build a bridge to accommodate the Burma-Siam railway. Their instinct is to sabotage the bridge but, under the leadership of Colonel Nicholson, they are persuaded that the bridge should be constructed as a symbol of British morale, spirit and dignity in adverse circumstances. At first, the prisoners admire Nicholson when he bravely endures torture rather than compromise his principles for the benefit of the Japanese commandant Saito. He is an honorable but arrogant man, who is slowly revealed to be a deluded obsessive. He convinces himself that the bridge is a monument to British character, but actually is a monument to himself, and his insistence on its construction becomes a subtle form of collaboration with the enemy. Unknown to him, the Allies have sent a mission into the jungle, led by Warden and an American, Shears, to blow up the bridge.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG"},"episode_id":7044,"content_control":"FAMILY"}}