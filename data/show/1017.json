/cloud01.albox.co/shows/f5d14032-152f-42c7-b7c1-70615c75aa46.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":1017,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Sci-Fi","Drama","Thriller","Comedy","Animation","Mystery","Family"],"id":1017,"type":"MOVIE","title":"April and the Extraordinary World","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/551a525e-d078-42df-aec3-c6f1c638c109.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/d6a02c11-72d6-4f20-9f10-4e3ceee6021d.jpg","likes":25,"dislikes":0,"views":7626,"release_date":"1460073600000","length":6393,"description":"In 1941, the world is radically different from the one we know from history books. Geopolitics has developed strangely: Napoleon V rules France and, for the last 70 years, scholars have been mysteriously disappearing, depriving mankind of their inventions. Without radio, television, electricity, aviation, and the combustion engine, the world is mired in outdated technology, dozing in the previous century's knowhow dominated by coal and steam. In this bizarre universe, Avril (Marion Cotillard), a teenage girl, Darwin (Philippe Katerine), her talking cat, Pops (Jean Rochefort), her grandfather, and Julius (Marc-André Grondin), a young scoundrel and police informer, go off in search of Avril's parents, two of the missing scientists. The quartet will face many dangers and mysteries in this strange new Rigged World.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG"},"episode_id":1017,"content_control":"NORMAL"}}