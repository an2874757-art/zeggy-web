hing_progress":0},{"items":[],"id":19416,"title":"دورايمون","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk48/shows/2145c465-fb36-4f5b-a8ab-a88c1bcdbdc5.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":42278,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Animation"],"id":42278,"type":"SERIES","title":"مورينيو وفريق المميزين ","logo":"","image":"https://cloud02.albox.co/seasons/045088a1-85eb-42e9-9779-0ab2cea16061.jpg","background_image":"https://cloud02.albox.co/seasons/5da525ef-0bc5-4f92-8242-33f6c47cbf11.jpg","likes":0,"dislikes":0,"views":183,"release_date":"1609459200000","season_number":1,"description":"من خلال حلقات هذا المسلسل، فسارعوا إلى متابعة صاحب لقب (السبيشل وان)، واستكشفوا معه مهارات وفنيات الساحرة المستديرة، كرة القدم. تكشف أحداث المسلسل عن مشاهدة مورينيو للاعب كرة قدم محلي، وإعجابه بطريقة لعبه؛ ليقرر بعدها مساعدة هذا اللاعب الصغير على تطوير مهاراته في كرة القدم، ليجعل منه نجمًا عالميّا. يشكل مورينيو من هذا اللاعب ورفاقه فريقًا، ويتولى تدريبهم على مهارات كرة القدم المختلفة، ليصنع منهم فريقًا مميزًا قادرًا على ربح مباريات كرة القدم ضد الفرق المنافسة. هيا، انطلقوا مع مورينيو وفريق المميزين إلى ملاعب كرة القدم، وتعرفوا أكثر على فنيّات ومهارات كرة القدم، أكثر الألعاب الرياضية شعبية حول العالم.\r\n\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"TV-PG"},"background_color":"","current_season_id":24680,"content_control":"NORMAL"}}