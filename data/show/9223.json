lPoster"},{"data":[{"items":[],"id":9223,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy","Animation"],"id":9223,"type":"MOVIE","title":"Wreck-It Ralph","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/bba399fe-0280-40bc-883d-83b434cf4267.png","background_image":"https://cdn6.albox.co/storage/disk49/shows/412ae45d-158c-4418-9a90-09320620319d.png","likes":623,"dislikes":11,"views":57573,"release_date":"1351814400000","length":6073,"description":"Wreck-It Ralph longs to be as beloved as his game's perfect Good Guy, Fix-It Felix. Problem is, nobody loves a Bad Guy. But they do love heroes... so when a modern, first-person shooter game arrives featuring tough-as-nails Sergeant Calhoun, Ralph sees it as his ticket to heroism and happiness. He sneaks into the game with a simple plan -- win a medal -- but soon wrecks everything, and accidentally unleashes a deadly enemy that threatens every game in the arcade. Ralph's only hope? Vanellope von Schweetz, a young troublemaking \"glitch\" from a candy-coated cart racing game who might just be the one to teach Ralph what it means to be a Good Guy. But will he realize he is good enough to become a hero before it's \"Game Over\" for the entire arcade?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG"},"episode_id":9223,"content_control":"FAMILY"}}