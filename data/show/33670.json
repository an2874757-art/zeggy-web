id":19157,"title":"Fairy Tail","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":""},"length":0,"continue_watching_progress":0},{"items":[],"id":15739,"title":"Tower of God","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/3c41a15c-8c5e-46e7-9d7e-33167a7fca4f.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":33670,"title":"","description":"24","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi"," Action"," Fantasy"],"id":33670,"type":"SERIES","title":"Naze Boku no Sekai wo Daremo Oboeteinai no ka?","logo":"","image":"https://cloud02.albox.co/seasons/368536e3-a6cd-4165-a13c-bf3dc5df7f36.jpg","background_image":"https://cloud02.albox.co/seasons/63883093-7cd5-4c14-8767-34d83014d70c.jpg","likes":334,"dislikes":6,"views":33435,"release_date":"1720828800000","season_number":1,"description":"في الوقت الذي انتهت فيه الحرب الكبرى بين خمسة أعراق متنافسة من أجل التفوق على الأرض بانتصار البشرية بقيادة البطل سيد، أصبح العالم فجأة \"مكتوبًا\" أمام أعين صبي يُدعى كاي. في هذا العالم المعاد كتابته، يشهد كاي هزيمة البشرية في الحرب نتيجة لغياب سيد - حيث تحكم التنانين والشياطين الأرض الآن، وأصبح كاي نفسه وجودًا منسيًا لجميع البشر. ومع ذلك، بعد مواجهة الفتاة الغامضة Rinne، قرر كاي التحرر من هذا المصير المعاد كتابته. في عالم بدون بطل، يرث السيف والمهارات القتالية للبطل (سيد) ويتحدى أجناس العدو القوية التي تهيمن على الأرض.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"background_color":"","current_season_id":18951,"content_control":"NORMAL"}}