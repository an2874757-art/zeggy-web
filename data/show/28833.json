ox.co/shows/db0bdcf4-b847-4a7f-92cd-2cd171728ece.png","image":"https://cloud01.albox.co/shows/bcd6ad45-908a-4e4e-a01d-061fc14d5365.jpg","background_image":"https://cloud01.albox.co/shows/63def41f-7420-4846-947e-19a95dc0158e.jpg","likes":940,"dislikes":24,"views":63316,"release_date":"1659744000000","length":6905,"description":"يصل Luffy و Straw Hat Crew إلى أول حفل موسيقي مباشر على الإطلاق لـ Uta ، حيث اجتمع العديد من المعجبين للاستمتاع بغناء المغنية من عالم آخر. بسبب صدمة الطفولة ، تحمل أوتا كراهية عميقة للقراصنة ؛ تم قطع لم شملها السعيد مع لوفي عندما علمت أنه أصبح منذ ذلك الحين. أدى رفض لوفي لتغيير أساليبه إلى إطلاق أوتا لسلطاتها على قبعات القش. سرعان ما يتعلم الطاقم أن عقولهم محاصرة بالفعل في عالم أحلام Uta منذ بداية الحفل ، بينما تظل أجسادهم اللاواعية نائمة في العالم الحقيقي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"PG"},"episode_id":583900,"background_color":"#e50011","content_control":"FAMILY"}}