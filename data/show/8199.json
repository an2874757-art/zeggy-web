ea7869d-79a1-4c72-b1ad-20e7dc9910b9.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8199,"title":"","description":"16","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","War"],"id":8199,"type":"MOVIE","title":"Black Book","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/2d6f5014-2b86-4342-a259-b7a2fa6ec8e5.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/f1e6cde5-7390-4cee-91e1-1a4afb010292.jpg","likes":72,"dislikes":2,"views":12714,"release_date":"1179446400000","length":8738,"description":"Israel 1956. Rachel, a Jew, rather unexpectedly meets an old friend at the kibbutz where she is working as a teacher. It brings back memories of her experiences in The Netherlands during the war, memories of betrayal. September 1944. Rachel is in trouble when her hiding place is bombed by allied troops. She gets in contact with a man from the resistance and joins a group of Jews who are to be smuggled across the Biesbosch by boat to the freed South Netherlands. Germans from a patrol boat murder them all however. Only Rachel is able to escape. She is rescued by a resistance group under the leadership of Gerben Kuipers. When Kuipers' son is captured after trying to smuggle weapons, he asks Rachel to seduce SS-hauptsturmführer Ludwig Müntze. Soon she will find out the attack in the Biesbosch wasn't a coincidence.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"R"},"episode_id":8199,"content_control":"FAMILY"}}