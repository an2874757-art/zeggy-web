كة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"R"},"background_color":"#ffffff","current_season_id":20691,"content_control":"NORMAL"}}