gth":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi","Thriller"],"id":10436,"type":"MOVIE","title":"Captain America: The Winter Soldier","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/e60f49c0-cee6-4be4-ac29-b1716520496c.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/68cee881-a4e6-41f7-bcfe-f013950df24e.jpg","likes":755,"dislikes":16,"views":98703,"release_date":"1396569600000","length":8154,"description":"كابتن أمريكا أو ستيف روجرز (كريس إيفانز) طرأت تغيرات كثيرة على حياته، حيث يعيش في واشنطن في هدوء أو هكذا كان يتمنى. يحاول ستيف التكيف مع العالم الجديد والعصري ولكن حين يتعرض المقر الأعلى للجاسوسية الدولية قسم إنفاذ القانون (شيلد) لهجوم شرس يجد ستيف نفسه متورطًا في خضم معركة مليئة بالخداع والمكائد والتي ربما ستدمر العالم. بمساعدة نتاشا رامونوف أو الأرملة السوداء (سكارليت جوهانسون) يقوم ستيف روجرز بتنفيذ خطة محكمة لإنقاذ ما يمكن إنقاذه.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"episode_id":10436,"content_control":"FAMILY"}}