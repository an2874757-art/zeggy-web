Poster"},{"data":[{"items":[],"id":37382,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":37382,"type":"SERIES","title":"السيدة ديلا مدبلج","logo":"","image":"https://cloud02.albox.co/seasons/22940587-8d2a-425c-a143-fbc6555da00c.jpg","background_image":"https://cloud02.albox.co/seasons/398153cc-146b-467b-a2c3-fc94776c799b.jpg","likes":37,"dislikes":2,"views":5691,"release_date":"1347580800000","season_number":1,"description":"ديلا هي عروس جميلة من عائلة باراز أوغلو. تنقلب حياتها رأسا على عقب عندما قتل زوجها الجميل على يد الابن الأكبر لعائلة كارادالي ، ريزا. تقسم ديلا على الانتقام من زوجها وتقسم على قتل ريزا. تنتقل من اسطنبول وتبدأ في العيش في مزرعة كبيرة لوالد زوجها من أجل الانتقام. عندما تلتقي ريزا بديلا ، يغرق لها على الفور دون أن يعرف أنها تنحدر من عائلة باراز أوغلو. في الوقت نفسه ، تقع ديلى في حب ريزا لكنها لا تعرف أن ريزا هي قاتلة زوجها السابق. في هذه القصة ، سوف تستكشف الحب المستحيل لشخصين فخورين ينتمون إلى عائلات متعارضة. هل ستتعلم ديلا أن رضا هي التي قتلت زوجها السابق؟ هل ستتمكن ديلى وريزا من كبح حبهما؟ هل سينسى الماضي؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"","current_season_id":21643,"content_control":"NORMAL"}}