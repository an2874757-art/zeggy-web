image":"https://cloud02.albox.co/seasons/221cba1b-f6be-494d-bb89-2537fd6e4b35.jpg","background_image":"https://cloud02.albox.co/seasons/986c6291-9429-46f0-8fdb-40113faaf9e1.jpg","likes":78,"dislikes":0,"views":3155,"release_date":"1114732800000","season_number":1,"description":"بعد نهاية العالم، تواجه البشرية تهديدًا آخر: مصاصو الدماء. أدت المواجهات المستمرة بين الأجناس إلى تقسيم العالم إلى فصائل منفصلة. ينتمي عرق مصاصي الدماء، متوشالح، إلى الإمبراطورية البشرية الجديدة؛ في حين أن البشر، الذين يعتبرهم مصاصو الدماء من أهل الأرض، يشكلون دولة الفاتيكان البابوية. علاوة على ذلك، تسعى الجماعات المتطرفة مثل منظمة روزنكرويز إلى إعادة إشعال الحرب، على الرغم من محاولات الفصائل لتجنب الصراع المباشر.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"background_color":"","current_season_id":19676,"content_control":"NORMAL"}}