cloud02.albox.co/shows/f80f4d65-2ac3-4108-97e2-6ff1e7230b38.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":1287,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"],"id":1287,"type":"MOVIE","title":"Lovers Vanished","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/734acd27-ca53-4e84-b754-3fc1728ae859.jpg","background_image":"","likes":24,"dislikes":1,"views":3155,"release_date":"1270080000000","length":6285,"description":"This independent melodrama, a Korean Leaving Las Vegas (1995) according to its creator, depicts the fragile bonding of two people who thought they would never love again. He is an unjustly convicted chef who voluntarily contracts HIV from another inmate's needle in order to get released from prison. Then he can find out who really murdered his wife. She was a magician's assistant, who fell miserably in love with her boss. Now she runs a remote restaurant on the windswept coast of South Korean's Jeju island. Their paths cross after he escapes from prison, visiting the young woman at the request of a fellow inmate. She gives him a job as a chef, and they begin to get closer. Despite the relaxing seaside idyll and the ray of hope shining down on the characters' stark lives, happiness is forbidden them. A nationwide police search has begun for the fugitive and the inescapable threat of death from AIDS hangs over him every moment like a shadow.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"PG-13"},"episode_id":1287,"content_control":"NORMAL"}}