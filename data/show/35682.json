/d04d0060-04b0-4ff5-8e15-b95f26b9f29e.png","image":"https://cloud02.albox.co/seasons/7c3fb25c-e3f6-41c0-a27c-555221c3f0f2.jpg","background_image":"https://cloud02.albox.co/seasons/36762044-67d8-4908-8cbe-be8d2a0604ed.jpg","likes":34,"dislikes":1,"views":5091,"release_date":"1732924800000","season_number":1,"description":"في عهد أسرة تانغ، كانت جي ينغ ينغ، وهي فتاة شابة من ورشة صباغة هوانهوا في ييتشو، وتشاو شيو يوان، وهي عائلة كبيرة من الديباج في ييتشو، حبيبين منذ الطفولة. ومع ذلك، بسبب ضغوط الأسرة، لم تتمكن تشاو شيو يوان من الزواج إلا من نيو وو نيانغ، ابنة عائلة نيو الرسمية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"R"},"background_color":"#050505","current_season_id":20327,"content_control":"NORMAL"}}