Poster"},{"data":[{"items":[],"id":8720,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy"],"id":8720,"type":"MOVIE","title":"A Thousand Words","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/be37bdff-9615-4735-99ce-f0091c6df36c.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/ed3ba19b-5c69-4099-8376-565aa2bee659.jpg","likes":50,"dislikes":2,"views":5070,"release_date":"1331251200000","length":5490,"description":"Jack McCall, played by Eddie Murphy, finds an unusual tree in his yard after an encounter with a spiritual guru. After discovering that with each word he speaks, a leaf drops off of the tree, Jack refuses to speak at all, as doing so will keep the tree, and him, alive. However, his work, marriage, and friendships are all affected by his choice. Can Jack figure out an alternative method of survival? Or will he simply have to live the rest of his life to the fullest?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":8720,"content_control":"FAMILY"}}