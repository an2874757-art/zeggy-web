":"normalPoster"},{"data":[{"items":[],"id":9986,"title":"","description":"32","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Romance","Comedy","Music","Animation","Family"],"id":9986,"type":"MOVIE","title":"Aladdin","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/15998fe9-b4e4-43fa-a827-3346efc998f7.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/4b0dd1a4-b5ef-4141-8946-ba6e7ab0ce51.jpg","likes":746,"dislikes":21,"views":80233,"release_date":"722649600000","length":5440,"description":"Aladdin is a poor street urchin who spends his time stealing food from the marketplace in the city of Agrabah. His adventures begin when he meets a young girl who happens to be Princess Jasmine, who is forced to be married by her wacky yet estranged father. Aladdin's luck suddenly changes when he retrieves a magical lamp from the Cave of Wonders. What he unwittingly gets is a fun-loving genie who only wishes to have his freedom. Little do they know is that the Sultan's sinister advisor Jafar has his own plans for both Aladdin and the lamp.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"G"},"episode_id":9986,"content_control":"FAMILY"}}