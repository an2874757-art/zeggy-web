iption":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/f78bdc0c-0252-4a08-b113-eb23d0682728.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":21239,"title":"Parasyte: The Maxim","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/9d07043d-fc45-48fb-8fb0-a69058cd82d8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":13683,"title":"The Seven Deadly Sins","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/9b3605b2-03af-44ee-8ba5-9b143767b1a9.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":21017,"title":"Naruto: Shippuden","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk48/shows/c961a55b-979b-4974-a53f-859a48b30a5b.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19760,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Animation","Family"],"id":19760,"type":"SERIES","title":"Les Miserables: Shoujo Cosette","logo":"","image":"https://cdn6.albox.co/storage/disk56/seasons/ec3edc60-aa52-4c6f-adb3-9756d8188cfb.jpg","background_image":"https://cdn6.albox.co/storage/disk56/seasons/96b7c4e2-2084-44f4-ba24-0de3ddbfea72.jpg","likes":201,"dislikes":1,"views":12220,"release_date":"1168128000000","season_number":1,"description":"The classic novel by Victor Hugo returns to the world of Japanese anime in Nippon Animation's 52-episode adaptation \"Les Misérables: Shoujo Cosette\". The plot shifts its focus to include the story of Cosette, the illegitimate daughter of Fantine, from her early days with the Thénardiers while her mother works in another town. At the same time, the enigmatic Monsieur Madeleine, who is secretly the ex-convict Jean Valjean, is trying to live an honest life as the beneficent mayor of the same town Fantine works in. Both Valjean and Cosette's lives drastically change as the Thénardiers show their true colors and Inspector Javert arrives in town, posing a potential threat to Madeleine's freedom. This adaptation follows Hugo's story with relative faithfulness, given its young audience, limited running time and moments of artistic license.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"N/A"},"current_season_id":8506,"content_control":"NORMAL"}}