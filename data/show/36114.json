افة مميزة إلى جدول برمجة رمضان.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"#000","current_season_id":20726,"content_control":"NORMAL"}}