0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":1875,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime","Mystery","Horror"],"id":1875,"type":"MOVIE","title":"Perfect Stranger","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/6e7e3756-7fab-484f-847a-c2dca3ffe7e0.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/bd0db52a-13af-4121-910b-b94a5fe99ec4.jpg","likes":36,"dislikes":0,"views":6277,"release_date":"1176422400000","length":6541,"description":"Rowena Price is a muckraking reporter for a New York paper. When her story about a closeted gay Senator who preaches family values is spiked, she quits and soon finds herself investigating the grisly murder of a childhood friend. Her friend had been dumped by ad exec Harrison Hill, so he's Rowena's prime suspect. Rowena gets a job at the ad agency as a temp, and she's soon the object of Hill's attentions. She's helped in her subterfuge by Miles Haley, a friend at the paper who has a secret thing for her. Everyone, it seems, has secrets, including Hill, who must keep his affairs from his wife - her money fuels his lifestyle. Murder will out?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"R"},"episode_id":1875,"content_control":"FAMILY"}}