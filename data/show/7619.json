gth":0,"continue_watching_progress":0},{"items":[],"id":11765,"title":"365 يوم سعادة","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/ef935d18-ecd3-47ca-b6ad-caecce925b6f.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":24528,"title":"موسى","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/16bfcd4e-d8ec-4647-a4f9-f0d20fb55cbb.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":31944,"title":"بلوموندو","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/f046c85c-91de-4542-884c-22b29f2f534c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":31942,"title":"مستر اكس","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/af58101d-8e16-4fd6-8ed5-46ff7ea25a6b.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7619,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy"],"id":7619,"type":"MOVIE","title":"همام في أمستردام","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/7a113b4e-a55c-4b53-a374-2de366bf9cc0.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/fddb7766-17b7-44c9-bd2c-84e024e450fe.jpg","likes":64,"dislikes":0,"views":6834,"release_date":"-2208988800000","length":8034,"description":"يعيش همام فى حارة شعبية مع أسرته كثيرة العدد، يعانى من البطالة، ولا يجد عملا يتكسب منه، يتقدم خطيب ثرى فتضيع الفتاة التى يحبها بعد أن تزوجت الثرى، يقرر السفر إلى خاله الذى يعيش فى هولندا منذ سنوات، فى امتردام يفقد همام نقوده وبعده جواز سفره، وفى حانة يتعرض للاعتداء عليه فينقذه أدريانو، الشاب المصرى المغترب، ويساعده فى البحث عن خاله، لكن خاله يتخلى عنه، فلا يبقى أمامه سوى الإقامة فى مع مجموعة من الشباب المغتربين ليبدأ رحلة الشقاء بين الفشل والنجاح، بعد فترة يصبح همام ثريا، يتعرف على فتاة هولندية تساعده فى تحقيق حلمه، وكل همه شراء أكبر مطاعم أمستردام والذى كان يحلم به وهو فقير، ويتحقق بذلك حلم همام فى الثراء فى بلاد الغربة، يعود إلى مصر فى زيارة لأسرته بعد سنوات من الكفاح.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"N/A"},"episode_id":7619,"content_control":"NORMAL"}}