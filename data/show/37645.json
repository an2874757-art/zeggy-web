متحررة، اشتهرت وو تشن بارتداء ملابس الرجال، وارتيادها بيت دعارة ليفانغ، وقيادة مجموعة من الشباب الأرستقراطيين في مغامرات جامحة. إلا أن أسلوب حياتها المريح يخفي سرًا أعمق، خارقًا للطبيعة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"R"},"background_color":"","current_season_id":21821,"content_control":"NORMAL"}}