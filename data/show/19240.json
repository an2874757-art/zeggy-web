://cloud02.albox.co/shows/2f0406e7-8471-4468-9dcc-cf7304578477.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19240,"title":"","description":"61","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Animation","Family"],"id":19240,"type":"SERIES","title":"ريمي","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/347cd8d8-dfb1-4b83-8f00-79e28cf796a9.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/e41b49b0-59f7-4703-afc1-1663d4a736cd.jpg","likes":771,"dislikes":12,"views":66268,"release_date":"851126400000","season_number":1,"description":"ريمي، هي فتاة من عائلة نبيلة فقدتها والدتها وهي طفلة رضيعة وربتها امرأة فقيرة على أنها ابنتها، ثم تكبر ريمي وتعرف الحقيقة، ويحاول زوج أمها أن يبيعها لحاجته للنقود، فتهرب ريمي مع فيتالِس الذي يعمل مع حيواناته الأليفة كفرقة غنائية جوالة، وتنضم إليهم كعضوة في الفرقة، وفي نفس الوقت تبحث عن أمها الحقيقية، وبالفعل تلتقي ريمي بأمها لكن دون أن تعلم أن هذه المرأة هي أمها الحقيقية، وبعد أن تبتعد عنها في تجوالها تعلم ذلك وتعود للبحث ثانية، كما أن أمها أيضا تعلم بالحقيقة وهي بعيدة عنها، ثم يكون اللقاء.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"G"},"background_color":"","current_season_id":14023,"content_control":"NORMAL"}}