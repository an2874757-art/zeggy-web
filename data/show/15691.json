ox.co/storage/disk46/shows/8dfe376e-c137-40b4-9bdc-08c9c02c8099.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35482,"title":"American Primeval","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/9e9b7a78-d31e-46da-af92-0cb7e7344f7c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15691,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime","Mystery"],"id":15691,"type":"SERIES","title":"The Witness for the Prosecution","logo":"","image":"https://cdn6.albox.co/storage/disk46/seasons/d30c546a-a56e-414e-a753-6235fc810619.jpg","background_image":"https://cdn6.albox.co/storage/disk45/seasons/3edc97fd-f711-4723-a03a-0b1271464087.jpg","likes":10,"dislikes":0,"views":3025,"release_date":"1485734400000","season_number":1,"description":"Set in 1920s London, a brutal and bloodthirsty murder has stained the plush carpets of a handsome London townhouse. The victim is the glamorous and rich Emily French. All the evidence points to Leonard Vole, a young chancer to whom the heiress left her vast fortune and who ruthlessly took her life. At least, this is the story that Emily's dedicated housekeeper Janet McIntyre stands by in court. Leonard however, is adamant that his partner, the enigmatic chorus girl Romaine, can prove his innocence. Tasked with representing Leonard is his solicitor John Mayhew and King's Counsel, Sir Charles Carter KC.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"current_season_id":3055,"content_control":"NORMAL"}}