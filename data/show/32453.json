/cloud02.albox.co/shows/27a47115-5f81-4c3e-8a40-53b7414faf4c.png","image":"https://cloud01.albox.co/seasons/14020460-25ed-4f93-981a-c1d12eeeb189.jpg","background_image":"https://cloud01.albox.co/seasons/ecec0df6-3a21-4ef2-a905-20b358ddf157.jpg","likes":56,"dislikes":0,"views":4497,"release_date":"1226620800000","season_number":1,"description":"هذه المرة، لن يكون باتمان وحيدًا! من شركة وارنر بروس للرسوم المتحركة يأتي أحدث تفسير لسلسلة باتمان الكلاسيكية. سيقوم بطلنا المقنع بالتعاون مع أبطال من عوالم DC الآخرى، لتقديم أكشن ومغامرة مستمرة مع لمسة من الفكاهة. الخنفساء الزرقاء، والسهم الأخضر، وأكوامان، وغيرهم الكثير سيحصلون على فرصة لتحقيق العدالة بجانب باتمان. على الرغم من أنه ما زال في غوثام، سيجد باتمان نفسه في العديد من المواقف خارج حدود المدينة، يواجه تحديات غير مألوفة ومثيرة. ومع وجود أعداء قويين في كل مكان، سيعتمد باتمان على ذكائه، والموارد المتاحة له، ومجموعته اللامحدودة من الأجهزة الرائعة لتحقيق العدالة","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"TV-PG"},"background_color":"#f9a006","current_season_id":18307,"content_control":"NORMAL"}}