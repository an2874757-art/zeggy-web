lbox.co/seasons/171d352a-b78a-41a1-bd6f-238e9979fc3f.jpg","background_image":"https://cloud01.albox.co/seasons/a61180da-285e-4498-bc7d-fda24b7d030d.jpg","likes":40,"dislikes":1,"views":4413,"release_date":"1651190400000","season_number":1,"description":"لطالما كانت تتذكر ، كانت نينغ منغ تحلم بأن تصبح مديرة استثمار ، ولكن منذ التخرج ، يبدو أنها تنجرف أبعد وأبعد عن هذا الحلم. تعمل حاليًا في شركة استثمار تحت إشراف Lu Ji Ming ، ولم تُمنح Ning Meng أبدًا فرصة للتقدم في حياتها المهنية. الاعتقاد بأن Ning Meng ليس لديها ما يلزم لتصبح مستثمرة مؤهلة ، فإن Lu Ji Ming تبقيها عالقة في وظيفة مسدودة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"background_color":"","current_season_id":14948,"content_control":"NORMAL"}}