kground_image":"https://cdn8.albox.co/storage/CLOUD00/shows/03ca0f4e-6f6d-484c-b19c-51cbacd293b1.jpg","likes":42,"dislikes":4,"views":2855,"release_date":"1227830400000","length":5925,"description":"تدور أحداث الفيلم في إطار كوميدي رياضي.\nيكبر الطفل اليتيم (فانج شي جي) بداخل مدرسة للكونج فو، ويصبح لاعبًا موهوبًا في كرة السلة.\nيتعرض فانج للعديد من المضايقات في المدرسة، ولكنه دائمًا ما ينجح في التغلب عليها.\nينضم فانج إلى فريق كرة السلة، ويقوده الحب إلى الوقوع في العديد من المتاعب.\nيحاول شي جي استخدام تقنيات الكونج فو في لعب كرة السلة، ويعمل من أجل مساعدة فريقه على الفوز بالبطولة.\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.9}],"value":4.9,"age":"PG-13"},"episode_id":438994,"background_color":"#eb1c24","content_control":"NORMAL"}}