kground_image":"https://cdn6.albox.co/storage/disk47/seasons/214ef2f0-b00d-4ef3-a9e2-1e58c6200309.jpg","likes":324,"dislikes":15,"views":113312,"release_date":"1594252800000","season_number":1,"description":"يدور المسلسل حول انضمام ضيفين غريبين الى عائلة كبيرة و دافئة. أتاش و ياسمين اللذان ينضمان بكذبة صغيرة الى هذه العائلة، أولاً سيقعان في الحب تحت هذه العلوية وثم سيتم امتحانهما بأكاذيبهما. أتاش، أيشان، ديمير و ياسمين بشخصياتهم المختلفة و القادمين من طبقات اجتماعية و ثقافية مختلفة سيقاومون من أجل حبهم و لو كلفهم ذلك الوقوف ضد عائلاتهم. بينما تترك الحياة الشباب في مواجهة هموم أكبر منهم، هل هذه العائلة ستتجاوز كل شيء بروابطها القوية و تستطيع البقاء معاً؟.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.2}],"value":5.2,"age":"PG-13"},"current_season_id":2160,"content_control":"NORMAL"}}