"card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Thriller"],"id":7268,"type":"MOVIE","title":"The Island","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/51407268-bfc6-4aab-9073-1d57b2264a93.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/47024a24-c1d4-460c-b9fe-08dcd9e59f0a.jpg","likes":58,"dislikes":0,"views":9379,"release_date":"1121990400000","length":8160,"description":"في عام 2019، يعيش لينكولن 6 إكو (إيوان ماكجريجور) في مكان مغلق، ويحلم مثل بقية قاطني هذا المكان بأن يتم اختيارهم للذهاب إلى \"الجزيرة\" التي تعد أخر مكان غير ملوث على ظهر الكوكب، لكنه يكتشف مع تطور الأحداث أنه هو وبقية القاطنين من المستنسخين الذين تم صنعهم خصيصاً من أجل تزويد الأعضاء البديلة للأثرياء، مما يدفعه للهروب من هذا المكان بصحبة رفيقته الجميلة جوردون 2 دلتا (سكارليت جوهانسون).","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-13"},"episode_id":7268,"background_color":"","content_control":"NORMAL"}}