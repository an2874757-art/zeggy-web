m, he must now embark on a journey to reclaim his fallen kingdom.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"pg-13"},"current_season_id":9029,"content_control":"NORMAL"}}