lbox.co/seasons/feca84ff-0c12-4ff6-8abf-625d56d448b5.jpg","likes":64,"dislikes":3,"views":6266,"release_date":"1602892800000","season_number":1,"description":"تانر مخترع شاب يعيش في بلدة صغيرة تدعى جيديلي في وسط المستنقع. فقد والده، فاضطر لدعم أسرته، لذلك لم يتمكن من الالتحاق بمدرسة العلوم الثانوية، التي تم قبوله فيها، رغم أنه كان يرغب بشدة في ذلك. كانت والدة تانر دائما تحاول تزويجه، لكن تانر لم يكن ينوي ذلك لأن هناك حبا في قلبه لم يستطع نسيانه لسنوات. حبيبته في الطفولة ديليك.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"background_color":"","current_season_id":22552,"content_control":"NORMAL"}}