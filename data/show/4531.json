elf falling in love with this mysterious beauty.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"R"},"episode_id":4531,"content_control":"NORMAL"}}