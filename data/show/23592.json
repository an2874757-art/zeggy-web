ikes":111,"dislikes":5,"views":15779,"release_date":"1604448000000","length":8207,"description":"يروي الفيلم قصة الموقف البطولي لطلاب بودولسك خارج موسكو في أكتوبر 1941. تم إرسال طلاب من مدارس المشاة والمدفعية في بودولسك إلى خط دفاع إلينسكي ، حيث قاتلوا جنبًا إلى جنب مع وحدات من الجيش السوفيتي 43 لصد تقدم ألمانيا حتى وصلت التعزيزات. فاق عددهم عددًا يائسًا ، فقد ضحى الشباب في سن المراهقة بحياتهم في معركة استمرت ما يقرب من أسبوعين لعرقلة تقدم القوات الألمانية المتفوقة نحو موسكو. هذا الفيلم ليس فقط عن الحرب. إنه أيضًا عن الحب والصداقة الحميمة الحقيقية والطريق من الصبا إلى الرجولة. تم إرسال حوالي 3500 متدرب وضباطهم لقيادة خط الدفاع الأخير خارج موسكو. بقي معظمهم هناك إلى الأبد.\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":""},"episode_id":419247,"content_control":"NORMAL"}}