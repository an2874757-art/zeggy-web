torage/disk54/shows/69c2a5ab-c3c7-4026-af09-3fc1aa268d7c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":417,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi","Thriller","Horror"],"id":417,"type":"MOVIE","title":"The Cell","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/b048d877-64d1-4902-8595-37582d059f60.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/0288b66d-ead6-4849-8993-c739c95e8e04.jpg","likes":57,"dislikes":5,"views":19346,"release_date":"966556800000","length":6553,"description":"Catharine Deane is a psychotherapist who is part of a revolutionary new treatment which allows her mind to literally enter the mind of her patients. Her experience in this method takes an unexpected turn when an FBI agent comes to ask for a desperate favour. They had just tracked down a notorious serial killer, Carl Stargher, whose MO is to abduct women one at a time and place them in a secret area where they are kept for about 40 hours until they are slowly drowned. Unfortunately, the killer has fallen into an irreversible coma which means he cannot confess where he has taken his latest victim before she dies. Now, Catherine Deane must race against time to explore the twisted mind of the killer to get the information she needs, but Stargher's damaged personality poses dangers that threaten to overwhelm her.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"R"},"episode_id":417,"content_control":"FAMILY"}}