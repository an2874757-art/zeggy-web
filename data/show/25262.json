ard_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Business"," Comedy"],"id":25262,"type":"SERIES","title":"Why Women Love","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/40faadcc-55d2-430c-949b-1c77ed53a07a.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/54fa6877-5880-4fa4-9aa5-27b4286dc1d6.jpg","likes":96,"dislikes":1,"views":6626,"release_date":"1644278400000","season_number":1,"description":"Zhao Jiang Yue هو الرئيس المستبد إلى حد ما لشركة تكنولوجيا. وهي معروفة بنهجها الجاد في العمل - وموظفيها. تطلق الشركة تطبيق مواعدة يعد بمطابقة المستخدمين مع شريك في غضون ثلاثة أشهر فقط. هي أيضا جاهلة إلى حد ما في شؤون القلب نفسها. لكن الأمور تبدأ في الشعور بعدم الراحة في العمل عندما تقوم العائلة التي تملك الشركة بترتيبات انضمام Gu Jia Xin ، وريث مجموعة الأعمال التي تمتلك الشركة ، للانضمام كمساعد مؤقت لـ Zhao Jiang Yue.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"current_season_id":13346,"content_control":"NORMAL"}}