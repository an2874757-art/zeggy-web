,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":36166,"type":"SERIES","title":"العاشق يفعل المستحيل مدبلج ","logo":"","image":"https://cloud02.albox.co/seasons/095e57b5-f7e4-4fb0-8e2a-c5a81e6f0f79.jpg","background_image":"https://cloud02.albox.co/seasons/6dbf376a-8f51-46f2-b7c1-33e1a00c640c.jpg","likes":118,"dislikes":11,"views":20764,"release_date":"1483228800000","season_number":1,"description":"تدور قصة مسلسل العاشق يفعل المستحيل حول البطل الذي يدعى «أوزان»، وهو شاب مدلل وهو الوريث الوحيد لأثرى أثرياء إسطنبول والذي يملك سلسلة شركات اكينسوي في تركيا. يرتكب أوزان خطأ فادح في بداية حلقات المسلسل ليكتشف والده هذا الخطأ، وعلى إثره يقوم الأب بمعاقبته وإرساله إلى مكان بعيد عن إسطنبول أشبه بالنفي.يلتقي أوزان في المكان الذي تم إرساله إليه بفتاة جميلة جداً تدعى «نازلي».\r\n\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"#000","current_season_id":20767,"content_control":"NORMAL"}}