n6.albox.co/storage/disk51/shows/baba9eee-3c7b-42ab-a526-83ac3b14ebc7.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/a0d17295-13c3-4ed0-a66e-28cdf94700ca.jpg","likes":90,"dislikes":0,"views":8904,"release_date":"1433721600000","season_number":1,"description":"Jang Yoon-ha is the youngest daughter of a chaebol family. Despite her wealth, she works part-time at a food market and hides her true identity as an heiress because all she truly wants is to find a man who'll love her for herself and not her money. Choi Joon-ki grew up in extreme poverty, and has a huge chip on his shoulder about his poor parents being belittled. Now working as a middle manager for a conglomerate, Joon-ki is smart and talented but also jaded and calculating, believing that love is a luxury only for the wealthy.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"N/A"},"current_season_id":8112,"content_control":"NORMAL"}}