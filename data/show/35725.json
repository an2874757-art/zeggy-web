gth":0,"continue_watching_progress":0},{"items":[],"id":36734,"title":"One: High School Heroes","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/d0628511-ef4c-4e1f-829e-22a23ed76fc1.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":19784,"title":"The K2","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk47/shows/b9d0987a-843f-4428-b1c1-dd404867d6be.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35725,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy"," Romance"," Wuxia"],"id":35725,"type":"SERIES","title":"Divine Destiny","logo":"","image":"https://cloud02.albox.co/seasons/c27caa70-93df-437f-b2e9-0a252ac6799f.jpg","background_image":"https://cloud02.albox.co/seasons/a61f570a-d3fc-4858-b3f1-499fceba4e4a.jpg","likes":15,"dislikes":0,"views":1652,"release_date":"1685664000000","season_number":1,"description":"تم التعرف على اليتيم جي رو تشين عن طريق الخطأ على أنه الوريث المنفي لعالم الخالدين، يين فينج، بسبب الحجر الأزرق الذي سرقه من مالكه الشرعي. وبسبب ذلك تم اختيار جي رو تشين كواحد من التلاميذ للزراعة تحت إشراف زعيم طائفة شيشوان. بشكل غير متوقع، على الرغم من أنه في قلبه، وقع في حب تشانغ يين يين - ابنة أحد الأعضاء القياديين في الطائفة والشخص الذي ساعده وأرشده طوال الوقت بينما وقع في حبه أيضًا - بسبب تأثير الحجر وحب الإله الخالد الأبدي، طور مشاعر تجاه أحد أعضاء الطائفة، جو تشينغ وتقرر الطائفة تزويجهما. لكن يين يين لم تستسلم بسهولة ولاستعادة قلب رو تشين، قررت أن تتعلم من الثعلب السماوي ذي الذيل التسعة، مهارة خاصة، والتي من شأنها أن تساعدها في حماية حبيبها ولكن بثمن، يجب أن تدفعه بنفسها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"background_color":"","current_season_id":20356,"content_control":"NORMAL"}}