 وفي النهاية تبرئ ساحة عائلتها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"NC-17"},"background_color":"","current_season_id":24819,"content_control":"NORMAL"}}