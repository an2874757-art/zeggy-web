ng_progress":0},{"items":[],"id":18447,"title":"The Saga of Tanya the Evil","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":""},"length":0,"continue_watching_progress":0},{"items":[],"id":40610,"title":"Witch Hat Atelier","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/b065cf1e-23aa-4dbd-b6eb-acec0e204cb6.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15739,"title":"Tower of God","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/3c41a15c-8c5e-46e7-9d7e-33167a7fca4f.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35978,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Fantasy"],"id":35978,"type":"SERIES","title":"Jewelpet Twinkle","logo":"","image":"https://cloud02.albox.co/seasons/80786407-f0d9-4cd4-8088-e09e7452491f.jpg","background_image":"https://cloud02.albox.co/seasons/48d07861-c644-4f60-be64-60f55d4c5473.jpg","likes":72,"dislikes":1,"views":3725,"release_date":"1270252800000","season_number":1,"description":"في أرض الجواهر، تعيش مخلوقات الجواهر التي تمتلك القدرة الطبيعية على استخدام السحر في وئام مع الساحرات، وتحضر مدرسة السحر والشعوذة لتعلم استخدام السحر بأعين الجواهر الخاصة بها. ومع ذلك، بالنسبة لروبي، الأرنب الياباني الأبيض الذي يفشل سحره أحيانًا، يتم تعيينه للذهاب إلى العالم البشري للبحث عن شريكها. ولكن عندما استخدمت البطاقة التي أعطاها لها السحرة، تم إرسالها إلى العالم البشري عن طريق الخطأ. في العالم البشري، التقت بها فتاة تدعى أكاري ساكورا على الشاطئ في طريقها إلى المدرسة. في البداية، لم تستطع أكاري فهمها بسبب لغة أرض الجواهر الخاصة بها حتى أخذت روبي حلوى خاصة حتى تتمكن من التحدث وفهم اللغة البشرية. مع مرور اليوم، عرفت روبي بمشاكلها واعتذرت لاحقًا. ظهرت تعويذة جوهرة على يد أكاري وأدركت أنها اختارتها روبي لتكون شريكتها. بعد ذلك، قررت دخول جائزة نجمة الجواهر الكبرى، والجائزة هي أن أي أمنية تريدها ستتحقق. هل ستكون هي جوهرة النجوم التالية وتتحقق أمنيتها في النهاية؟ أم أن الأمر سينتهي بكارثة كبيرة...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG"},"background_color":"","current_season_id":20598,"content_control":"NORMAL"}}