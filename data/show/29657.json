ss":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":29657,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Documentary"],"id":29657,"type":"SERIES","title":"The Wild Andes","logo":"https://cloud01.albox.co/shows/823ba854-6b05-42fb-b2b5-a03c120f344a.png","image":"https://cloud01.albox.co/seasons/2f8f30cd-296a-4bd8-add6-b19e2ac99844.jpg","background_image":"https://cloud01.albox.co/seasons/9f1e1bfa-a2f6-4e09-b3da-075ba0828ed1.jpg","likes":14,"dislikes":0,"views":1809,"release_date":"1537488000000","season_number":1,"description":"The Andes mountains were born from the volcanic fire nearly 25 million years ago, they are the longest mountain chain on earth. The mountain range is pushed up by tectonic forces and continue to rise up to create new and beautiful landscapes and habitats for the variety of creatures that roam them. Take a journey through the mountains' extremes and learn about the animals that call the 4,000-mile expanse their home. Take the paths along the western edge of South America from Southern Patagonia's icy expanse to the oxygen-deprived Altiplano plateau all the way to the northern's tropical landscape.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"PG-13"},"background_color":"#75859c","current_season_id":16811,"content_control":"NORMAL"}}