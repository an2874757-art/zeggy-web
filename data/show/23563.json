-468f3dc5fbc6.png","image":"https://cdn7.albox.co/storage/CLOUD00/shows/ddacb2de-25c7-4b66-b4d8-52eaaa99873f.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/shows/f8508324-4335-46f6-bb59-d15effd666c0.jpg","likes":150,"dislikes":4,"views":4940,"release_date":"1355270400000","length":4774,"description":"تعيش سيلستين (باولين بيرنر) في العالم السفلي للقوارض، في الملجأ تم إخبارها بالعالم السيء والوحشي والمخيف الذي يعيش به مجموعة من الدببة ولكن تتشكك سيلستين في صدق تلك القصص، وكان لدي سيلستين شغف بالرسم ولكنها تدرس طب الأسنان حيث إنها مهنة القوارض. في يوم من الأيام وبينما تقوم بمهمة لها في عالم الدببة يكتشفها دب يُدعى (لامبر ويسلون) ويعتزم أن يأكلها لكنها تخبره أنها سترشدة على سرداب به طعام وبالفعل يذهب إلى هناك معها وتنشأ بينهما علاقة قوية.\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"G"},"episode_id":418865,"background_color":"#d86856","content_control":"NORMAL"}}