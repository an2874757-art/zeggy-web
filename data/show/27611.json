x.co/shows/5142b625-6804-4c3e-9016-d07d7acd514f.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":27611,"title":"","description":"25","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":27611,"type":"SERIES","title":"Tuzak - الفخ","logo":"https://cloud01.albox.co/shows/84f34405-7a0b-4fce-908d-74c873c07b2b.png","image":"https://cloud01.albox.co/seasons/3e854412-32eb-4073-a4a0-6c9dc8e1ab22.jpg","background_image":"https://cloud01.albox.co/seasons/a179df25-454b-46f8-a297-9afdbb987428.jpg","likes":195,"dislikes":11,"views":52421,"release_date":"0","season_number":1,"description":"حول حياة الأشقاء الذين سلبت طفولتهم منهم، ويحاولون الانتقام من شخص غني كان السبب في تغيير حياتهم، وتقف ابنة العدو الذكية والقوية أمام من خططوا لهذا الانتقام لعدة سنوات، فمن سيقع في الفخ هو لغز مجهول يسعى \"المحامي أوموت\" أكين أكينوزو، مع أشقائه ماهر وأومي إلى تحقيق العدالة بين يديه، وستكون الحجة مليئة بالخيانات والتعويضات والمفاجآت، سعيا وراء هدفه، سيعاني \"أوموت\" من الصراع مع العائلة التي يريد تدميرها هي عائلة \"غونيش\".\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"#37646b","current_season_id":15170,"content_control":"FAMILY"}}