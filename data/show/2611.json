":"normalPoster"},{"data":[{"items":[],"id":2611,"title":"","description":"14","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":2611,"type":"MOVIE","title":"You Again","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/3b40499f-be21-4163-886d-8c6d79471c93.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/976e6e3a-e8fb-42c6-acea-cf908ad4eb5e.jpg","likes":48,"dislikes":5,"views":9899,"release_date":"1285286400000","length":6328,"description":"As a teenager Marni was the kind of girl no guy would go near and would be tormented by the mean girls, and no one was meaner to her than Joana the head cheerleader. Years later, she's a successful woman with a good job. When she goes home for her brother's wedding she discovers that her brother is marrying Joana. And he doesn't know what she did to Marni. When they meet she wants Joana to apologize for the way she treated her but Joana feigns ignorance. When Marni tells her mother, Gail about her and Joana, Gail tells her to try and put it behind her. But when Gail meets Joana's aunt Mona, it turns that she's her old friend Ramona who was her friend in high school whom she had falling out with with years ago, and Gail is unaware what caused it. Gail feels like Mona is trying to thumb her success in her face. When Marni learns that Joana does remember her she sets to expose her to her brother.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"PG-13"},"episode_id":2611,"content_control":"NORMAL"}}