id":17713,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":17713,"type":"SERIES","title":"ابو جبل","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/3775eb70-5b13-456f-9197-4055c79a5424.jpg","background_image":"https://cdn6.albox.co/storage/disk54/seasons/75255e4e-33e3-4710-aa5c-059526261394.jpg","likes":82,"dislikes":1,"views":67840,"release_date":"1554076800000","season_number":1,"description":"تشهد الحلقات الأولى مقتل أطفال مصطفى شعبان الثلاثة من زوجته التي تجسدها الفنانة عائشة بن أحمد، ويدخل شعبان في صراعات مع عائلته وإخوته خاصة بعد وفاة أطفاله الثلاثة، ووالده حسن حسني ويبدأ مصطفى رحلة البحث عن القاتل على مدار الحلقات حتى يدخل السجن، وتتوالى الأحداث في إطار درامي مشوق، وبه العديد من الألغاز تكشفها الحلقات ويتورط الفنان مصطفى شعبان في عدد كبير من الأزمات والمشاكل، التي تقلب حياته رأساً على عقب، مما يجعله يستعين بصديقه مجدي البحيري للوقوف إلى جانبه والتخلص منها","rating":{"sources":[],"value":0,"age":"TV-14"},"current_season_id":5847,"content_control":"NORMAL"}}