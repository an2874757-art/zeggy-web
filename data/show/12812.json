":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","War"],"id":12812,"type":"MOVIE","title":"Saving Private Ryan","logo":"https://cdn7.albox.co/storage/CLOUD00/shows/1fc2287b-9f18-46c4-923f-ff16378a1745.png","image":"https://cdn7.albox.co/storage/CLOUD00/shows/6e9482e3-bd32-410c-97ba-a7e09e525f59.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/shows/e2081707-8160-4070-a981-860e5caa0ce7.jpg","likes":1375,"dislikes":25,"views":106682,"release_date":"901238400000","length":10169,"description":"Opening with the Allied invasion of Normandy on 6 June 1944, members of the 2nd Ranger Battalion under Cpt. Miller fight ashore to secure a beachhead. Amidst the fighting, two brothers are killed in action. Earlier in New Guinea, a third brother is KIA. Their mother, Mrs. Ryan, is to receive all three of the grave telegrams on the same day. The United States Army Chief of Staff, George C. Marshall, is given an opportunity to alleviate some of her grief when he learns of a fourth brother, Private James Ryan, and decides to send out 8 men (Cpt. Miller and select members from 2nd Rangers) to find him and bring him back home to his mother...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"R"},"episode_id":12812,"content_control":"FAMILY"}}