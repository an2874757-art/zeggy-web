ption":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk57/shows/f8bf673b-6902-4d26-8970-90291ff28f37.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":21310,"title":"Sherlock","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/0cb28fdd-fc91-4f48-bb61-46e93155eb12.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":21275,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime","Mystery"],"id":21275,"type":"SERIES","title":"the missing","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/53506260-74c8-44fa-9eb8-d547f0d76135.jpg","background_image":"https://cdn6.albox.co/storage/disk47/seasons/e6b173da-61dc-499a-8738-cb00866eb828.jpg","likes":71,"dislikes":1,"views":16518,"release_date":"1486857600000","season_number":1,"description":"\"The Missing\" follows Tony, played by James Nesbitt, as a man devastated by the abduction of his young son, Oliver, during a family vacation in France. He becomes a man obsessed, unable to accept that his child may be dead and spends years searching for him. Tony's exhaustive search fractures his marriage to Emily, played by Frances O' Connor and threatens to destroy his life. Tcheky Karyo plays Julien, the French police detective who launched the initial search for the child. Even though he is retired in present day, he too cannot shake the small belief that the child may still be alive. Told using a fascinating narrative puzzle, \"The Missing\" explores the impact of a child's abduction, the emotional cost of obsession, hope and finding when to let go. This gripping thriller is told simultaneously over multiple time frames and set in France and London.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG-13"},"current_season_id":10611,"content_control":"NORMAL"}}