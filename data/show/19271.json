watching_progress":0},{"items":[],"id":40737,"title":"We Are All Trying Here","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/8acb0f12-3142-492f-8c39-e77239581723.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35614,"title":"The Trauma Code: Heroes on Call","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/55a26a3e-4693-4636-8b09-de5e572749f6.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36733,"title":"Good Boy ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/b297704e-01b5-4aac-aa6a-518737b4d728.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":17101,"title":"Love Alarm","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/077e0cd3-b3ba-467c-80dc-5397fe7d2fe2.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19271,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":19271,"type":"SERIES","title":"Birth of a Beauty","logo":"","image":"https://cdn6.albox.co/storage/disk47/seasons/294889a2-a0ba-4bf3-a841-a9aa142ea23e.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/eb10c7fe-7327-4666-a772-7930cb896715.jpg","likes":164,"dislikes":5,"views":15454,"release_date":"1414800000000","season_number":1,"description":"Overweight, kind-hearted Sa Geum-ran (Ha Jae-sook) married into a well-to-do family, but her husband Lee Kang-joon (Jung Gyu-woon) has spent the past seven years in the United States for his business, and she lives with his mother and sisters who treat her badly. Geum-ran learns that Kang-joon has been having an affair with sophisticated broadcast announcer Gyo Chae-yeon (Wang Ji-hye), and he asks for a divorce. When she sees her in-laws welcoming Chae-yeon with open arms, the distraught Geum-ran threatens her husband, who follows her and causes her to drive her car off a cliff. Everyone assumes that Geum-ran committed suicide and attends her funeral, not knowing that she's still alive. To get revenge against those who've wronged and betrayed her, Geum-ran begs Han Tae-hee (Joo Sang-wook), whom she thought was the plastic surgeon of extreme-makeover television show Change, to transform her, and he reluctantly agrees because of his own ulterior motives. After weight loss and surgery, Geum-ran emerges from the full-body makeover as a stunningly beautiful woman, and she begins calling herself the new name Sara (Han Ye-seul), albeit retaining her coarse ajumma personality. With Tae-hee as her life coach, they scheme to ruin Kang-joon and Chae-yeon's upcoming wedding in three weeks. But as Sara interacts with Kang-joon in their staged run-ins, old feelings resurface, and she decides that instead of destroying him, she wants her husband back. They adjust their plan accordingly, though Tae-hee soon finds himself falling for Sara.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG-13"},"background_color":"","current_season_id":7792,"content_control":"NORMAL"}}