/shows/80c16db8-6682-4cdd-b4bf-b8bc24724df2.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":14789,"title":"هم نوايا","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk57/shows/f9658da4-11d1-4d67-874e-a86f76aa8480.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35346,"title":"القدر","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/31c35e08-cbab-4051-b739-34ef1a360215.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":25710,"title":"كسر عضم","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/4069cb82-a538-43a4-9cc1-c8fbfaba35bb.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18432,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":18432,"type":"SERIES","title":"امراة من نار","logo":"","image":"https://cdn6.albox.co/storage/disk57/seasons/826e4d4c-1c11-4534-bd1c-7fca2db125bf.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/513dce11-68df-4b74-8b46-3758ef372d6b.jpg","likes":10,"dislikes":0,"views":4363,"release_date":"-2208988800000","season_number":1,"description":"قررت ناهد المسيري الموافقة على طلب إدارة المستشفى، التي تعمل بها ممرضة ، بالذهاب لرعاية الثري القعيد، والمريض بالقلب ، الدكتورمنصور الراوي، الذي نجا وطفله الرضيع من حادث قتل ، ماتت فيه زوجته ، وخرج منه مشلولا، خاصة وأنها علمت أنه يريد زوجة ليس لديها أبناء؟ تكون أما بديله لطفله .أخفت ناهد طفلها من عباس السكري الذي هجرها وسافر إلى أوروبا، عند عمتها، وبدأت تخطط للزواج من منصور الراوي الذي وثق فيها وتزوجها، وعهد إليها بتربية طفله، بل واختارها وصية عليه بعد موته، الذي تحقق بعد ذلك بشهور قليلة آلت ناهد على نفسها أن تثأر لذاتها وابنها من الدنيا والفقر، حتى ولوفعلت مايعجز عنه الشيطان ..لذا فقد استبدلت ابن منصور بطفلها الذي بحوزة عمتها وزورت في شهادات ميلادهما، بل إنها تركت بلدتها وسافرت إلى مدينة أخرى، لايعرفها فيها أحد تعود بعد خمس سنوات ..تتعرف مرضعة أحمد منصور الحقيقي عليه، من \"وحمة\" في جسده تعرفها منذ طفولته المبكرة ، لكن ناهد تقتلها حتى لاتنكشف جريمتها .. ويعود عباس السكري، ليتعامل مع ابنه المزيف على أنه فلذة كبده ..وتمر الأيام ..وها هي ناهد تقف أمام باب الفندق الضخم ، تنتظر خروج ابنها العريس في يد عروسة ليلة زفافهما ..تنطلق رصاصات الثأر إلى صدر أحمد منصور، المفروض أنه صعيدي الأصل ..تصرخ \"إنه ابني أنا، وليس أحمد الحقيقى ..\" ولكنها عدالة السماء.","rating":{"sources":[],"value":0,"age":"TV-14"},"current_season_id":6725,"content_control":"NORMAL"}}