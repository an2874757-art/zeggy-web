}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Drama","Comedy","Animation"],"id":21936,"type":"SERIES","title":"Fullmetal Alchemist","logo":"","image":"https://cdn6.albox.co/storage/CLOUD00/seasons/b71d936d-87f7-42ba-bf25-2c63851f84ee.jpg","background_image":"https://cdn6.albox.co/storage/CLOUD00/seasons/0f3a09e7-ae96-4730-b274-b21bd1ffa9ed.jpg","likes":381,"dislikes":8,"views":42349,"release_date":"1099699200000","season_number":1,"description":"The Elric brothers' mother is dead and their father has long since abandoned them. Deciding to perform a forbidden human transmutation to bring their mother back, they end up losing their bodies. Now Edward must join the military in order to gain certain alchemical privileges, with his one goal being to restore his brother to his original state. But with war on the horizon it's only a matter of time before they are both forced to question their morals and ultimately decide the value of human life.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"PG-13"},"current_season_id":11086,"content_control":"NORMAL"}}