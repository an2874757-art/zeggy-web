"genres":["Adventure","Comedy","Animation"],"id":12785,"type":"MOVIE","title":"Everyone's Hero","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/98bb0fb5-4961-4ac4-9fbc-185fc85facce.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/28273bee-c81f-4757-93a3-004bdc8c8e32.jpg","likes":16,"dislikes":0,"views":1946,"release_date":"1158278400000","length":5234,"description":"A young boy named Yankee Irving finds himself at an extraordinary crossroads: He has a chance to be a hero - and make a difference against incredible odds - or he can play it safe. With faith in himself instilled by his family, he teams up with a sassy young girl and some off-the-wall sidekicks and embarks on a sometimes perilous, often funny, cross-country quest. In the process, he restores his family's honor, befriends the world's biggest sports superstar, and reveals the hero within.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"G"},"episode_id":12785,"content_control":"NORMAL"}}