ن الشركة، لكن بونتا مُقيَّدٌ أيضًا بقاعدة غامضة تُلزمه بـ\"عدم الوقوع في حب الناس\".","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-14"},"background_color":"#ffffff","current_season_id":22377,"content_control":"NORMAL"}}