"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Horror"],"id":2913,"type":"MOVIE","title":"Maggie","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/4acea490-34d6-4bcd-bcfb-78bde494e248.jpg","background_image":"","likes":36,"dislikes":3,"views":7664,"release_date":"1431043200000","length":5704,"description":"After a couple of weeks seeking out his teenage daughter Maggie, Wade finds her in the quarantine wing of a hospital. Maggie has been infected by a lethal outbreak that transforms the victim into a zombie. Wade's friend Dr. Vern Kaplan releases Maggie to spend her last days with Wade and her family. Her stepmother Caroline asks Wade to take their little kids to her sister's house to keep them safe. While Maggie is slowly transformed, Wade stays with her protecting Maggie. But Dr. Vern warns him that the moment that he will have to take an ultimate decision is closer.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"PG-13"},"episode_id":2913,"content_control":"FAMILY"}}