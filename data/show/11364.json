ontinue_watching_progress":0},{"items":[],"id":12040,"title":"Taare Zameen Par","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk42/shows/8ac0fd10-c61f-4a53-9a00-140e4b29ebe8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":9550,"title":"Mohabbatein","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/db5e2b22-94b5-4345-9d26-76ad3c155e8a.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":33870,"title":"Kill","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/b5a3b1d2-b22c-4dee-b9be-52a15ab628f1.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":97,"title":"Sir","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk47/shows/35c28e7a-ce56-42b7-a73f-b4aaab6c68f8.jpeg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":11364,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":11364,"type":"MOVIE","title":"Salaam Namaste","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/3ce408b3-11ec-4ed4-a553-7572e3034979.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/47db5a4f-a159-4632-8aff-71b05c293330.jpg","likes":130,"dislikes":2,"views":17384,"release_date":"1126224000000","length":9491,"description":"Falling in love. It's very easy to do. Being in love - now that's the tough part. Nick (Saif Ali Khan) - He's a chef. Ambar (Preity Zinta) - She's a Radio Jockey. They're young, they're cool, they're independent -and together they make the PERFECT pair. Or do they? Surrounded by quirky friends, bosses and landlords but far away from home. Nick and Ambar take a huge leap of faith as they decide to move in together. And now they must tiptoe towards getting to know each other? They are attracted to each other - but they fight. They live together, but as friends, in different rooms. They're in a relationship - but then again they're not. They seem to want the same things, but it seems that they have very little in common. Between all this chaos, they find out that Ambar is pregnant. Nick doesn't want the baby. How the two handle this dilemma is what will decide the direction this relationship will take and be the real test of their love. So are they really made for each other? Are they actually compatible? Is this whole thing worth it? After all, if a relationship is what happens when you're busy not thinking about it - then what does it mean when everything has to be such a \"decision\"? SALAAM NAMASTE gives us a quirky take on life, love and relationship as it looks at a fairy tale with a bit of a squint. Full of colour, humour and zest it is an endearing look at what being in love really means!!.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"PG-13"},"episode_id":11364,"content_control":"NORMAL"}}