,"section_type":"normalPoster"},{"data":[{"items":[],"id":17988,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy","Friendship","Youth"],"id":17988,"type":"SERIES","title":"Ugly Duckling","logo":"","image":"https://cdn6.albox.co/storage/disk58/seasons/d26d8a9d-dbb7-461d-a19e-6f8655070dd1.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/53e13d7e-02cc-4d14-8661-72bf5a82fbdf.jpg","likes":22,"dislikes":2,"views":3941,"release_date":"1431820800000","season_number":1,"description":"Junita, nicknamed Junior, did plastic surgery because people said her face was fat. Without knowing that she was allergic to chemicals, it ruined her face by causing acne everywhere. It would take a year to fully recover. After the incident, nobody wanted to get close to her and whoever saw her would call her a ghost-face. She couldn't stand it so she begged her mom to let her study at a college in the countryside to avoid the social life of Bangkok, and to have face treatment done by a doctor recommended by the Ugly Duckling forum. And that's where she meets Suea, a handsome, flirty, penniless senior, who is the first person to sincerely befriend her despite her looks.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"R"},"current_season_id":6184,"content_control":"NORMAL"}}