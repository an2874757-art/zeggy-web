type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk42/shows/a6b1358b-cd97-40b2-931e-1f446cc78473.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35504,"title":"Sakamoto Days ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/cc00f4e6-b24a-4f01-81ed-133c09faf2d9.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":32570,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Sports"],"id":32570,"type":"SERIES","title":"Boukyaku Battery (TV)","logo":"","image":"https://cloud01.albox.co/seasons/55fa83ad-008e-4510-a7cb-6b34b094dc3d.jpg","background_image":"https://cloud01.albox.co/seasons/4240492d-8270-41ad-a5f3-c205b792e894.jpg","likes":62,"dislikes":3,"views":6160,"release_date":"1712707200000","season_number":1,"description":"Boukyaku Battery هي قصة عن بطارية بيسبول شهيرة تتألف من الرامي العبقري Haruka Kiyomine والصياد الماهر Kei Kaname الذي كان يُعرف أيضًا باسم \"الجنرال\". خلال أيام الدوري الأول، كانوا موهوبين بما يكفي ليس فقط للفوز، ولكن أيضًا لسحق آمال وأحلام العديد من لاعبي المدرسة الثانوية الذين لعبوا ضدهم. ومع ذلك، فقد كانام ذاكرته ودخل الاثنان مدرسة كوتيساشي الثانوية، وهي مدرسة ثانوية عامة بلا اسم. في نفس المدرسة، يلتقون بالعديد من اللاعبين الموهوبين الذين تركوا لعبة البيسبول بعد اللعب ضدهم في المرحلة الإعدادية. هذه قصة اجتماعهم معًا في نادي بيسبول تم إنشاؤه حديثًا للعب البيسبول مرة أخرى.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-13"},"background_color":"","current_season_id":18374,"content_control":"NORMAL"}}