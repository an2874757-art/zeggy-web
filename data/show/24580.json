ms":[],"id":24580,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["School"," Supernatural"," Comedy"],"id":24580,"type":"SERIES","title":"Samurai High School","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/67a49457-be83-4fe4-a7bf-27328ec5ee05.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/14103f57-8d4c-4e6e-b8f6-28611bd638e4.jpg","likes":21,"dislikes":0,"views":2791,"release_date":"1255737600000","season_number":1,"description":"موتشيزوكي كوتارو طالب ثانوي معتدل وأقل رجلاً. في أحد الأيام ، قام بزيارة مكتبة والتقى بأمين المكتبة الغامض هيميكو ، الذي أوصاه بكتاب قديم عن جنرال بطولي من فترة سينجوكو قبل 400 عام. يلاحظ Kotaro أنه يحمل نفس الاسم والعمر اللذين وصفهما الجنرال في الكتاب ، ويختبر الفلاش باك ... يذكر Kotaro لاحقًا الكتاب لأبيه ، الذي يخبره أنه قد يكون من نسل الساموراي القوي. في تلك اللحظة ، تلقى كوتارو رسالة من صديق طفولته آي يخبره أن زميله في الفصل ناكامورا تسويوشي في مشكلة. يندفع إلى مكان الحادث ولكن ليس لديه الشجاعة للمساعدة حتى يحوله الفلاش باك مرة أخرى إلى ساموراي!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"background_color":"","current_season_id":12877,"content_control":"NORMAL"}}