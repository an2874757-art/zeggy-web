d":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":23827,"title":"","description":"163","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Psychological"," Romance"," Drama"," Comedy"],"id":23827,"type":"SERIES","title":"Yumi's Cells","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/e6e9f466-b5a4-41cf-9f65-3f1d28a6b68d.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/85a82e9b-603a-45db-bd3b-8b6d6a0af373.jpg","likes":417,"dislikes":12,"views":61247,"release_date":"1631836800000","season_number":1,"description":"يتم التحكم في كل إنسان على هذا الكوكب من خلال شبكة معقدة من الخلايا ، ويتم تشغيله من خلال نظام تشغيل غير مرئي يتم تجاهله تمامًا في الغالب. على الرغم من أن البشر لا يفكرون أبدًا في كيفية إدارتهم لوظائفهم يومًا بعد يوم ، فإن الخلايا داخل جسم الإنسان تعمل باستمرار ، وتؤدي دورها للحفاظ على حياة الإنسان وبصحة جيدة. ولهذا السبب من الخارج ، قد تبدو Kim Yoo Mi تمامًا مثل أي امرأة عاملة أخرى في العالم ، ولكن تحت هذا المظهر الخارجي العادي يكمن شيء غير عادي حقًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"PG-13"},"background_color":"","current_season_id":12314,"content_control":"NORMAL"}}