g_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9437,"title":"","description":"71","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":9437,"type":"MOVIE","title":"Room","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/d4f42876-e53f-4b4a-878d-f13735d0464d.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/36ae0d0c-1d8e-433a-8a1e-da85492d265c.jpg","likes":424,"dislikes":11,"views":56689,"release_date":"1453420800000","length":7058,"description":"ROOM tells the extraordinary story of Jack, a spirited 5-year-old who is looked after by his loving and devoted mother. Like any good mother, Ma dedicates herself to keeping Jack happy and safe, nurturing him with warmth and love and doing typical things like playing games and telling stories. Their life, however, is anything but typical--they are trapped--confined to a 10-by-10-foot space that Ma has euphemistically named Room. Ma has created a whole universe for Jack within Room, and she will stop at nothing to ensure that, even in this treacherous environment, Jack is able to live a complete and fulfilling life. But as Jack's curiosity about their situation grows, and Ma's resilience reaches its breaking point, they enact a risky plan to escape, ultimately bringing them face-to-face with what may turn out to be the scariest thing yet: the real world.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"R"},"episode_id":9437,"content_control":"FAMILY"}}