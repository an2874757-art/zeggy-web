":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":34853,"type":"SERIES","title":"الزهرة البيضاء‎","logo":"","image":"https://cloud02.albox.co/seasons/ffc94cce-39cc-457a-ad30-0a7bfd2e46b3.jpg","background_image":"https://cloud02.albox.co/seasons/d996ef82-8400-40a8-9898-882a66ad45a7.jpg","likes":23,"dislikes":0,"views":5034,"release_date":"1127088000000","season_number":1,"description":"تدور أحداث المسلسل حول نفوذ عائلة (أصلان) التي تعد من أقوى وأغنى العائلات في مدينة (أضنة) التركية ، حيث تمتلك الأسرة أراضي زراعية شاسعة ، يتوفى والد العائلة ويترك 4 ذكور يديرون الأعمال التجارية ، تتوالى الأحداث حيث يقع (عمر) في حب مهندسة الزراعة (جران) التي عادت مؤخرا من (أمريكا) ، والتي يطلق عليها (الزهرة البيضاء) لرقة ملامحها ، تتطور الأحداث بين النفوذ ، والسلطة ، والحب . فهل سينجح (عمر) ، و(جران) في الوصول بحبها إلى بـر\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"background_color":"","current_season_id":19737,"content_control":"NORMAL"}}