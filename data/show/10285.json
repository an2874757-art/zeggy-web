:0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10285,"title":"","description":"195","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Family"],"id":10285,"type":"MOVIE","title":"Harry Potter and the Prisoner of Azkaban","logo":"","image":"https://cdn6.albox.co/storage/disk41/shows/46d2849d-a49d-4c04-ad4a-bd94608f67b6.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/0589831c-2fd4-434a-ab99-03bcf026d914.jpg","likes":3190,"dislikes":54,"views":421655,"release_date":"1086307200000","length":8502,"description":"Harry Potter is having a tough time with his relatives (yet again). He runs away after using magic to inflate Uncle Vernon's sister Marge who was being offensive towards Harry's parents. Initially scared for using magic outside the school, he is pleasantly surprised that he won't be penalized after all. However, he soon learns that a dangerous criminal and Voldemort's trusted aide Sirius Black has escaped from the Azkaban prison and wants to kill Harry to avenge the Dark Lord. To worsen the conditions for Harry, vile creatures called Dementors are appointed to guard the school gates and inexplicably happen to have the most horrible effect on him. Little does Harry know that by the end of this year, many holes in his past (whatever he knows of it) will be filled up and he will have a clearer vision of what the future has in store...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"episode_id":10285,"background_color":"","content_control":"FAMILY"}}