نغ زي ولي يان شو للاقتراب من بعضهما البعض.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"background_color":"","current_season_id":20147,"content_control":"FAMILY"}}