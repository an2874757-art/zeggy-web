omments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Animation"],"id":1529,"type":"MOVIE","title":"Batman Unlimited: Mechs vs. Mutants","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/afcfa3a4-db61-4166-87fe-9018957ddab3.jpg","background_image":"","likes":28,"dislikes":0,"views":3001,"release_date":"1472515200000","length":4512,"description":"The Dark Knight is back doing what he does best - protecting the citizens of Gotham City - in the third installment of the Batman Unlimited series, Batman Unlimited: Mechs vs. Mutants. When evil scientist Mr. Freeze activates his latest invention on two of Gotham City's most formidable criminals - Killer Croc and Bane - things go from bad to worse. Turning them into super-sized mutant monsters, the Super-Villains start bashing through the streets of Gotham City with no end in sight. It's up to the Caped Crusader and his Super Hero team to save the day by putting the giant robot mechs in their place - but it will be an uphill battle as they face off against enormous foes.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG"},"episode_id":1529,"content_control":"NORMAL"}}