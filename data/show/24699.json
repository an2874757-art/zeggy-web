tle":"Live Your Life","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/9818776c-5bb2-4ab5-83de-3891ccf0965c.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/7338c8a3-a562-41b5-95f1-bedbf39f3abf.jpg","likes":68,"dislikes":2,"views":8287,"release_date":"1633392000000","season_number":1,"description":"لقد دأب Wu You و He Xiya على تأليب ذكائهما وإرادتهما ضد بعضهما البعض لفترة طويلة فقط لإدراك أنهما أصبحا زوجين في المشاحنات. تكتشف Wu You أن He Xiya كان الرجل الذي أنقذ حياتها عندما تعرضت لحادث سيارة. الغرامية Su Fei هي مدوّنة جمعت تقنياتها المجربة والمختبرة في التعامل مع الشؤون العاطفية لها عددًا كبيرًا من المتابعين. في الواقع ، ليس لديها خبرة عندما يتعلق الأمر بالحب. محظوظ بالنسبة لها ، هناك دائمًا هذا الرجل الدافئ والموثوق به حتى عندما يتم التشكيك في مصداقيتها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"background_color":"","current_season_id":12943,"content_control":"NORMAL"}}