pe":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Animation"],"id":19421,"type":"SERIES","title":"A Town Where You Live","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/05258a3f-8716-4cec-bf55-bec5b15b1632.jpg","background_image":"https://cdn6.albox.co/storage/disk60/seasons/54340831-4489-4f1d-95b3-ba330f75aa5d.jpg","likes":35,"dislikes":5,"views":4546,"release_date":"1331856000000","season_number":1,"description":"Haruto Kirishima lived a calm life out in the countryside, away from the fast-paced life of the city. Then Yuzuki Eba appeared in his life out of nowhere, having come from Tokyo to briefly live with his family. Their time together left him enamored with the memories of that short period before she just as abruptly disappeared from his life, and left him full of questions. Beginning some time later, Haruto moves to Tokyo to live with his sister, in order to pursue a career as a cook. In reality though he wishes to be with Yuzuki. Things don't start good though. When he arrives he is mistaken for a burglar and attacked by his sister's neighbor Mishima Asuka. After the misunderstand is cleared his feelings begin to waver though. Is Eba, who keeps avoiding him for seemingly no reason, the one for him or is it Asuka?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"N/A"},"current_season_id":7998,"content_control":"NORMAL"}}