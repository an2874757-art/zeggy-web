ype":"normalPoster"},{"data":[{"items":[],"id":35654,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Thriller"," Mystery"," Crime"],"id":35654,"type":"SERIES","title":"Kujaku no Dance, Dare ga Mita? ","logo":"https://cloud02.albox.co/shows/45e87e6c-197b-4fe1-8af6-9faf7b494f71.png","image":"https://cloud02.albox.co/seasons/dd027b05-262f-4fcd-a7b4-2a6e72e8701f.jpg","background_image":"https://cloud02.albox.co/seasons/96abfad1-4699-429b-81c1-76c3e8209e44.jpg","likes":67,"dislikes":0,"views":10524,"release_date":"1737676800000","season_number":1,"description":"ياماشيتا كوموجي طالبة جامعية تعيش مع والدها، ضابط الشرطة السابق، منذ وفاة والدتها. في عشية عيد الميلاد، قُتل والد كوموجي، وتركت رسالة تحتوي على كلمة \"اتهام كاذب\". باستخدام الدليل، تم القبض على رجل. ومع ذلك، اكتشفت كوموجي لاحقًا أن الرجل الذي تم القبض عليه بتهمة قتل والدها هو الابن الوحيد للرجل الذي اعتقله والدها قبل 22 عامًا بتهمة قتل عائلة. بالتعاون مع المحامي ماتسوكازي يوشيتيرو، تحقق كوموجي في حادثتين من الحاضر والماضي يبدو أنهما مرتبطتان.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"R"},"background_color":"#000000","current_season_id":20299,"content_control":"FAMILY"}}