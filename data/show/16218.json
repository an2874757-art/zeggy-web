gth":0,"continue_watching_progress":0},{"items":[],"id":13602,"title":"Jurassic World: Camp Cretaceous","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/a5a02d75-4520-486f-b9d6-2b18d2dc0737.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16921,"title":"غرافيتي فولز","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk54/shows/70e54780-5ee1-4351-be40-646916547764.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":17934,"title":"تنانين سباق الى الحافة","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk50/shows/9d5027b1-e143-4324-bbe5-0b3fb667d8cc.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16218,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy","Sci-Fi","Comedy","Animation"],"id":16218,"type":"SERIES","title":"Yu-Gi-Oh! Zexal (مدبلج)","logo":"","image":"https://cdn6.albox.co/storage/disk47/seasons/5014579a-3f5f-4897-a2f3-8eb01c30b1f2.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/a4d08179-9a39-4ff4-b564-f1ca5067fd2d.jpg","likes":60,"dislikes":2,"views":11020,"release_date":"1318636800000","season_number":1,"description":"The story takes place in the near future in a city called Heartland. The story focuses on Yuma Tsukumo, a young duelist who strives to become the Duel Monsters champion, despite being an amateur. One day, during a duel with a school bully, a mysterious spirit called Astral appears before him, and helps him to win. Astral explains to Yuma he is searching for his lost memories, which have been transformed into 99 Xyz Monsters cards called Numbers and have been scattered across the globe. The Numbers have the ability to possess the duelists who own them and bring out their darkest desires. In order to recover his memories, Astral teams up with Yuma in order to recover the Numbers cards. Using the powers of Zexal, the two must compete with Numbers Hunters, who seek to claim the Numbers cards for themselves in order to destroy Astral's homeworld.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.9}],"value":4.9,"age":"TV-Y7"},"current_season_id":3807,"content_control":"NORMAL"}}