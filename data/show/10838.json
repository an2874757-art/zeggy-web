"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller"],"id":10838,"type":"MOVIE","title":"The Expendables","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/ab023661-d577-4035-a732-916d0399fb04.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/35912b62-1f45-4083-a158-ea97b5f543d5.jpg","likes":811,"dislikes":11,"views":87394,"release_date":"1281657600000","length":6208,"description":"Barney Ross leads the \"Expendables\", a band of highly skilled mercenaries including knife enthusiast Lee Christmas, martial arts expert Yin Yang, heavy weapons specialist Hale Caesar, demolitionist Toll Road and loose-cannon sniper Gunner Jensen. When the group is commissioned by the mysterious Mr. Church to assassinate the merciless dictator of a small South American island, Barney and Lee head to the remote locale to scout out their opposition. Once there, they meet with local rebel Sandra and discover the true nature of the conflict engulfing the city. When they escape the island and Sandra stays behind, Ross must choose to either walk away and save his own life - or attempt a suicidal rescue mission that might just save his soul.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"episode_id":10838,"content_control":"NORMAL"}}