e":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Crime"],"id":9845,"type":"MOVIE","title":"From Paris with Love","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/c617aef3-0d1f-438b-b7af-80ad574eed31.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/ca6cc0e3-3c2c-44ce-bbdb-462cc1c0e424.jpg","likes":212,"dislikes":9,"views":16477,"release_date":"1265328000000","length":5559,"description":"James Reece is an ambitious aide to the U.S. Ambassador in Paris, doing little jobs for the CIA and hoping to get into black ops. On the night he and his girlfriend, Caroline, become engaged, he's told to pick up Charlie Wax at Orly. Charlie is an unorthodox government employee - large, bald and bearded, foul-mouthed and eccentric. Charlie immediately takes James on a wild ride of murder and mayhem, through ethnic enclaves. As bodies pile up, the purpose remains opaque to James. Caroline, unhappy that James has been out of touch for a day, tells him to bring Charlie for dinner. Charlie can be charming - where will it lead? Does the chess-playing James have what it takes?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"episode_id":9845,"content_control":"FAMILY"}}