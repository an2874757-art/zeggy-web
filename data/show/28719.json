hing_progress":0},{"items":[],"id":19407,"title":"العهد","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/9a732ead-146b-4404-ad6c-1e2f4a0e17e7.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":28719,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":28719,"type":"SERIES","title":"سامحني مدبلج","logo":"","image":"https://cloud01.albox.co/seasons/206d90ff-afed-4454-a9a8-a2d23c55f837.jpg","background_image":"","likes":49,"dislikes":7,"views":10925,"release_date":"1304899200000","season_number":1,"description":"\r\nبطل القصة يشعر بالندم نتيجة أحداثٍ عاشها خلال مرحلة من حياته. فهو يريد أن يبحث و يواجه  كل قلب حطمه و كل شخص أثرّ على حياته في السابق حتى اليوم الحاضر .  وحتى مجرد اعتذار سيريح ضميره . لكنه من الصعب أن يسامحه الناس بعد كل هذه السرقات والخداع .فهناك من سرق نقودهم وآخرون  سرق أحلامهم .\r\nفي كل حلقة يواجه البطل شخصاً مختلفاً، ليواجه ما قام به في الماضي وفي كل مرة يعيش أحاسيس الندم...  وبالرغم من أنه يعيش هذه الأحاسيس بعمق إلا أنه يستمر بالعمل لإصلاح نفسه. فهو يريد أن يبني حياة جديدة ويؤسس أسرة. ويعيش حلم الزواج من ابنة ضابط الشرطة ، آمر المخفر . لذا فهو يواجه ماضيه وبكل عزم يعمل على تجاوز الصعوبات والامتحانات الكبيرة.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"","current_season_id":16055,"content_control":"NORMAL"}}