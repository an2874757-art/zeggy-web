g_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7362,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Animation"],"id":7362,"type":"MOVIE","title":"Puss in Boots","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/2039f95a-7205-4895-8fab-2f11a7f413fd.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/d17bedbd-6cc0-4d6f-b0e0-1c75a39412ee.jpg","likes":286,"dislikes":5,"views":25164,"release_date":"1319760000000","length":5414,"description":"Years before meeting Shrek and Donkey, the adorable but tricky Puss in Boots must clear his name from all charges making him a wanted fugitive. While trying to steal magic beans from the infamous criminals Jack and Jill, the hero crosses paths with his female match, Kitty Softpaws, who leads Puss to his old friend, but now enemy, Humpty Dumpty. Memories of friendship and betrayal enlarges Puss' doubt, but he eventually agrees to help the egg get the magic beans. Together, the three plan to steal the beans, get to the Giant's castle, nab the golden goose, and clear Puss' name.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG"},"episode_id":7362,"content_control":"FAMILY"}}