3,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Sport"],"id":6083,"type":"MOVIE","title":"The Wrestler","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/44a163c8-d5d4-48e2-9850-1f319826d8f0.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/4b97dcad-6139-4257-8eb4-9ce90ea26044.jpg","likes":33,"dislikes":0,"views":4194,"release_date":"1233273600000","length":6554,"description":"This is a drama about an aging professional wrestler, decades past his prime, who now barely gets by working small wrestling shows in VFW halls and as a part-time grocery store employee. As he faces health problems that may end his wrestling career for good he attempts to come to terms with his life outside the ring: by working full time at the grocery store, trying to reconcile with the daughter he abandoned in childhood and forming a closer bond with a stripper he has romantic feelings for. He struggles with his new life and an offer of a high-profile rematch with his 1980s arch-nemesis, The Ayatollah, which may be his ticket back to stardom.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"episode_id":6083,"content_control":"FAMILY"}}