tion":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Romance","Music","War"],"id":1509,"type":"MOVIE","title":"The Story of Vernon and Irene Castle","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk43/shows/e53475d1-33b2-48b6-bc79-b1725980ce6a.jpg","likes":4,"dislikes":0,"views":3042,"release_date":"-970790400000","length":5607,"description":"In 1911, Vernon Castle, minor comic in a stage revue, pursues the leading lady to a New Jersey beach...where, instead, he meets stage-struck Irene Foote. A few misadventures later, they're married; at Irene's insistence, they abandon comedy to attempt a dancing career, which attempt only lands them in Paris without a sou. Fortunately, agent Maggie Sutton hears them rehearse and starts them on their brilliant career as the world's foremost ballroom dancers. But at the height of their fame, World War I begins...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"episode_id":1509,"content_control":"NORMAL"}}