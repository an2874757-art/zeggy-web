escription":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Comedy","Documentary"],"id":16113,"type":"SERIES","title":"Hawking","logo":"","image":"https://cdn6.albox.co/storage/disk51/seasons/58de0777-0e79-4173-8aec-a90bd3f072c2.jpg","background_image":"https://cdn6.albox.co/storage/disk60/seasons/9c32baa2-a2d9-407f-86f7-562f2153b6d0.jpg","likes":6,"dislikes":0,"views":1762,"release_date":"1379635200000","season_number":1,"description":"Hawking is the extraordinary story of the planet's most famous living scientist, told for the first time in his own words and by those closest to him. Made with unique access to Hawking's private life, this is an intimate and moving journey into Stephen's world, both past and present. An inspirational portrait of an iconic figure, Hawking relates his incredible personal journey from boyhood under-achiever, to PhD genius, to being diagnosed with Motor Neuron Disease and given just two years to live. Despite the constant threat of death, Hawking manages to make many remarkable scientific discoveries and rises to fame and super-stardom. Hawking - a remarkable man, and a remarkable movie.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG-13"},"background_color":"","current_season_id":3658,"content_control":"NORMAL"}}