ws/908b0fe8-4fbc-41d4-b6ee-d914a6099e10.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36202,"title":"آسر","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/23a2a128-eb5a-4f7a-97f4-8b7817ce982e.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":32157,"title":"أشغال شقة","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/4a24687c-7b5f-479d-8b61-0676f7621815.png"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19059,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":19059,"type":"SERIES","title":"ابو جعفر المنصور","logo":"","image":"https://cdn6.albox.co/storage/disk56/seasons/d1435e77-b63c-4673-a7c7-fab5698358fe.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/57cdedd7-9869-4344-a4ad-04da48c2fedb.jpg","likes":14,"dislikes":2,"views":3386,"release_date":"1199145600000","season_number":1,"description":"تدور أحداث المسلسل في الحقبة التاريخية التي عاصرت النصف الثاني من عصر الأمويين وبداية الخلافة العباسية حتى عهد مؤسسها الفعلي أبو جعفر المنصور - بطل القصة-، القصة تعايش حياة الناس في تلك الحقبة، كما تسرد تطورات الأحداث في بيت الخلافة الأموي من عهد الخليفة عمر بن عبد العزيز وحتى عهد آخر خلفائهم مروان بن محمد بن مروان، ويعايش حياة العباسيين في الحميمة مسقط رأس أبي جعفر منذ عهد إمامهم وجده علي بن عبد الله بن عباس، الذي بدأ الدعوة للعباسيين سرًا، وانتقلت الإمامة بينهم حتى حان الوقت المناسب ليعلن فيه إبراهيم بن محمد بن علي بن عبد الله بن عباس - أخوه- إمام العباسيين بداية الجهر بالدعوة وأمر مولاه أبو مسلم الخراساني بقيادة جيش العباسين.. وتدور الحداث حتى يصل أبو جعفر المنصور إلى سدة الحكم والخلافة وحكمه لبلاد المسلمين مدة 20 سنة من 137 هـ إلى 157 هـ.","rating":{"sources":[],"value":0,"age":"PG-13"},"current_season_id":7527,"content_control":"NORMAL"}}