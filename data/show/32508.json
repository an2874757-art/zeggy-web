لكومينتانغ، فإن طريقه يختلف عن طريق شين تو نان. لقاء صدفة مع Shen Jin Zhen يقوده إلى اتخاذ خيارات مختلفة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":9}],"value":9,"age":"PG-14"},"background_color":"","current_season_id":18334,"content_control":"NORMAL"}}