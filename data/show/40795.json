"genres":["Drama"],"id":40795,"type":"SERIES","title":"Mom, I'm Sorry","logo":"","image":"https://cloud02.albox.co/shows/55f4eba9-8fda-4e84-a595-ef688b4589f3.jpg","background_image":"https://cloud02.albox.co/shows/44d8ab56-3926-460e-ab80-49ae5bcd02f6.jpg","likes":22,"dislikes":1,"views":1844,"release_date":"1716422400000","season_number":1,"description":"\"Mom, I'm sorry. Please don't die.\" When Henry realizes death is at his mother's doorstep, he strikes a deal with a lifespan dealer to give years of his own life to his ailing mother. Now, his mother is a 20-year-old college student with a full life ahead of her, and Henry devotes his remaining days to helping her live life to the fullest. But things turn complicated when his friend falls in love with her!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"NC-17"},"background_color":"","current_season_id":23803,"content_control":"NORMAL"}}