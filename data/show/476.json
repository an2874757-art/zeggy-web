cdn6.albox.co/storage/disk58/shows/04810ea5-af10-46f6-96c8-bc01cc39e09e.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/71cf40a6-6ed3-4c22-babf-e7fd6008a1ec.png","likes":18,"dislikes":0,"views":7167,"release_date":"524448000000","length":6054,"description":"تتزوج هناء (شمس البارودي) من كمال (يوسف شعبان) الذي تكتشف أنه شاب وصولي، فهو يدفعها إلى ممارسة الرذيلة حتى يحقق طموحاته، يقدمها لمديره سعفان (عماد حمدي) الذي يكافئ كمال بتعيينه مديرًا للمبيعات في الشركة. وسرعان ما تصبح هي أيضا عاهرة تبيع جسدها في سبيل تسلقها السلم الوظيفي. تلتقي هناء بأحمد (محمود ياسين) حبها القديم، وتخفى عنه سلوكها مع سعفان الذي تضيق به، وتتفق معه على أن تطلب الطلاق من كمال ليتزوجه. فماذا سيفعل عندما يعرف حقيقة ماضيها سيء السمعة؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"PG-13"},"episode_id":476,"content_control":"NORMAL"}}