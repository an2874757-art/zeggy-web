normalPoster"},{"data":[{"items":[],"id":24735,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Historical"," Romance"," Wuxia"],"id":24735,"type":"SERIES","title":"One and Only","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/168c514d-6ee2-430f-93da-0fa0d096be08.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/ca3f854b-ab3d-4f63-8988-5cab71b7ed21.jpg","likes":71,"dislikes":0,"views":5071,"release_date":"1629244800000","season_number":1,"description":"نشأ Zhou Sheng Chen على يد شقيقه ، الإمبراطور ، حتى سن الثالثة عشرة ، عندما انطلق للدفاع عن الحدود وإثبات نفسه كقائد مخلص وبارع. تسوي شي يي ، الابنة المطلعة لعائلة محترمة ، كانت مخطوبة لولي العهد منذ ولادتها. ومع ذلك ، أدت المؤامرات السياسية والأحداث المأساوية إلى سقوط تسوي شي يي ، وصار خطيبها السابق إمبراطورًا صغيرًا ، وعودة تشو شنغ تشين إلى العاصمة وسط سحابة من الاضطرابات السياسية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"PG-13"},"background_color":"","current_season_id":12978,"content_control":"NORMAL"}}