omments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Comedy"],"id":23668,"type":"SERIES","title":"Stop! Miss Hua","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/63dc33aa-233b-49ad-848e-c70051b7b0a4.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/b76716b4-cc7a-4670-9567-d911183e8427.jpg","likes":33,"dislikes":0,"views":3484,"release_date":"1627430400000","season_number":1,"description":"تلتقي شخصية اجتماعية وقحة بفارسها في درع لامع في رجل إطفاء سابق يكون مظهره الخارجي القوي هو النقيض تمامًا لشخصيته الرائعة. ولدت Hua Ming Yue بملعقة فضية. مع انحناء كل من حولها لإرادتها ، فهي لا تعرف مفهوم الاضطرار إلى العمل من أجل أي شيء وتعرف فقط كيف تلعب بقوة. كان تشين دونغ هاي في يوم من الأيام قائد سرب فريق من رجال الإطفاء. بعد تقاعده ، درس في المملكة المتحدة وعاد إلى وطنه بألوان متطايرة حيث تقدم بطلب للحصول على وظيفة في Hua Group. على الرغم من أنه طويل وداكن ووسيم ، إلا أنه في الواقع لطيف في القلب.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG-13"},"background_color":"","current_season_id":12197,"content_control":"NORMAL"}}