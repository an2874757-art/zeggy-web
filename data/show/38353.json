ching_progress":0},{"items":[],"id":17197,"title":"Ace of Diamond Act II","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":""},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":38353,"title":"","description":"35","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sport"],"id":38353,"type":"SERIES","title":"Wandance","logo":"https://cloud02.albox.co/shows/e9925068-0be6-4358-bb9f-45f28f0e46d4.jpg","image":"https://cloud02.albox.co/seasons/4100ce51-ff95-4297-b06b-d357c421cca7.jpg","background_image":"https://cloud02.albox.co/seasons/2abf74b4-b23b-4dea-9fe3-29de326a8a0b.jpg","likes":201,"dislikes":15,"views":32936,"release_date":"1759881600000","season_number":0,"description":"كابوكو كوتاني يبدأ دراسته الثانوية، ويخطط لفعل ما اعتاد فعله: مرافقة أصدقائه، والصمت، وتجنب لفت الانتباه. فمن الصعب عليه، في النهاية، أن يتعايش مع تلعثم كهذا - فلماذا نزيد الطين بلة بالتميز عن الآخرين؟ لكنه يرى طالبة أخرى في السنة الأولى، هيكاري واندا، ترقص كأن لا أحد يراقبها - أو كأنها لا تهتم بمن يراها. هذا ما جعل كابوكو يتساءل: هل سيتمكن من بلوغ هذه الحرية نفسها؟ ليجد طريقه إلى واندا، يفعل شيئًا لم يخطر بباله قط: ينضم إلى نادي الرقص. فكل رقصة تبدأ بخطوة، أليس كذلك؟ انضموا إلى كابوكو وواندا وهما يرقصان بحرية نحو الحياة والحب!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-14"},"background_color":"#f050b4","current_season_id":22414,"content_control":"NORMAL"}}