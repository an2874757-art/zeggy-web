ss":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4653,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Sport"],"id":4653,"type":"MOVIE","title":"Wimbledon","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/7dc0a450-49f8-499b-a334-82a49d02e24b.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/f4dc8bef-3a3f-4fb5-beed-394a5e7bb99a.jpg","likes":21,"dislikes":0,"views":6210,"release_date":"1095379200000","length":5865,"description":"Peter Colt, an English tennis player in his thirties whose ranking slipped from 11th to 119th in the world, considers he never really had to fight for anything as his wealthy but all but close family easily put him through studies and allowed him to pursue his tennis ambitions, bravely exchanges jokes with his German sparring partner Dieter Prohl, in a similar position, but feels it's about time to admit he's getting too old to compete with fitter coming men (or boys) and intends, after a last Wimbledon, to take a job with the prestigious tennis club instead. Just then, by accident, he bumps into Lizzie Bradbury, the American rising star of female tennis, falls in love with her and finds her interest in him changes his entire perception, even gives him the strength to win again. But where will it lead them, especially when her overprotective father-manager Dennis Bradbury proves determined to nip their relationship in the bud, believing it detrimental to her career?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":4653,"content_control":"FAMILY"}}