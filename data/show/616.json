ems":[],"id":616,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime","Mystery"],"id":616,"type":"MOVIE","title":"The Pledge","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/c03e7735-009b-45a6-91c6-f8dadc11c8d6.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/33c919ca-b8fc-48c2-a1f6-ad1dcf4c2932.jpg","likes":29,"dislikes":1,"views":5569,"release_date":"979862400000","length":7404,"description":"The night he retires as a Nevada sheriff, Jerry Black pledges to the mother of a murdered girl that he will find the killer. Jerry doesn't believe the police arrested the right man; he discovers this is the third incident in the area in the recent past with victims young, blond, pretty, and small for their age. So he buys an old gas station in the mountains near the crimes in order to search for a tall man who drives a black station wagon, gives toy porcupines as gifts, and calls himself the wizard: clues from a drawing by the dead girl. Jerry's solitary life gives way to friendship with a woman and her small, blond daughter. Has Jerry neglected something that may prove fatal?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"R"},"episode_id":616,"content_control":"NORMAL"}}