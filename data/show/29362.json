://cloud01.albox.co/seasons/224f3a39-4f5c-4bd8-a46c-b9b779965a2f.jpg","background_image":"https://cloud01.albox.co/seasons/483cfe6b-8770-4d39-a28d-938048bf7a08.jpg","likes":69,"dislikes":3,"views":7375,"release_date":"1681257600000","season_number":1,"description":"عاد يان يو تشو إلى مسقط رأسه للعمل وتكوين صداقات جديدة في مكان عمله. في أحد الأيام ، ذهب إلى غرفة الهروب ووجد نفسه منجذبا بشدة إلى المالك ، شو آي أنت. ومع ذلك ، كان ذلك عندما بدأ في تجربة أوهام غريبة في غرفة الهروب. كما تعرف يان يو تشو على زوال لك ، بدأت المزيد والمزيد من الحوادث تحدث من حوله وحتى أصدقائه. في عملية حل غرف الهروب وإيجاد العقل المدبر وراء كل هذه الأحداث ، وجد نفسه تدريجيا يكشف الحقيقة وراء ذكرياته المفقودة...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG-13"},"background_color":"","current_season_id":16604,"content_control":"NORMAL"}}