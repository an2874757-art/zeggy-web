 من قيام الجنية الخالدة جين لي بختم سيد الشياطين جي تشوان، تقوم وحش سماوي يُدعى جين لي بتحريره عن طريق الخطأ، ويتم نقله إلى عالم الشياطين لقوته النادرة. وبصفتهما عدوين جمعهما القدر، تتحول عداوتهما ببطء إلى حب، إلى أن تهدد حقيقة صادمة عن أصل جين لي بتفريقهما وتغيير مصيرهما.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"NC-17"},"background_color":"","current_season_id":22795,"content_control":"NORMAL"}}