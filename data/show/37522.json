n":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/40699191-b63d-4f98-b3dc-91c1bd2841e3.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":37522,"title":"","description":"57","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"," Romance"," Family"],"id":37522,"type":"SERIES","title":"Our Golden Days ","logo":"","image":"https://cloud02.albox.co/seasons/6fae6662-cdb7-44d4-9080-d057222855d6.jpg","background_image":"https://cloud02.albox.co/seasons/150c9788-030c-497e-b243-868f50a42faa.jpg","likes":227,"dislikes":3,"views":50426,"release_date":"1754697600000","season_number":1,"description":"لي جي هيوك شخص كفؤ، معروف في عمله وحبه. يتميز بالمبادرة وطيب القلب، لكنه يتمتع أيضًا بروح دعابة. يبدو لي جي هيوك جذابًا، لكن بعد أن مرّ بأصعب لحظات حياته، يجد معنى الحياة الحقيقي. يحيط به أناسٌ مثل جي أون أو وبارك سونغ جاي. تتمتع جي أون أو بشخصية مشرقة ومرحة. تعمل كمديرة مقهى ومصممة ديكور داخلي. لا تفقد شغفها أبدًا حتى في الأوقات الصعبة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"background_color":"","current_season_id":21746,"content_control":"NORMAL"}}