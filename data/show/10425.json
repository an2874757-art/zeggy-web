e":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":10425,"type":"MOVIE","title":"Chihayafuru Part I","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/561b1651-e67e-4b56-b17e-dbf39bcbf2ac.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/6829d7d0-df1d-462f-8cb8-2386fd027bcd.png","likes":40,"dislikes":0,"views":3101,"release_date":"1458345600000","length":6675,"description":"When Chihaya Ayase was in the 6th grade of elementary school, she met Arata Wataya. Arata Wataya transferred from Fukui Prefecture. Taichi Mashima was Chihaya Ayase's friend since they were little. Arata got close to Chihaya and Taichi from the card game 'karuta'. Four years later, Chihaya is a high school student. Chihaya learns that Arata, who went back to Fukui Prefecture, doesn't play karuta anymore. Believing they will meet Arata again, Chihaya and Taichi start a karuta club at their high school.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"PG-13"},"episode_id":10425,"content_control":"NORMAL"}}