:7239,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime"],"id":7239,"type":"MOVIE","title":"Young Adam","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/a1aabe43-ec47-435b-83b9-3cca21a77a8c.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/ba1ee986-115b-4d2c-80a1-b6dd1c3e1988.png","likes":17,"dislikes":1,"views":3313,"release_date":"1064534400000","length":5864,"description":"Joe, a rootless young drifter, finds work on a barge travelling between Glasgow and Edinburgh, owned by Les and his wife Ella. One afternoon they discover the corpse of a young woman floating in the water. Accident? Suicide? Murder? As the police investigate and suspect is arrested, we discover that Joe knows more than he is letting on. Gradually we learn of Joe's past relationship with the dead woman. Meanwhile an unspoken attraction develops between Joe and Ella, heightening the claustrophobic tensions in the confined space of the barge.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"r"},"episode_id":7239,"content_control":"NORMAL"}}