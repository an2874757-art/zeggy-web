:{"image":"https://cloud02.albox.co/shows/9295f787-0b1a-4609-8d31-a44393f8b140.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15167,"title":"Its Okay to Not Be Okay","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/ff27a8c2-7fd7-48a9-877f-d910f9ae40c9.jpeg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":25163,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Youth"," Sports"],"id":25163,"type":"SERIES","title":"Hello The Sharpshooter","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/1dad6f9d-8fb2-4ccb-a549-956c3eadf1ec.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/ac4a7263-541b-4ce6-b013-c03a78bee7b2.jpg","likes":40,"dislikes":1,"views":3698,"release_date":"1643760000000","season_number":1,"description":"قبل عدة سنوات ، عندما كانوا في المدرسة الثانوية ، التقى تانغ شين مع شين تشينغ يوان طويل القامة. وقعت في حبه على الفور ، رغم أنها لم تخبره في ذلك الوقت. أخبرها أنه لن ينسىها ، ولكن منذ ذلك الحين ، سارت مساراتهم في اتجاهات مختلفة: لقد أصبحت مراسلة متدربة ، بينما أصبح رائد إطلاق النار بالمسدس بطول 50 مترًا في البلاد ، يترأس عرض الصين لتحقيق المجد الأولمبي. بينما يستعد فريق الرماية بالمسدس للأولمبياد ، تم تكليف تانغ شين بمقابلته. ولكن عندما واجهتها فجأة الرجل الذي حملت شمعة من أجله ، تغلب عليها الأعصاب. في غضون ذلك ، هو رافض وبارد تجاهها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG-13"},"current_season_id":13280,"content_control":"NORMAL"}}