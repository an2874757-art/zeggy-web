erwise often hopeless mortals and moves on to new adventures.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG"},"current_season_id":1794,"content_control":"NORMAL"}}