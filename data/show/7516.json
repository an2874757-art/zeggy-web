ws/eff38218-28c1-45af-a2dd-2df637c8e8c8.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7516,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Crime"],"id":7516,"type":"MOVIE","title":"RocknRolla","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/39e9e6ed-4790-41f8-afb1-80118b7eb554.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/b2a0cc42-d83a-4516-9f09-b0b939bc834c.jpg","likes":63,"dislikes":2,"views":11728,"release_date":"1225411200000","length":6858,"description":"Lenny Cole, a London mob boss, puts the bite on all local real estate transactions. For substantial fees, he's helping Uri Omovich, a Russian developer. As a sign of good faith, Omovich loans Cole a valuable painting, promptly stolen off Cole's wall. While Cole's men, led by the dependable Archie, look for the canvas, three local petty criminals, the Wild Bunch, steal money from the Russian using inside information from his accountant, the lovely Stella. Meanwhile, a local drug-addled rocker, Johnny Quid, is reported drowned, and his connection to Cole is the key to unraveling the deceits and double crosses of life in the underworld.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"episode_id":7516,"content_control":"NORMAL"}}