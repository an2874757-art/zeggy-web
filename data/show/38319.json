e":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Romance"],"id":38319,"type":"SERIES","title":"The Heart of Genius","logo":"https://cloud02.albox.co/shows/824ea009-c85f-460f-bcdc-6d2cf11d0505.jpg","image":"https://cloud02.albox.co/seasons/9429c0fe-1bb2-4326-a615-5d32d9593465.jpg","background_image":"https://cloud02.albox.co/seasons/d3add09a-49b0-45a5-890d-9b82b8a56495.jpg","likes":14,"dislikes":0,"views":1065,"release_date":"1658448000000","season_number":1,"description":"أخذت صيغة رياضية غامضة لين تشاوكي بالصدفة إلى عالم موازٍ عندما كانت في الثالثة عشرة من عمرها. في هذه المغامرة الغريبة، ومع سنوات الخبرة المتراكمة في مسابقة الأولمبياد، اكتشفت لين تشاوكي فجأةً أن كل من ضيع الوقت، وتخلى عن معتقداته، وأحلامه التي لم تكتمل، وفشل في تحقيق أهدافه، وحتى مرض والدها المستعصي، يمكن تعويض كل شيء عند دخولها هذا العالم الموازي. حتى أولئك الذين كانت بداياتهم سيئة للغاية، لا تزال هناك احتمالات لا حصر لها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-14"},"background_color":"#000000","current_season_id":22239,"content_control":"NORMAL"}}