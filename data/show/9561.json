ted","section_type":"normalPoster"},{"data":[{"items":[],"id":9561,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Crime"],"id":9561,"type":"MOVIE","title":"Enter the Dragon","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/fdebbaf2-e71e-4a3c-b0cc-7e8ae20e1d2d.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/f3ab45f9-8c31-4287-b3e9-a1fe547a4c75.jpg","likes":135,"dislikes":2,"views":11270,"release_date":"114566400000","length":6153,"description":"Enter the Dragon revolves around the three main characters. Lee, a man recruited by an agency to investigate a tournament hosted by Han, since they believe he has an Opium trade there. Roper and Williams are former army buddies since Vietnam and they enter the tournament due to different problems that they have. Roper is on the run from the Mafia due to his gambling debts, while Williams is harassed by racist police officers and defends himself from them and uses the car for his getaway. It is a deadly tournament that they will enter on an island. Lee's job is to get the other two out of there alive.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"episode_id":9561,"content_control":"NORMAL"}}