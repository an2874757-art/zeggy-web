torage/disk52/shows/e8e75c46-7f43-4f5a-8798-3c2eaa9eb7c0.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8649,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Animation"],"id":8649,"type":"MOVIE","title":"Wonder Woman","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/00d2dd2e-1ca0-4939-a059-20c6ba9f5d3f.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/9f33e83b-609c-4d2c-a4f2-cdbefc9104ee.jpg","likes":38,"dislikes":0,"views":5806,"release_date":"1236038400000","length":4419,"description":"In antiquity, the Amazons defeat the war god, Ares, and Zeus charges them to hold him prisoner as eternally young warriors on the hidden island of Themyscira. Centuries later, US Air Force pilot Steve Trevor is lured to crash land on the island and the distraction of that trespass allows Ares to escape. In response, Princess Diana wins the responsibility to both take Trevor home and recapture the fugitive god. Steve Trevor offers to help and together this disparate pair must not only overcome Ares' efforts to achieve a bloody revenge, but also reconcile their own conflicting world views in an adventure that would be the first for the greatest of the female superheroes.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":8649,"content_control":"NORMAL"}}