onico the Animation تتبع Sonico وهي تواجه تحديات شاقة في بحثها عن مكانها في العالم ، حتى عندما تكون أيامها مليئة بالحب والسعادة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"background_color":"","current_season_id":12893,"content_control":"NORMAL"}}