cal"],"id":2949,"type":"MOVIE","title":"Haikara-san ga Tooru","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/b56ff9ca-6dc4-4f67-9483-43b7c40b1b7f.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/0e63119a-76fd-4fb4-929a-da0ba54abc9b.jpg","likes":248,"dislikes":5,"views":15122,"release_date":"1510358400000","length":5871,"description":"The story follows Benio \"Haikara-san\" Hanamura, who lost her mother when she was very young and has been raised by her father, a high-ranking official in the Japanese army. As a result, she has grown into a tomboy—contrary to traditional Japanese notions of femininity, she studies kendo, drinks sake, dresses in often outlandish-looking Western fashions instead of the traditional kimono, and is not as interested in housework as she is in literature. She also rejects the idea of arranged marriages and believes in a woman's right to a career and to marry for love.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"PG-13"},"episode_id":2949,"content_control":"NORMAL"}}