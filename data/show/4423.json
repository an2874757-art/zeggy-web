":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4423,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Crime"],"id":4423,"type":"MOVIE","title":"Keeping Mum","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/cbbdc1f0-0618-467e-867c-13ddff8a1a43.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/92cc0f52-6f61-4776-8c70-f18ff4cf6102.jpg","likes":35,"dislikes":2,"views":4739,"release_date":"1160092800000","length":5931,"description":"Walter Goodfellow, the vicar for the small English country parish of Little Wallop, has allowed his marriage to Gloria go stale, and he is so detached from his family that he has not taken notice that his 17-year-old daughter Holly is going through a succession of relationships with unsuitable boyfriends, and his son Petey fears going to school owing to being bullied. Out of desperation for affection, Gloria begins to fall for the advances of Lance, an American golf pro who is giving her \"private\" lessons. The problems upsetting the family start to fade away after Grace Hawkins, the new housekeeper, arrives and starts tending to matters as an older, and rather darkly mysterious version of Mary Poppins.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"R"},"episode_id":4423,"content_control":"NORMAL"}}