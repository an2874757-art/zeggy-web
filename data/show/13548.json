length":0,"continue_watching_progress":0},{"items":[],"id":9753,"title":"World War Z","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk42/shows/4936761f-58ef-4660-a6c0-1f0ed4504b16.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":13548,"title":"","description":"48","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":13548,"type":"MOVIE","title":"Melissa P.","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/c022f1fd-6e8b-4823-87db-1e1076834553.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/72b79627-9be7-4384-bf0e-868a22b0ecd4.png","likes":507,"dislikes":88,"views":96034,"release_date":"1132272000000","length":5871,"description":"Melissa lives with her mother and her grandmother in Sicily. She has a close relationship with her grandmother, a heavy smoker, who seems to be the only person in the world who understands Melissa. Melissa's father lives in another country. One day Melissa and her friend go to a party at a school friend's home. While there, Melissa meets Daniele, a boy from the school, and has her first sexual experience. The experience is far from being what Melissa always has dreamed it would be, because Daniele forces her and later forgets her. However, Melissa has fallen in love with Daniele. Back at school, when Melissa tries to get Daniele's attention, he barely remembers her. He takes advantage of Melissa's feelings for him, convincing her to have sex with him whenever he wants. When Melissa discovers Daniele's true motivations, she takes revenge by having even wilder sexual experiences with him and other boys. She even begins keeping a diary to document her sexual experiences. Melissa's mother is worried and tries to approach her distant daughter, while her grandmother is sent off to a rest home.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.8}],"value":4.8,"age":"R"},"episode_id":13548,"content_control":"NORMAL"}}