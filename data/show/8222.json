ntinue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8222,"title":"","description":"12","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Family"],"id":8222,"type":"MOVIE","title":"The Sorcerer's Apprentice","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/5ff6f972-590e-44de-b9fa-da3db445d4ba.jpeg","background_image":"https://cdn6.albox.co/storage/disk46/shows/5903745e-66d3-4145-8bfe-ffbad8a88991.jpeg","likes":113,"dislikes":1,"views":7823,"release_date":"1279065600000","length":6543,"description":"Balthazar Blake (Nicolas Cage) is a master sorcerer in modern-day Manhattan trying to defend the city from his arch-nemesis, Maxim Horvath (Alfred Molina). Balthazar can't do it alone, so he recruits Dave Stutler (Jay Baruchel), a seemingly average guy who demonstrates hidden potential, as his reluctant protégé. The sorcerer gives his unwilling accomplice a crash course in the art and science of magic, and together, these unlikely partners work to stop the forces of darkness. It'll take all the courage Dave can muster to survive his training, save the city and get the girl as he becomes The Sorcerer's Apprentice.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":8222,"background_color":"","content_control":"FAMILY"}}