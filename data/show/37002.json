Db","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"PG-13"},"background_color":"","current_season_id":21370,"content_control":"NORMAL"}}