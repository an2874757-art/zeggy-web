e6c-bf97-b9aa1e80f747.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":11715,"title":"Malena","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk50/shows/cd15b7ac-a298-4b85-93c7-a5ad74c7e190.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10472,"title":"Twilight","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/7409ad61-2581-41c0-8334-fd635d480b20.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3934,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Thriller"],"id":3934,"type":"MOVIE","title":"Reflections in a Golden Eye","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk52/shows/50835b6d-811e-48c6-af69-e836add89b83.jpg","likes":9,"dislikes":0,"views":10163,"release_date":"-70070400000","length":6535,"description":"US Army Major Weldon Penderton is stationed on a base in the American south. He and his wife Leonora Penderton are in an unsatisfying marriage. Weldon is generally a solitary man who in his time alone tries to bolster his self image as he feels less than adequate as a man and a major. He does not want to viewed like Captain Murray Weincheck, who has been bypassed for promotion time and time again solely because he is seen as being too sensitive. Self absorbed Leonora, when not focused on her passion of horses and riding, tries to maintain the facade of being what she sees an officer's wife should be while she carries on an affair with their next door neighbor, married Colonel Morris Langdon. Morris' wife, Alison Langdon, suffered a nervous breakdown three years ago after miscarrying, she still with that nervous constitution. Alison is generally drawn toward sensitive types, such as Captain Weincheck and their faithful flamboyant Filipino houseboy, Anacleto. Peripheral to the Pendertons' lives is brooding Private Williams, who Leonora knows as the enlisted man who works at the stables, and who Weldon asks to do some work around their house. While Weldon secretly becomes fixated on Williams, Williams in turn becomes secretly fixated on Leonora. The question becomes what emotions, many of those emotions being latent, will dictate what actions each of these people will make.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"episode_id":3934,"content_control":"NORMAL"}}