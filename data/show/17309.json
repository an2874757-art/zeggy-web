scription":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/382b440d-eb43-4a73-a8d3-573f276b1439.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16321,"title":"You","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk44/shows/402641cb-5e0c-469e-a335-9b14e55ccae7.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17309,"title":"","description":"21","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","History"],"id":17309,"type":"SERIES","title":"Poldark","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/77009570-a6b3-4046-9319-a7803e39390d.jpg","background_image":"https://cdn6.albox.co/storage/disk57/seasons/9c020726-cf86-461c-b114-919c23006c44.jpg","likes":137,"dislikes":3,"views":44099,"release_date":"1497139200000","season_number":1,"description":"Ross Poldark returns to England after fighting in the American Revolution. His family and friends thought he was dead. The woman he hoped to marry is now engaged to his cousin. His father is dead, and the property he has inherited has been allowed to deteriorate. It is the late 1700s in Cornwall, England. This is a family drama, but is also about the challenges and conflicts between the rich and the poor. It is a time when fishermen are not catching much fish, tin and copper mines are closing down because prices are too low, but the price of food and rents are high. Ross faces the challenge of making his land productive, caring for the tenants who rely on him, and trying to win back the woman he loved - or finding a reason to live without her.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"current_season_id":5328,"content_control":"FAMILY"}}