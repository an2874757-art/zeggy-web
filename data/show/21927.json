0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Drama","Romance","Historical","Martial Arts","Wuxia"],"id":21927,"type":"SERIES","title":"The Legend of Zu","logo":"","image":"https://cdn6.albox.co/storage/CLOUD00/seasons/91f754a5-c680-4751-9733-1a4058a7d7e9.jpg","background_image":"https://cdn6.albox.co/storage/CLOUD00/seasons/ce515535-a20b-4bdd-b482-dd9dd013e207.jpg","likes":22,"dislikes":0,"views":3953,"release_date":"1442880000000","season_number":1,"description":"Zhuge Yu Wo is leader of the Mt. Zu Sect, a highly prestige sect in Jiang Hu (martial art world). In order to protect the world from catastrophic chaos, he battled against the evil villain Green Cape, who stole the Scarlet Soul Stone. In the midst of the battle, the Scarlet Soul Stone was forced into Ding Yin's body. Because of this, Ding Yin became a disciple of the Mt. Zu Sect, and vowed to protect the world from evil and chaos. By chance, Ding Yin found out that Yu Wu Xin, daughter of Shang Guan Jing Wo, looked surprisingly similar to his dead wife. As a result they fell in love with each other. At the same time, the power structure of the Mt. Zu Sect was shaking, which leads to another catastrophic chaos in Jiang Hu. ~~ Adaptation of the same name novel. Add Synopsis In Portuguese","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"current_season_id":11076,"content_control":"NORMAL"}}