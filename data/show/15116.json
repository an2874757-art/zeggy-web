"Mr. Robot","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk44/shows/24f7e7fa-7af0-4762-9c42-1b75c06db5a4.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15116,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller","Crime","Mystery","Western"],"id":15116,"type":"SERIES","title":"Justified","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/60416af6-9ac3-4dd4-9975-4c3deeac5661.jpg","background_image":"https://cdn6.albox.co/storage/disk49/seasons/287374e6-8da5-4d5e-82a0-316d216aea29.jpg","likes":80,"dislikes":3,"views":22480,"release_date":"1268697600000","season_number":1,"description":"U.S. Marshal Raylan Givens is a modern day 19th century-style lawman, enforcing his brand of justice in a way that puts a target on his back with criminals and places him at odds with his bosses in the Marshal service. That conflict results in a reassignment for Givens to the U.S. District covering the town where he grew up. He is an anachronism - a tough, soft spoken gentleman who finds his quarry fascinating, but never gives an inch. Dig under his placid skin and you'll find an angry man who grew up hard in rural Kentucky, with an outlaw father, who knows a lot more about who he doesn't want to be than who he really is.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"R"},"current_season_id":2258,"content_control":"FAMILY"}}