e_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10293,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":10293,"type":"MOVIE","title":"Behind the Camera","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/675a249b-326c-460a-b646-76d0711bb2cd.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/c36bfa5c-8386-47cc-8f04-95622df3ad38.jpg","likes":7,"dislikes":0,"views":1464,"release_date":"1360454400000","length":5101,"description":"Director E J-yong signs on to direct a short advertorial film and becomes taken with the whimsical notion of directing the film not from on set, but from an off-site location using Web-based technology. E writes this very idea into his short film, a story about a director who attempts to \"remote direct\" his film set in order to go on a date. E then rounds up an impressive star-studded cast, but secretly flies out to Hollywood, Los Angeles in order to put his plan to action. On the morning of the first day of shoot, E J-yong greets his cast and crew through a monitor. Without the director on set, the film goes spiraling into chaos.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":10293,"content_control":"NORMAL"}}