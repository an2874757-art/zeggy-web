ows/6ab4e7e7-a781-4d1d-bbb5-a03db73018a3.jpeg"},"length":0,"continue_watching_progress":0},{"items":[],"id":8804,"title":"Attack on Titan movie 3","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/ac673e39-0299-4535-9dd8-e011a6318625.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10155,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Animation","Family"],"id":10155,"type":"MOVIE","title":"Piano no Mori","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/ee98792d-a617-42f7-a186-c98bfbdae679.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/f669f0f4-cc03-45ae-b91a-c7912cd3ecb8.jpg","likes":29,"dislikes":0,"views":2468,"release_date":"1184976000000","length":6059,"description":"Amamiya Shuuhei moves from Tokyo to the country side due to his grandmother's bad health. His father is a famous pianist and Shuuhei has taken strict piano lessons since he was very young, aspiring to follow in his footsteps. In school, he is teased by his classmates and is dared to play the piano in the forest. This piano is said to be cursed: if you play it, no sound will come. After school, Ichinose Kai, a boy in the same class, takes Shuuhei to the forest. When Shuuhei tries to play he fails, but Kai plays a wonderful song. This is the beginning of a strong friendship, and a story of two very different boys developing their skills as musicians.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"pg-13"},"episode_id":10155,"content_control":"NORMAL"}}