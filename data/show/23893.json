":[{"items":[],"id":23893,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Medical"," Romance"," Comedy"," Sports"],"id":23893,"type":"SERIES","title":"May-December Romance","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/8b10f456-0399-4cbe-96ca-db784ca90185.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/d498cff9-d8f6-4ab8-839a-4be9a78b2250.jpg","likes":5,"dislikes":0,"views":1624,"release_date":"1630540800000","season_number":1,"description":"تم التخلص من Orn في سن 52 لكنها لن تغرق في البؤس. إن عملية تغيير كامل للجسم تجعلها تبدو 25 مرة أخرى. نعم الحياة مليئة بالمفاجآت! لدى Orn إعجاب كبير بتوم ، لاعبة تنس الطاولة ، والتي هي أصغر منها بكثير لدرجة أنه يمكن أن يكون طفلها. تم القبض على توم للتو وهو يتعاطى المنشطات دون أن يعرف أن العقار من أخيه تا ، وهو طبيب ومقامر مثقل بالديون. ودائمًا ما يكون Mint في مأزق عندما يتعلق الأمر بـ Ta. هل يجب أن تلاحق سحقها على معلمها المدمن على القمار أم أن تنسى ذلك للأبد؟ من ناحية أخرى ، داناي ، رئيس اتحاد التنس ، فجأة يفتح صفحة جديدة ويحاول استعادة أورن مرة أخرى. لا يبدو أن طالبة جامعية تُدعى ماي تهتم كثيرًا بعمر داناي. حتى أنها تعتبره \"رجل نبيل كلاسيكي\". هل يمكن أن يسود الحب على فارق السن؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"background_color":"","current_season_id":12354,"content_control":"NORMAL"}}