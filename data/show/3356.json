_progress":0},{"items":[],"id":37075,"title":"Ice Road: Vengeance","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/cff28c28-18e2-40cc-a31a-11469b4f3cc3.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36228,"title":"Novocaine","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/1f589b14-23bc-41fd-a716-ca624cdf87b0.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10286,"title":"Harry Potter and the Chamber of Secrets","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk41/shows/6b9d02b4-1986-4f45-8714-fbcb41cec2d0.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3356,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi","Drama","Thriller","Mystery"],"id":3356,"type":"MOVIE","title":"The Door","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/a88db8a7-9e86-4561-9680-5c02660d6009.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/5de1a765-7431-4649-803a-ddd7fbdbd3e3.jpg","likes":52,"dislikes":2,"views":6210,"release_date":"1259193600000","length":5976,"description":"David Andernach (Mads Mikkelsen) lives non-chalantly at the height of his success as a painter, as a tragic misfortune befalls him from one second to the other. While he is paying his beautiful neighbor a visit, his daughter Leonie drowns in the pool of his house. Tormented by guilt, David turns into a wreck. His life is no longer under control, especially since his wife Maja (Jessica Schwarz) can never forgive him. Completely at the end he wants to kill himself jumping in the same pool, but at the last moment is saved by a friend. But as the guilt-ridden man has fallen in the greatest despair, a butterfly flapping on his nose leads him to a door, actually more an underground tunnel. On the other side he finds life as it was before. He gets back to the all-important moment and so given the opportunity to save his daughter. But even with his own ego, which is just on the road to regret his infidelity. Conscious as never before of those who have always loved him, the auspicious opportunity for a new beginning soon turns out to be a veritable horror scenario, because the past holds dark, fateful secrets.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":3356,"content_control":"NORMAL"}}