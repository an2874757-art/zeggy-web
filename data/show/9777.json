on":"149","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":9777,"type":"MOVIE","title":"Wild Child","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/aefd8fd7-9af3-4123-9010-91c209ddb7c5.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/c7558bc4-b19c-45ad-9afd-2ffc722213bd.jpg","likes":921,"dislikes":10,"views":37410,"release_date":"1218758400000","length":5904,"description":"Since Malibu brat Poppy Moore's mom passed away, she has pushed her rich, usually absent dad Gerry shamelessly. When his patience wears out, she's shipped off to her mother's former English boarding school for girls, Abbey Mount. On her first day she makes enemies of most dorm mates, especially dominant lacrosse school captain Harriet, and the school's principal Mrs. Kingsley. Unwilling to accept the strict regime, she decides to misbehave and take the blame for everyone until she's dismissed. The school only appealing feature for her is Kingsley's dashing son Freddie. When the dream prince transfers his favor from ambitious, uptight Harriet to unruly Poppy, that changes everything.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":9777,"content_control":"FAMILY"}}