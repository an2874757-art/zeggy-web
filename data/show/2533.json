,"section_type":"normalPoster"},{"data":[{"items":[],"id":2533,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Music"],"id":2533,"type":"MOVIE","title":"Control","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/6e2cabd4-321b-4be8-a126-97a607832006.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/4e52bc5a-2008-4c88-8128-0003dd799e9f.jpg","likes":33,"dislikes":0,"views":3133,"release_date":"1190764800000","length":7321,"description":"Ian Curtis is a quiet and rather sad lad who works for an employment agency and sings in a band called Warsaw. He meets a girl named Debbie whom he promptly marries and his band, of which the name in the meantime has been changed to Joy Division, gets more and more successful. Even though Debbie and he become parents, their relationship is going downhill rapidly and Ian starts an affair with Belgium Annik whom he met after one of the gigs and he's almost never at home. Ian also suffers from epilepsy and has no-good medication for it. He doesn't know how to handle the feelings he has for Debbie and Annik and the pressure the popularity of Joy Division and the energy performing costs him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"episode_id":2533,"content_control":"FAMILY"}}