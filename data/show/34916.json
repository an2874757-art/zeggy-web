3bcd.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":34916,"title":"","description":"13","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Youth"," Comedy","  Romance"],"id":34916,"type":"SERIES","title":"Smile Code ","logo":"","image":"https://cloud02.albox.co/seasons/45d17abb-5dc8-4539-b0c9-7b6897a5df1a.jpg","background_image":"https://cloud02.albox.co/seasons/0a663e3e-0ee9-422b-b682-f96f7130bfac.jpg","likes":120,"dislikes":1,"views":16555,"release_date":"1731024000000","season_number":1,"description":"تحكي قصة ممثلة برامج حوارية بدوام جزئي محرومة من الرفاهية وعضو جمهور منعزل يعاني من فقدان القدرة على التعبير عن المشاعر - والمعروف أيضًا باسم \"العمى العاطفي\" - يقتربان من بعضهما البعض ويشفيان بعضهما البعض. قصة حب بين امرأة مضحكة حتى النهاية ورجل لا يستطيع الضحك، تبدأ مسابقة حب. ومع ذلك، فإن ما يربط الرومانسية ليس فقط المشاعر بين الرجال والنساء، ولكن أيضًا الشباب الحضري المكافح الذي يعيش في شنغهاي. على خشبة المسرح وخارجها في المسرحية، تضرب الشكاوى الحارة ولكن الملاحظة نقاط الألم في الحياة، والسخرية الفكاهية خفيفة، لكنها مليئة أيضًا بالتفاؤل والانفتاح الذهني.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"background_color":"","current_season_id":19784,"content_control":"NORMAL"}}