0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller","Crime"],"id":12614,"type":"MOVIE","title":"Live by Night","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/0f7e4a78-c831-47e8-a953-db7d249a2c2b.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/ec031abb-730f-46a0-bbb5-2bdfe41149a5.jpg","likes":76,"dislikes":1,"views":8550,"release_date":"1484265600000","length":7732,"description":"تدور أحداث الفيلم في (بوسطن) عام 1926؛ حيث الخمور تتدفق، الرصاص يتطاير، ورجل وحيد يقرر أن يترك بصمته بالعالم في ظل الحظر الذي أوجد شبكة لا تنتهي من مصانع التقطير تحت الأرض، الحانات، العصابات، وضباط الشرطة الفاسدين، و(جو كافلين) الابن الأصغر لقائد شرطة بارز في (بوسطن)، يُدير ظهره أخيرًا لتربيته الصارمة الحازمة. فبعد فراغه من مرحلة طفولته، يتحول من السرقة إلى عمل مدفوع الأجر يتعامل فيه مع مجموعة من أخطر الغوغائيين، ويجد (جو) نفسه مستمتعًا بغنائم مهنته الجديدة، بالإثارة، وسمعته السيئة التي اكتسبها كخارج عن القانون.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"R"},"episode_id":12614,"content_control":"FAMILY"}}