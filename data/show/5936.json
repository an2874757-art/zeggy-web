s":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5936,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Crime"],"id":5936,"type":"MOVIE","title":"The Heat","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/452dfa49-9a6a-4ebc-b610-46b321c20938.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/d1b9d665-c5d6-4e43-adf3-29ebd045714c.jpg","likes":71,"dislikes":0,"views":7218,"release_date":"1372377600000","length":7220,"description":"Sarah Ashburn, an FBI agent, is extremely ambitious and has her eye on a promotion, but she doesn't get along with her co-workers. She is sent to Boston to uncover the identity of an elusive drug lord, Mr. Larkin, by tracking down his proxy, Rojas, and is told that she'll have a good shot at the promotion if she finds Larkin. When she arrives in Boston, she learns that Larkin has been eliminating his competition and taking over their operations. She learns that Rojas is in Boston PD custody and goes to see him to ask him what he knows about Larkin, but is warned that the cop who arrested Rojas, Shannon Mullins, is very territorial, and she is not exactly sociable. When the two meet they don't get along. When Mullins learns why Ashburn is in Boston, she decides to find Larkin herself. Ashburn is told by her boss to work with Mullins, but it won't be easy because Ashburn does things by the book while Mullins does things her way.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"R"},"episode_id":5936,"content_control":"FAMILY"}}