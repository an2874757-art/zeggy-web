ion_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Animation"],"id":16557,"type":"SERIES","title":"My Wife Is the Student Council President","logo":"","image":"https://cdn6.albox.co/storage/disk52/seasons/7f3a4a53-667c-46a7-9368-68f042138368.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/b0ea8638-1b55-4b55-bb6b-8700fd73a019.jpg","likes":110,"dislikes":16,"views":30687,"release_date":"1435708800000","season_number":1,"description":"The story begins with Izumi Hayato running to be student council president. But when a beautiful girl swings in promising the liberalization of love while flinging condoms into the audience, he ends up losing to her and becoming the vice president. At the student council meeting, the newly-elected president invites herself over to Izumi's house, where she promptly announces she is to become Izumi's wife thanks to an agreement—facilitated by alcohol—made between their parents when they were only 3.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"R"},"current_season_id":4261,"content_control":"NORMAL"}}