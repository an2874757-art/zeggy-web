2.albox.co/shows/df58a327-0635-46e8-8f0c-7521724d49e9.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9838,"title":"","description":"27","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Romance","Crime"],"id":9838,"type":"MOVIE","title":"Parker","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/ef29b20d-7af7-4fba-ab7e-053463c45e23.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/57f45876-1cf8-45db-b56a-c6de395a98a7.jpg","likes":377,"dislikes":13,"views":59842,"release_date":"1359072000000","length":7120,"description":"Parker is a thief who has an unusual code. He doesn't steal from the poor and hurt innocent people. He is asked to join four other guys on a job. They pull it off flawlessly. They tell Parker that what they got can help them set up another job which will net them much more. But Parker doesn't want to join them and asks for his share. But they need it all so they try to kill him. They dispose of his body but someone finds him--he is still alive--and takes him to the hospital. After recovering he sets out to get back at the ones who tried to kill him, another one of his codes. Despite being told that they are working for a known mobster which he was not aware of, he still wants to go after them. He learns where they are and poses as a wealthy Texan looking to buy a house. So he hires a real estate agent, Leslie Rogers to show him around. He is actually trying to find out where they're holed up. And when he finds it, he sets out on his plan to get them. But when they learn he is alive, they contact the mobster to take care of him. So the mobster sends a killer to take care of him. And Leslie also finds herself intrigued with him so she follows him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"R"},"episode_id":9838,"content_control":"FAMILY"}}