ws/e5072325-6fae-4d0c-98bb-3a7f22abd7bb.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":23998,"title":"Komi-san wa Comyushou desu","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/dd1c013c-f7f7-45c3-bf5f-7ea4ff398303.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":24295,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Drama"," Comedy"," Slice of Life"],"id":24295,"type":"SERIES","title":"Hanasaku Iroha","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/06d07c17-db0c-45a7-b157-a85ffda95520.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/09484db6-b472-44ba-b9b3-a06a5920428e.jpg","likes":18,"dislikes":0,"views":1263,"release_date":"1301788800000","season_number":1,"description":"أوهانا ماتسوماي هي مراهقة نشطة وبرية تعيش في طوكيو مع والدتها العزباء الخالية من الهموم. فجأة ، قررت والدتها الهروب مع صديقها الجديد من جامعي الديون ، مما أجبر الفتاة الصغيرة على الاعتماد على نفسها - وفقًا لفلسفة والدتها \"الاعتماد على نفسك فقط\" - في المناطق الريفية باليابان ، حيث تدير جدتها الباردة نزلًا صغيرًا. مدفوعة بالتكيف مع نمط الحياة الهادئ للريف ، تعيش Ohana وتتعامل مع تحديات العمل كخادمة ، بالإضافة إلى مقابلة وتكوين صداقات مع أشخاص آسرين في مدرستها الجديدة والنزل.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"PG-13"},"background_color":"","current_season_id":12671,"content_control":"NORMAL"}}