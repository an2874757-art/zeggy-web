lated","section_type":"normalPoster"},{"data":[{"items":[],"id":37451,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller"," Mystery","drama "],"id":37451,"type":"SERIES","title":"Beneath the Undertow","logo":"","image":"https://cloud02.albox.co/seasons/637c395e-b454-43a6-85cc-46f17042b929.jpg","background_image":"https://cloud02.albox.co/seasons/ff1fc3e1-6b55-4498-a5f4-7606773db562.jpg","likes":22,"dislikes":0,"views":4655,"release_date":"1753920000000","season_number":1,"description":"في مصنع أساهي الحكومي النابض بالحياة سابقًا، عُثر بالصدفة على جثة طالبة جامعية بقدمها المبتورة في خزان صرف صحي مهجور. المتوفاة هي شين شياو تشو، ابنة عامل في المصنع. يُكلَّف قائد فريق الشرطة الجنائية ليان هاي بينغ بالتحقيق في القضية. يُعيَّن شي تشيانغ فنغ، ضابط الشرطة الجنائية الشاب الذي أبلغ عن القضية في اليوم الأول، بالصدفة ضمن فريق التحقيق التابع لليان هاي بينغ.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"","current_season_id":21693,"content_control":"NORMAL"}}