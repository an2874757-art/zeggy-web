ngth":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15154,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Comedy","Animation","Family"],"id":15154,"type":"SERIES","title":"Ojamajo Doremi","logo":"","image":"https://cdn6.albox.co/storage/disk53/seasons/d3837fd5-c2b3-44d9-b507-857c98dff14a.jpg","background_image":"https://cdn6.albox.co/storage/disk51/seasons/50681d1c-e627-4f3f-a3b6-c807522f00c9.jpg","likes":95,"dislikes":1,"views":13681,"release_date":"1126310400000","season_number":1,"description":"Ojamajo Doremi is the story about a girl by the name of Doremi Harukaze and her friends as they learn magic. Doremi is the main star of the show, for it was her who caused her friends, Aiko and Hazuki to become witch's apprentices as well. Doremi claims to be \"the unluckiest bishoujo in the world\", so she hopes to one day learn magic, because she thinks it'll make her life easier. She stumbles across the Maho Dou (Magic Hall) one day and calls a woman by the name of Marika (her actual witch name is Majorika) a witch. Because she called out a witch as a witch, she must now train under Majorika's advisory and pass all her witch's exams to meet her goal of becoming a full-fledged witch.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"PG-13"},"current_season_id":2316,"content_control":"NORMAL"}}