Poster"},{"data":[{"items":[],"id":639,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy","Family"],"id":639,"type":"MOVIE","title":"غدي","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/907f7cf5-b86a-41e0-81a8-ad780f3847bc.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/2fe4ff25-a6c7-470c-9ef4-7a5052183239.jpg","likes":11,"dislikes":1,"views":2889,"release_date":"1383177600000","length":5812,"description":"في إحدى القرى اللبنانية، يعيش الطفل لابا الذي يعاني من ثقلٍ في النطق مما يجعله محط سخطٍ وسخريةٍ للعديد من رفاقه في المدرسة، حينها بدأ لابا في تعويض النطق بالكتابة، ثم جاء البيانو إلى قريته وبدأ في تعلم العزف على يد الأستاذ فوزي، وتخلص من مشكلته مع مرور الأيام، وصار معلمًا الموسيقى والغناء، وتزوج ورُزق بصبيٍ معاقٍ يُدعى غدي، والذي كانت ثرثرته تثير غضب أهل القرية، إلا أنه كان في نظر والده ملاكًا وهو ما يحاول إثباته لأهل قريته جميعًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":639,"content_control":"NORMAL"}}