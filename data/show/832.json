mments"}],"post_info":{"genres":["Thriller","Crime","Film-Noir"],"id":832,"type":"MOVIE","title":"The Big Heat","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/d3d4cde2-0fdc-46e9-8e74-ef0d65e7f282.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/c88ee106-28f1-46c2-9a82-4377a48ce663.jpg","likes":12,"dislikes":0,"views":3635,"release_date":"-507168000000","length":5373,"description":"Dave Bannion is an upright cop on the trail of a vicious gang he suspects holds power over the police force. Bannion is tipped off after a colleague's suicide and his fellow officers' suspicious silence lead him to believe that they are on the gangsters' payroll. When a bomb meant for him kills his wife instead, Bannion becomes a furious force of vengeance and justice, aided along the way by the gangster's spurned girlfriend Debbie. As Bannion and Debbie fall further and further into the Gangland's insidious and brutal trap, they must use any means necessary (including murder) to get to the truth.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"episode_id":832,"content_control":"NORMAL"}}