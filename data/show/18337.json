r"},{"data":[{"items":[],"id":18337,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Crime"],"id":18337,"type":"SERIES","title":"Sick Note","logo":"","image":"https://cdn6.albox.co/storage/disk55/seasons/4f8ea23a-c6c7-4be0-ac4a-6be5a9542e8b.jpg","background_image":"https://cdn6.albox.co/storage/disk42/seasons/492d3fd5-b6b4-4846-b12b-77dc45078437.jpg","likes":1,"dislikes":2,"views":3256,"release_date":"1510012800000","season_number":1,"description":"Sick Note is the story of Daniel Glass (Rupert Grint), a compulsive liar, who's stuck in a failing relationship and a dead end job, where he is under the thumb of his irrepressible boss Kenny West (Don Johnson). And just when things couldn't get any worse, he's diagnosed with esophageal cancer. However, everyone starts to treat him better because of his diagnosis and suddenly Daniel finds he has a new lust for life. But then he finds out he was misdiagnosed by the most incompetent oncologist on Earth, Dr Ian Glennis (Nick Frost) and that's when Daniel has a big decision to make: come clean and go back to his old rubbish life, or keep this new information a secret and pretend to be ill. He decides to go for the latter but very quickly the lie spirals out of control and both Daniel and Dr Glennis have to spend all of their waking lives trying to prevent the truth from getting out.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"N/A"},"current_season_id":6607,"content_control":"NORMAL"}}