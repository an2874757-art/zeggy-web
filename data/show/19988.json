gi and his friends succeed or will they lose their souls?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"N/A"},"current_season_id":8813,"content_control":"NORMAL"}}