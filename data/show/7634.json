co/storage/CLOUD00/shows/77310be4-6fbf-44ef-85c5-7b45c2e325d5.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7634,"title":"","description":"141","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy","Family"],"id":7634,"type":"MOVIE","title":"The Princess Diaries","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/4e19274b-eff4-4d74-a2a1-1f8c55950567.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/6900a69c-e02d-4ec8-b6df-30f6f731e2ad.jpg","likes":1539,"dislikes":36,"views":83318,"release_date":"0","length":6928,"description":"Mia Thermopolis is the average teenager - sweet, a little geeky and pretty much invisible to everyone with the exception of her mother, best friend Lilly and Lilly's older brother Michael. Making it through high school without throwing up is a challenge in itself for Mia, so it doesn't come as welcome news when her estranged grandmother shows up out of the blue and calmly informs her that she is in fact the heir to the throne of a European country called Genovia. Suddenly Mia's life is thrown into complete overload. She's being taught about scarves, waves and pears in order to become a perfect princess, she gets a makeover and a tough looking yet sweet bodyguard/limo driver called Joe. Things get out of hand when the media gets a hold of the story and suddenly Mia is thrust into the spotlight in both the newspapers and in school. On top of all that Mia has a choice to make. She must decide by Genovia's Independence Day Ball whether she longs to relinquish her claim on the throne or to become the princess and heir to the throne her father and grandmother want her to be.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":7634,"background_color":"","content_control":"NORMAL"}}