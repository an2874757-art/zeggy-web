1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":4183,"type":"MOVIE","title":"Remember the Night","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/4ad1b5a8-5188-4792-a338-e33a35efce4a.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/acf5393d-8d72-417e-a044-de6a86b02c2e.jpg","likes":8,"dislikes":0,"views":3151,"release_date":"-945216000000","length":5651,"description":"Just before Christmas, Lee Leander is caught shoplifting. It is her third offense. She is prosecuted by John Sargent. He postpones the trial because it is hard to get a conviction at Christmas time. But he feels sorry for her and arranges for her bail, and ends up taking her home to his mother for Christmas. Surrounded by a loving family (in stark contrast to Lee's own family background) they fall in love. This creates a new problem: how do they handle the upcoming trial?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"episode_id":4183,"content_control":"NORMAL"}}