ows/90b9b42d-9d1b-42d1-8a21-ad7f1cba84f2.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9513,"title":"","description":"16","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime","Mystery"],"id":9513,"type":"MOVIE","title":"Eastern Promises","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/d7097349-beea-40a1-8711-a895d86dbde0.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/f241ad4b-6d8e-40b9-a357-2b3b4066de58.jpg","likes":171,"dislikes":8,"views":10477,"release_date":"1190332800000","length":6033,"description":"In London, the Russian pregnant teenager Tatiana arrives bleeding in a hospital, and the doctors save her baby only. The Russian descendant midwife Anna Khitrova finds Tatiana's diary written in Russian language in her belongings and decided to find her family to deliver the baby, she brings the diary home and ask her uncle Stepan to translate the document. Stepan refuses, but Anna finds a card of a restaurant owned by the Russian Semyon inside the diary and she visits the old man trying to find a lead to contact Tatiana's family. When she mentions the existence of the diary, Semyon immediately offers to translate the document. However, Stepan translates part of the diary and Anna discovers that Semyon and his sick son Kirill had raped Tatiana when she was fourteen years old and forced her to work as prostitute in a brothel of their own. Further, Semyon is the dangerous boss of the Russian mafia \"Vory v Zakone\", jeopardizing the safety of Anna and her family. Meanwhile, Semyon's driver Nikolai Luzhin gets close to Kirill and Semyon, climbing positions in the criminal organization, but he helps Anna, her family and the baby.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"episode_id":9513,"content_control":"FAMILY"}}