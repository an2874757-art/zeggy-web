4.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":13955,"title":"Alice in Borderlands","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/57e64695-cd9a-43b4-82db-970628d4449a.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36734,"title":"One: High School Heroes","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/d0628511-ef4c-4e1f-829e-22a23ed76fc1.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":38001,"title":"","description":"511","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy ","Romance ","life ","youth "],"id":38001,"type":"SERIES","title":"A Hundred Memories ","logo":"","image":"https://cloud02.albox.co/seasons/7382ff65-a29b-4732-aae5-46006c83ce88.jpg","background_image":"https://cloud02.albox.co/seasons/0b0533ce-4cd2-47aa-92d0-04ad69a2264a.jpg","likes":1173,"dislikes":16,"views":100085,"release_date":"1757721600000","season_number":1,"description":"في كوريا الجنوبية في ثمانينيات القرن الماضي، تعمل كو يونغ راي كموصلة حافلات في شركة تشيونغ أ للنقل، حيث تساعد الركاب على الوصول إلى حيث يحتاجون للذهاب. وعلى الرغم من إصابتها بدوار الحركة، إلا أنها ملتزمة بعملها لدعم أسرتها. وسرعان ما تنضم إليها سيو جونغ هوي، وهي شابة ذات صوت عالٍ بشكل مثير للإعجاب والتي تقرر أيضًا أن تصبح موصلة حافلات. تصبح يونغ راي وجونغ هوي صديقين سريعين، ولكن سرعان ما يتم اختبار علاقتهما من قبل هان جاي بيل، وهو ملاكم طموح من عائلة مضطربة ولكنها ثرية والذي اقتحم حياتهما عندما ساعد الفتاتين في إيقاف أحد المتهربين من الأجرة. يطور يونغ راي إعجابًا بجاي بيل، لكن يبدو أن جاي بيل يكن مشاعر لجونغ هوي، مما يؤدي إلى توتر الصداقة بينهما. فهل سيجد يونغ راي وجونغ هوي طريقة للحفاظ على صداقتهما معًا، على الرغم من المساعي الرومانسية المتضاربة؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"background_color":"","current_season_id":22033,"content_control":"FAMILY"}}