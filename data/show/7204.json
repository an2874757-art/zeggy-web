ng_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7204,"title":"","description":"20","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama"],"id":7204,"type":"MOVIE","title":"The Good Lie","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/027cccc1-807f-40b6-bdb4-95992e848b1e.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/590d302e-81eb-4242-be27-0734d1c6aa7e.jpg","likes":171,"dislikes":2,"views":10178,"release_date":"1415923200000","length":6600,"description":"Four Sudanese children are orphaned after their village is massacred in the Second Sudanese Civil War. Consequently, they make an arduous and dangerous trek through the plains, enduring hardship, death and sacrifice all the way until they reach safety in a refugee camp in Kenya. Years later, these youths are among 3600 selected for resettlement in America, only to have the one girl among them sent to Boston, while the three boys must to make a new life in Kansas City. Together, these young men must adjust to an alien culture even as the emotional baggage of their past haunts them. However, these newcomers, and their new friends like employment counselor Carrie Davis, strive to understand each other in this new home, as they make peace with their histories in a challenge that will change all their lives.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":7204,"content_control":"FAMILY"}}