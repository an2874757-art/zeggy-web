/shows/38ea2aac-5ea3-4848-928d-45d9080c9ccc.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6044,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Comedy"],"id":6044,"type":"MOVIE","title":"The Incredible Burt Wonderstone","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/14d93a13-cea6-4d9b-a8a8-fb64f46d1f61.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/32c00326-d0ad-4177-85b1-455a0017fa66.jpg","likes":18,"dislikes":1,"views":3442,"release_date":"1363305600000","length":6018,"description":"Superstar magicians Burt Wonderstone (Steve Carell) and Anton Marvelton (Steve Buscemi) have ruled the Las Vegas Strip for years, raking in millions with illusions as big as Burt's growing ego. But lately the duo's greatest deception is their public friendship, while secretly they've grown to loathe each other. Facing cutthroat competition from guerrilla street magician Steve Gray (Jim Carrey), whose cult following surges with each outrageous stunt, even their show is starting to look stale. But there's still a chance Burt and Anton can save the act - both onstage and off - if only Burt can get back in touch with what made him love magic in the first place.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":6044,"content_control":"FAMILY"}}