],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36481,"title":"","description":"115","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Comedy"," Music"," Youth"],"id":36481,"type":"SERIES","title":"Spring of Youth","logo":"","image":"https://cloud02.albox.co/seasons/bdb1693d-fd95-46ee-9c03-978736122b0f.jpg","background_image":"https://cloud02.albox.co/seasons/5738fbed-1444-4468-95d2-d2eb82a6fb40.jpg","likes":651,"dislikes":17,"views":65007,"release_date":"1746576000000","season_number":1,"description":"سا جاي، المغني وعازف الجيتار الكاريزمي في فرقة الكيبوب الشهيرة \"ذا كراون\"، يُجبر بشكل غير متوقع على التسجيل في جامعة هانجو - الحرم الجامعي الذي لم تطأ قدمه قدمه من قبل - بعد حادث مفاجئ. أُلقي في عالم غير مألوف، وهو يشق طريقه بشكل فوضوي عبر الحياة الجامعية ويلتقي بشكل مصيري مع كيم بوم، المغنية وعازفة لوحة المفاتيح الموهوبة من فرقة \"توساجي\"، التي حلمت ذات مرة بجامعة آيفي ليج لكنها تحولت إلى الموسيقى بعد وفاة والدتها قبل ست سنوات. مع اقترابهم، يشتعل شغف سا جاي بالموسيقى من جديد ويشكل فرقة غامضة لبدء الموسيقى من جديد. في هذه الأثناء، يضيف سيو تاي يانغ - عازف الجيتار اللامع وطالب الطب الذي ينحدر من عائلة من الأطباء - التوتر وهو يتنافس مع سا جاي، موسيقيًا وشخصيًا. عالقًا بين الحب والتنافس والانسجام، يشعل الثلاثي فصلًا جديدًا في رحلتهم الموسيقية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"R"},"background_color":"","current_season_id":21027,"content_control":"NORMAL"}}