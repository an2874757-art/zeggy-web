:0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7139,"title":"","description":"53","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime"],"id":7139,"type":"MOVIE","title":"Casino","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/4eb960d2-d380-4ec9-86d1-ab636fd4e2b5.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/4cccd4c5-f133-49ea-95bd-9346354db244.jpg","likes":529,"dislikes":4,"views":39568,"release_date":"816998400000","length":10694,"description":"This Martin Scorsese film depicts the Janus-like quality of Las Vegas--it has a glittering, glamorous face, as well as a brutal, cruel one. Ace Rothstein and Nicky Santoro, mobsters who move to Las Vegas to make their mark, live and work in this paradoxical world. Seen through their eyes, each as a foil to the other, the details of mob involvement in the casinos of the 1970's and '80's are revealed. Ace is the smooth operator of the Tangiers casino, while Nicky is his boyhood friend and tough strongman, robbing and shaking down the locals. However, they each have a tragic flaw--Ace falls in love with a hustler, Ginger, and Nicky falls into an ever-deepening spiral of drugs and violence.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"R"},"episode_id":7139,"content_control":"FAMILY"}}