d":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10406,"title":"","description":"257","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller"],"id":10406,"type":"MOVIE","title":"Black Swan","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/f54bb2d7-1acd-41b5-9983-ab7ec5c21ac0.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/7c438303-e83b-47bf-b05f-cdaf5f45d4f0.jpg","likes":1081,"dislikes":58,"views":50884,"release_date":"1292544000000","length":6488,"description":"Nina (Portman) is a ballerina in a New York City ballet company whose life, like all those in her profession, is completely consumed with dance. She lives with her obsessive former ballerina mother Erica (Hershey) who exerts a suffocating control over her. When artistic director Thomas Leroy (Cassel) decides to replace prima ballerina Beth MacIntyre (Ryder) for the opening production of their new season, Swan Lake, Nina is his first choice. But Nina has competition: a new dancer, Lily (Kunis), who impresses Leroy as well. Swan Lake requires a dancer who can play both the White Swan with innocence and grace, and the Black Swan, who represents guile and sensuality. Nina fits the White Swan role perfectly but Lily is the personification of the Black Swan. As the two young dancers expand their rivalry into a twisted friendship, Nina begins to get more in touch with her dark side - a recklessness that threatens to destroy her.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"R"},"episode_id":10406,"content_control":"NORMAL"}}