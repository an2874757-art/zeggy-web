pe":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller"],"id":7668,"type":"MOVIE","title":"Octopussy","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/ae80145e-9b04-4499-8175-9df38ba74238.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/9c06c93a-b089-404b-a223-414a99751ce9.jpg","likes":20,"dislikes":1,"views":5331,"release_date":"424051200000","length":7849,"description":"James Bond's next mission sends him to the circus. A British agent was murdered and found holding onto a priceless Faberge egg. Kamal Kahn buys the egg at an auction, but Bond becomes suspicious when Kahn meets up with Russian General, Orlov. Bond soon finds out that Kahn's and Orlov's plan is to blow a nuclear device in an American Air Force Base. Bond teams up with a circus group, which are headed by the beautiful Octopussy, who is also close friend of Kahn. Will Bond be quick enough, before World War III begins?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"episode_id":7668,"background_color":"","content_control":"NORMAL"}}