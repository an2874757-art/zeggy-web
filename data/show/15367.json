/disk45/shows/9a341845-2217-4312-9681-334404794305.png"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":15367,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Documentary"],"id":15367,"type":"SERIES","title":"I am Jane Doe","logo":"","image":"https://cdn6.albox.co/storage/disk53/seasons/4d5d0857-d9a6-4f9b-9a65-ba7697224a22.jpg","background_image":"https://cdn6.albox.co/storage/disk53/seasons/e5e176a2-9e1e-4a9a-9b75-3c5c93a53d5a.jpg","likes":4,"dislikes":0,"views":2674,"release_date":"1486684800000","season_number":1,"description":"The epic battle that several American mothers are waging on behalf of their middle-school daughters, victims of sex trafficking on Backpage.com, the adult classifieds section that for years was part of the iconic Village Voice. Narrated by Academy Award-nominee Jessica Chastain and directed by award-winning filmmaker Mary Mazzio, the documentary follows the journey of these young girls and their mothers in real time as they run headlong into a collision course not only with Backpage but with judges, powerful corporations, special interest groups, and an outdated internet freedom law that has been interpreted by federal judges to protect websites from any responsibility for hosting ads which sell underage girls. I AM JANE DOE is a gut-wrenching human story and fresh look at a social and legal issue that affects every community in America.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-13"},"current_season_id":2647,"content_control":"NORMAL"}}