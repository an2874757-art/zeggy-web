 العمل وألم القلب، نمت هوانغ يي مي وفهمت ببطء المسار الذي تريد أن تسلكه في الحياة. قررت مواصلة تعليمها، وعادت إلى المدرسة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"R"},"background_color":"","current_season_id":19882,"content_control":"NORMAL"}}