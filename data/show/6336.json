rd_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","Horror"],"id":6336,"type":"MOVIE","title":"Absentia","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/67ec5917-1217-4ce2-839a-216596e016dd.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/2c25c338-4b83-446e-9a3f-6a96c8fa2bfa.jpg","likes":5,"dislikes":3,"views":2650,"release_date":"1365638400000","length":5471,"description":"Tricia's husband Daniel has been missing for seven years. Her younger sister Callie comes to live with her as the pressure mounts to finally declare him 'dead in absentia.' As Tricia sifts through the wreckage and tries to move on with her life, Callie finds herself drawn to an ominous tunnel near the house. As she begins to link it to other mysterious disappearances, it becomes clear that Daniel's presumed death might be anything but 'natural.' The ancient force at work in the tunnel might have set its sights on Callie and Tricia ... and Daniel might be suffering a fate far worse than death in its grasp.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"R"},"episode_id":6336,"content_control":"NORMAL"}}