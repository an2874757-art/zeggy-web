Poster"},{"data":[{"items":[],"id":20008,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi"],"id":20008,"type":"SERIES","title":"Mobile Suit Gundam: The Origin III - Dawn of Rebellion","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/0621fc97-194f-4e0d-b066-a9c704180160.jpg","background_image":"https://cdn6.albox.co/storage/disk46/seasons/fac98bdf-044a-4ed6-bfe8-3d10b12031ff.jpg","likes":12,"dislikes":0,"views":1903,"release_date":"1463788800000","season_number":1,"description":"Universal Century 0074. After leaving Texas Colony, Édouard Mass camouflages his identity and enrolls in the Autonomous Republic of Zeon's Space Defense Military Academy under the name of Char Aznable. He develops a friendship with his classmate Garma, a scion of the Zabi family. Gradually the two become admired by the other students. Then, in Universal Century 0077, the students at last rise up in arms and begin the fight for independence against the Earth Federation's security forces. This rebellion, however, also marks the beginning of Char's spectacular scenario of revenge... Now, the gears of history are turning!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"R"},"current_season_id":8842,"content_control":"NORMAL"}}