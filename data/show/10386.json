oster"},{"data":[{"items":[],"id":10386,"title":"","description":"34","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller"],"id":10386,"type":"MOVIE","title":"Casino Royale","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/42bac61f-32c4-4a28-97a7-607a555c64cb.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/e229efb6-06f2-445e-93e9-c64d05765fd4.jpg","likes":450,"dislikes":13,"views":43158,"release_date":"1163721600000","length":8673,"description":"James Bond goes on his first ever mission as a 00. Le Chiffre is a banker to the world's terrorists. He is participating in a poker game at Montenegro, where he must win back his money, in order to stay safe among the terrorist market. The boss of MI6, known simply as M sends Bond, along with Vesper Lynd to attend this game and prevent Le Chiffre from winning. Bond, using help from Felix Leiter, Mathis and having Vesper pose as his partner, enters the most important poker game in his already dangerous career. But if Bond defeats Le Chiffre, will he and Vesper Lynd remain safe?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"episode_id":10386,"content_control":"FAMILY"}}