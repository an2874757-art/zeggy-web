ng_progress":0},{"items":[],"id":6758,"title":"ليلة هنا وسرور","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk42/shows/e41d4352-59fc-4f67-96d7-64845a4c026e.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":30305,"title":"البعبع","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/4221a40d-1dea-47ba-9e0e-6983a162c2cc.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38509,"title":"سمبوسة چباتي","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/4cb6b8ab-ece8-4044-95f0-1e06f0eef2ad.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":34981,"title":"رمسيس باريس","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/b50c5994-3ba0-4fec-b8a3-ad179d002244.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7336,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":7336,"type":"MOVIE","title":"قهوة المواردي","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/755c786e-aa78-4954-8186-67b539a42a33.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/4fae24d3-e6fe-425e-af8b-d994b6d9d7bd.jpg","likes":3,"dislikes":1,"views":2090,"release_date":"0","length":7181,"description":"يخرج حسنين أبو سنة من السجن بعد ارتكابه جريمة قتل أحد سكان عمارته وتنتاب المخاوف أهل الحرى من عودته لسطوته وجبروته، يقنع أبو سنة بعض مستأجرته محلات عمارته بتركها مقابل مبلغ من المال ويحولها إلى محلات تجارية، مكاتب للإستيراد والتصدير. ينجح أبو سنة فى إقناع غباشة بتأجير شقته مفروشة للثرى العربى رضوان، يقوم الصحفى أحمد بتسجيل ما يطرأ على الحى من تغيير فى مقالات، لكن رئيس التحرير يرفض نشرها، يعجب سفروت بفراولة التى تصده، لذا يتمرد على العمل فى مقهى أبيها المواردى ويرحل عن الحى يتزوج المواردى من عشيقته رجاء بعد أن يتعرض للمشاكل مع أبو سنة. يضغط غباشة على وردة ابنة زوجته للزواج من رضوان فتهرب يوم الزفاف إلى الإسكندرية وأيضا فهى تعجب بجارها الطالب ممدوح لكنه لا يشعر بها. يعود سفروت إلى الحى وقد كون ثروة كبيرة يتفق أبو سنة وسفروت مع غباشة على قتل أحمد ليلة زواجه من فراولة. يطلق المواردى زوجته رجاء. يقوم شعبان صديق أحمد بتجميع مقالاته عن الحى ويصدرها فى كتاب وفاء لذكراه. وعندما يقرأ ممدوح ما كتبه أحمد عنه يدرك أخطاءه ويسافر إلى الإسكندرية ويعود ويتم زواجهما ببن فرحة أهل الحى. أبو سنة على أيدى أشخاص غير معروفين.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":7336,"background_color":"","content_control":"NORMAL"}}