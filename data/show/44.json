e_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":44,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Romance","History"],"id":44,"type":"MOVIE","title":"Legendary Courtesan Hwang Jin Yi","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk50/shows/31444d9d-1274-4b65-98f1-660e3b085a42.jpg","likes":26,"dislikes":4,"views":7481,"release_date":"1181088000000","length":8505,"description":"HWANG Jin-yi was one of the most legendary women in the 500-year reign of the Joseon Dynasty. Born into nobility, she made the startling choice to become a gisaeng at age 15. By 18, she was the object of desire of all men and the envy of all women. As both a poet and a courtesan, HWANG Jin-yi was a woman ahead of her time who embraced her work and life with gusto, and become a role model for women in the 21st century. Her only love, however, was a man nobody ever knew. The man she chose was compelled to abandon his identity and cross class lines. A revolutionary who dreamed of a new world, HWANG Jin-yi became a heroine for the people. In an age where one's fate was determined by birth, her commitment to her love never wavered","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"PG-13"},"episode_id":44,"content_control":"NORMAL"}}