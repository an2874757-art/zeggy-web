لق لهزيمة الشياطين. يبدأ البشر الذين تعثروا في عالم الآلهة وإله الخصوبة المبتدئ حياتهم المشتركة المليئة بقشور الأرز معًا.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"background_color":"","current_season_id":18899,"content_control":"NORMAL"}}