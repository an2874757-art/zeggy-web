title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5150,"title":"","description":"35","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Comedy","Animation","Family"],"id":5150,"type":"MOVIE","title":"The Boxtrolls","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/f3220f1c-3c57-4fbd-8416-64ba3c211497.jpg","background_image":"https://cdn6.albox.co/storage/disk41/shows/44fdf485-1d53-412c-8e4a-64d991f92a15.jpg","likes":640,"dislikes":12,"views":33529,"release_date":"1411689600000","length":5770,"description":"THE BOXTROLLS are a community of quirky, mischievous creatures who have lovingly raised an orphaned human boy named Eggs in the amazing cavernous home they've built beneath the streets of a city called Cheesebridge. The story is about a young orphaned boy raised by underground cave-dwelling trash collectors who tries to save his friends from an evil exterminator, the town's villain, Archibald Snatcher. When Snatcher comes up with a plot to get rid of the Boxtrolls. Eggs decides to venture above ground and \"into the light,\" where he meets and teams up with fabulously feisty Winnie. Together, they devise a daring plan to save The BoxTrolls family. The film is based upon the children's novel 'Here Be Monsters' by Alan Snow.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG"},"episode_id":5150,"background_color":"","content_control":"FAMILY"}}