ion_type":"comments"}],"post_info":{"genres":["Fantasy","Comedy","Family"],"id":13449,"type":"MOVIE","title":"Mr. Popper's Penguins","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/0de3c83f-82c5-4f0f-9eb7-50f54e6a609d.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/8d60188b-5a6f-40b3-b26f-6e18ab1a5603.jpg","likes":109,"dislikes":3,"views":7307,"release_date":"1308268800000","length":5661,"description":"Tom Popper grew up having very little interaction with his father who was off exploring the world. When he grows up he spends most of time on his work and ignores his children. One day his father sends him an unusual gift: a penguin. Popper can't help but wonder why his father would send him a penguin. He tries to get rid of it, but accidentally orders five more. When his children and ex-wife show up to celebrate his son's birthday, the kids are taken with the penguins. And Popper finally gets to connect with his kids while his work suffers.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-13"},"episode_id":13449,"background_color":"","content_control":"FAMILY"}}