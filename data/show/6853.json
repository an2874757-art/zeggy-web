tion_type":"normalPoster"},{"data":[{"items":[],"id":6853,"title":"","description":"29","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Thriller","Horror"],"id":6853,"type":"MOVIE","title":"Ghost Rider","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/5f3d0261-bcfd-485d-bfa9-b590ed99061a.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/e11b54ec-34ab-4d83-a8f1-02246c57a4a0.jpg","likes":464,"dislikes":7,"views":37052,"release_date":"1171584000000","length":7405,"description":"When the motorcyclist Johnny Blaze finds that his father Barton Blaze has a terminal cancer, he accepts a pact with the Mephistopheles, giving his soul for the health of his beloved father. But the devil deceives him, and Barton dies in a motorcycle accident during an exhibition. Johnny leaves the carnival, his town, his friends and his girlfriend Roxanne. Years later Johnny Blaze becomes a famous motorcyclist, who risks his life in his shows, and he meets Roxanne again, now a TV reporter. However, Mephistopheles proposes Johnny to release his contract if he become the \"Ghost Rider\" and defeat his evil son Blackheart, who wants to possess one thousand evil souls and transform hell on earth.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.2}],"value":5.2,"age":"PG-13"},"episode_id":6853,"content_control":"NORMAL"}}