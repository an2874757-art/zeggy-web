n":"119","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Animation"],"id":21121,"type":"SERIES","title":"Snow White with the Red Hair","logo":"","image":"https://cdn6.albox.co/storage/disk50/seasons/71a8429c-c176-43c7-a6b7-0644e543ff35.jpg","background_image":"https://cdn6.albox.co/storage/disk42/seasons/ce103b54-e8a0-4b0a-8292-031e768f5600.jpg","likes":769,"dislikes":11,"views":70089,"release_date":"1435708800000","season_number":1,"description":"Shirayuki was a young girl born with unique apple-red hair. She meets a famous but foolish Prince Raji, who falls in love with her at first sight and orders her to become his concubine. With nowhere else to go, Shirayuki cuts her hair and escapes to a neighboring country. While traversing through the forests, she meets a young boy, Zen, who helps her after she boldly cures his wounds but then gets poisoned by an apple given to Shirayuki. Meanwhile, Prince Raji sends out henchmen to search for her. What will happen to Shirayuki? What is Zen's true character? A fantasy story between an optimistic heroine and a prince who constantly stays on her watch.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"pg-13"},"current_season_id":10383,"content_control":"NORMAL"}}