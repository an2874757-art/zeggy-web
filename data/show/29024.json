1e15a6da8e9.png","image":"https://cloud01.albox.co/seasons/10cc77f4-644d-4947-ae5d-cf3bd5e71723.jpg","background_image":"https://cloud01.albox.co/seasons/8a524de7-220c-4092-83eb-474f594b63e0.jpeg","likes":528,"dislikes":30,"views":289638,"release_date":"1679529600000","season_number":1,"description":"ملحمة درامية تُشعل النار من رحم الظلم والظلام، وذلك حيث قصة عبدو العربجي، الذي يعمل على نقل البضائع على الطنبر؛ لإعالة عائلته.\r\nلكنّ ظلم أبو حمزة النشواتي له يُدخله في صراعات معه ومع ابنه حمزة. وبين حقد بدور، وانتقام دريّة خانوم - زوجة شقيق أبو حمزة- كيف سيُواجه عبدو المكائد؟ وهل سيبقى للحبّ من مكان في ظلّ كلّ هذه الحروب؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"#d7c0ad","current_season_id":16285,"content_control":"NORMAL"}}