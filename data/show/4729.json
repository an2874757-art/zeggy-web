ion_type":"normalPoster"},{"data":[{"items":[],"id":4729,"title":"","description":"20","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy","Family"],"id":4729,"type":"MOVIE","title":"Geek Charming","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/c4ca5bbe-a22c-4773-ba7d-c273c05da274.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/6eec86b0-c367-4aa0-b4a7-fac4394bdbf2.jpg","likes":76,"dislikes":4,"views":7817,"release_date":"0","length":5867,"description":"Dylan Shoenfield is the pink princess of the upscale Woodlands Academy. She has the coolest boyfriend, the most popular friends, and a brand-new it bag that everyone covets, but when she accidentally tosses her Serge Sanchez bag into a fountain, this princess comes face-to-face with her own personal frog - self-professed film geek Josh Rosen. In return for rescuing Dylan's bag, Josh convinces Dylan to let him film her for his documentary on high school popularity. Reluctantly, Dylan lets F-list Josh into her A-list world, and is shocked to realize that sometimes nerds can be pretty cool. But when Dylan's so-called prince charming of a boyfriend dumps her flat, her life and her social status comes to a crashing halt. Can Dylan win the Woodlands Academy Spring Formal Blossom Queen crown? Can Josh win the Woodlands Academy 5th Annual Film Festival? Can Dylan, with Josh's help, pull the pieces together to create her own happily-ever-after?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":4729,"background_color":"","content_control":"FAMILY"}}