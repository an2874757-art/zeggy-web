_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime","Mystery"],"id":14125,"type":"SERIES","title":"The Blacklist","logo":"https://cdn7.albox.co/storage/CLOUD00/shows/301a8450-df73-42ac-bda5-cc0e0f8fa7ab.png","image":"https://cdn6.albox.co/storage/disk50/seasons/792b1d7e-cd14-4316-a881-608d2d5443f0.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/a29b8be6-2733-450c-b572-d48902507024.jpg","likes":2219,"dislikes":61,"views":577863,"release_date":"1379894400000","season_number":1,"description":"تدور أحداث المسلسل حول العميل الحكومي السابق رايموند ريدينجتون (جيمس سبادر) الشهير بـ\"ريد\" الذي استطاع أن يهرب طويلًا من أيدي السلطات التي ترغب في القبض عليه. يقوم ريد فجأة بتسليم نفسه إلى المباحث الفيدرالية، ويعرض عليهم أن يساعدهم في القبض على أحد الإرهابيين بشرط أن يتحدث فقط إلى إليزابيث كين (ميجان بون)، وهي محللة جرائم شابة في المباحث الفيدرالية وقد أنهت للتوّ تدريبها في قاعدة كوانتيكو.\n\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"background_color":"","current_season_id":821,"content_control":"FAMILY"}}