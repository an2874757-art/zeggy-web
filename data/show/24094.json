,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Drama"," Comedy"],"id":24094,"type":"SERIES","title":"Once We Get Married ","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/ea209ada-b0d6-46b6-9e66-f73cb8ca78c8.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/24762f3a-468b-4af2-acc9-ac85ac253013.jpg","likes":82,"dislikes":0,"views":6141,"release_date":"1633651200000","season_number":1,"description":"Gu Xi Xi هي متسوق أزياء ، وتدير متجرًا صغيرًا عبر الإنترنت من المنزل ، وتشتري فساتين زفاف أنيقة من Alex لعملائها. خلال حفل استقبال خاص ، تعرفت على يين سي تشين ، الرئيس ذو البطن الأسود الذي جاء لمناقشة التعاون التجاري مع أليكس. تحدث حادثة تؤدي بهم إلى الحفاظ مؤقتًا على علاقة زواج تعاوني تعاقدية من أجل وضع مربح للجانبين يتعلق بإليكس. يجد الاثنان مع شخصيات متناقضة الحب تدريجياً في هذا الزواج التعاقدي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"R"},"background_color":"","current_season_id":12511,"content_control":"NORMAL"}}