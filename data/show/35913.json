:"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Fantasy"," Adventure"," Slice of Life"],"id":35913,"type":"SERIES","title":"Tanoshii Muumin Ikka","logo":"","image":"https://cloud02.albox.co/seasons/27488828-d66c-4c3b-b01d-6850411cfd2c.jpg","background_image":"https://cloud02.albox.co/seasons/cd2982ca-feb0-43a8-a38e-2f77688f7dc7.jpg","likes":39,"dislikes":1,"views":2661,"release_date":"639878400000","season_number":1,"description":"لقد وصل الربيع أخيرًا إلى وادي مومين، مما أفسح المجال لمغامرة رائعة أخرى لمومين ترول وبقية سكانه. مع عودة سنوفكين إلى المنزل من هجرته الشتوية، بدأ سكان الوادي أخيرًا في النهوض من سباتهم. بعد العثور على قبعة غامضة، لم يتمكن المومين من التخلص منها بسبب جودتها العالية، وبدلاً من ذلك يأملون في العثور على صاحبها في النهاية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"G"},"background_color":"","current_season_id":20529,"content_control":"NORMAL"}}