gress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9405,"title":"","description":"25","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Mystery"],"id":9405,"type":"MOVIE","title":"The Village","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/1f12b7ec-8807-431d-b11e-ec79dabdd385.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/ea9d27e1-5868-4db7-a1fb-7ef0e40260ce.jpg","likes":107,"dislikes":10,"views":12402,"release_date":"1091145600000","length":6468,"description":"M Night Shyamalan's The Villiage revolves around a desolate town in Pennsylvania. The residents of this town live simply and without the means of a modern world - no tv, modern medications. They live by strict rules - They are not to leave the village or the monsters beyond their boundaries will surely attack them. Lucius and Ivy have an attraction - a strong one. But when Noah - a man with an intellectual disability and whom also has feelings for Ivy, finds out that the two are In love, Noah attacks Lucius. He will die if brave Ivy (who is blind) does not breach the borders and find help to save Lucius.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":9405,"content_control":"NORMAL"}}