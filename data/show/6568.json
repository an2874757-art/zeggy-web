https://cloud02.albox.co/shows/0f97c112-24d5-48f8-8a91-ee2cd16aa8ec.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6568,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Drama"],"id":6568,"type":"MOVIE","title":"Zatoichi Meets Yojimbo","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/ac8f3ffa-96ed-41e3-882f-ffb19bfa71a1.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/d3bc1961-8d66-403a-8772-fdd89d9c63d4.jpg","likes":19,"dislikes":0,"views":1691,"release_date":"1209600000","length":6964,"description":"With a price on his head, Ichi seeks tranquillity in a favorite village. Since his last visit, it has fallen prey to Boss Masagoro, the son of a merchant rumored to have stolen gold from the shogunate. The boss has hired Yojimbo as his hard-drinking enforcer, but Yojimbo is both a spy for the shogunate, trying to find the gold, and in love with the merchant's unwilling mistress, Umeno. Ichi hires on as the merchant's masseur and buys Umeno's freedom with his employer's own money. This embarrasses Yojimbo who withdraws from a pact with Ichi to stir up trouble between father and son and their gangs. As the two sides fight, Ichi finds the gold and sets up a final set of confrontations.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"PG-13"},"episode_id":6568,"content_control":"NORMAL"}}