enres":["Drama"],"id":4366,"type":"MOVIE","title":"Ode to My Father","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/962ed542-93e3-4b29-90c5-63078813e91e.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/a01bb0d8-969d-46ca-9333-d10f1461201c.jpg","likes":45,"dislikes":1,"views":3519,"release_date":"1418774400000","length":7584,"description":"Amid the chaos of refugees fleeing the Korean War in December 1950, a young boy, Duk-soo, sees his fate change in the blink of an eye when he loses track of his younger sister and he leaves his father behind to find her. Settling in Busan, Duk-soo devotes himself to his remaining family, working all manner of odd jobs to support them in place of his father. His dedication leads him first to the deadly coal mines of Germany, where he meets his first love, Youngja, and then to war-torn Vietnam in this generational epic about one man's personal sacrifices.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"episode_id":4366,"content_control":"NORMAL"}}