ms":[],"id":38001,"title":"A Hundred Memories ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/42a0dec0-cb3c-42d5-bf3f-2e688f70ddb9.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":16949,"title":"Vagabond","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk45/shows/5b5edee0-3b3e-49fe-add1-c857d51fe432.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35506,"title":"","description":"42","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Drama"],"id":35506,"type":"SERIES","title":"Motel California ","logo":"","image":"https://cloud02.albox.co/seasons/58e1b3bb-902e-4497-ae0b-75f5e8ab1a82.jpg","background_image":"https://cloud02.albox.co/seasons/86b6a087-aadf-418f-82a6-edbc429309b5.jpg","likes":212,"dislikes":10,"views":27710,"release_date":"1736467200000","season_number":1,"description":"نشأت جي جانج هوي في موتيل كاليفورنيا لأن والدها كان يدير الموتيل في قريتها الريفية. كما جاءت والدتها من خلفية مختلطة الأعراق. وبسبب الخلفية العائلية غير العادية لجانج هوي، كانت هدفًا للهمسات والقيل والقال من قبل السكان المحليين. حملت جانج هوي جرحًا عميقًا في قلبها منذ ذلك الوقت. لقد أحبت صديقة طفولتها تشيون يون سو، التي كانت حبها الأول. عندما بلغت العشرين من عمرها، غادرت مسقط رأسها وانتقلت إلى سيول. بعد 12 عامًا، تعمل كمصممة داخلية وتصل إلى ذروة حياتها المهنية، ولكن لسبب ما، قررت العودة إلى مسقط رأسها. تلتقي مجددًا بحبها الأول، تشيون يون سو.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"background_color":"","current_season_id":20196,"content_control":"NORMAL"}}