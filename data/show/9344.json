"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9344,"title":"","description":"16","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Crime"],"id":9344,"type":"MOVIE","title":"Transporter 2","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/ce2f4f74-7e3e-44a0-b0b9-1a8bb87eab39.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/81db3445-3e71-4bac-810c-e33fa13163ae.jpg","likes":323,"dislikes":8,"views":41678,"release_date":"1125619200000","length":5258,"description":"Frank Martin is the best in the business. The ex-Special Forces operative hires himself out as a mercenary \"transporter\" who moves goods--human or otherwise. Very simple, he delivers, no questions asked. Frank has relocated from the French Mediterranean to Miami, Florida, where as a favor to a friend, Frank is driving for the wealthy Billings family. There's very little that can surprise The Transporter, but young Jack Billings has done just that; Frank has unexpectedly bonded with Jack, age 6, who he drives to and from school. But when Jack is kidnapped, Frank must use his battle-tested combat skills to retrieve the boy and thwart the kidnappers' master plan to release a virus that will kill anyone with whom it comes in contact.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":9344,"content_control":"FAMILY"}}