continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"," Drama"," Comedy"],"id":23885,"type":"SERIES","title":"Dali and the Cocky Prince ","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/32d212f1-2c09-4260-acdc-e6a9363c1139.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/70541cb2-fbf7-4b59-8275-74bf8c30dc7e.jpg","likes":312,"dislikes":3,"views":17147,"release_date":"1632268800000","season_number":1,"description":"كصبي صغير ، نشأ Moo Hak في السوق كبائع متجول. على الرغم من جهله ، إلا أنه قوي الإرادة ويعرف كيف يكسب المال. وهو الآن المدير الإداري لسلسلة مطاعم Dondon F and B العالمية التي بدأتها عائلته كمطعم صغير للـ Gamjatang. ومع ذلك ، فهو غير محترم ويهتم فقط بالمال. يلتقي دا لي ، الابنة الوحيدة والطفل لعائلة من الطبقة العليا التي تدير معرضًا فنيًا. لديها معرفة عميقة بالأشياء. تتعرض للإفلاس بسبب وفاة والدها المفاجئة وتبدأ حياة صعبة. يبدأ Moo Hak و Da Li علاقة كمدين ومدين عبر معرض الفنون. هل سيتفهم هذان القطبان المتضادان بعضهما البعض ويقعان في الحب؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.5}],"value":8.5,"age":"R"},"background_color":"","current_season_id":12344,"content_control":"NORMAL"}}