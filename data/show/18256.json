image":"https://cdn6.albox.co/storage/disk49/seasons/a5e073a5-1479-4741-a9e3-20f1ee797f72.jpg","background_image":"https://cdn6.albox.co/storage/disk56/seasons/cae24095-75dc-4828-9f22-1f91a06ce0fd.jpg","likes":30,"dislikes":1,"views":6024,"release_date":"-2208988800000","season_number":1,"description":"أرزو فتاه بسيطه ومرحه تحب أمها كثيرا وتعيش مع امها وجدتها واخواتها بلكناو ولديهم مصنع صغير للغزل وتكره والدها كثيراً لأنه ترك أمها وتزوج بأخري ومن هنا تعلمت كيف تكون مسئوله عن عائلتها ثم تذهب إلى مومباي لتعمل مصممه هناك وتعيش بمنزل صاحبه والدتها ألفيرا ويشاء القدر أن تقابل هناك بطل قصتها ساهر عظيم شودري وتعيش معه تحت سقف واحد وهو شخص متكبر ومغرور وقاسي ويكره أرزو كثيراً ولديه سر بحياته يجعله بارد المشاعر والحب بالنسبه له الأسم الأخر للألم ومجرد كذبه ، ولكن عندما يري مهاره أرزو بالعمل بشركته كمصممه سيبدء بالأعجاب بها ولكن هل ساهر سيؤمن بالحب مره أخري؟ وهل ستحبه أرزو أم تكره  لسوء معاملته معها؟ وماذا ستفعل أرزو عندما تعلم ان ساهر هو الذى أحرق مصنع امها؟ هل ستسامحه؟ أم ستكره؟ وما هو السر","rating":{"sources":[],"value":0,"age":"N/A"},"current_season_id":6514,"content_control":"NORMAL"}}