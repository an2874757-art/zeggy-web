":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"N/A"},"current_season_id":8269,"content_control":"NORMAL"}}