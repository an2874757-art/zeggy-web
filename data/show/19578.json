itle":"بنات البومب","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/aa77785d-3f74-4327-a34a-6e8d90ac7e89.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":22201,"title":"النمر","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/f6245e58-b575-45d3-8b8e-1fb62f958e2d.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":18628,"title":"ابو العروسة","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk45/shows/9ba489a0-a891-4fcc-b2c7-8d131edb2c62.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19578,"title":"","description":"24","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":19578,"type":"SERIES","title":"أحلام كبيرة","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/51a94f17-133f-4f6c-a533-cc225593b981.JPG","background_image":"https://cdn6.albox.co/storage/disk54/seasons/1e069135-1771-453c-a8bb-ab9e1512bdea.jpg","likes":287,"dislikes":8,"views":37144,"release_date":"1072915200000","season_number":1,"description":"يروي المسلسل قصة عائلة الحلبي المكونة من أبو عمر (بسام كوسا) وأم عمر (سمر سامي) وأولادهم : عمر (باسل خياط) ، حسن (رامي حنا) ، سامي (قصي الخولي) ، رشيد (مكسيم خليل) ، يعمل الأب في التجارة مع أخيه أبو شريف (حسن عويتي) والذي كتب والده كل الأملاك باسمه مما يؤدي لحدوث مشاكل بين الأخوين تنتهي بإصابة سالم (أبو عمر) بجلطة دماغية تقعده عن العمل مما يدفع عمر الابن الأكبر المتفوق دراسياً للتخلي عن طموحه بالسفر إلى الولايات المتحدة - لدراسة الفيزياء الحديثة - ليدرس الحقوق ،ويعمل بالتجارة مع أبو وفيق (صبحي الرفاعي) صديق أبو عمر ليعيل عائلته ثم يفتح مكتباً للمحاماة ويتعرف على الصحفية وفاء (نورمان أسعد) التي يقع في حبها و يتزوجها رغم أنها مصابة بقصور في القلب مما يمنعها من الإنجاب، أما حسن الابن الثاني فهو شاب ثري جمع ثروته بطرق غير مشروعة يملك شركة سياحية ،يوقعه طموحه في عدة مشاكل مع أصحاب الشركات السياحية. سامي الابن الثالث ممثل ومثقف يتزوج سلمى (نادين تحسين بك) التي عادت من الولايات المتحدة خصيصاً لكي تتزوج سامي الذي وعدها بالزواج - عندما بقيت عندهم حين مات والديها وهي صغيرة لعدة أشهر حتى أخذها عمها إلى أمريكا - ولكن شك سامي وغيرة زميلته أدى إلى حدوث مشاكل عديدة بينهما تنتهي بالطلاق ،رشيد الابن الأصغر يدرس في الجامعة و يعمل في شركة حسن السياحية ويحب زميلته هيفاء (نسرين طافش).","rating":{"sources":[],"value":0,"age":"PG-13"},"background_color":"","current_season_id":8242,"content_control":"NORMAL"}}