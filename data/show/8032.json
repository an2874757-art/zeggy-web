on_type":"normalPoster"},{"data":[{"items":[],"id":8032,"title":"","description":"41","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":8032,"type":"MOVIE","title":"Training Day","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/5d90b6d3-10ec-4a83-8c16-9795541f60f6.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/191685a7-d41a-4958-8dc3-c40e00a95a57.jpg","likes":380,"dislikes":8,"views":26171,"release_date":"1002240000000","length":7322,"description":"In Los Angeles, a city where streets are overrun by drug dealers, those who have sworn to uphold the law are breaking them to clean up the streets. Denzel Washington plays L.A.P.D. detective Alonzo Harris, a veteran narcotics officer whose methods of enforcing the law are questionable, if not corrupt. 'Training Day' follows Harris as he trains rookie Jake Hoyt over a 24-hour period. Ethical dilemmas arise for Hoyt as well as the audience as questions present themselves as to whether or not Harris' methodology for ridding the streets of South Central Los Angeles of drugs is right or wrong.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"episode_id":8032,"content_control":"FAMILY"}}