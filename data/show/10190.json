rogress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10190,"title":"","description":"31","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi"],"id":10190,"type":"MOVIE","title":"The Hunger Games: Mockingjay - Part 2","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/23578df6-280b-4bee-9c21-1144676fe7bf.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/49ec88b2-a99a-4ad4-b48a-843b8194e2eb.jpg","likes":363,"dislikes":4,"views":36785,"release_date":"1447977600000","length":8217,"description":"After young Katniss Everdeen agrees to be the symbol of rebellion, the Mockingjay, she tries to return Peeta to his normal state, tries to get to the Capitol, and tries to deal with the battles coming her way...but all for her main goal: assassinating President Snow and returning peace to the Districts of Panem. As her squad starts to get smaller and smaller, will she make it to the Capitol? Will she get revenge on Snow or will her target change? Will she be with her \"Star-Crossed Lover,\" Peeta, or her long-time friend, Gale? Deaths, bombs, bow and arrows, a love triangle, hope... What will happen?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":10190,"content_control":"FAMILY"}}