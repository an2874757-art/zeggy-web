ien: Earth","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/b8d02f50-6f21-4a7d-bcdf-20d89d5697c4.JPG"},"length":0,"continue_watching_progress":0},{"items":[],"id":22003,"title":"Invincible","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/9edb1c1b-0f99-41bd-98a3-a2c5fb9e7d75.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17462,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Drama"],"id":17462,"type":"SERIES","title":"Legion","logo":"","image":"https://cdn6.albox.co/storage/disk44/seasons/ad253a19-d7ce-4d43-9dda-e0e5659ec262.jpg","background_image":"https://cdn6.albox.co/storage/disk55/seasons/b09c89e1-a9f1-4aa1-8ac0-310a3f4ed7fe.jpeg","likes":300,"dislikes":12,"views":50061,"release_date":"1486512000000","season_number":1,"description":"Legion, based on the Marvel Comics by Chris Claremont and Bill Sienkiewicz, is the story of Scott Young (Dan Stevens), a troubled young man who may be more than human. Diagnosed as schizophrenic as a child, Scott has been in and out of psychiatric hospitals for years. Now in his early 20's and free once again, Scott loses himself in the rhythm of the structured regimen of life in the daily life: breakfast, lunch, dinner, therapy, medications, sleep. David spends the rest of his time in companionable silence alongside his chatterbox friend Shannon (Aubrey Plaza), a fellow patient whose life-long and alcohol addiction has done nothing to quell her boundless optimism that her luck is about to change. The pleasant numbness of David's routine is completely upended with the arrival of a beautiful and troubled new patient named Syd (Rachel Keller). Inexplicably drawn to one another, David and Syd share a startling encounter, after which David must confront the shocking possibility that the voices he hears and the visions he sees may actually be real.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"current_season_id":5514,"content_control":"FAMILY"}}