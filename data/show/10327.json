UD00/shows/d845b5e9-7eac-474b-9859-ed632a67ca72.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10327,"title":"","description":"25","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Drama","Romance"],"id":10327,"type":"MOVIE","title":"Beastly","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/6bfa86fc-a489-4d50-8f32-f39ee35501ea.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/677b2d4e-a5a8-4441-aad8-e93362c26674.jpg","likes":350,"dislikes":9,"views":25733,"release_date":"1299196800000","length":5169,"description":"At the Buckeston Academy High School, the wealthy, arrogant, narcissistic, and bigoted Kyle Kingson is a student who does not respect his classmates. When Kyle is elected representative of the students, he plays a prank on the outcast Kendra, who has a reputation as a witch: he invites her to a party and humiliates her in front of their classmates. However, Kendra curses him with a spell that makes Kyle as ugly as his soul. Further, she tells him that if he does not find anyone who loves him within a year, he will be doomed to that appearance forever. When Kyle's father, Rob Kingson, sees him, he takes Kyle to specialists but the doctors do not know what to do, so Rob hides Kyle in an apartment with a maid and a blind tutor. When Kyle sees his mate Lindy on the streets, he saves her from a dangerous drug dealer and he brings her to his apartment to protect her. Now his only hope is that Lindy will fall in love with him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"PG-13"},"episode_id":10327,"content_control":"FAMILY"}}