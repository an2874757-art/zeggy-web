a":[{"items":[],"id":8043,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Thriller","Horror"],"id":8043,"type":"MOVIE","title":"The Descent: Part 2","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/5a802635-1b8a-49e5-87f1-4f4fecfa5536.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/c551124e-6a14-4784-a0e3-eea2e47ce4ed.jpg","likes":120,"dislikes":5,"views":12583,"release_date":"1259712000000","length":5633,"description":"Distraught, confused, and half-wild with fear, Sarah Carter emerges alone from the Appalachian cave system where she encountered unspeakable terrors. Unable to plausibly explain to the authorities what happened - or why she's covered in her friends' blood - Sarah is forced back to the subterranean depths to help locate her five missing companions. As the rescue party drives deeper into uncharted caverns, nightmarish visions of the recent past begin to haunt Sarah and she starts to realize the full horror and futility of the mission. Subjected to the suspicion and mistrust of the group and confronted once more by the inbred, feral and savagely ruthless Crawlers, Sarah must draw on all her inner reserves of strength and courage in a desperate final struggle for deliverance and redemption.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"R"},"episode_id":8043,"content_control":"NORMAL"}}