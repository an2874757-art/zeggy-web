progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18955,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Tragedy"],"id":18955,"type":"SERIES","title":"Best Arrangement","logo":"","image":"https://cdn6.albox.co/storage/disk56/seasons/e72b7e26-e41c-4b76-98e5-0feb47882c57.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/7f12f068-573d-4ed3-92a8-a7be8ad8e089.jpg","likes":4,"dislikes":0,"views":2044,"release_date":"1511568000000","season_number":1,"description":"Summer 2011: Zhao Zi Hui is in a passionate relationship with her boss Yan Ruo Qiu. Suddenly, her grandma who’s living in Dongbei falls ill and comes to Shanghai to get hospitalized. At the same time, Yan Ruo Qiu’s ex-wife comes back because she wants to have her former husband back. During these tumultuous times, Zi Hui meets Xu Tian in the hospital who suggests her to join hands and open a restaurant together. At first, Zi Hui takes it as a joke, but she slowly starts to see his seriousness and braveness and ends up really opening a restaurant with him. Not only do these two work close together from now on, but their hearts slowly get closer as well. (Source: CdramaBase)","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"current_season_id":7401,"content_control":"NORMAL"}}