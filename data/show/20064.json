":13984,"title":"Attack on Titan","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/e126e97c-eb65-4ae3-a4b9-96add264c3be.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":21439,"title":"Death Note","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/877f57f4-6cca-4ed6-8626-d4171e15fbbb.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":39483,"title":"Uruwashi no Yoi no Tsuki","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/ea151de5-60eb-4951-8e3c-0415ba73509c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15008,"title":"Quanzhi Fashi","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk43/shows/c325a2ae-a5a5-40dd-a655-93dc44aeb7c8.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":20064,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Animation"],"id":20064,"type":"SERIES","title":"Space Brothers","logo":"","image":"https://cdn6.albox.co/storage/disk46/seasons/c4f93179-b54d-4cc4-b6c4-fc0303a62d59.jpg","background_image":"https://cdn6.albox.co/storage/disk52/seasons/22aa4eeb-7e26-4b2b-aff2-6a060074bff1.jpg","likes":9,"dislikes":0,"views":1289,"release_date":"1401580800000","season_number":1,"description":"On a fateful summer night in 2006, Mutta Nanba and his younger brother Hibito witness what they believe to be a UFO flying toward the Moon. This impressing and unusual phenomenon leads both siblings vowing to become astronauts, with Hibito aiming for the Moon and Mutta, convinced that the eldest brother has to be one step ahead, for Mars.\r\n\r\nNow an adult, life hasn't turned out how Mutta had pictured it: he is diligently working in an automotive company, whereas Hibito is on his way to be the very first Japanese man to step on the Moon. However, after losing his job, Mutta is presented with an unexpected opportunity to catch up to his younger brother when the Japanese Aerospace Exploration Agency, commonly known as JAXA, accepts his application to participate in the next astronaut selection. Despite self-doubts about his prospects, Mutta is unwilling to waste this chance of a lifetime, and thus embarks on an ambitious journey to fulfill the promise made 19 years ago.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"current_season_id":8919,"content_control":"NORMAL"}}