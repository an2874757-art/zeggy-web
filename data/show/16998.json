n":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/ced7cd96-3ff5-4029-af5a-3eea2b865382.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":26627,"title":"Kung Fu Panda: The Dragon Knight","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/415e4540-cb15-4cd9-9f3e-1d933bb1302c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":29773,"title":"My Adventures with Superman","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/e8c78fef-86fb-4b46-8b5a-bcf8b9b9c2f4.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16998,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":16998,"type":"SERIES","title":"me and sister","logo":"","image":"https://cdn6.albox.co/storage/disk50/seasons/facee743-4175-4e94-986d-5d1c5bbdf550.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/b57f9532-a9b0-428c-8a21-44cbb20650c2.jpg","likes":67,"dislikes":2,"views":5789,"release_date":"695001600000","season_number":1,"description":"القصة هي عن فرح، فتاة تدرس في الصف الرابع، سافر والداها إلى الهند فتأتي ابنة خالتها لتعيش معها، وفي ذات اليوم الذي يسافر فيه والداها، تظهر فتاة صغيرة في المنزل قادمة من كوكب آخر، وعلمت فيما بعد أن اسمها مروة، من خلال اتصال والدة الطفلة عن طريق جهاز خاص كان معها عندما ظهرت.\r\n\r\nفي أول الأمر كانت فرح خائفة جدا منها ،ولكن مع مرور الوقت تعلقت بها و أصبحت تخاف عليها كأنها أختها، مع العلم أن نجوى في الأول كانت تكرهها متحججة بأنها تسبب لها الصداع ولكن مع الوقت أحبتها وأحنت عليها، وتبدأ بعد ذلك أحداث طريفة لإخفاء الطفلة ريثما يصل والداها، إلى أن يعرف الجميع -في النهاية- بأمرها، فيخترع أحد علماء الأرض مركبة فضائية توصل الطفلة بأمان إلى كوكبها، لكن فرح المسكينة وجميع الاصدقاء وحتى نجوى ولؤي حزنو كثيرا على فراق الصغيرة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"current_season_id":4938,"content_control":"NORMAL"}}