_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Drama","History"],"id":8914,"type":"MOVIE","title":"The Way Back","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/a76f722b-afd8-4588-9eb9-e48fd1a1e46e.jpg","background_image":"","likes":202,"dislikes":6,"views":20936,"release_date":"1295568000000","length":7992,"description":"In 1941, three men attempt to flee communist Russia, escaping a Siberian gulag. The film tells their story and that of four others who escaped with them and a teenage girl who joins them in flight. The group's natural leader is Janusz, a Pole condemned by accusations secured by torturing his wife, spent much of his youth outdoors, and knows how to live in the wild. They escape under cover of a snowstorm: a cynical American, a Russian thug, a comedic accountant, a pastry chef who draws, a priest, and a Pole with night blindness. They face freezing nights, lack of food and water, mosquitoes, an endless desert, the Himalayas, as well as many moral and ethical dilemmas throughout the journey towards freedom.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG-13"},"episode_id":8914,"content_control":"NORMAL"}}