}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":1967,"title":"","description":"15","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Music"],"id":1967,"type":"MOVIE","title":"Honey","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/4d01dddb-f840-4ebc-9407-304fa1212a5b.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/6b631c7f-66f5-4564-9823-52f6424a9b48.jpg","likes":128,"dislikes":8,"views":9209,"release_date":"1070582400000","length":5636,"description":"Honey Daniels is a 22-year-old, sexy, tough-minded, part-black, part-Latina hip-hop dancer in New York's East Harlem who dreams of making it big as a music video choreographer. She teaches hip-hop dancing at a local youth center and encourages the local kids to attend to keep them off the streets and out of trouble. When luck shines on Honey in the form of a famous music video director, named Michael, who casts her in one music video, she's encouraged to make the transition from dancer to choreographer. But Honey's sudden success comes with a price when Michael refuses to take \"no\" for an answer to his sexual advances and then tries to sabotage her career by blackballing her out of the business.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"episode_id":1967,"content_control":"FAMILY"}}