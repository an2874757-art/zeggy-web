ps://cdn7.albox.co/storage/CLOUD00/shows/36ff823f-a1cb-420b-ba67-6a79efa76b02.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/shows/8b444bcd-46c0-49c6-b1f6-714eed1da351.jpg","likes":170,"dislikes":4,"views":7692,"release_date":"792720000000","length":6711,"description":"ذهب المأمور للتحقيق في وفاة أحد السكان العجائز في مزرعةٍ ريفيةٍ، هناك يعثر على مراهقٍ صغيرٍ يعيش وحيدًا في القبو.\nنتعرف عندها على الفتى الأمهق جيريمي ريد الملقب بباودر وذلك لبشرته البيضاءاء الساطعة.صاحب ذكاءً وقدراتٍ خارقة بعد إصابة أمه بصاعقةٍ كهربائية وهي حاملًا، تموت الأم ويتخلى عنه الأب ليربيه أجداده في مزرعتهم.يتم إرساله إلى ملجأٍ للأولاد، ولكنه يجد صعوبة في التكيف مع العالم الخارجي.\n\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"episode_id":425267,"background_color":"#23136b","content_control":"NORMAL"}}