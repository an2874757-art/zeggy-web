ress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Mystery","History"],"id":39774,"type":"SERIES","title":"Unveil: Jadewind","logo":"","image":"https://cloud02.albox.co/seasons/0dda5a29-2c8c-499d-90b1-7ea7047d54ca.jpg","background_image":"https://cloud02.albox.co/seasons/b01efdb8-9daf-4eef-ac1d-8791f0074681.jpg","likes":76,"dislikes":1,"views":13857,"release_date":"1770249600000","season_number":1,"description":"خلال مهرجان الفوانيس، تُتوفى الأميرة هواي سي في ظروف غامضة خلال مأدبة. يُكلَّف لي باي يي، كبير الحرس، وشياو هواي جين، قائد الحرس الملكي، بالتحقيق في الأمر، فيكتشفان أن الأميرة هي القاتلة. بعد أن تعرضت للخيانة والظلم، انتقمت الأميرة لنفسها بمعاقبة خائنها وابنة عائلة نافذة، قبل أن تُلقي بنفسها من شرفة بنغلاي هربًا من مصير زواجها المحتوم.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"TV-14"},"background_color":"","current_season_id":23218,"content_control":"NORMAL"}}