type":"normalPoster"},{"data":[{"items":[],"id":7326,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Crime"],"id":7326,"type":"MOVIE","title":"Trespass","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/83655bd1-1e60-49e0-b3d5-5b455b4e6dbe.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/2ffac0ed-1786-40f0-9602-28d4595324b7.jpg","likes":20,"dislikes":0,"views":4128,"release_date":"1319155200000","length":5442,"description":"Kyle and Sarah Miller have it all: a huge gated house on the water, fancy cars, and the potential for romance in their relationship. He's just back from a business trip (he brokers diamonds) and their teen daughter Avery is sneaking out to a party, when four thugs in security uniforms and ski masks stage a home invasion. They want what's in the safe: cash and diamonds. Kyle stalls them, trying to negotiate for Sarah's freedom. Over the next few hours, the back stories of the four robbers (two brothers, a girlfriend, and the representative of a local drug kingpin) as well as the fault lines in Kyle and Sarah's marriage come into play. Is there room here for heroism?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"R"},"episode_id":7326,"content_control":"FAMILY"}}