inue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8647,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Romance","Comedy"],"id":8647,"type":"MOVIE","title":"Gorgeous","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/5812f7c8-f449-4ff0-a643-cbce1d79d549.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/128ee73f-456f-4e9e-9b76-363d7590cd79.jpg","likes":36,"dislikes":0,"views":4444,"release_date":"918259200000","length":7177,"description":"A Taiwanese girl named Bu has just been proposed to. While pondering the proposal, she finds a message in a bottle which inspires her go to Hong Kong to meet the guy, Albert, who wrote the message. However, she finds out that Albert is gay. A successful playboy businessman CN, and Howie have been rivals in love and business since school days. Howie finds out that CN is dating his girl and also trying to take over his company. Howie tells his guys to teach CN a lesson. Bu happens to be there and saves CN, but decides to fake her identity and scheme to make him fall in love with her. In the meantime Howie, who wants to teach CN a humiliating lesson, hires a highly trained foreign fighter to beat him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":8647,"content_control":"NORMAL"}}