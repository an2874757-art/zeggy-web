escription":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/3454d5ff-70b8-4fea-9272-7f9c2a86cd52.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":37637,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Animation"],"id":37637,"type":"SERIES","title":"مونستر هانتر مدبلج","logo":"","image":"https://cloud02.albox.co/seasons/878db0e9-1550-4f08-93be-a0ab57b7d725.jpg","background_image":"https://cloud02.albox.co/seasons/d58a1802-0fa6-4f97-b8ed-bf538411b2ec.jpg","likes":143,"dislikes":2,"views":14271,"release_date":"0","season_number":1,"description":"هذا هو العالم الذي يوجد فيه كل من الرجال والوحوش. أولئك الذين يصطادون الوحوش يطلق عليهم الصيادون. ولكن في ركن صغير من عالم الصياد ، هناك أولئك الذين يطلق عليهم الفرسان الذين يرتبطون بالوحوش ويتعايشون معها. مع Kizuna Ishi (أحجار الترابط) التي تسمح لهم بإيقاظ القوة الخفية داخل الوحوش ، يعيش الدراجون في سرية مع Otomon ، الوحوش التي شكلوا اتصالا بها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"PG"},"background_color":"","current_season_id":21814,"content_control":"NORMAL"}}