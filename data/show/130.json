,"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":130,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Comedy","Crime"],"id":130,"type":"MOVIE","title":"Midnight Run","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/1f102498-6e56-42cf-922c-386371819487.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/b80a78af-c12d-4601-ad7b-386fb58c0330.jpg","likes":37,"dislikes":3,"views":4868,"release_date":"585360000000","length":7579,"description":"Bounty hunter Jack Walsh (Robert De Niro) is sent to find and return bail jumper and former Mafia accountant, Jonathan \"The Duke\" Mardukas (Charles Grodin). The FBI has had no success in locating The Duke, so when Jack finds him in next to no time, they are a little embarrassed. In order to collect his $100,000 fee, Jack must take The Duke from New York to Los Angeles. However, the Mafia and the FBI have other ideas, as does Marvin Dorfler (John Ashton), a rival bounty hunter. On their long cross-country trip to LA, the two get to know each other and they build up a strange friendship.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"R"},"episode_id":130,"content_control":"FAMILY"}}