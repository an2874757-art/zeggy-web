ress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8483,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":8483,"type":"MOVIE","title":"Love in the Time of Cholera","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/82769c5a-4681-4754-8cda-8e1fd72d45c1.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/0814bf64-def1-4731-b55c-6e54be832c36.png","likes":36,"dislikes":4,"views":5981,"release_date":"1195171200000","length":8308,"description":"In Colombia just after the Great War, an old man falls from a ladder; dying, he professes great love for his wife. After the funeral, a man calls on the widow - she dismisses him angrily. Flash back more than 50 years to the day Florentino Ariza, a telegraph boy, falls in love with Fermina Daza, the daughter of a mule trader. Ariza is persistent, writing her constantly, serenading, speaking poetically of love. Her father tries to keep them apart, and then, one day, she sees this love as an illusion. She's soon married to Urbino, a cultured physician, and for years, Ariza carries a torch, finding solace in the arms of women, loving none. After Urbino's fall, are Ariza's hopes delusional?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"R"},"episode_id":8483,"content_control":"NORMAL"}}