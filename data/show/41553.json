موهوبة ببصيرة خارقة، يُحقق في سلسلة من القضايا الخارقة للطبيعة التي تكشف حقائق خفية. وبينما يكشفان القصص الإنسانية وراء كل قضية، يُساعدان النفوس المضطربة على إيجاد السلام، ويواجهان صراعاتهما الداخلية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"NC-17"},"background_color":"#000","current_season_id":24214,"content_control":"NORMAL"}}