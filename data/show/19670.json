d":34370,"title":"The Judge from Hell","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/c358b7c1-3c5f-4259-85b6-c202c19ab1dc.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19670,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":19670,"type":"SERIES","title":"Falsify","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/a9e5e877-a4f4-4736-bfd0-c006b48c4ed1.jpg","background_image":"https://cdn6.albox.co/storage/disk50/seasons/e724d45e-d6d8-4643-b656-2a3e22d478da.jpg","likes":22,"dislikes":0,"views":2871,"release_date":"1500854400000","season_number":1,"description":"In modern society, journalism has lost its integrity, and journalists who focus on the facts have disappeared. However, we've seen that there are still journalists who seek the truth, and if there is at least one person who is willing to look, the truth will come out from the darkness. Here we have two journalists. One is a \"media jackal\", a journalist who will write any story, fact or fiction, in order to get views, and the other is a \"vegetative journalist\" who hasn't been able to write a single article for five years. These two journalists, with the help of a prosecutor work together in order to seek the truth.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"N/A"},"current_season_id":8371,"content_control":"NORMAL"}}