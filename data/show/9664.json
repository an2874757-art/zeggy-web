ter"},{"data":[{"items":[],"id":9664,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy","Animation"],"id":9664,"type":"MOVIE","title":"Planes","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/495ee509-a1e9-4a46-9bff-c12c990e9adb.jpeg","background_image":"https://cdn6.albox.co/storage/disk50/shows/0d77edde-12b8-4aac-bd2f-1b30f9f94772.jpeg","likes":46,"dislikes":0,"views":4543,"release_date":"1376006400000","length":5495,"description":"Dusty Crophopper is a little cropduster plane with a fear of heights and a crazy dream of being a racer. While his friends need convincing, Dusty gets the training he needs from Skipper, a veteran fighter, and qualifies for the Wings Across the World race. In the event, Dusty finds competitors who soon learn that there is something special about this underdog as he is tested to his physical and emotional limits. In doing so, Dusty soon finds enemies, and more importantly friends, who are inspired by his dream. In the face of all obstacles, the winner of this air race will be anyone's guess.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"PG"},"episode_id":9664,"content_control":"FAMILY"}}