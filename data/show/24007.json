Db","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"PG-13"},"background_color":"#bb0404","current_season_id":12453,"content_control":"NORMAL"}}