":[{"items":[],"id":1942,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":1942,"type":"MOVIE","title":"Private School","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/6e847a84-e70d-489e-92ab-19e02fc29f9b.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/01a15975-dfe3-44f4-8961-e7b7d75f9b83.jpg","likes":39,"dislikes":9,"views":9731,"release_date":"428284800000","length":5329,"description":"Christine (Phoebe Cates), a student at an exclusive all-girls private school, is in love with Jim, who attends an academy for boys nearby. Christine's arch rival Jordan also has her eye on Jim, and she is willing to do whatever she can to steal him away. Jim's uber-slob buddy Bubba is going with Betsy, Christine's cynical friend, though he would probably be unfaithful if any other woman were willing to get near him. Bubba and his pals sneak into the girls' school dressed in drag in hopes of reaching the Promised Land (better known as the women's shower room), while Christine and Jim run away together for the weekend, though their escapade isn't as romantic as they had hoped.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"R"},"episode_id":1942,"content_control":"NORMAL"}}