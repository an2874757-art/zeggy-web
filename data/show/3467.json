,"card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","War"],"id":3467,"type":"MOVIE","title":"Head in the Clouds","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/bac03426-d61e-4d07-975c-8f42f41afb03.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/a683938e-22a3-4db4-a9d2-864e074417bb.jpg","likes":23,"dislikes":1,"views":6434,"release_date":"1099094400000","length":7275,"description":"HEAD IN THE CLOUDS is a sweeping romantic drama set in 1930's England, Paris, and Spain. Gilda Bessé shares her Paris apartment with an Irish schoolteacher, Guy Malyon, and Mia, a refugee from Spain. As the world drifts toward war, Gilda defiantly pursues her hedonistic lifestyle and her burgeoning career as a photographer. But Guy and Mia feel impelled to join the fight against fascism, and the three friends are separated - seemingly forever.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"R"},"episode_id":3467,"content_control":"NORMAL"}}