s"}],"post_info":{"genres":["Thriller","Crime","Mystery"],"id":14676,"type":"SERIES","title":"Bron/Broen","logo":"","image":"https://cdn6.albox.co/storage/disk53/seasons/7db99abc-769e-4bdf-9323-cf2c3c8f9118.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/8a85855f-a5a7-4f5d-98cb-7cbb02620247.jpg","likes":15,"dislikes":0,"views":6891,"release_date":"1316563200000","season_number":1,"description":"Season 2 begins 13 months after the events of the first season. A coastal tanker leaves the Öresund waterway and is headed straight for the Øresund Bridge. When the Coast Guard board the ship they discover there is no crew, and three Swedish and two Danish youths are chained below deck. Saga Norén, County Police, Malmö, is put in charge of the case and contacts Martin Rohde, who is still haunted by the death of his son. Soon it turns out the chained youths were just the beginning... Someone wants to direct our attention to the changing climate and the use of our planet's resources, and will stop at nothing to do it. It all turns into a race against the clock to prevent a disaster where many lives are at stake...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"R"},"background_color":"","current_season_id":1652,"content_control":"NORMAL"}}