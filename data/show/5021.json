":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5021,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","History"],"id":5021,"type":"MOVIE","title":"Munich","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/39e5213d-6a71-4bb3-9600-9ce8a387985a.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/fe302677-0298-4c80-8b64-4db060c5042a.jpg","likes":32,"dislikes":6,"views":5628,"release_date":"1136505600000","length":9824,"description":"After Black September's assassination of Israeli athletes at the Munich Olympics in 1972, Prime Minister Golda Meir okays a black-box operation to hunt down and kill all involved. A team of five gathers in Switzerland led by Avner, a low-level Mossad techie whose father was a war hero and whose wife is pregnant. It's an expendable team, but relying on paid informants, they track and kill several in Europe and Lebanon. They must constantly look over their shoulders for the CIA, KGB, PLO, and their own sources. As the body count mounts -- with retribution following retribution -- so do questions, doubts, and sleepless nights. Loyalties blur. What does it mean to be a Jew?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"episode_id":5021,"content_control":"NORMAL"}}