:0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19685,"title":"","description":"3362","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["TV-Show"],"id":19685,"type":"SERIES","title":"خواطر","logo":"","image":"https://cdn6.albox.co/storage/disk45/seasons/6ed391c1-8886-4e45-ac8c-4d2294bc624d.jpg","background_image":"https://cdn6.albox.co/storage/disk59/seasons/13348f26-d3fe-4a76-9ae8-6b5982f0c944.jpg","likes":29,"dislikes":2,"views":23956,"release_date":"1128384000000","season_number":1,"description":"\"Khawatir\", an Arabic word which means thoughts. A TV show devoted to help young people to be mature in their faith, work, knowledge of the world, and their role to make their countries a better place to live. This T.V show criticizes the Arab world in a good way. Ahmad Al Shughairi went to many Arab countries and observed its negative and positive aspects. Accordingly, he tried to apply new ideas and creative methods to develop many sectors in the region, especially the education sector. He took the good examples from cities inside and outside the Arab world. And then he cooperated with different companies from Arab world to start developing many sectors.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":0.9}],"value":0.9,"age":"PG-13"},"background_color":"","current_season_id":8386,"content_control":"NORMAL"}}