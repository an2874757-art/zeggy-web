card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Sport"],"id":8813,"type":"MOVIE","title":"Before the Fall","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/7d2058ce-7231-4a85-aa63-b50b29ec0f7b.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/8465fd4b-7916-4d24-8d0b-e2db7e80c42c.jpeg","likes":71,"dislikes":1,"views":4595,"release_date":"1105574400000","length":6874,"description":"In 1942, Friedrich Weimer's boxing skills get him an appointment to a National Political Academy (NaPolA) - high schools that produce Nazi elite. Over his father's objections, Friedrich enrolls, seeing this as his ticket out of factory life to university and a good salary. During his year in seventh column (fifth form), this innocence is altered as Friedrich encounters hazing, cruelty, death, and the Nazi code. His friendship with Albrecht, the ascetic son of the area's governor, is central to this education; a night in the forest hunting for escaped Russian POWs brings things to a head.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":8813,"content_control":"FAMILY"}}