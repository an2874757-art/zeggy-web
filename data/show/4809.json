//cdn6.albox.co/storage/disk45/shows/37aebca1-e0f8-464a-9ed2-53c74b4f2908.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4809,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Sci-Fi","Drama","Romance"],"id":4809,"type":"MOVIE","title":"Phenomenon","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/842dffd6-d344-46eb-aeb2-bf49332c4c0e.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/4f361ab4-9b4f-40d0-9148-3b9a436c86be.jpg","likes":87,"dislikes":2,"views":8909,"release_date":"836352000000","length":7406,"description":"John Travolta plays George Malley, who owns the local auto repair shop in a small California town. After celebrating his birthday with friends at the local bar/hang-out, George heads for home. He pauses to watch a strange light in the sky, then collapses for a few seconds in the middle of the deserted street. In the days and weeks that follow, George finds his IQ and consciousness expanding dramatically, and develops telekinetic abilities. Despite his attempts to explain what has happened to him, with just a very few exceptions, most of the local townspeople treat the \"new\" George as a freak. His state of isolation becomes even more pronounced when his new-found abilities allow him to correctly predict an earthquake, and outside authorities become interested in what's happened to him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"PG"},"episode_id":4809,"content_control":"FAMILY"}}