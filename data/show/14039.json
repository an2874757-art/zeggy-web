ype":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/d47a6d27-5ea8-4e9a-8534-10f529ee8a87.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":20219,"title":"Berserk","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk48/shows/1d0e703d-3ecf-4fca-aa67-f84ef8ef69b0.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":14039,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Shounen","Supernatural","Game"],"id":14039,"type":"SERIES","title":"Hikaru no Go","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/145ad2b0-9215-4e20-aa5c-ebfcb710f193.jpg","background_image":"https://cdn6.albox.co/storage/disk42/seasons/1f8c8267-78d1-4884-8767-259bcc0ba10f.jpg","likes":89,"dislikes":5,"views":12552,"release_date":"1151712000000","season_number":0,"description":"12-year-old Shindou Hikaru is just your average 6th grader. One day, while searching through his grandfather's attic, he comes across an old Go board. Upon touching the Go board, Hikaru is possessed by the spirit of Fujiwara no Sai, and continues to be haunted by him soon after. Sai was once a great Go player, who committed suicide and continued to stay in the world as a spirit desiring only to play Go once again. Finally bending to Sai's pleas, Hikaru allows Sai to play Go through himself, unknowingly attempting the first game with the young prodigy Touya Akira. Time has finally started moving, as Sai's quest for the perfect game, \"The Hand of God\", is set underway. Based on the manga by Yumi Hotta and Takeshi Obata.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.4}],"value":8.4,"age":"PG-13"},"current_season_id":710,"content_control":"NORMAL"}}