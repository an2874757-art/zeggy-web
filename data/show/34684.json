d02.albox.co/shows/9ff8cdad-da1a-49c0-9070-c9fbba7c414a.png","image":"https://cloud02.albox.co/shows/1ceb30fa-a2a8-4c9a-a4cb-e2b6f2f7f936.jpg","background_image":"https://cloud02.albox.co/shows/68f72533-6a3a-44c2-8050-90e4ad553cc2.jpg","likes":39,"dislikes":2,"views":6041,"release_date":"1712880000000","length":3696,"description":"تدور أحداث هذه القصة حول الناس والمدينة. مدينة تعدين الفحم المزدحمة بالحفارات الصغيرة، والمعروفة باسم \"هاكونيوا\". في هذه المدينة التي تتغير يوميًا مثل المتاهة، توجد فتاة تدعى كاجاري تدير شركة رسم خرائط وصبي يدعى يويا يحلم بالتحرر من \"هاكونيوا\". في النهاية، يجد الاثنان، جنبًا إلى جنب مع السكان الفريدين في المدينة، أنفسهم في مواجهة مؤامرة تهز المدينة بأكملها. يعتمد مصير \"هاكونيوا\" على رسومات كاجاري على الخريطة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG-13"},"episode_id":946283,"background_color":"#fffafa","content_control":"FAMILY"}}