:0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":13381,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi"],"id":13381,"type":"MOVIE","title":"Battle Los Angeles","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/d883df82-2e11-4161-a55b-96609a4b6959.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/843e8bfe-1103-4347-a9da-43cb24f67731.jpg","likes":102,"dislikes":5,"views":10659,"release_date":"1299801600000","length":6971,"description":"Los Angeles and other cities around the world are being bombarded by meteors that seem to be slowing down once they hit the earth's atmosphere. The earth is suddenly being invaded by space aliens that have landed off the shore of LA, and who begin killing everybody along the beach. The military is ordered into action. Marine Staff Sergeant Nantz (Aaron Eckhart), who was about to retire, is reassigned to a new platoon. The platoon, flown by chopper to the forward operating base at Santa Monica Airport, is being led by a new 2nd Lt. Martinez (Ramon Rodriguez). They are sent on a mission to rescue some civilians who are trapped at the police station within alien territory. They only have 3 hours to complete their mission and get out before the Air Force bombs that zone.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"PG-13"},"episode_id":13381,"content_control":"FAMILY"}}