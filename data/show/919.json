continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":919,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Comedy"],"id":919,"type":"MOVIE","title":"Fools Rush In","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/dd1fb289-019b-4e7f-a7fe-e672bfe32e1e.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/4229a7b6-b04b-432a-b1a7-1dfcb6775701.jpg","likes":31,"dislikes":1,"views":4806,"release_date":"855878400000","length":6546,"description":"Sparks fly and cultures collide in this romantic comedy about a casual night of passion that turns into the love of a lifetime. Alex Whitman is a New Yorker sent to Las Vegas to oversee a construction project. There he meets Isabel Fuentes, and some serious chemistry brings them together for one night. But Alex doesn't see Isabel again until three months later, when he learns she is pregnant. On a whim and prayer, he proposes. However, there's more to marriage than a Vegas chapel and an Elvis impersonator, as Alex and Isabel soon learn.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":919,"content_control":"FAMILY"}}