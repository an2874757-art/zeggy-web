,"image":"https://cdn6.albox.co/storage/disk52/seasons/2bb49ac9-3bcb-4db7-a488-c82ee61547fd.jpg","background_image":"https://cdn6.albox.co/storage/disk47/seasons/917d6d7e-0ed7-4193-b9cd-070e9a9ca89a.jpg","likes":262,"dislikes":10,"views":42834,"release_date":"1546300800000","season_number":1,"description":"قصة المسلسل : تدور القصة حول عائلة من مالكي الاراضي الاثرياء الذين يتبعون النظام الاقطاعي , مالك سركار كبير الاسرة وزعيم القرية التي يقيمون فيها , شقيق مالك سركار الاصغر لديه زوجتان احداهما انفصل عنه رغبة في ارضاء اخيه وحفاظاً على عادات وتقاليد العائلة وانجب منها بنتان , هوريا ومنهال …هوريا فتاة عصرية وعاقلة وتحب مساعدة الاخرين تحب صديقها دانش ولكن دون علمها تم خطبتها لابن عمها ووريث مالك سركار وفي حين ان هوريا وامها تعارض هذا الزواج الا ان مالك سركار يصر على هذا الزواج لنرى ماذا سيحدث","rating":{"sources":[],"value":0,"age":"TV-14"},"current_season_id":3902,"content_control":"NORMAL"}}