34,"title":"","description":"14","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller"],"id":7034,"type":"MOVIE","title":"Yojimbo","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/58605b83-21d7-4f4f-9d04-356c4e2c40fc.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/1b3ac4d2-0ab3-437d-b7ff-7f13837cd0a5.jpg","likes":78,"dislikes":2,"views":6156,"release_date":"-261964800000","length":6628,"description":"Sanjuro, a wandering samurai enters a rural town in nineteenth century Japan. After learning from the innkeeper that the town is divided between two gangsters, he plays one side off against the other. His efforts are complicated by the arrival of the wily Unosuke, the son of one of the gangsters, who owns a revolver. Unosuke has Sanjuro beaten after he reunites an abducted woman with her husband and son, then massacres his father's opponents. During the slaughter, the samurai escapes with the help of the innkeeper; but while recuperating at a nearby temple, he learns of innkeeper's abduction by Unosuke, and returns to the town to confront him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"r"},"episode_id":7034,"content_control":"FAMILY"}}