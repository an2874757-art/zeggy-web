ontinue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5189,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy"],"id":5189,"type":"MOVIE","title":"Magic Mike","logo":"https://cdn6.albox.co/storage/CLOUD00/shows/ecb93830-ddd5-4b17-bba3-b2f382583768.png","image":"https://cdn6.albox.co/storage/CLOUD00/shows/b305fb2f-02c2-4672-9828-ce47674c6031.jpg","background_image":"https://cdn6.albox.co/storage/CLOUD00/shows/c8a03d11-2b3a-48aa-af0c-0d86a322afa7.jpg","likes":24,"dislikes":5,"views":6946,"release_date":"1340928000000","length":6629,"description":"Mike Lane is a thirty-year old living in Tampa,Florida. By day he works as a roofer while at night, as Magic Mike, he is the star attraction of the Kings of Tampa, a group of male strippers. Secretly he wants out in order to further a projected furniture-making business but his credit rating precludes a bank loan for this despite his considerable savings. One night Adam, a teen-aged work-mate of Mike, follows him to the club and, when one of the acts is unable to go on,he is prevailed upon to strip - becoming a huge hit. However success goes to his head and his foolish actions not only threaten to jeopardize his sister Brooke's relationship with Mike but Mike's ambitions as well.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"episode_id":5189,"content_control":"FAMILY"}}