"image":"https://cdn6.albox.co/storage/disk58/shows/8a4b5cfb-8512-44c4-a92f-c1460a2f4620.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":37365,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Drama"," Comedy"],"id":37365,"type":"SERIES","title":"Wang's Family","logo":"","image":"https://cloud02.albox.co/seasons/b7eed1c6-0919-403b-b7e7-36696ef163ca.jpg","background_image":"https://cloud02.albox.co/seasons/7fd45ad4-f898-4522-b675-3dee35682996.jpg","likes":16,"dislikes":0,"views":1200,"release_date":"1377907200000","season_number":1,"description":"تواجه عائلة وانغ تحدياتٍ عديدة: النخبوية؛ والتمييز؛ وعودة الأبناء إلى ديارهم بعد أن عاشوا بمفردهم خلال دراستهم الجامعية؛ وتوازن القوى بين الزوج والزوجة والأسرة؛ واتخاذ القرارات بشأن موعد الزواج وإنجاب طفل في ظل الصعوبات المالية التي يشهدها المجتمع الكوري اليوم. تزوجت الابنة الأولى من عائلة ميسورة الحال، ولكن بعد إفلاسها، اضطرت هي وعائلتها للعودة إلى منزل والديها. كما تواجه الابنة الثانية صعوباتٍ ماليةً لأن زوجها عاطل عن العمل، بينما قررت الابنة الثالثة فجأةً ترك عملها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"background_color":"","current_season_id":21640,"content_control":"NORMAL"}}