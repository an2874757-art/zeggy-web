ngth":0,"continue_watching_progress":0},{"items":[],"id":4838,"title":"Attack on Titan: Part 1","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/9f012b1d-4505-4075-a25b-838c8e9aee2c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":3729,"title":"Extreme Job","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/0e697728-4e28-43e6-bf4f-fa926d6cf0f9.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":37261,"title":"Wall to Wall","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/19799c46-867b-4b06-afbf-453bf68c24c5.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35006,"title":"Striking Rescue","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/3ed36aab-1300-4759-87ea-cff21581abe1.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":1048,"title":"#Alive","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk45/shows/d1617823-9f4c-4df8-a2f7-5d241a3a1703.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":33842,"title":"Wonderland","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/2c8c2a3a-e776-4011-a91f-788a11e6dc53.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8462,"title":"","description":"13","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Action","Drama"],"id":8462,"type":"MOVIE","title":"Fearless","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/b9648091-5c3c-4991-a70c-2ae9cd409df7.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/de22d586-19fe-4b13-b448-a3467b55ea29.jpg","likes":68,"dislikes":2,"views":9401,"release_date":"1158883200000","length":8446,"description":"Martial arts legend Huo Yuanjia became the most famous fighter in all of China at the turn of the 20th Century. Huo faced personal tragedy but ultimately fought his way out of darkness and into history, defining the true spirit of martial arts. His self-discovery, and the choices he made, inspired his nation. The son of a great fighter who did not wish for his child to follow in his footsteps, the bullied Huo Yuanjia resolves to teach himself how to fight - and win. Years of training enable him to ace match after match in his home region of Tianjin. But as his fame as a martial arts master grows, so does his pride. After an ill-advised fight leads to another master's death, members of Huo's family are slain in revenge. Grieving and ashamed, Huo wanders the country in shock. Near death, he is rescued by women from an idyllic village, and is offered simple kindness and generosity that help him heal and regain his equilibrium over a period of several years. Huo realizes that the future of martial arts lies in sportsmanship and not brutality, and he rejoins society to apply what he has learned. Returning to Tianjin, Huo takes steps to come to terms with his past and restore his family's name. His evolving, graceful Mizong (Missing) Fist method of fighting brings Huo renewed success, and he forms the progressive Jingwu Sports Federation. Taking note, duplicitous members of the Foreign Chamber of Commerce engineer a Shanghai tournament pitting Huo against four fighters, each representing the major foreign powers in China. Huo commits to the bout and faces off against, respectively, a British boxer, a Spanish swordsman, a Belgian soldier, and a Japanese martial artist. What happened that day in 1910 has never been, and will never be, forgotten in China.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"episode_id":8462,"content_control":"FAMILY"}}