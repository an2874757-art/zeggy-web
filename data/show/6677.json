storage/disk51/shows/7409ad61-2581-41c0-8334-fd635d480b20.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6677,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi","Drama","Thriller","Crime","Mystery"],"id":6677,"type":"MOVIE","title":"Minority Report","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/06717fa8-4ed8-482a-abfd-306a50fefc69.png","background_image":"https://cdn6.albox.co/storage/disk55/shows/f7f37117-f97e-468c-ac97-5abacdafb4e6.png","likes":103,"dislikes":2,"views":11174,"release_date":"1024617600000","length":8710,"description":"In the year 2054 A.D. crime is virtually eliminated from Washington D.C. thanks to an elite law enforcing squad \"Precrime\". They use three gifted humans (called \"Pre-Cogs\") with special powers to see into the future and predict crimes beforehand. John Anderton heads Precrime and believes the system's flawlessness steadfastly. However one day the Pre-Cogs predict that Anderton will commit a murder himself in the next 36 hours. Worse, Anderton doesn't even know the victim. He decides to get to the mystery's core by finding out the 'minority report' which means the prediction of the female Pre-Cog Agatha that \"might\" tell a different story and prove Anderton innocent.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"episode_id":6677,"content_control":"NORMAL"}}