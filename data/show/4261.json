fd40cc8-69a6-4d33-a785-e6875913b81e.JPG"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4261,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller","Crime","Western"],"id":4261,"type":"MOVIE","title":"Death Hunt","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/c3034ad7-92bd-468a-9705-74f8be735264.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/72716779-7858-426e-b6e3-38524a138760.jpg","likes":15,"dislikes":0,"views":3446,"release_date":"-2208988800000","length":5822,"description":"Canada 1931: The unsociable trapper Johnson lives for himself in the ice-cold mountains near the Yukon river. During a visit in the town he witnesses a dog-fight. He interrupts the game and buys one of the dogs - almost dead already - for $200 against the owner's will. When the owner Hasel complains to Mountie Sergeant Millen, he refuses to take action. But then the loathing breeder and his friends accuse Johnson of murder. So Millen, although sympathetic, has to try to take him under arrest - but Johnson defends his freedom in every way possible.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":4261,"content_control":"NORMAL"}}