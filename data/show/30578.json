يرين رفاقها يموتون ببطء واحدًا تلو الآخر.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":9}],"value":9,"age":""},"background_color":"","current_season_id":17320,"content_control":"NORMAL"}}