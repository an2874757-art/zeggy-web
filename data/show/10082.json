4-bdcc-055909f3f140.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10082,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action"],"id":10082,"type":"MOVIE","title":"Kick","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/36b62c1f-c956-4a11-8600-f4a0ac56be2c.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/ead12c9c-6519-4f52-8c64-09d6f5e6d589.jpg","likes":217,"dislikes":6,"views":27164,"release_date":"1406246400000","length":8808,"description":"On a train journey in Warsaw, psychiatrist Shaina meets Himanshu, who is a police officer from India to discuss their prospective marriage. Both are reluctant to enter into an arranged union but become friends and strike a deep conversation where Shaina reveals her previous relationship with the eccentric Devi, a man who lived only for his 'Kick' aka an adrenaline rush . Despite his idiosyncrasies they embark on a whirlwind romance, until one day he breaks up with her for a new 'Kick' and walks away never to return. Himanshu in turn regales her with his glorious escapades as an officer but mentions that he has finally met his match, an intelligent thief. What they are both unaware of is that their stories have one thing in common, Devi. He returns to their lives under the pretext of having lost his memory. Behind it all, is a deeper mystery and an uncompromising mission for which Devi is ready to lose his life.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.4}],"value":5.4,"age":"r"},"episode_id":10082,"content_control":"FAMILY"}}