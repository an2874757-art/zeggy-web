":[{"items":[],"id":8719,"title":"","description":"60","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","History","War"],"id":8719,"type":"MOVIE","title":"The Admiral","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/d1299b28-8f0e-4c88-a6da-d27998d890d6.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/2a5b35a4-8467-4df9-984b-3e446854fd9d.jpg","likes":376,"dislikes":6,"views":57272,"release_date":"1406678400000","length":7726,"description":"The film mainly follows the famous 1597 Battle of Myeongryang during the Japanese invasion of Korea (1592-1598), where the iconic Joseon admiral Yi Sun-sin managed to destroy a total of 31 of 133 Japanese warships with only 13 ships remaining in his command. The battle, which took place in the Myeongryang Strait off the southwest coast of the Korean Peninsula, is considered one of the greatest victories of Yi.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"r"},"episode_id":8719,"content_control":"NORMAL"}}