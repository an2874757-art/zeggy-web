ength":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":2907,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Mystery","War"],"id":2907,"type":"MOVIE","title":"A Very Long Engagement","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/4c5e43e8-5758-43ce-88ac-113bd87dfe99.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/d646f1b3-534a-41d3-a2ea-b7f675bdbdde.jpg","likes":57,"dislikes":4,"views":10578,"release_date":"1105660800000","length":7990,"description":"Five desperate French soldiers during The Battle of the Somme shoot themselves, either by accident or with purpose, in order to be invalided back home. Having been \"caught\" a court-martial convenes and determines punishment to be banishment to No Man's Land with the objective of having the Germans finish them off. In the process of telling this tale each man's life is briefly explored along with their next of kin as Methilde, fiancée to one of the men, tries to determine the circumstances of her lover's death. This task is not made any easier for her due to a bout with polio as a child. Along the way she discovers the heights and depths of the human soul.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"episode_id":2907,"content_control":"NORMAL"}}