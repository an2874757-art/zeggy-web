ts","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","School","Friendship","Youth"],"id":17586,"type":"SERIES","title":"Just an Encore","logo":"","image":"https://cdn6.albox.co/storage/disk45/seasons/dfe30a06-581e-47d5-bc9a-9de994369e8f.jpg","background_image":"https://cdn6.albox.co/storage/disk58/seasons/ca88410a-8272-4436-985d-b82316de3864.jpg","likes":19,"dislikes":0,"views":3367,"release_date":"1548806400000","season_number":1,"description":"Ordinary high school student Yan Ze is secretly in love with her desk-mate Ji Xiaowho is not only the most handsome boy in school but also a top student. But Yan Ze is neither particularly beautiful nor does she have a particularly good figure, and her grades are only so-so as well. Her best friend and adopted sister Gu Xi Ye, however, is the opposite of her, beautiful and an outstanding student. Yan Ze thus can’t help feeling that she will forever be no more than Xi Ye’s shadow. When Yan Ze discovers that her crush might like Xi Ye, her restrained negative emotions towards Xi Ye only become stronger until she explodes.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"current_season_id":5691,"content_control":"NORMAL"}}