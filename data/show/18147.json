nd the Scarlet Knights, and is pursued.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"TV-14"},"current_season_id":6385,"content_control":"NORMAL"}}