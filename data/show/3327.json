ontinue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3327,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","History"],"id":3327,"type":"MOVIE","title":"True Legend","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/da9f0425-343c-42c8-b250-69fbb7bf91aa.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/68dc195e-c44e-4a40-8e46-5137458911d1.jpg","likes":29,"dislikes":2,"views":4006,"release_date":"1265673600000","length":6877,"description":"Su Qi-Er retired from his life as a renowned Qing dynasty general in order to pursue his dream of a family and his own martial arts school. However, Su's peaceful life is shattered when his vengeful adopted brother, Yuan Lie, kidnaps his son and leaves Su for dead. Saved from his demise by his wife Ying and the reclusive doctor Yu, Su resolves to perfect his technique so that he may defeat Yuan Lie and reunite his family. Suffering from visions that he aided in his training by two of the \"Eight Immortals\" in the form of the mystical \"God of Wushu\" and the eccentric \"Old Sage\" master of Drunken Boxing. He embarks on the path that would eventually give rise to the legend of the \"King of Beggars.\"","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"R"},"episode_id":3327,"content_control":"NORMAL"}}