5.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3015,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Horror"],"id":3015,"type":"MOVIE","title":"Blood: The Last Vampire","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/e8611299-c7c2-4bc1-946f-f70e04763a8f.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/fee80d74-88cd-4bac-b847-3142d496ce58.jpg","likes":33,"dislikes":3,"views":3768,"release_date":"1244073600000","length":5328,"description":"In 1970, the four hundred year-old skilled samurai Saya is sent to the Kanto High School in an American military base in Tokyo by the Council, a secret society that has been hunting vampires for centuries. Saya has the appearance of a teenager but is the tormented half-breed creature with the soul of her human father and the powers and need of blood of her vampire mother. She is obsessed to face the powerful demon Onigen that killed her father. In the base, Saya saves Alice McKee, who is the daughter of General McKee and commander of the base, from the attack of several vampires. When General McKee is killed by a member of the Council, Alice runs to the hotel where Saya is lodged. They join forces and go to the countryside to chase Onigen.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"R"},"episode_id":3015,"content_control":"NORMAL"}}