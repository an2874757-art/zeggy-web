omments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance"," Drama"," Comedy"],"id":25257,"type":"SERIES","title":"Assistant of Superstar","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/4773f080-c424-4efb-9cdf-b77531dfb513.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/3cb2e28f-4c4a-473a-a15e-0fb14ec8c893.jpg","likes":59,"dislikes":1,"views":4502,"release_date":"1644796800000","season_number":1,"description":"قد يكون Wang Yu Xi نجمًا رائعًا وسيمًا بشكل لا يصدق ، لكن تحت هذا المظهر الخارجي اللامع يكمن سر مدفون بعمق: إنه لم يتلق أبدًا تعليمًا جيدًا. على هذا النحو ، يقضي أيامه في العيش بشكل غير مريح بالقرب من حدود الأمية. في حين أن Yu Xi عادة ما يكون قادرًا على إخفاء عيوبه ، إلا أن هناك أوقاتًا يفشل فيها فشلاً ذريعاً ؛ آخرها كانت مقابلته الفاشلة لدور مهم في مشروع قادم. نظرًا لأن حاجته إلى معلم أصبحت الآن واضحة بشكل صارخ ، فإن شركته ليس لديها خيار سوى العثور عليه ، لكن البحث أثبت أنه أصعب مما كان يتخيله أي شخص في الأصل.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"R"},"current_season_id":13340,"content_control":"NORMAL"}}