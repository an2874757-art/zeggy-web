ormalPoster"},{"data":[{"items":[],"id":4681,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":4681,"type":"MOVIE","title":"Two Lovers","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/0db75324-4269-4d26-b775-f7343656d4a2.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/7d51fcf1-52dd-4760-b21d-0a428eddcaf8.jpg","likes":35,"dislikes":3,"views":5429,"release_date":"1237507200000","length":6608,"description":"Leonard Kraditor is a burned-out case, living with his immigrant parents after his fiancée left him, helping out at their Brooklyn dry cleaners, taking photographs, at loose ends, suicidal. In quick succession, he meets two women: Sandra, the daughter of his parents' business associates, frank, direct, sensual, Jewish like Leonard; and, his neighbor Michelle, mercurial, rootless, fun, blond, unattainable. Michelle is in love with a married man and cries on Leonard's shoulder; Sandra wants to save him. Is Leonard willing to risk losing Sandra's fidelity for the moments Michelle's moods swing toward him? Can this end well?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":4681,"content_control":"NORMAL"}}