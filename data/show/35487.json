title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35487,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Mystery","Supernatural"],"id":35487,"type":"SERIES","title":"Zen Ryoiki Ijo Kaiketsu Shitsu ","logo":"https://cloud02.albox.co/shows/b8cda6ac-698f-4117-b4f8-c6741f5667db.png","image":"https://cloud02.albox.co/seasons/efb487ad-7025-4e8b-a3a2-26aa7bb1d0bf.jpg","background_image":"https://cloud02.albox.co/seasons/c99b017c-10dc-4ac9-9849-55e3e175e546.jpg","likes":16,"dislikes":0,"views":2583,"release_date":"1728432000000","season_number":1,"description":"أوكيتاما ميابي هو مدير شركة زينريويكي إيجو كايكيتسو شيتسو (المعروفة باسم زينكيتسو). الشركة هي أقدم وكالة تحقيق تحاول حل القضايا الغامضة. يتمتع ميابي بهالة أنيقة، ويمتلك معرفة وذاكرة وبصيرة غير عادية. بقدراته، يحل قضايا غير طبيعية لا يمكن تفسيرها ولا يمكن حلها حتى من خلال التحقيقات العلمية المتطورة. غالبًا ما تنطوي قضاياه على ما هو خارق للطبيعة وغامض. يزور مكان الحادث ويحقق بالتفصيل، ويجمع كل الحقائق معًا ويستنتج فرضية يمكن للجميع فهمها. الكلمات التي يتحدث بها غامضة، وهو شخص لا يُظهر للناس ما يدور في ذهنه.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"background_color":"#0a0a0a","current_season_id":20177,"content_control":"FAMILY"}}