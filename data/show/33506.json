":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"background_color":"","current_season_id":18852,"content_control":"NORMAL"}}