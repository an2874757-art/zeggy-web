ching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4763,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Crime"],"id":4763,"type":"MOVIE","title":"Men at Work","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk44/shows/1e1d42b9-60a5-406c-ad36-ab5197d5d342.jpg","likes":2,"dislikes":0,"views":4678,"release_date":"651456000000","length":5923,"description":"Carl and James are two pleasant but unambitious garbage men. Carl has a telescope with which he observes his neighbors. One evening he sees a man giving a female neighbor a hard time. As she leaves he shoots the man with a pellet gun. Hiding, he and James miss two men strangling the man and leaving with the body. When he appears in a can on their route they are afraid and hide the body, fearing that they may be implicated in the death. Trying to crack the case, they spy on the woman, join up with a slightly to majorly crazed Vietnam vet, kidnap a pizza man and help to protect the ecology.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":4763,"content_control":"FAMILY"}}