atching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":232,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi","Drama","Thriller","Mystery"],"id":232,"type":"MOVIE","title":"The Manchurian Candidate","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/5b621dba-9bfe-404f-985a-cdef168debd3.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/bdf9520d-adab-4d57-83e9-3a923d120a5b.jpg","likes":19,"dislikes":3,"views":5006,"release_date":"1091145600000","length":7792,"description":"When his army unit was ambushed during the first Gulf War, Sergeant Raymond Shaw saved his fellow soldiers just as his commanding officer, then-Captain Ben Marco, was knocked unconscious. Brokering the incident for political capital, Shaw eventually becomes a vice-presidential nominee, while Marco is haunted by dreams of what happened -- or didn't happen -- in Kuwait. As Marco (now a Major) investigates, the story begins to unravel, to the point where he questions if it happened at all. Is it possible the entire unit was kidnapped and brainwashed to believe Shaw is a war hero as part of a plot to seize the White House? Some very powerful people at Manchurian Global corporation appear desperate to stop him from finding out.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"R"},"episode_id":232,"content_control":"FAMILY"}}