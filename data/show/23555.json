127,"dislikes":1,"views":8782,"release_date":"1629072000000","season_number":1,"description":"من المعروف أن طبيب الأسنان Ai Jing Chu ، الذي يدرس أيضًا في جامعة Donghu ، هو أكثر الرجال وسامة في المدرسة. ومع ذلك ، فإن أمين مكتبة الجامعة تسنغ لي متحيز ضده بسبب القليل من سوء الفهم. عندما أجبرتها والدة Zeng Li على الحصول على تقويم الأسنان ، حاولت تجنب Ai Jing Chu بأي ثمن ، لكنها في النهاية أصبحت مريضته. عندما يتفاعل الاثنان أكثر فأكثر مع بعضهما البعض ، يدرك Zeng Li أن Ai Jing Chu هو في الواقع شخص محترف للغاية ومهتم ، ويبدأ في تطوير المشاعر له.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG-13"},"background_color":"","current_season_id":12132,"content_control":"NORMAL"}}