4e9722f-ea4e-4bde-9ea4-be8ef9198112.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":32872,"title":"Shaitaan","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/0fa03d4f-bd5c-4503-9259-4a974ec450cd.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3720,"title":"","description":"29","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Crime"],"id":3720,"type":"MOVIE","title":"Highway","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/badbd634-31ea-4023-a376-e498249ffd49.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/ed743fd9-d887-4f52-b406-8e28b275cbf0.jpg","likes":157,"dislikes":3,"views":8176,"release_date":"1392940800000","length":7984,"description":"A city girl - young, full of life - is on the highway at night with her fiancé. Suddenly, her life is swung away from the brocade and jewelry of marriage to the harsh brutality of abduction. Her life will never be the same again. The gang is in a panic; the girl is a big industrialist's daughter, his links in the corridors of power make ransom out of the question. But for the leader of this group sending her back is not an option. As the days pass by, the scenery changes, the girl feels that she has changed as well. Gradually, a strange bond begins to develop between the victim and the oppressor. It is in this captivity that she, for the first time, feels free.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"PG-13"},"episode_id":3720,"content_control":"NORMAL"}}