ox.co/shows/58d28f4a-bad1-4015-a0cd-2ad3f064e124.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38579,"title":"كارثة طبيعية","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/59fdbe59-56a2-462e-9917-74f6a7954130.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35898,"title":"بالدم","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/fbbd39bf-f488-4a4a-b1aa-22f4beb28b77.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38371,"title":"لينك","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/0ec1e164-6c95-4750-8af3-6f373c96c514.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19880,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Historical"],"id":19880,"type":"SERIES","title":"الحصرم الشامى الموسم الاول","logo":"","image":"https://cdn6.albox.co/storage/disk44/seasons/ead3bd40-d32b-440b-a3e6-edbca9dc4b55.jpg","background_image":"https://cdn6.albox.co/storage/disk59/seasons/a74d8017-d591-4355-a98c-033a6d8aef85.jpg","likes":46,"dislikes":4,"views":9894,"release_date":"-2208988800000","season_number":1,"description":"مسلسل اجتماعي تاريخي من تأليف وسيناريو\"فؤاد حميرة\"عن كتاب البديري الحلاق\"حوادث دمشق اليومية\"... ويتحدث العمل عن الحياة اليومية الاجتماعية لأهل الشام في الفترة بين 1715 ـ 1750 من خلال عدة عائلات شامية وحياتها الاجتماعية والاقتصادية والسياسية في تلك الفترة، ويتضمن أحداثاً تجري في القرن الثامن عشر\"في فترة سليمان باشا العظم ثم أسعد باشا\"وقد رصدها المؤلف بكل دقة واتقان وروى الأحداث السلبية من قتل ونهب واغتصاب وفقر وظلم، كما تحدث عن الوقائع البطولية مثل الشهامة والنضال من أجل حياة كريمة عز وجودها في ذلك الزمان. في\"الحصرم الشامي\" تتنوع الحكايات والشخصيات وقد وقع المخرج على كوكبة من نجوم الدراما السورية منهم الفنان عباس النوري الذي يجسد شخصية\"حمزة آغا\" التي تتميز بالتعالي والانتهازية والأنانية وخدمة مصالحه، و يعشق ذاته ويتصرف بأمور الآخرين كما يريد، ولا يعرف الحب ولا التعاون مع الآخرين لكونه يحمل في أعماقه كماً هائلاً من الكره","rating":{"sources":[],"value":0,"age":""},"current_season_id":8678,"content_control":"NORMAL"}}