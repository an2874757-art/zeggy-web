 بعضهم البعض. معًا، لم يتخلصوا من مظالمهم فحسب، بل تخلوا أيضًا عن الكراهية، وأعادوا اكتشاف أنفسهم، وسعوا وراء الحب الحقيقي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"background_color":"","current_season_id":19407,"content_control":"NORMAL"}}