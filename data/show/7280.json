],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7280,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Fantasy","Romance","Comedy","Music","Animation","Family"],"id":7280,"type":"MOVIE","title":"Aladdin and the Return of Jafar","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/bfde2d53-61ff-44ac-b3aa-cb12389fa4c2.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/20d8e1a6-eccf-401c-ae36-be2359e88eba.jpg","likes":63,"dislikes":1,"views":8819,"release_date":"769392000000","length":4155,"description":"Aladdin is adjusting to his new life as part of the upper crust. He and Princess Jasmine may not be married yet, but the pressures of palace society have already begun. On top of that, Iago (the parrot pet of Sultan's ex-vizir turned genie, Jafar) appears asking for help and no one is happy to see him. But things begin to look up when Genie returns from his trip around the world. Meanwhile, Jafar's black lamp is discovered by an idiot crook called Abis Mal. By using Abis Mal, Jafar makes his way back to Agrabah with ideas of payback for Aladdin and his friends.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"G"},"episode_id":7280,"content_control":"NORMAL"}}