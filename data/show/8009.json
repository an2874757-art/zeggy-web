ox.co/shows/d8419c33-4cfb-45b3-b8f7-c310777948b0.JPG"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8009,"title":"","description":"25","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":8009,"type":"MOVIE","title":"The Lucky One","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/3f093b23-06c1-4ece-83ca-b577656cf31c.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/923fa18e-206a-4608-bfde-32a6cc2f0e07.jpg","likes":212,"dislikes":8,"views":27010,"release_date":"1334880000000","length":6053,"description":"Logan is a marine serving in Iraq. While there, he finds a photo of a girl with \"keep safe\" written on the back. He is admiring it when his unit is attacked. He survives and credits the photo for saving him. He tries to find the owner but can't, assuming he was killed. When he goes back to the States, he finds it difficult to adjust and is still haunted by what happened. Analyzing the photo, he finds in the background a landmark that tells him she is in Louisiana. He then goes there and finds her. He learns her name is Beth. He tries to tell her what happened but can't get the words out. She assumes he's there to apply for the job they advertised looking for someone to help at her family's business, a dog kennel. He says yes but at first she gets an uneasy feeling from him but her grandmother decides to give him a chance. It isn't long that he makes a connection with her son. He then discovers that it was her brother who had the picture only he doesn't remember him. He sees that her brother's death has a profound effect on her. Eventually they get close which makes her grandmother happy but not her ex who is a deputy sheriff who's always threatening to take their son away from her.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"PG-13"},"episode_id":8009,"content_control":"FAMILY"}}