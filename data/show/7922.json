_type":"comments"}],"post_info":{"genres":["Action","Adventure","Comedy"],"id":7922,"type":"MOVIE","title":"Jackie Chan's Who Am I?","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/420a3663-13ac-416f-a817-5ea2f04659f4.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/9a333b90-20b2-496a-b87d-76d93f2ae0ed.jpg","likes":112,"dislikes":3,"views":16920,"release_date":"884995200000","length":6481,"description":"Jackie Chan, a top secret militant soldier, crashes into the South African jungle after his mission of kidnapping three scientists (who were experimenting with a powerful mineral) has gone awry. Waking up in a village of local natives, Chan has no memory of who he is, thus being addressed as \"Who Am I\". His journey with aid from two female sidekicks to find out his identity leads him all the way to Rotterdam where he coincidentally discovers the location of the organization that kidnapped the three scientists. With no memory, Chan is thirsty for answers by any means necessary.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG-13"},"episode_id":7922,"content_control":"NORMAL"}}