o/storage/disk59/seasons/c4928bc3-4a55-498c-a53e-1d3f109b01d6.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/cfab52ff-a5e7-412a-b3da-f16a58472c16.jpg","likes":63,"dislikes":2,"views":15138,"release_date":"1500249600000","season_number":1,"description":"تحكي عن قصه زواج فريده من نوعها زواج ابنه الثامنه عشر من طفل يبلغ التاسعه من عمره ولكن كيف يحدث هذا ويجوز هذا الزواج تفسيره هو أن مان سينغ والد راتان الطفل ملك يمتلك مملكه كبيره ولكن ابنه راتان مازال صغيرا وحتى يرث العرش عنه لابد ان يكون قوي ويكبر ليكون مسؤولا والملك مان سينغ بنفس الوقت انقذ فتاه الثامنه عشر وهى ديا شجاعه وقويه وجميله تحاول ان تسد دين عليها لمان سينغ لانه انقذ حياتها وهى طفله ويطلب منها ان ترد له الجميل بأن تتزوج أبنه راتان وتنقذه من الاعداء الذين يرغبون بموته ولكن ما يثير للدهشه هنا أن راتان يقع فى حب ديا من أول نظره ويرغب بالزواج منها ، هل ستوافق ديا بالزواج من طفل اصغر منها حتى ترد الدين؟ هل ستحمي راتان حقاً من الموت؟ لنري ماذا سيحدث .","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"TV-14"},"current_season_id":4727,"content_control":"NORMAL"}}