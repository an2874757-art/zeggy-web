d":20308,"title":"","description":"237","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":20308,"type":"SERIES","title":"رأفت الهجان","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/7204fb69-0dee-4e09-b55d-a7ca876f9577.jpg","background_image":"https://cdn6.albox.co/storage/disk44/seasons/77f6cded-07be-49d2-9373-5ecef0a520ba.jpg","likes":173,"dislikes":6,"views":122153,"release_date":"-2208988800000","season_number":1,"description":"قصة الجزء الاول لمسلسل رأفت الهجان : الجزء الأول من الملحمة الوطنية المستوحاة من قصة الجاسوس المصري (رفعت علي سليمان الجمال) الذي تم زرعه داخل المجتمع اﻹسرائيلي للتجسس لصالح المخابرات المصرية. رفعت الجمال في المسلسل هو رأفت الهجان (محمود عبد العزيز)، وفي الجزء الأول نتعرف على مقدمة الملحمة وعلاقة رأفت بالمخابرات المصرية، ونتعرف على زوجته هيلين سمحون (يسرا)، ونتابع قصته في مصر، وترتيب المخابرات المصرية لتاريخه اليهودي فيها، وكيفية خروجه من مصر، لكي يبدأ رحلة الجاسوسية ضد إسرائيل ولصالح المخابرات المصرية.\r\n","rating":{"sources":[],"value":0,"age":"N/A"},"current_season_id":9236,"content_control":"NORMAL"}}