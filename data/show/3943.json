e":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3943,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Mystery","Horror"],"id":3943,"type":"MOVIE","title":"The Shortcut","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/4a60c864-86a7-4776-9ef4-af3d1ddfddef.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/5e69236c-b240-477c-bdd1-f09b90d5d618.jpg","likes":18,"dislikes":2,"views":3695,"release_date":"1254182400000","length":5115,"description":"High school senior Derek was adjusting to life in a new town when he discovered an overgrown path leading into the woods. According to his classmates, the local kids used to use it as a shortcut before a malevolent farmer began chasing them away with a shovel. Eventually, a few of the local kids went missing under mysterious circumstances. Rumor has it that the old man got them. Now years have passed, and no one dares go near the path. The townspeople have simply accepted the fact that it's off limits. But Derek suspects that the old man is hiding something, and he's determined to find out what it is. Once he uncovers the sinister secret that lies just beyond the trees, however, he may not live to reveal the awful truth.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.1}],"value":5.1,"age":"PG-13"},"episode_id":3943,"content_control":"NORMAL"}}