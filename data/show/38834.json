العلاقات المعقدة، يستكشف العرض صعود أورهان وسط الصراعات الداخلية والتهديدات الخارجية، مواصلا إرث كورولوش: عثمان بجيل جديد من الشخصيات وسرد قصصي عالي المخاطر.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":9}],"value":9,"age":"PG-13"},"background_color":"","current_season_id":23692,"content_control":"NORMAL"}}