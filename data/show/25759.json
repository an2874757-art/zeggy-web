"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":25759,"type":"SERIES","title":"Hakim - القاضي","logo":"https://cdn8.albox.co/storage/CLOUD00/shows/76cc7948-50fd-4743-b356-ebd169ca9cf3.png","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/d244a961-f30f-48e4-9c37-0a52eb2fcf10.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/2b45fe5f-6294-4cb1-a324-2479f471486b.jpg","likes":44,"dislikes":1,"views":7343,"release_date":"1649030400000","season_number":1,"description":"تدور قصة مسلسل القاضي حول أحد القضاة الأتراك الكبار المعروفين بصدقهم وقوتهم القانونية وعدم تأيده للخطأ مهما كان. وهو في طريقه للحصول على ترقية جديدة وكبيرة في حياته العمل يتورط ابنه بقضية كبيرة. وهو صدمه لأحد الرجال وهروبه. يجد نفسه هذا القضي متورط مع أحد العائلات الإجرامية الكبيرة. ليدخل هذا القاضي في مصادمات وحروب كبيرة لإنقاذ ابنه من تلك القضية وهذه العائلة.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"background_color":"#885d3b","current_season_id":13741,"content_control":"NORMAL"}}