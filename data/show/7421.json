ًا لوالده.. يتوفى علي ويرث منصور كل شيء من أمواله وأملاكه وحتى إتجاره بالمخدرات، ويساعده في ذلك الضابط رشدي (خالد الصاوي) بتيسير عمليات بيع السلاح والمخدرات لمنصور مقابل إبلاغه عن عصابات الصعيد، إلا أن الوضع يتطور وتتأزم الأمور بينهما.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.7}],"value":8.7,"age":"PG-13"},"episode_id":7421,"content_control":"NORMAL"}}