"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10883,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Thriller"],"id":10883,"type":"MOVIE","title":"Riddick","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/4e70a719-4c0f-41ea-8621-08fc27fe3169.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/d9cd9c3b-dc7f-4d2c-8b67-b485af0c99a7.jpg","likes":148,"dislikes":5,"views":20527,"release_date":"1378425600000","length":7607,"description":"The infamous Riddick has been left for dead on a sun-scorched planet that appears to be lifeless. Soon, however, he finds himself fighting for survival against alien predators more lethal than any human he's encountered. The only way off is for Riddick to activate an emergency beacon and alert mercenaries who rapidly descend to the planet in search of their bounty. The first ship to arrive carries a new breed of merc, more lethal and violent, while the second is captained by a man whose pursuit of Riddick is more personal. With time running out and a storm on the horizon that no one could survive, his hunters won't leave the planet without Riddick's head as their trophy.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.4}],"value":6.4,"age":"R"},"episode_id":10883,"content_control":"FAMILY"}}