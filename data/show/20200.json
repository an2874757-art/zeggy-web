:"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/e057f648-9e40-4253-a871-31be4fce0aea.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":37093,"title":"Mizuzokusei no Mahoutsukai","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/3fa61e34-4b15-43f5-945b-21408a398716.JPG"},"length":0,"continue_watching_progress":0},{"items":[],"id":39411,"title":"Sentenced to Be a Hero","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/e08eca5e-e447-480c-b55a-e3f92413e1fa.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":20200,"title":"","description":"13","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Animation","School"],"id":20200,"type":"SERIES","title":"Tsuki ga Kirei","logo":"","image":"https://cdn6.albox.co/storage/disk59/seasons/8cbed4e0-00cc-4fd9-a55a-196ddaef8410.jpg","background_image":"https://cdn6.albox.co/storage/disk44/seasons/55fc1e6f-fabb-4b10-9e6d-b238309024d9.png","likes":105,"dislikes":1,"views":9526,"release_date":"1491523200000","season_number":1,"description":"With a new school year comes a new crowd of classmates, and for their final year of junior high, aspiring writer Kotarou Azumi and track team member Akane Mizuno end up in the same class. Though initially complete strangers, a few chance encounters stir an innocent desire within their hearts. A yearning gaze, a fluttering heart—the hallmarks of young love slip into their lives as fate brings their paths to a cross.\r\n\r\nHowever, though love is patient and love is kind, Kotarou and Akane discover it is not always straightforward. Despite the comfort they find in each other's company, heartache and anxiety come hand in hand with pursuing the feelings in their hearts. With the uncertainty of how the other truly feels as well as the competing affections of those around them, the road ahead is unclear. Even so, under the shining light of a beautiful full moon, Kotarou gathers his courage to ask Akane a single question, one that forever changes their quiet relationship.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"pg-13"},"current_season_id":9101,"content_control":"NORMAL"}}