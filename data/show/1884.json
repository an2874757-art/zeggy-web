title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Comedy","Crime"],"id":1884,"type":"MOVIE","title":"Rumble in the Bronx","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/e6991035-ba1d-4898-aa2e-2562ce29f28b.jpeg","background_image":"https://cdn6.albox.co/storage/disk58/shows/ae6be856-3d4e-4045-b12c-1b4a3195971d.jpeg","likes":51,"dislikes":1,"views":4798,"release_date":"825033600000","length":5374,"description":"Keong comes from Hong Kong to visit New York for his uncle's wedding. His uncle runs a market in the Bronx and Keong offers to help out while Uncle is on his honeymoon. During his stay in the Bronx, Keong befriends a neighbor kid and beats up some neighborhood thugs who cause problems at the market. Meanwhile, one of those petty thugs in the local gang stumbles into a criminal situation way over his head. Blinded by greed, his involvement draws his gang, the kid, Keong, and the whole neighborhood into a deadly crossfire. When the lazy cops fail to successfully resolve matters, Keong takes things into his own hands. Needless to say, much spectacular kung-fu and outrageous action sequences follow....","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":1884,"content_control":"NORMAL"}}