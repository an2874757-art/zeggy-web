type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Crime","Family"],"id":9367,"type":"MOVIE","title":"Nancy Drew","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/f4158854-91f6-4fbf-ad6a-863b89f487ac.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/5346cd47-10b3-48b8-b954-69a1332a95ad.jpg","likes":90,"dislikes":4,"views":7270,"release_date":"1181865600000","length":5959,"description":"Nancy Drew accompanies her father on a business trip to Los Angeles California. Nancy booked an abandoned house for them to stay in hiding the mystery of a movie star's murder from her father as a promise that she would stay out of trouble and be normal. Fitting into high school as a normal teen turns out to be harder than it sounds, for Nancy Drew. She soon befriends a younger boy and determines that the sleuthing world is where she belongs. While snooping through the attic, she finds a letter from the Hollywood star, Dehlia Draycott, written to someone named 'Z'. This leads Nancy on a wild goose chase as she comes to find out that Dehlia has a secret daughter, her daughter is to inherit everything and someone killed Dehlia because they were written out of the will.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":9367,"background_color":"","content_control":"NORMAL"}}