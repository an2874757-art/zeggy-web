cription":"34","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"],"id":8168,"type":"MOVIE","title":"Grown Ups","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk55/shows/2193cb41-6004-4f12-9f96-f115d0953a7f.jpeg","likes":259,"dislikes":4,"views":23068,"release_date":"1277424000000","length":6140,"description":"In 1978, five 12-year-olds win a CYO basketball championship. Thirty years later, they gather with their families for their coach's funeral and a weekend at a house on a lake where they used to party. By now, each is a grownup with problems and challenges: Marcus is alone and drinks too much. Rob, with three daughters he rarely sees, is always deeply in love until he turns on his next ex-wife. Eric is overweight and out of work. Kurt is a househusband, henpecked by wife and mother-in-law. Lenny is a successful Hollywood agent married to a fashion designer; their kids take privilege for granted. Can the outdoors help these grownups rediscover connections or is this chaos in the making?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-13"},"episode_id":8168,"content_control":"FAMILY"}}