"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7913,"title":"","description":"29","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi"],"id":7913,"type":"MOVIE","title":"Transformers: Age of Extinction","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/de36fc36-1f46-4155-816e-e1f006daa472.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/01235de2-1566-4250-bbd3-b17d950b4695.jpg","likes":484,"dislikes":11,"views":63738,"release_date":"1403827200000","length":9907,"description":"After the battle between the Autobots and Decepticons that leveled Chicago, humanity thinks that all alien robots are a threat. So Harold Attinger, a CIA agent, establishes a unit whose sole purpose is to hunt down all of them. But it turns out that they are aided by another alien robot who is searching for Optimus Prime. Cade Yeager, a \"robotics expert\", buys an old truck and upon examining it, he thinks it's a Transformer. When he powers it up, he discovers it's Optimus Prime. Later, men from the unit show up looking for Optimus. He helps Yeager and his daughter Tessa escape but are pursued by the hunter. They escape and Yeager learns from technology he took from the men that a technology magnate and defense contractor named Joshua Joyce is part of what's going on, so they go to find out what's going on.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.7}],"value":5.7,"age":"PG-13"},"episode_id":7913,"content_control":"FAMILY"}}