/disk60/shows/00a2069c-dda2-4512-91db-e01519fc928f.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7541,"title":"","description":"9","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","History"],"id":7541,"type":"MOVIE","title":"The Young Victoria","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/c361ed56-664d-43a4-8465-d30cbbdaa417.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/5bbca937-ddde-4150-9ba3-5eddcb045ee5.jpg","likes":80,"dislikes":3,"views":8492,"release_date":"0","length":6279,"description":"Dominated by her possessive mother and her bullying consort, Conroy, since childhood, teen-aged Victoria refuses to allow them the power of acting as her regent in the last days of her uncle, William IV's rule. Her German cousin Albert is encouraged to court her for solely political motives but, following her accession at age eighteen, finds he is falling for her and is dismayed at her reliance on trusty Prime Minister Melbourne. Victoria is impressed by Albert's philanthropy which is akin to her own desire to help her subjects. However her loyalty to Melbourne, perceived as a self-seeker, almost causes a constitutional crisis and it is Albert who helps restore her self-confidence. She proposes and they marry, Albert proving himself not only a devoted spouse, prepared to take an assassin's bullet for her, but an agent of much-needed reform, finally endorsed by an admiring Melbourne.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG-13"},"episode_id":7541,"background_color":"","content_control":"NORMAL"}}