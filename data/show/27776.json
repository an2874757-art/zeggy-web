logo":"https://cloud01.albox.co/shows/f9b21c6f-f526-4d06-96f1-c8d835ff7c7c.png","image":"https://cloud01.albox.co/shows/27ae9321-e773-44d1-b264-81b98cee8f85.jpg","background_image":"https://cloud01.albox.co/shows/464a983e-8ea2-476b-b722-8b78a1796f59.jpg","likes":96,"dislikes":2,"views":5838,"release_date":"1643932800000","length":6801,"description":"في السنوات التي أعقبت الحرب الشرسة ، تسيطر إمبراطورية زول الآن على أراضي ومواطني أكوافا المنافسة - باستثناء منطقة أكوافا فاير هورس ، حيث تستمر الكلاب البرية التي كانت تحمل في السابق حمى الذئب الأسود القاتلة في التجول بحرية. عندما تتسابق مجموعة من الكلاب عبر منجم خاضع لسيطرة الزول ، يتعرض فان ، وهو جندي سابق مستعبد ، وفتاة صغيرة تُدعى يونا ، للعض ، لكنهما يتمكنان من الفرار باعتبارهما الناجين الوحيدين من الهجوم. أخيرًا مجانًا ، يبحث Van and Yuna عن حياة بسيطة وسلمية في الريف. ولكن مع تفشي المرض الفتاك مرة أخرى ، وجدوا أنفسهم على مفترق طرق صراع أكبر بكثير من أي دولة واحدة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"R"},"episode_id":560037,"background_color":"#bac9a5","content_control":"NORMAL"}}