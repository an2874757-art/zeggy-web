لول التسعينيات، أصبح مبنى متعدد الاستخدامات، يحمل كل عصر قصصًا جديدة عن الأشخاص الذين مروا به.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"background_color":"","current_season_id":21953,"content_control":"NORMAL"}}