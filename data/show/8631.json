scription":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Animation","Family"],"id":8631,"type":"MOVIE","title":"Alvin and the Chipmunks","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/af6128a0-a988-4bc4-90e7-f57b35ecf3c2.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/94735560-01b3-4fb2-baff-de29dacb5c29.jpg","likes":80,"dislikes":0,"views":8849,"release_date":"1197590400000","length":5474,"description":"In a tree farm, three musically inclined chipmunks, Alvin, Simon and Theodore, find their tree cut down and sent to Los Angeles. Once there, they meet the frustrated songwriter David Seville, and despite a poor house wrecking first impression, they impress him with their singing talent. Seeing the opportunity for success, both human and chipmunks make a pact for them to sing his songs. While that ambition proves a frustrating struggle with the difficult trio, the dream does come true after all. However, that success presents its own trials as their unscrupulous record executive, Ian Hawke, plans to break up this family to exploit the boys. Can Dave and the Chipmunks discover what they really value amid the superficial glamor around them?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.2}],"value":5.2,"age":"PG"},"episode_id":8631,"content_control":"FAMILY"}}