shows/8559c19f-d133-4cfc-83c8-98ab4dae5a73.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3765,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Comedy","Animation","Crime","Family"],"id":3765,"type":"MOVIE","title":"Osmosis Jones","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/920f4f39-a9fe-4ed9-b596-6486671adebe.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/3e27134a-7be3-4318-bba4-8ff6ec89f3ef.jfif","likes":11,"dislikes":1,"views":2019,"release_date":"997401600000","length":5723,"description":"Frank Detomello is a slovenly zoo keeper, and simple father to the only young and bright girl named Shane, who catches a cold right after he swallowed a germ-ridden egg! The inside of his body is known as the \"City of Frank\". An unlikely hero of a policeman white blood cell, by the name of Osmosis Jones, works as a member of Immunity cell. But with that germ-ridden egg comes a mortal danger: Osmosis discovers Frank has really contracted a villainous and black-hearted deadly virus known as Thrax who arrives and is plotting to ultimately overheat Frank's body, killing him from the inside out! Thrax is motivated by trying to become the nastiest new virus, attempting to kill each new victim faster than the previous. His grandiose plan for Frank is death in 48 hours, breaking previous medical records! Meanwhile the pill that Frank took, Drix arrives in the body and covers Frank's throat with ice to cover the irritation. Osmosis Jones becomes his newest partner. Now it's all up to only Osmosis and Drix to put an end of Thrax's plans before Frank gets sick forever and Shane will become an orphan!","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"PG"},"episode_id":3765,"content_control":"FAMILY"}}