://cloud02.albox.co/seasons/a4b0e8c4-7332-4b33-8c84-c3796d0d2efe.jpg","background_image":"https://cloud02.albox.co/seasons/9faaad21-0451-4d68-a276-f16a1e9ef83c.jpg","likes":48,"dislikes":11,"views":6388,"release_date":"1755820800000","season_number":1,"description":"في ثمانينيات القرن الماضي، كانت تشونغمورو، قلب صناعة السينما في كوريا الجنوبية، تتربع جونغ هوي ران على عرش التمثيل في البلاد. بطبعها الحاد وشخصيتها القوية، لا تتردد في التعبير عن رأيها أو كشف المخالفات. ومن المقرر أن تلعب دور البطولة في فيلم *مدام آيما*، أحدث أفلام المنتج كو جونغ هو، وهو خبير مخضرم في صناعة السينما لا يرحم، ويبذل قصارى جهده للبقاء في الصدارة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"background_color":"","current_season_id":21850,"content_control":"NORMAL"}}