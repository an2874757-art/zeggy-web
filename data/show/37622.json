url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance","drama "," Wuxia"],"id":37622,"type":"SERIES","title":"When Destiny Brings the Demon","logo":"https://cloud02.albox.co/shows/b7f08b8e-6c4e-4901-8716-24e7fe091b6a.jpg","image":"https://cloud02.albox.co/seasons/eb47a192-60f5-4801-9ccb-019e5ab9eccd.jpg","background_image":"https://cloud02.albox.co/seasons/29b10c8d-df40-4f2d-ae7a-354e81afd38b.jpg","likes":285,"dislikes":6,"views":31928,"release_date":"1755302400000","season_number":1,"description":"بعد لقائه بسيما جياو، سيد قصر غينغتشين الخالد، الذي حُبس في الجبال لخمسمائة عام، ولياو تينغ يان، الذي وصل فجأةً إلى عالم الخلود، غلبته غريزة \"السمك المملح\" (مصطلح يُستخدم لوصف الأشخاص الذين يُقلّلون من شأن أنفسهم ولا يسعون وراء أي شيء) التي تدفعه إلى عدم الرغبة في أي شيء. ومنذ ذلك الحين، بدأ لياو تينغ يان بتوجيه سيما جياو نحو الخير تدريجيًا، وأصبح الشخص الذي غيّره.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"R"},"background_color":"","current_season_id":21801,"content_control":"NORMAL"}}