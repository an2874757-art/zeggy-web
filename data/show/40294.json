itle":"قيامة ارطغرل مترجم","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk50/shows/4974dfd8-bd3d-4199-aae8-6b2e0bafdb5a.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":39389,"title":"ورود وذنوب  مدبلج","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/229d945f-27d9-4108-b63b-9fa8690601e8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35227,"title":"Şakir Paşa Ailesi - عائلة شاكر باشا","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/9ab47abf-4ef9-496b-9661-29704bf0adb8.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":40294,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":40294,"type":"SERIES","title":"بائعة الورد مدبلج","logo":"","image":"https://cloud02.albox.co/seasons/6b70bb97-5afe-4647-9ddf-df90f6764473.jpg","background_image":"https://cloud02.albox.co/seasons/6540cd0c-4448-4ed5-ba06-1e8cc013eeb1.jpg","likes":114,"dislikes":5,"views":26291,"release_date":"1267142400000","season_number":1,"description":"غونولتسلين مستوحى من مسرحية برنارد شو 'بيغماليون' وفيلمها المقتبس 'سيدتي الجميلة'. ينقل المسلسل المشهد إلى إسطنبول حيث يعيش كل من مراد وحسرت، الشخصيتان الرئيسيتان. مراد يبلغ من العمر ثلاثين عاما وهو موسيقي ومعلم موسيقي ناجح ولد ونشأ في إسطنبول. ينحدر من سلالة طويلة من الناس المحترمين والأغنياء والنبيلين. أما البطلة النسائية حسرت - من ناحية أخرى - فقد ولدت ونشأت في أحد أحياء إسطنبول الأكثر فقرا. هي شابة حرة الروح ذات لسان 'فاحش'. تكسب حسرت رزقها من بيع الزهور والغناء أحيانا في فرقة موسيقية. يسمع مورات الإمكانات في صوتها غير المدرب، ويأخذ على عاتقه تعليمها أسرار الموسيقى من خلال تدريبها الكلاسيكي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-14"},"background_color":"","current_season_id":23506,"content_control":"NORMAL"}}