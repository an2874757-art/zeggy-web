nts","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy","Animation"],"id":7472,"type":"MOVIE","title":"Antz","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/a1e814e6-b66e-41a7-8410-b8b326a080bb.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/fd66208e-8f4d-486b-b7a1-0d0f74c1700c.jpg","likes":31,"dislikes":4,"views":4012,"release_date":"907286400000","length":5002,"description":"In an anthill with millions of inhabitants, Z 4195 is a worker ant. Feeling insignificant in a conformity system, he accidentally meets beautiful Princess Bala, who has a similar problem on the other end of the social scale. In order to meet her again, Z switches sides with his soldier friend Weaver - only to become a hero in the course of events. By this he unwillingly crosses the sinister plans of ambitious General Mandible (Bala's fiancé, by the way), who wants to divide the ant society into a superior, strong race (soldiers) and an inferior, to-be-eliminated race (the workers). But Z and Bala, both unaware of the dangerous situation, try to leave the oppressive system by heading for Insectopia, a place where food paves the streets.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG"},"episode_id":7472,"content_control":"FAMILY"}}