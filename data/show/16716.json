"url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/2d4be5dd-aee3-4d27-b593-270eaf570f8d.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":16716,"title":"","description":"36","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Crime"],"id":16716,"type":"SERIES","title":"NCIS","logo":"","image":"https://cdn6.albox.co/storage/disk54/seasons/1a5f78ca-934e-4fef-aa7d-7b6a076a27e7.jpg","background_image":"https://cdn6.albox.co/storage/disk42/seasons/8827a880-2fec-4cb1-bd71-071a7b01f85c.jpg","likes":191,"dislikes":12,"views":151229,"release_date":"1064275200000","season_number":1,"description":"Special Agent Leroy Jethro Gibbs is the leader of a team of special agents belonging to the NCIS (Naval Criminal Investigative Service) Major Case Response Team. Gibbs, a former Marine, is a tough investigator and a highly skilled interrogator who relies on his gut instinct as much as evidence. Gibbs' second in command is Senior Field Agent Tony DiNozzo, a womanizing, movie-quoting former Baltimore Homicide Detective, who despite being the class clown always gets the job done. The team also consists of probationary field agent Eleanor Bisbop, a former NSA agent, as well as Junior Field Agent Timothy McGee, a computer-savvy agent often mocked by DiNozzo. Assisting them are Abby Sciuto, the energetic-but-Goth lab tech who is like a daughter to Gibbs and is famously quoted as saying \"mike hunt won't stop bleeding!!\", and Dr. Donald Mallard, nicknamed Ducky, the eccentric medical examiner full of unusual stories. This team of elite agents, based in Washington, D.C., solve criminal cases involving Marine and Navy personnel and their families, sometimes traveling the United States - or the world - to do it.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"pg-13"},"current_season_id":4478,"content_control":"FAMILY"}}