ue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3016,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":3016,"type":"MOVIE","title":"The Cider House Rules","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/df0c476e-b02d-4506-8cf8-30877183fe25.jpg","background_image":"https://cdn6.albox.co/storage/disk51/shows/34d4fc5c-36e4-40a2-98bc-b4171016a38c.jpg","likes":30,"dislikes":1,"views":3363,"release_date":"947203200000","length":7525,"description":"Homer is an orphan in remote St. Cloud, Maine. Never adopted, he becomes the favorite of orphanage director Dr. Larch, who imparts his full medical knowledge on Homer, who becomes a skilled, albeit unlicensed, physician. But Homer yearns for a self-chosen life outside the orphanage. When Wally and pregnant Candy visit the orphanage Dr. Larch provides medically safe, albeit illegal, abortions Homer leaves with them to work on Wally's family apple farm. Wally goes off to war, leaving Homer and Candy alone together. What will Homer learn about life and love in the cider house? What of the destiny that Dr. Larch has planned for him?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":3016,"content_control":"FAMILY"}}