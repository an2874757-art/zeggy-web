:"18","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy","Horror"],"id":8262,"type":"MOVIE","title":"A Nightmare on Elm Street 3: Dream Warriors","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/43926c46-d770-4073-a5b8-f750e4f5264f.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/f4f6a56a-4d21-45d0-a68a-d027a25b6f3a.jpg","likes":84,"dislikes":2,"views":5821,"release_date":"541382400000","length":5792,"description":"Picking up where the original Nightmare left off, Nancy has grown up and become a psychiatrist specializing in dream therapy. She meets a group of children at a local hospital facing Freddy Krueger, the same demon she once encountered in her sleep. One of them is Kristen, who has the power to draw other people into her dreams. Working with a male doctor assigned to the case, Nancy helps the kids realize their special abilities within the nightmare world. When Freddy captures one of her charges, she leads a rescue attempt into Krueger's domain, in hopes of putting his spirit to rest once and for all.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"R"},"episode_id":8262,"content_control":"FAMILY"}}