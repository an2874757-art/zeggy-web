فسها باستمرار: هل يُمكنها التكفير عن جريمتها إذا قضت فترة سجنها؟ في أحد الأيام، تزور شقيقتها الكبرى ناتسو كوماتسوبارا صالون التجميل داخل سجن النساء.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.5}],"value":6.5,"age":"R"},"background_color":"","current_season_id":21919,"content_control":"NORMAL"}}