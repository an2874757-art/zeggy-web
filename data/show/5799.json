ps://cloud02.albox.co/shows/84291716-eb10-43c9-af9b-6d65144a46e5.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":34729,"title":"Terrifier 3","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/4c56fcc0-0fe9-4cdf-b65a-68dd273895fb.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":24271,"title":"Venom: Let There Be Carnage","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/5df18ace-f7a2-4df0-b46d-379a9d4c80ae.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":27378,"title":"Blonde","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/c2d85126-babc-4789-8eb0-801ecb14e10e.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":30104,"title":"Spider-Man Across the Spider Verse","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/d03d2339-28d6-4234-8cb9-636598e64ebb.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10256,"title":"Harry Potter and the Deathly Hallows: Part 2","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/9553d7a6-6ae9-40cc-8a13-bdcec52737e0.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5799,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Romance","Comedy","Family"],"id":5799,"type":"MOVIE","title":"Bedtime Stories","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/1c81f482-0dd8-46bb-8a34-b75670d3ac7c.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/e858950d-5ae2-4025-975d-e8d7c1f57543.jpg","likes":22,"dislikes":0,"views":3820,"release_date":"1230163200000","length":5954,"description":"In 1974, Marty Bronson builds the Sunny Vista Motel in Los Angeles, California, with the intention of raising his son Skeeter and his daughter Wendy in the place where he works. However he is not a good businessman and the hotel goes bankrupt. Marty is forced to sell his motel to Barry Nottingham who promises to hire Skeeter in a general manager position when he has grown up. Years later, Barry builds a new hotel; forgets his promise to Marty; and Skeeter Bronson is only the handyman of his hotel. The general manager is the arrogant Kendall, who is engaged with the shallow Barry's daughter Violet Nottingham. When the Webster Elementary School where Wendy is the principal will be closed to be demolished, she needs to travel to Arizona for a job interview. Wendy asks her friend Jill, who is teacher in the same school, to watch her son Patrick and her daughter Bobbi during the day and Skeeter to watch them during the night. Skeeter meets the estranged kids with his best friend Mickey and makes up bedtime stories to help them to sleep but the kids add details to the stories, changing their endings. Soon Skeeter realizes that the plot of the stories are coming true and affecting his life. Meanwhile Barry Nottingham decides to give a change to Skeeter to dispute the manager position in his new hotel with Kendall like in one of his stories. But Skeeter has told to his nephew and his niece that stories do not have happy endings.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":5799,"background_color":"","content_control":"FAMILY"}}