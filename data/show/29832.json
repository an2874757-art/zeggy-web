ound_image":"https://cloud01.albox.co/shows/6528fdb9-8470-466d-bf08-ccaea27b19be.jpg","likes":56,"dislikes":2,"views":5955,"release_date":"1683849600000","length":7207,"description":"يناير 2118. تلقى كبير مفتشي إدارة التحقيقات الجنائية ، أكاني تسونيموري ، تقريرًا عن حادثة على سفينة أجنبية - تم اكتشاف جثة الأستاذة ميليشيا سترونسكايا. وراء الحادث مجموعة تعرف باسم Peacebreakers ، وهي منظمة شبه عسكرية أجنبية وتهديد خارجي جديد يستهدفون أوراق البروفيسور البحثية المعروفة باسم \"وثيقة سترونسكايا\". يجتمع `` أكاني '' مجددًا مع `` شينيا كوغامي '' ، الهارب السابق من دائرة التحقيقات الجنائية ، ويواجه قضية تتصاعد بسرعة تتجاوز توقعاتهم. قد تكشف أوراق سترونسكايا عن حقيقة من شأنها أن تهز الحكومة اليابانية ، وحتى نظام العرافة ، حتى النخاع. تم الكشف عن الحلقة المفقودة في هذه القصة غير المروية.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"episode_id":843361,"background_color":"","content_control":"FAMILY"}}