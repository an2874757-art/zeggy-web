tion":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/b897836a-3504-4f75-91b0-2b4ef4f9182c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":672,"title":"The Housemaid","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk57/shows/bd72d03e-29af-4f7c-aa0b-4a8cb5b6e0d2.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":24183,"title":"Shark: The Beginning","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/ab965921-9aae-400b-9750-285af036889c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":36696,"title":"11 Rebels","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/4b96baa0-8c40-4bad-9b06-56c6f6bb4603.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":772,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Thriller"],"id":772,"type":"MOVIE","title":"Haunters","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk51/shows/02bc6f63-df15-4869-bb0e-dd83d1954182.jpg","likes":45,"dislikes":3,"views":7605,"release_date":"1289347200000","length":6458,"description":"After losing his job at a scrap metal yard, Kyu-Nam finds a new job at a small pawn shop named Utopia. He is immediately drawn to the family atmosphere at Utopia, working with his new boss Jung-Sik and boss's daughter Young-Sook. Unfortunately for Kyu-Nam, his moment of happiness will only be fleeting. Cho-In lived through a brutal childhood. He has had to use a prosthetic leg since an early age, grew up with an abusive father and lived with a mother who at one point attempted to kill her own son out of despair. Cho-In also possesses an awe-inspiring supernatural gift. Cho-In can control other people's minds when they are within his field of sight. One fateful day, Cho-In walks into the Utopia pawn shop to steal whatever money exists in the safe. Not expecting much resistance, Cho-In is surprised to find one man at the Utopia pawn shop is able to break free from his mind control abilities. That man is Kyu-Nam. Cho-In then resorts to killing the owner of pawn shop to make his escape. All of this is captured on CCTV. An epic battle will soon occur between these two people with supernatural abilities and nothing to lose.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"R"},"episode_id":772,"content_control":"NORMAL"}}