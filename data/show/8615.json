g_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8615,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy","Family"],"id":8615,"type":"MOVIE","title":"Annie","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/ce396a80-4310-4995-b9ff-0f0cab937df7.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/54f1b841-17d5-42f5-91ea-a23ba5210ed8.jpg","likes":49,"dislikes":0,"views":4376,"release_date":"1418947200000","length":7103,"description":"Annie is a young, happy foster kid who's also tough enough to make her way on the streets of New York in 2014. Originally left by her parents as a baby with the promise that they'd be back for her someday, it's been a hard knock life ever since with her mean foster mom Miss Hannigan. But everything's about to change when the hard-nosed tycoon and New York mayoral candidate Will Stacks - advised by his brilliant VP, Grace and his shrewd and scheming campaign advisor, Guy - makes a thinly-veiled campaign move and takes her in. Stacks believes he's her guardian angel, but Annie's self-assured nature and bright, sun-will-come-out-tomorrow outlook on life just might mean it's the other way around.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"episode_id":8615,"background_color":"","content_control":"FAMILY"}}