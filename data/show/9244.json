ontinue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9244,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Romance"],"id":9244,"type":"MOVIE","title":"The Lovers - Time Traveller","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/9993514f-9c26-4d6e-8900-421365c5bd0d.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/b96a1288-86e7-4ba3-9bb6-7e8accc4cdda.jpg","likes":12,"dislikes":0,"views":4658,"release_date":"1423785600000","length":6569,"description":"Great Barrier Reef, 2020. After a dangerous dive to save his wife Laura trapped while exploring an colonial British merchant ship wreckage, Jay Fennel, a rugged and attractive marine archeologist lies brain dead in a Boston hospital. Fennel's dream-like coma takes us back in time to Pune, India in 1778. The British East India Company is invading the palaces and a young captain named James Stewart, who bears a striking resemblance to Fennel, is about to embark on a dangerous mission. Along the way he encounters murder, deceit, betrayal and revenge. He falls deeply in love with an Indian She-warrior named Tulaja, an impossible love which he must fight for. Only the power of a ring can transcend time and save a life.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.5}],"value":4.5,"age":"R"},"episode_id":9244,"background_color":"","content_control":"NORMAL"}}