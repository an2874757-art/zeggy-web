omments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":1667,"type":"MOVIE","title":"My Blueberry Nights","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/31298b8d-bc5a-4b27-8b98-74863e88cd7f.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/71a94206-24f7-47aa-9c0e-71bf73eec2b6.jpg","likes":19,"dislikes":2,"views":6831,"release_date":"1196208000000","length":5703,"description":"Elizabeth's heart is broken. For solace, she drops in late at night a few times at Jeremy's diner for blueberry pie a la mode; they talk. Once, he watchers her sleep, her head on the counter. Abruptly, she leaves New York City to get away from her pain. She works a couple of jobs in Memphis. There, a heart-broken cop is drinking himself into oblivion, his ex occasionally showing up where he drinks and Lizzy works. Then, she's in Nevada, working at a casino where she uses her savings (she wants a car) to stake Leslie, a busted gambler, in a high rollers' game. After, Beth drives Leslie to Vegas where Leslie's estranged father lives. Broken relationships. What about Jeremy?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"episode_id":1667,"content_control":"NORMAL"}}