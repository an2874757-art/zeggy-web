id":4988,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure"],"id":4988,"type":"MOVIE","title":"Viking Legacy","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/c21f4550-76e2-4d15-b41a-7004fc3e0eb3.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/22c68224-08c8-4c3f-83a8-e00705a04ba1.jpg","likes":59,"dislikes":3,"views":18371,"release_date":"1474243200000","length":4802,"description":"In ancient times, there were seven sacred scrolls believed to grant power and prosperity to those who possessed them. Prophecy told that a child born in pure Royal blood would one day harness power and rule over the nations. As men fought to claim the scrolls, Europe was pushed to the brink of war. In order to maintain peace, a Celtic King, the Father of a pure blood child, obtained the scrolls and gave them to the Christian Council for safe keeping. As word of the King's actions spread, a warlord hell - bent on finding the scrolls murdered him in cold blood. And so, the King's Daughter, like the scrolls, was taken into hiding until the day that the prophecy could be fulfilled.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":2.4}],"value":2.4,"age":"PG-13"},"episode_id":4988,"content_control":"NORMAL"}}