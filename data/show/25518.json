id":25518,"title":"","description":"18","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["رومانسية"],"id":25518,"type":"SERIES","title":"لا تترك يدي (مدبلج)","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/94be995c-b709-4161-88ce-96d6775c559c.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/7ffb4c45-aa93-459d-99c3-8e7b7604b188.jpg","likes":433,"dislikes":12,"views":144006,"release_date":"1552694400000","season_number":1,"description":"في إطار درامي، تدرس الفتاة أزرا في أمريكا لتصبح طاهية محترفة مثل والدها. وتقابل سينك، على متن الطائرة وتأخذ حقيبته عن طريق الخطأ بدلاً من حقيبتها. ويعود سينك الذي تم طرده من جامعته في أمريكا إلى اسطنبول ويكافح من أجل اختيار مصيره ويشهد التحول الكبير في حياة أزرا عندما يموت والدها في حادث حريق تاركًا إياها وابنه المصاب بالتوحد مع زوجته الجشعة.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"PG-13"},"background_color":"","current_season_id":13520,"content_control":"NORMAL"}}