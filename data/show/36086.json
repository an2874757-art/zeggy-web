ب شو تونغ شنغ، يُصبحان فريقًا قويًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"background_color":"","current_season_id":20698,"content_control":"NORMAL"}}