me, dubbed \"Little Zorro\", and a small brown dog.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"N/A"},"current_season_id":7972,"content_control":"NORMAL"}}