 السابقة و اشياء اخرى كتبها بوصيته .","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"R"},"background_color":"","current_season_id":18228,"content_control":"NORMAL"}}