0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8285,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller"],"id":8285,"type":"MOVIE","title":"Kill for Me","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/ddc173b6-c0c8-48cb-a0f0-ce4b29b905d8.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/5880f190-c38e-447f-888c-ca52653e8661.jpg","likes":24,"dislikes":0,"views":2864,"release_date":"1360627200000","length":5697,"description":"The college student Natalie Ross goes missing and her friend and roommate Amanda Rowe accuses her ex-boyfriend Cameron McClure to the police. However nothing is proved against Cameron and Amanda's roommate Zoe decides to rent Natalie's room to share the expenses of their house. They accept the student Hayley Jones and she gets close to Amanda. When the upset Cameron threatens Amanda, Hayley defends her and they have a close relationship. Soon Cameron breaks in their house and hits Amanda; however Hayley arrives at home and hits Cameron on the head with an axe. Hayley convinces Amanda to hide the corpse, burying in the farm of her abusive father Garret Jones. Then she tries to convince Amanda to kill Garret, but Amanda refuses. Hayley kidnaps Amanda's friend Mark to force Amanda to kill her father. What will Amanda do?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"R"},"episode_id":8285,"content_control":"NORMAL"}}