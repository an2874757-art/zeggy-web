,"id":6873,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Crime","Mystery"],"id":6873,"type":"MOVIE","title":"Michael Clayton","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/bdf07e76-81e9-4e77-9cbc-e0b6c53678e9.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/52dc6795-90f1-4cca-a621-5ca4d3377813.jpg","likes":21,"dislikes":0,"views":2912,"release_date":"1192147200000","length":7178,"description":"Michael Clayton, a high-priced law firm's fixer, leaves a late night poker game, gets a call to drive to Westchester, and watches his car blow up as he's taking an impromptu dawn walk through a field. Flash back four days. He owes a loan shark to cover his brother's debts (Michael's own gambling habits have left him virtually broke). His law firm is negotiating a high-stakes merger, and his firm's six year defense of a conglomerate's pesticide use is at risk when one of the firm's top litigators goes off his meds and puts the case in jeopardy. While Michael is trying to fix things someone decides to kill him. Who? Meanwhile his son summarizes the plot of a dark fantasy novel.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"episode_id":6873,"content_control":"FAMILY"}}