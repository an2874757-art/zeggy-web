ن معا وعندما يتمكن عزت من التغلب على حمدى تسارع بدرية بقتله فتسجن هى الأخرى. تمر السنوات ويلتقيان ولا يتعرف أحدهما على الآخر، لقد فقد حمدى بصره.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"PG-13"},"episode_id":7154,"background_color":"","content_control":"NORMAL"}}