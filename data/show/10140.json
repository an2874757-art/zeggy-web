x.co/shows/14df597f-e8be-4468-b0f1-7651534318c6.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":2916,"title":"The Angry Birds Movie 2","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk46/shows/039dc607-bc89-4731-bb4d-02f3e9b50873.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":2461,"title":"The Addams Family","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/269f79bb-aeab-4b0c-87bc-bc7edb51a5e4.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10790,"title":"WALL·E","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk43/shows/ea1e1278-66ab-41cb-b00c-ecdd7eb03f6c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":7751,"title":"The Princess and the Frog","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/97c704c0-ef55-44ab-bef7-1799335b98e3.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":3283,"title":"The Secret Life of Pets 2","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/3f78481d-9f2a-4a29-bb77-95275dcd1d36.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":38441,"title":"The Twits","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/11755a59-397b-40c2-8fb0-266de309bd55.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10140,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Animation"],"id":10140,"type":"MOVIE","title":"Ice Age: The Meltdown","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/5476ad82-9300-4a1c-83cc-5be748efa175.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/e85dc343-f827-48c7-ade3-0a8b58a3c426.jpg","likes":106,"dislikes":3,"views":12596,"release_date":"1143763200000","length":5436,"description":"Manny the woolly mammoth, Sid the sloth, Diego the saber-toothed tiger, and the hapless prehistoric squirrel/rat known as Scrat are still together and enjoying the perks of their now melting world. Manny may be ready to start a family, but nobody has seen another mammoth for a long time; Manny thinks he may be the last one. That is, until he miraculously finds Ellie, the only female mammoth left in the world. Their only problems: They can't stand each other--and Ellie somehow thinks she's a possum! Ellie comes with some excess baggage in the form of her two possum \"brothers\"-- Crash and Eddie, a couple of daredevil pranksters and cocky, loud-mouthed troublemakers. Manny, Sid and Diego quickly learn that the warming climate has one major drawback: A huge glacial dam holding off oceans of water is about to break, threatening the entire valley. The only chance of survival lies at the other end of the valley. So our three heroes, along with Ellie, Crash and Eddie, form the most unlikely family--in any \"Age\"-- as they embark on a mission across an ever-changing, increasingly dangerous landscape towards their salvation.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"PG"},"episode_id":10140,"content_control":"FAMILY"}}