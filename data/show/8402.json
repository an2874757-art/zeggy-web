mments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Mystery","Horror"],"id":8402,"type":"MOVIE","title":"Julia's Eyes","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/5968d2d3-0047-4d5e-8522-b9bcdeb4b3b0.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/575f93fa-d601-497d-89a1-1e96526de22c.jpg","likes":54,"dislikes":1,"views":7092,"release_date":"1288310400000","length":7035,"description":"After the death of the blind Sara, who hanged herself in the basement of her house, her twin sister Julia suspects that she was actually murdered. Julia has a degenerative problem with her eyes and is losing her sight, and she temporarily moves with her husband Isaac to Sara's house to arrange her funeral. Julia goes to the Centro Baumann for the blind, which Sara frequented, and she learns from other members that Sara had a boyfriend. Julia is chased by a mysterious man, but police inspector Dimas does not believe her. Julia follows Sara's last steps trying to find the identity of her secret lover. Julia is surrounded by deaths and weird events while she loses her sight.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"r"},"episode_id":8402,"content_control":"NORMAL"}}