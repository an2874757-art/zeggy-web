ength":0,"continue_watching_progress":0},{"items":[],"id":3826,"title":"عيش حياتك","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/cb38e823-6ae9-43b0-9708-221a442b10c9.jpeg"},"length":0,"continue_watching_progress":0},{"items":[],"id":11850,"title":"ولاد رزق","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":""},"length":0,"continue_watching_progress":0},{"items":[],"id":2139,"title":"قصة حب","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk60/shows/67a09339-ed24-4567-aa55-233bd26f2fe0.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":41433,"title":"فاميلي بيزنس","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/66d7d8b8-db7c-41ee-a025-657fb98d1ec8.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3335,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Crime"],"id":3335,"type":"MOVIE","title":"المرأة والساطور","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/9df55189-d7d7-46c1-88bc-419c109365cd.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/fcf0ab2b-0c34-459f-93a0-818e31cc0cb5.jpg","likes":25,"dislikes":4,"views":10348,"release_date":"870048000000","length":6185,"description":"تدور أحداث الفيلم فى الإسكندرية حول قصة حقيقية لامرأة قتلت زوجها ومزقت جسده لاشلاء.. سعاد قاسم أرملة شابة ترك لها زوجها ثروة كبيرة والابنة المرهقة مديحة (14 سنة) فى حى سموحة، يلتقى بها محمود علوان النصاب فى الطريق الزراعى يوهمها أنه مدير مكتب رئيس الوزراء وأنه أرمل لينسج شباكه عليها حتى يتزوجها، فيحصل على توكيل رسمى ليتصرف فى ممتلكاتها ويبدد رصيدها فى البنك ويعاملها معاملة شاذة  كزوجة ويستولى على مصوعاتها، ويتضح أنه لا ينفق على أمه العجوز المريضة واخيه المتخلف بالقاهرة، وأنه يحمل بطاقات شخصية مزورة كرجل أعمال وكصحفى أيضا وان له ضحايا عديدين سلب أموالهم، ومنهم ألبير حبيب العجوز الذى سلب مدخراته وظل يطارده لاستردادها دون جدوى. يتمادى محمود فى إذلال سعاد، ويرفض إعادة الملايين الذى استولى عليها منها إليها، كما يرفض أن يطلقها وعندما يحاول اغتصاب ابنتها الوحيدة مديحة تسرع بذبحه، وتقطيع جسده إلى أشلاء وتلقى بكل منها فى جهة.. تنهار سعاد وتعترف لرجال الشرطة بالحقيقة، ويحكم عليها بالسجن المؤبد 15 سنة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"R"},"episode_id":3335,"content_control":"NORMAL"}}