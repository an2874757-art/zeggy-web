"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":12078,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi","Thriller"],"id":12078,"type":"MOVIE","title":"Aliens","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/ad9c3ee4-9ee7-4855-a816-d135c26bb6ad.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/ba186b49-261d-46ac-9e8d-164fe0c10c85.jpg","likes":110,"dislikes":3,"views":20984,"release_date":"522028800000","length":9267,"description":"Fifty seven years after Ellen Ripley survived her disastrous ordeal, her escape vessel is recovered after drifting across the galaxy as she slept in cryogenic stasis. Back on Earth, nobody believed her story about the \"Aliens\" on the moon LV-426. After the \"Company\" orders the colony on LV-426 to investigate, however, all communication with the colony is lost. The Company enlists Ripley to aid a team of tough, rugged space marines on a rescue mission to the now partially terraformed moon to find out if there are aliens or survivors. As the mission unfolds, Ripley will be forced to come to grips with her worst nightmare, but even as she does, she finds that the worst is yet to come.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"episode_id":12078,"content_control":"FAMILY"}}