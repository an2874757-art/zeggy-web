ess":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":10156,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","History"],"id":10156,"type":"MOVIE","title":"Lincoln","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/5cba7b95-55cd-41e8-a197-957f67ad1f57.png","background_image":"https://cdn6.albox.co/storage/disk44/shows/55228a85-adfe-4def-bce5-f753bad28f8e.png","likes":89,"dislikes":1,"views":7746,"release_date":"1353024000000","length":9038,"description":"In 1865, as the American Civil War winds inexorably toward conclusion, U.S. president Abraham Lincoln endeavors to achieve passage of the landmark constitutional amendment which will forever ban slavery from the United States. However, his task is a race against time, for peace may come at any time, and if it comes before the amendment is passed, the returning southern states will stop it before it can become law. Lincoln must, by almost any means possible, obtain enough votes from a recalcitrant Congress before peace arrives and it is too late. Yet the president is torn, as an early peace would save thousands of lives. As the nation confronts its conscience over the freedom of its entire population, Lincoln faces his own crisis of conscience -- end slavery or end the war.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"episode_id":10156,"content_control":"FAMILY"}}