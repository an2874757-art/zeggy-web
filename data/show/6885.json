e_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6885,"title":"","description":"21","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Thriller"],"id":6885,"type":"MOVIE","title":"Reign of Fire","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/e31bcf37-94bc-4dab-be94-3d189e8a0c65.jpg","background_image":"https://cdn6.albox.co/storage/disk53/shows/654334bd-c94e-4882-9c5f-2ff2f020b50b.jpg","likes":289,"dislikes":10,"views":41257,"release_date":"1026432000000","length":6118,"description":"It is twenty years in the future, and the planet has been devastated by vicious fire-breathing dragons. The last vestiges of humanity now struggle for survival at remote outposts. In a ruined castle in the English countryside, Quinn is desperately trying to hold together a band of frightened, restless survivors. As a boy, Quinn watched his mother die protecting him from one of the beasts, and is still haunted by the memory. One day, a group of American rogues shows up, led by a brash, tough-guy named Van Zan. He claims to have discovered a way to kill the dragons once and for all, and enlists Quinn's help. But doing so will force Quinn to confront his own frightening memories. This, and Quinn's responsibilities to those that are under his protection, results in a battle of wills between the two men. In the end, events cause them both to realize that they must work together to defeat the monsters--both without and within.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"PG-13"},"episode_id":6885,"content_control":"FAMILY"}}