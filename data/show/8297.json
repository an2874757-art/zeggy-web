.co/storage/disk58/shows/b82ceebb-4f74-4f6c-a63f-0bbc0dc82b4d.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8297,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Horror"],"id":8297,"type":"MOVIE","title":"Anacondas: The Hunt for the Blood Orchid","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/9cdfea81-e544-4b3a-b772-6b8efc19e68c.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/d9245cee-b767-47f0-b2f6-d4df5093986f.jpg","likes":35,"dislikes":0,"views":9154,"release_date":"1093564800000","length":5804,"description":"In New York, the ambitious Dr. Jack Byron and his associate Gordon Mitchell present the research of his assistant Sam Rogers to the CEO and board of directors of a corporation to sponsor a scientific expedition to Borneo. The objective is to find a flower, Blood Orchid, that flourishes for a couple of weeks every seven years and could be a fountain of youth, prolonging the expectation of life of human beings. They are succeeded and once in Borneo, they realize that it is the raining season and there is no boat available to navigate on the river. They pay US$ 50,000.00 to convince Captain Bill Johnson and his partner Tran to sail to the location. After an accident in a waterfall, the survivors realize that a pack of anacondas have gathered for mating and their nest is nearby the plantation of Blood Orchid, which made them bigger and bigger.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.6}],"value":4.6,"age":"PG-13"},"episode_id":8297,"content_control":"NORMAL"}}