ogress":0},{"items":[],"id":14156,"title":"كلارنس","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/c053d840-eb79-4f48-adae-de0a4282f972.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":17669,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":17669,"type":"SERIES","title":"النمر المقنع","logo":"","image":"https://cdn6.albox.co/storage/disk46/seasons/e9182bd3-d912-4cbd-be69-7afba8d93d79.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/c3487d14-0b3d-4411-bcad-1c8ffb92af01.jpg","likes":105,"dislikes":0,"views":8767,"release_date":"356572800000","season_number":1,"description":"تدور أحداث الجزء المدبلج من المسلسل حول صحفي يتصنع الغباء والحماقة اسمه تامر، والذي انتحل شخصية النمر المقنع الثاني بعدما مات النمر المقنع الأول (والذي سُمي صنديد) في حادث سير عندما ضحى بحياته من أجل إنقاذ طفل صغير، تعهد هذا النمر المقنع الجديد بتخليص حلبة المصارعة من كل الشرور، وقابل في حلقات المسلسل مجموعة من المصارعين من منظمة شريرة تهدف إلى السيطرة على عالم المصارعة تسمى اتحاد مصارعي الفضاء، بعد هزيمة النمر المقنع لمجموعة من المصارعين الأقوياء قابل في الحلقة الأخيرة رئيس المنظمة، والذي يدعى سترونغر، وبعد اعتراف سترونغر بالهزيمة في المباراة النهائية أفصح النمر المقنع للجميع عن هويته الحقيقية، ثم تابع المباراة مع سترونغر الذي أصيب أثناء المباراة بذبحة صدرية توفي على إثرها.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"PG-13"},"current_season_id":5791,"content_control":"NORMAL"}}