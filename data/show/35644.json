},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35644,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Animation","Family"],"id":35644,"type":"SERIES","title":"بي بليد المعركة الحديدية مدبلج","logo":"https://cloud02.albox.co/shows/99783962-af5a-4005-8b84-bc40d25be836.png","image":"https://cloud02.albox.co/seasons/f5f3adeb-27e2-4191-8fdd-ba058c9d8b2e.jpg","background_image":"https://cloud02.albox.co/seasons/1f0f7ebb-0194-4bff-936c-c753472fa2ce.jpg","likes":126,"dislikes":7,"views":9735,"release_date":"1238889600000","season_number":1,"description":"مجموعة جديدة من الشخصيات تأخذ المعركة المستمرة بين الخير والشر. Gingka ، بطلنا ، ومجموعته من الأصدقاء المخلصين يأخذون مجموعة خطيرة تسمى السديم المظلم. تتمثل مهمة Dark Nebula في الاستيلاء على العالم وإطلاق شرهم ؛ ولكن قبل أن يتمكنوا من القيام بذلك ، يجب عليهم تدمير Gingka لأنه الشخص الوحيد القوي بما يكفي للوقوف في طريقهم. تتساقط المؤامرة عندما يصبح الأصدقاء أعداء وأعداء يصبحون حلفاء. كل شيء يبدأ وينتهي بـ Gingka وهو يكافح من أجل العثور على القوة للدفاع عن عالمه وشرف Beyblade.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"TV-Y7-FV"},"background_color":"#787878","current_season_id":20291,"content_control":"NORMAL"}}