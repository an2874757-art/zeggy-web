":[{"items":[],"id":10264,"title":"","description":"121","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller","Crime","Mystery"],"id":10264,"type":"MOVIE","title":"Memories of Murder","logo":"","image":"https://cdn6.albox.co/storage/disk41/shows/4ff8ecb8-4cbd-4ee8-93fd-21c7342563fc.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/e179a95e-bcf3-489d-aa78-f57f1ee52ef6.jpg","likes":800,"dislikes":15,"views":66675,"release_date":"1044489600000","length":7868,"description":"In 1986, in the province of Gyunggi, in South Korea, a second young and beautiful woman is found dead, raped and tied and gagged with her underwear. Detective Park Doo-Man and Detective Cho Yong-koo, two brutal and stupid local detectives without any technique, investigate the murder using brutality and torturing the suspects, without any practical result. The Detective Seo Tae-Yoon from Seoul comes to the country to help the investigations and is convinced that a serial-killer is killing the women. When a third woman is found dead in the same \"modus-operandi\", the detectives find leads of the assassin.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"r"},"episode_id":10264,"background_color":"","content_control":"FAMILY"}}