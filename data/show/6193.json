type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":6193,"type":"MOVIE","title":"The Good Guy","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/a53b969b-503b-405b-a12a-24b206e22dd7.jpg","background_image":"https://cdn6.albox.co/storage/disk50/shows/d6f04833-fbc7-4fbc-b41f-0baa4afc292b.jpg","likes":24,"dislikes":1,"views":4644,"release_date":"1266537600000","length":5449,"description":"Ambitious young Manhattanite and urban conservationist Beth wants it all: a good job, good friends, and a good guy to share the city with. Of course that last one is often the trickiest of all. Beth falls hard for Tommy, a sexy, young Wall Street hot-shot. But just as everything seems to be falling into place, complications arise in the form of Tommy's sensitive and handsome co-worker Daniel. Beth soon learns that the game of love in the big city is a lot like Wall Street -- high risk, high reward and everybody has an angle.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"R"},"episode_id":6193,"content_control":"NORMAL"}}