ge":"https://cloud02.albox.co/shows/71b165ff-927f-4ea8-ae81-effc41ae08f6.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":897,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi","Thriller","Comedy","Horror"],"id":897,"type":"MOVIE","title":"The Stepford Wives","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/f9fd5014-0c9b-425a-800a-f318026d1c73.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/fc5d9317-2bc9-4874-929c-2ae2b12eb760.jpg","likes":78,"dislikes":7,"views":17538,"release_date":"1086912000000","length":5572,"description":"Joanna Eberhart, a wildly successful president of a TV Network, after a series of shocking events, suffers a nervous breakdown and is moved by her milquetoast of a husband, Walter, from Manhattan to the chic, upper-class, and very modern planned community of Stepford, Connecticut. Once there, she makes good friends with the acerbic Bobbie Markowitz, a Jewish writer who's also a recovering alcoholic. Together they find out, much to their growing stupor and-then horror, that all the housewives in town are strangely blissful and, somehow... doomed. What is going on behind the closed doors of the Stepford Men's Association and the Stepford Day Spa? Why is everything perfect here? Will it be too late for Joanna and Bobbie when they finally find out?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"episode_id":897,"content_control":"FAMILY"}}