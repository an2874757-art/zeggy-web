25","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Crime"],"id":9290,"type":"MOVIE","title":"Ronin","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/f3eb86b5-f1dc-440c-8cf1-8dca29d41c21.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/afa7fcdb-0f9d-4d9f-84c0-e9f381b7b992.jpg","likes":176,"dislikes":1,"views":13287,"release_date":"906681600000","length":7294,"description":"Ronin is the Japanese word used for Samurai without a master. In this case, the Ronin are outcast specialists of every kind, whose services are available to everyone - for money. Dierdre (undoubtedly from Ireland) hires several Ronin to form a team in order to retrieve an important suitcase from a man who is about to sell it to the Russians. After the mission has been completed successfully, the suitcase immediately gets switched by a member of the team who seems to work into his own pocket. The complex net of everyone tricking everyone begins to surface slowly, and deadly...","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"episode_id":9290,"content_control":"NORMAL"}}