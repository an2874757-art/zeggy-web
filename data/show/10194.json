tion":"34","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Family"],"id":10194,"type":"MOVIE","title":"Journey to the Center of the Earth","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/3c02a069-0b26-4f60-8bf6-606bc4505f88.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/ae446166-76e2-4216-8097-02e414c78eb5.jpg","likes":276,"dislikes":2,"views":18813,"release_date":"1215734400000","length":5560,"description":"Professor Trevor Anderson receives his teenager nephew Sean Anderson. He will spend ten days with his uncle while his mother, Elizabeth, prepares to move to Canada. She gives a box to Trevor that belonged to his missing brother, Max, and Trevor finds a book with references to the last journey of his brother. He decides to follow the steps of Max with Sean and they travel to Iceland, where they meet the guide Hannah Ásgeirsson. While climbing a mountain, there is a thunderstorm and they protect themselves in a cave. However, a lightening collapses the entrance and the trio is trapped in the cave. They seek an exit and falls in a hole, discovering a lost world in the center of the Earth.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.8}],"value":5.8,"age":"PG-13"},"episode_id":10194,"content_control":"FAMILY"}}