lbox.co/shows/3f4f86a3-50cd-46f5-844b-7d22c2051efd.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":1633,"title":"Extraction","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/c0db9d77-88cc-43d1-b1c8-ca7a63720ea6.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":11155,"title":"Pirates of the Caribbean: The Curse of the Black Pearl","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk50/shows/2fa7a0ad-a1b6-4591-8803-9bfabd1d7a9a.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":26050,"title":"The Northman","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/6b415889-8a20-477f-ac91-a38acae7f902.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":12584,"title":"Inglourious Basterds","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/CLOUD00/shows/7a157031-c09f-4e70-a1bd-ed595ef96675.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":40366,"title":"Agent Zeta","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/dc2f863c-be10-485b-8e0b-04df5b8f1929.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8703,"title":"","description":"55","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":8703,"type":"MOVIE","title":"Roman Holiday","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/9a700dd8-4076-41a7-8ebe-b88f5d1b0a5d.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/d739bba5-ccbd-47a5-9c04-da36ec11472e.jpg","likes":288,"dislikes":2,"views":14682,"release_date":"-515376000000","length":7090,"description":"Joe Bradley is a reporter for the American News Service in Rome, a job he doesn't much like as he would rather work for what he considers a real news agency back in the States. He is on the verge of getting fired when he, sleeping in and getting caught in a lie by his boss Hennessy, misses an interview with HRH Princess Ann, who is on a goodwill tour of Europe, Rome only her latest stop. However, he thinks he may have stumbled upon a huge scoop. Princess Ann has officially called off all her Rome engagements due to illness. In reality, he recognizes the photograph of her as being the young well but simply dressed drunk woman he rescued off the street last night (as he didn't want to turn her into the police for being a vagrant), and who is still in his small studio apartment sleeping off her hangover. What Joe doesn't know is that she is really sleeping off the effects of a sedative given to her by her doctor to calm her down after an anxiety attack, that anxiety because she hates her regimented life where she has no freedom and must always do and say the politically correct things, not what is truly on her mind or in her heart. In wanting just a little freedom, she seized upon a chance opportunity to escape from the royal palace where she was staying, albeit with no money in her pockets. Joe believes he can get an exclusive interview with her without she even knowing that he's a reporter or that he's interviewing her. As Joe accompanies \"Anya Smith\" - her name as she tells him in trying to hide her true identity - around Rome on her incognito day of freedom somewhat unaware that the secret service is searching for her, along for the ride is Joe's photographer friend, Irving Radovich, who Joe has tasked with clandestinely taking photographs of her, those photos to accompany the story. As the day progresses, Joe and Ann slowly start to fall for each other. Their feelings for each other affect what both decide to do, Ann with regard to her royal duties, Joe with regard to the story, and both with regard to if there is a future for them together.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"r"},"episode_id":8703,"content_control":"FAMILY"}}