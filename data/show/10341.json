genres":["Drama","Comedy"],"id":10341,"type":"MOVIE","title":"The Square","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/8fb9cda8-063d-4424-a65c-069dfc91190a.jpg","background_image":"","likes":18,"dislikes":1,"views":5664,"release_date":"1503619200000","length":9074,"description":"Christian is the respected curator of a contemporary art museum, a divorced but devoted father of two who drives an electric car and supports good causes. His next show is \"The Square\", an installation which invites passersby to altruism, reminding them of their role as responsible fellow human beings. But sometimes, it is difficult to live up to your own ideals: Christian's foolish response to the theft of his phone drags him into shameful situations. Meanwhile, the museum's PR agency has created an unexpected campaign for \"The Square\". The response is overblown and sends Christian, as well as the museum, into an existential crisis.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"episode_id":10341,"content_control":"FAMILY"}}