ter"},{"data":[{"items":[],"id":7487,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Mystery"],"id":7487,"type":"MOVIE","title":"Tinker Tailor Soldier Spy","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/4510aa11-ab85-4b87-9250-c09c6354fe58.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/f0a18b1d-e2cb-43f5-a228-cc7ed8525d06.jpg","likes":110,"dislikes":3,"views":15806,"release_date":"1325808000000","length":7642,"description":"In the early 1970s during the Cold War, the head of British Intelligence, Control, resigns after an operation in Budapest, Hungary goes badly wrong. It transpires that Control believed one of four senior figures in the service was in fact a Russian agent - a mole - and the Hungary operation was an attempt to identify which of them it was. Smiley had been forced into retirement by the departure of Control, but is asked by a senior government figure to investigate a story told to him by a rogue agent, Ricky Tarr, that there was a mole. Smiley considers that the failure of the Hungary operation and the continuing success of Operation Witchcraft (an apparent source of significant Soviet intelligence) confirms this, and takes up the task of finding him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"R"},"episode_id":7487,"content_control":"NORMAL"}}