h X Rich ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/9dbaabb7-f43d-4ee7-920a-52485d9c729c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":17910,"title":"Her Private Life","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk60/shows/9636dd4b-0b7b-4bb4-ae8d-2459193e1ee0.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35552,"title":"Ang Mutya ng Section E - جوهرة القسم اي ","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/3d0b7f33-ee1d-4c7c-ad12-bb31c588afb7.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":36658,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["drama ","life ","youth "],"id":36658,"type":"SERIES","title":"Wind Direction","logo":"https://cloud02.albox.co/shows/66086120-4057-4a5c-902f-3cef41745323.jpg","image":"https://cloud02.albox.co/seasons/817c29d3-f98d-4ff4-8c88-03cfe1eeadac.jpg","background_image":"https://cloud02.albox.co/seasons/77ab2e75-d547-4cf4-bec6-a55436ee6f93.jpg","likes":10,"dislikes":0,"views":1060,"release_date":"1725840000000","season_number":1,"description":"وُلدت تشنغ مياو مياو، البالغة من العمر سبعة عشر عامًا، وشقيقها تشنغ يا يا، البالغ من العمر ستة عشر عامًا، في مصنع إنتاج النفط رقم 1 بحقل لينتشي النفطي. ثلاثة أجيال من عائلتهما تعمل في حقل النفط. والدهما، تشنغ بينغ فاي، طبيب أنف وأذن وحنجرة، ووالدتهما، جيا داي يو، موظفة لوجستية في فريق. انتقلت العائلة بأكملها من الشمال الغربي إلى بلدة هيبينغ الساحلية في أواخر التسعينيات. بشوقها للعالم الخارجي، اصطحبت مياو مياو حبيب طفولتها لي سي وصديقتها المقربة هو تشيو مين، عازمةً على استغلال إجازة الصيف من عامها الدراسي الأول في المدرسة الثانوية لبدء مغامرة \"الذهاب إلى هونغ كونغ للترحيب بعودة المدينة إلى الوطن الأم\"، لكنها فشلت.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"PG-13"},"background_color":"","current_season_id":21179,"content_control":"NORMAL"}}