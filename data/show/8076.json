Poster"},{"data":[{"items":[],"id":8076,"title":"","description":"20","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy"],"id":8076,"type":"MOVIE","title":"Hot Fuzz","logo":"","image":"https://cdn6.albox.co/storage/disk43/shows/076a6d55-568b-43d7-87a2-06ef95a66152.jpg","background_image":"","likes":157,"dislikes":4,"views":12901,"release_date":"1177027200000","length":7247,"description":"Top London cop, PC Nicholas Angel is good. Too good. And to stop the rest of his team looking bad, he is reassigned to the quiet town of Sandford. He is paired with Danny Butterman, who endlessly questions him on the action lifestyle. Everything seems quiet for Angel, until two actors are found decapitated. It is called an accident, but Angel isn't going to accept that, especially when more and more people turn up dead. Angel and Danny clash with everyone, whilst trying to uncover the truth behind the mystery of the apparent \"accidents\".","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"episode_id":8076,"content_control":"FAMILY"}}