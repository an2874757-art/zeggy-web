ان مجددًا مع والدتها، بينما وجدت الدفء والانتماء مع عائلة فو.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"R"},"background_color":"","current_season_id":21348,"content_control":"NORMAL"}}