"https://cdn6.albox.co/storage/disk52/shows/0b3eb14b-aefa-4d72-af86-dcfb422c6912.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6514,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Sci-Fi","Thriller","Mystery"],"id":6514,"type":"MOVIE","title":"Sky Captain and the World of Tomorrow","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/16fa9b18-bb33-412d-b4fd-6158bc53b368.png","background_image":"https://cdn6.albox.co/storage/disk49/shows/6f4b7354-a89f-4ae2-a5f2-bc3b08c03f00.jpg","likes":19,"dislikes":2,"views":4436,"release_date":"0","length":6396,"description":"In 1939, an intrepid reporter in New York City makes a connection between the story she's covering -- of famous scientists suddenly disappearing around the world, and a recent attack on the city by giant robots. Determined to find the solution to these happenings, she seeks the help of her ex-boyfriend, the captain of a mercenary legion of pilots. The two are investigating the case when the robots attack the city again, though in a stroke of luck, Sky Captain's right-hand man is able to locate their source. They then set off on an adventure in search of the evil mastermind behind these schemes, who is bent on creating a utopia and destroying the current world.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":6514,"background_color":"","content_control":"FAMILY"}}