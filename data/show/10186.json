[{"items":[],"id":10186,"title":"","description":"94","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Sport"],"id":10186,"type":"MOVIE","title":"Million Dollar Baby","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/59b4ab91-8ac9-471c-a480-be9a52a75093.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/2188a26a-4910-4dce-9f39-e22b3c475c35.jpg","likes":320,"dislikes":9,"views":39504,"release_date":"1106870400000","length":7949,"description":"Wanting to learn from the best, aspiring boxer Maggie Fitzgerald wants Frankie Dunn to train her. At the outset he flatly refuses saying he has no interest in training a girl. Frankie leads a lonely existence, alienated from his only daughter and having few friends. Maggie's rough around the edges but shows a lot of grit in the ring and he eventually relents. Maggie not only proves to be the boxer he always dreamed of having under his wing but a friend who fills the great void he's had in his life. Maggie's career skyrockets but an accident in the ring leads her to ask Frankie for one last favor.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"episode_id":10186,"content_control":"FAMILY"}}