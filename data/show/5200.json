ard_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Romance"],"id":5200,"type":"MOVIE","title":"First Knight","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/cb7ade79-6923-4a86-bf94-9ae7df114ebb.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/10e1e00c-fe7f-40fc-8e0b-8d13e59a309b.jpg","likes":152,"dislikes":7,"views":15537,"release_date":"805075200000","length":8030,"description":"Lancelot lives by the sword. In fact, they're next door neighbours, so teaming up to fight for money comes pretty naturally. Lady Guinevere, on her way to marry King Arthur is ambushed by the evil Sir Malagant. Fortunately Lancelot is lurking nearby and he rescues his future queen. They fall in love, but Guinevere still fancies the idea of wearing a crown, so she honours her promise to Arthur. Can Lady Guinevere remain faithful, or will this Pretty Woman become a lady of the knight?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.9}],"value":5.9,"age":"PG-13"},"episode_id":5200,"content_control":"NORMAL"}}