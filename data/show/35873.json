gress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[],"id":35873,"type":"SERIES","title":"Apollo no Uta","logo":"","image":"https://cloud02.albox.co/seasons/36e929d3-475b-4e23-9167-8681b58c7b58.jpg","background_image":"https://cloud02.albox.co/seasons/5e7fb653-1b86-46b5-827b-901d8b57cf5b.jpg","likes":17,"dislikes":2,"views":6006,"release_date":"1740441600000","season_number":1,"description":"بسبب صدمة طفولته مع والدته، أصبح تشيكايشي شوغو يكره الحب، ويستمر في العيش بالبقاء في منزل امرأة لا يحبها وأخذ أموالها. يشعر بشيء خاص فقط في علاقته بصديق طفولته واتاري هيرومي، ولكن في يوم من الأيام، عندما يكتشف شوغو أن هيرومي لديها مشاعر تجاهه، فإن كراهيته للحب تقوده إلى ارتكاب خطأ فادح والتسبب في وفاة هيرومي. في العالم الذي وصل إليه، أعطت الإلهة شوغو عقوبة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"background_color":"","current_season_id":20489,"content_control":"FAMILY"}}