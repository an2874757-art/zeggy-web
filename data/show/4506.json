[{"items":[],"id":4506,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Thriller","Horror"],"id":4506,"type":"MOVIE","title":"Dawn of the Dead","logo":"","image":"https://cdn6.albox.co/storage/disk44/shows/495f0b8e-0b1f-434f-96a6-4b9c11e08c52.jpg","background_image":"https://cdn6.albox.co/storage/disk60/shows/61714c7f-aa66-4b69-9c72-306da2a0f16f.jpg","likes":23,"dislikes":0,"views":4665,"release_date":"296352000000","length":7627,"description":"Following the events of Night of the Living Dead (1968), we follow the exploits of four survivors of the expanding zombie apocalypse as they take refuge in an abandoned shopping mall following a horrific SWAT evacuation of an apartment complex. Taking stock of their surroundings, they arm themselves, lock down the mall, and destroy the zombies inside so they can eke out a living--at least for a while. Tensions begin to build as months go on, and they come to realize that they've fallen prey to consumerism. Soon afterward, they have even heavier problems to worry about, as a large gang of bikers discovers the mall and invades it, ruining the survivors' best-laid plans and forcing them to fight off both lethal bandits and flesh-eating zombies.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.9}],"value":7.9,"age":"R"},"episode_id":4506,"content_control":"NORMAL"}}