 ولكن حتى بعد مرور عام، لم تجده بعد.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"NC-17"},"background_color":"","current_season_id":23892,"content_control":"NORMAL"}}