nres":["Action","Drama","Romance","Animation","War"],"id":15280,"type":"SERIES","title":"Valkyria Chronicles","logo":"","image":"https://cdn6.albox.co/storage/disk51/seasons/903242c6-4b68-4517-b058-74b6276a55f7.jpg","background_image":"https://cdn6.albox.co/storage/disk55/seasons/f84febb8-6428-4145-a981-39df15d376fc.jpg","likes":41,"dislikes":1,"views":4302,"release_date":"1238803200000","season_number":1,"description":"When Imperial forces attack the small border town of Bruhl, Welkin Gunther, son of late General Belgen Gunther, is forced to fight for his life alongside Town Watch captain Alicia Melchiott. Along with Welkin's adopted sister Isara, the three escape to Gallia's capitol and subsequently join the country's militia forces. As members of the newly-formed Squad 7, they must work to repel the invading Imperial forces and discover the true purpose of the invasion itself.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"pg-13"},"current_season_id":2496,"content_control":"NORMAL"}}