:0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5081,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Fantasy","Sci-Fi","Animation"],"id":5081,"type":"MOVIE","title":"Green Lantern: First Flight","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/b9979a3a-6856-4f80-b427-f65b028ba6f9.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/9c9b4500-f740-409a-ae5b-3d38637ab4b1.jpg","likes":78,"dislikes":2,"views":10607,"release_date":"1248739200000","length":4657,"description":"When pilot Hal Jordan accepts a mysterious, powerful ring from a dying alien creature, it transforms him into a Green Lantern - one of an elite force of heroes. These heroes patrol the universe to ensure peace and justice under the leadership of the Guardians of the Universe. Unsure of their newest recruit, the Guardians assign Hal to their most-honored Green Lantern Sinestro for training, unaware that Sinestro wants to overthrow the Guardians and create a new order he'll control. It's a battle of might and willpower as Hall must prove his worth by defeating Sinestro to save the Green Lantern Corps.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"PG-13"},"episode_id":5081,"content_control":"NORMAL"}}