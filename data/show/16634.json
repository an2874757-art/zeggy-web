escription":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":16634,"type":"SERIES","title":"الاميمي","logo":"","image":"https://cdn6.albox.co/storage/disk44/seasons/908eb1fe-bbc0-4ee5-8889-930e104e22a4.jpg","background_image":"https://cdn6.albox.co/storage/disk45/seasons/03ead65c-d630-40c5-8ade-67568805496a.jpg","likes":18,"dislikes":2,"views":5139,"release_date":"-2208988800000","season_number":1,"description":"\"الأميمي\" هو المسؤول عن تسخين المياه في \"حمام السوق\" ويقضي فيه معظم أوقاته، وتنعكس طبيعة مهنته على شكل علاقاته مع الناس، بل ترتبط أحداثه بزمانٍ ومكان محددين: \"دمشق في العام 1850، بعد خروج \"إبراهيم باشا\" من بلاد الشام، وعودة العثمانيين للحكم، ويرصد المسلسل ارتدادات الأحداث السياسية على الحياة الاجتماعية للناس في تلك الفترة\". يبدء الاميمي بصراع بين مراد بيك الشخصية السلبية وفتحي بيك أخو الاميمي يكشف الاميمي انو مراد بيك وأبو رياض هما ورا السرقات الي تصير في من الزعران","rating":{"sources":[],"value":0,"age":"TV-14"},"current_season_id":4372,"content_control":"NORMAL"}}