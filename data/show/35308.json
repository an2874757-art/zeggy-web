"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":35308,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Documentary"],"id":35308,"type":"SERIES","title":"اساليب البقاء","logo":"","image":"https://cloud02.albox.co/seasons/6308090a-a255-4dab-a17f-b0a8a67dccce.jpg","background_image":"https://cloud02.albox.co/seasons/e31e6019-657a-48af-bbc5-4038c591f644.jpg","likes":12,"dislikes":0,"views":1376,"release_date":"1576108800000","season_number":1,"description":"يرصد برنامج أساليب البقاء تحركات هازن أوديل مرشد البراري ومدرب أساليب البقاء على قيد الحياة أثناء تتبعه لبعض الرحلات البشرية الأكثر قسوة، معتمداً على المهارات التي تعلمها من السكان الأصليين. بعد العيش لأول مرة مع السكان المحليين لفهم طريقة حياتهم، ينطلق أوديل في رحلات فردية عبر أقاليم تدفعه إلى حدوده القصوى. ويجب عليه أن يعتمد في رحلته على الغرائز الطبيعية واتباع الأساليب القديمة التي صُقلت على مدار آلاف الأعوام كي ينجو بحياته.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG-13"},"background_color":"","current_season_id":20045,"content_control":"NORMAL"}}