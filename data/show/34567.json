,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":34567,"title":"","description":"68","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Action"," Mystery","  Thriller"],"id":34567,"type":"SERIES","title":"Doubt ","logo":"","image":"https://cloud02.albox.co/seasons/0a7b38be-f501-4c60-9678-d517c30147a8.jpg","background_image":"https://cloud02.albox.co/seasons/247c1b82-3e4c-40d2-8f7b-e9e8353b5468.jpg","likes":306,"dislikes":8,"views":27320,"release_date":"1728691200000","season_number":1,"description":"جانج تاي سو هو محلل جنائي أسطوري في كوريا. كان من أوائل المحللين في مجاله ومهد الطريق لمحللي السلوك الإجرامي في البلاد. لقد اكتسب الاحترام والثقة المطلقة داخل منظمة الشرطة. في المنزل، هو أب أعزب ويربي ابنته بمفرده. يعمل جانج تاي سو على قضية قتل ويدرك أن ابنته متورطة في القضية. يهز الاكتشاف كل شيء في معتقداته المهنية وعلاقته بابنته. لحماية ابنته، يكافح جانج تاي سو للكشف عن الحقيقة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"R"},"background_color":"","current_season_id":19509,"content_control":"NORMAL"}}