oster"},{"data":[{"items":[],"id":8114,"title":"","description":"24","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Family"],"id":8114,"type":"MOVIE","title":"October Sky","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/7b97035d-3079-44cc-aa20-1b4201c016dc.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/d4dfa5f8-40b9-4575-9322-a43f78128f52.jpg","likes":110,"dislikes":1,"views":6756,"release_date":"0","length":6449,"description":"In a 1950's mining town called Coalwood, Homer Hickam is a kid with only one future in sight, to work in the local coal mine like his father. However in October 1957, everything changes when the first artificial satellite, Sputnik goes into orbit. With that event, Homer becomes inspired to learn how to build rockets. With his friends and the local nerd, Homer sets to do just that by trial and a lot of error. Unfortunately, most of the town and especially Homer's father thinks that they are wasting their time. Only one teacher in the high school understands their efforts and lets them know that they could become contenders in the national science fair with college scholarships being the prize. Now the gang must learn to perfect their craft and overcome the many problems facing them as they shoot for the stars.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG-13"},"episode_id":8114,"background_color":"","content_control":"NORMAL"}}