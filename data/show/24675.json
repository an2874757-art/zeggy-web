s":["Drama","Romance","Political","Melodrama"],"id":24675,"type":"SERIES","title":"Snowdrop","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/23bcf894-8974-4fb5-80b7-a46f4498e75e.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/58826d17-7e80-4f5f-a8df-0c6cf0beee0a.jpg","likes":2469,"dislikes":42,"views":156286,"release_date":"0","season_number":1,"description":"في عام 1987 ، كان Im Soo Ho و Eun Young Ro طلابًا في جامعة مرموقة في سيول. تتمتع Im Soo Ho ، التي نشأت في ألمانيا ، بسحر لطيف لكنها تنبعث منها جوًا من السرية. وقع إيون يونغ رو ، الذي يتمتع بالحيوية والحيوية والبهجة ، في حبه من النظرة الأولى في تجمع اجتماعي. في أحد الأيام ، اندفع سو هو فجأة إلى عنبر للإناث مغطى بالدماء ، وأخفاه إيون يونغ رو وعلاج جروحه على الرغم من تعرضه للخطر تحت المراقبة الدقيقة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":9.2}],"value":9.2,"age":"R"},"background_color":"null","current_season_id":12931,"content_control":"NORMAL"}}