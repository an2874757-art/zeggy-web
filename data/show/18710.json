0c16db8-6682-4cdd-b4bf-b8bc24724df2.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":27146,"title":"ستيلتو","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/20674914-2655-4351-b27a-cf2709df65c7.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":25738,"title":"وطن","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/375e7426-4406-457e-9b98-4da6498af36e.png"},"length":0,"continue_watching_progress":0},{"items":[],"id":30998,"title":"الخائن","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud01.albox.co/shows/7afcb0d2-165a-4666-b1a1-13d1c51accf8.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35888,"title":"إش إش","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/e385d2fd-7728-4cfe-b6a5-7896d3f43836.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":35899,"title":"نسمات أيلول","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/bc576888-2efa-473d-9a51-600f8f0ffb8e.jpeg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18710,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":18710,"type":"SERIES","title":"بيت جدي","logo":"","image":"https://cdn6.albox.co/storage/disk43/seasons/476908eb-3590-4dcb-b0b2-0a8ce0e3e3b7.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/1c512cf9-15da-41ea-9d19-36e9a1c01b0e.jpg","likes":152,"dislikes":1,"views":75243,"release_date":"-2208988800000","season_number":1,"description":"المسلسل يتحدث عن قيم كانت سائدة في الثلاثينات من القرن الماضي من عادات وتقاليد ذات اهمية وما زال البعض حتى هذه اللحظة يحاول ان يكرس هذه القيم والتقاليد. ويتناول المسلسل حي الميدان في عام 1930 عبر عائلة كبيرة تسكن بيتاً واحداً وينشأ بين أفرادها العديد من القضايا التي تستهوي المشاهدين ولا يكتفي العمل بذلك بل يخرج إلى الحارة ليلاحظ تشابك العلاقات بين أفرادها وخاصة أن حي الميدان يعد من أعرق الأحياء الدمشقية وكان في تلك الفترة في قلب المدينة ، وينفي كوكش كونه يتكئ على نص لكاتب له تجربة سابقة مهمة وهو مروان قاووق ويؤكد أنه تعاون مع الكاتب في هذا الإطار وأن قاووق قدم نصاً مهماً مختلفاً تماماً عن «باب الحارة» لكي لا يكرر نفسه وأن هناك قضايا لم يلاحظها نص «باب الحارة» ألقي عليها الضوء في «بيت جدي»، كما يؤكد كوكش أن وجود النجوم الكبار في هذا العمل يعد مكسباً مهماً له، يذكر أن نجوم الدراما السورية يشاركون في هذا العمل أمثال : بسام كوسا، أسعد فضة، ناجي جبر، كاريس بشار، وفاء موصللي، سحر فوزي، عصام عبه جي، حسن دكاك والسيدة منى واصف كضيفة شرف ومن الفنانين الشباب هناك وائل شرف وعلاء قاسم وأناهيد فياض ومحمد قنوع وعلي سكر وإمارات رزق وسواهم .. ويلعب الفنان علاء قاسم دور راشد الابن الأكبر للعائلة وهو الذي ورث عن والده مهنة «الحلونجي» وهو بغياب والده يستلم زمام الأمور وبحضوره يتحول إلى شخص لا قيمة له في البيت والحارة وهو متزوج ولكنه لا ينجب أولاداً فيضطر للزواج من أرملة لهذه الغاية وهو شخصية متسلطة ومتعجرفة وبنفس الوقت هو حنون ويحب بناته كثيراً ويعطف على أولاد الأرملة التي تزوجها. ويؤكد علاء أنه يحاول تقديم الشخصية بكل بساطة وتلقائية وأنه ركز على التفاصيل فيها وخاصة أنه يقف لأول مرة أمام كاميرا مسلسل من الموروث الشعبي وأمام نجوم تميزوا بهذه النوعية من المسلسلات ويرى أن «بيت جدي» له ميزة جيدة وهي أن الكاتب قاووق حاول تقديم شيء مختلف عن «باب الحارة» وأنه دخل بمنافسة مع ذاته .. بينما يلعب الفنان حسن دكاك شخصية أبو عارف «البوابيري» المهتم بقضايا حارته ومن أجل ذلك يتناحر مع الذين يريدون السوء لها. ويلعب الفنان ناجي جبر شخصية أبو راشد كبير العائلة والحارة ويلعب الفنان وائل شرف شخصية «عجاج» أحد أبناء أبو راشد ..","rating":{"sources":[],"value":0,"age":"TV-14"},"current_season_id":7071,"content_control":"NORMAL"}}