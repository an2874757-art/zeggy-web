/9d18e654-2de1-4fb4-b179-7dfac4277867.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4352,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Romance","Comedy"],"id":4352,"type":"MOVIE","title":"I'm Your Hero","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/562b5889-4bc0-4ddd-ac67-d0a24d0d8669.png","background_image":"https://cdn6.albox.co/storage/disk57/shows/23bd1dd0-123c-412a-a236-5442528557b8.png","likes":108,"dislikes":0,"views":11533,"release_date":"1396569600000","length":7640,"description":"Sreenath Prasad aka Seenu is the most notorious boy in Ooty. He drops out of college in Ooty in order to pursue education in a Bangalore college. Here he falls in love with Sunaina. But Sunaina is forced to marry Angad, a local police officer, who is more of a terrorizing gangster. Seenu also has another die-hard lover in the form of Ayesha, of whom he is unaware. He had once saved her friends and Ayesha instantly knew that he was the perfect man for her. Ayesha's father is a big gangster and kidnaps Sunaina to get hold of Seenu and compel him to marry his daughter.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"episode_id":4352,"content_control":"NORMAL"}}