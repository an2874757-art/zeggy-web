tching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8479,"title":"","description":"8","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance"],"id":8479,"type":"MOVIE","title":"C'est Si Bon","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/0a165c01-a132-407b-9b3d-251224a9c2ab.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/5ea02bb7-23cc-43a6-8b2f-00938b68fa4e.jpg","likes":56,"dislikes":1,"views":5282,"release_date":"1423785600000","length":7335,"description":"Oh Geun-tae (JUNG Woo) is a country boy with a booming baritone who is discovered by aspiring singer-songwriter Lee Jang-hui (JIN Goo) and thrust into the bustling world of Seoul's iconic folk music café-C'est Si Bon. Unwittingly, he becomes the third member of the yet-to-debut \"C'est Si Bon Trio\" and the begrudging buffer between two rival musicians-the vocal genius, Song Chang-shik (JO Bok-rae), and the heartthrob, Yoon Hyeong-ju (KANG Ha-neul). Amidst the smoke and chatter of C'est Si Bon's youthful clientele, they meet aspiring actress Min Ja-young (HAN Hyo-joo) and find themselves completely bewitched. Will their muse inspire them to create legendary music, or tear them apart before they even begin?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"episode_id":8479,"content_control":"NORMAL"}}