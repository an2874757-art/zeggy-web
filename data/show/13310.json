lbox.co/shows/21f8ea2a-70ec-490e-b5b0-c24e12ef5eae.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":13310,"title":"","description":"26","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Thriller","Crime"],"id":13310,"type":"MOVIE","title":"The Bank Job","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/d3f4a8df-b8c6-415e-b348-cdd8f3786f2a.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/09843a35-aff7-4f14-a0b1-52db3e1a0bf7.jpg","likes":336,"dislikes":14,"views":59432,"release_date":"1204848000000","length":6722,"description":"Business is slow for Terry Leather, a London car dealer, married with children. He's an artful dodger, so Martine, a former model with a thing for him, brings him her scheme: a bank's alarm is off for a couple weeks, so let's tunnel into the vault. He assembles a team, not realizing her real goal is a safe-deposit box with compromising photos of a royal: she needs the photos to trade for avoiding a jail sentence - and MI-5, or is it MI-6, is pulling the strings two steps removed. A Trinidadian thug, a high-end bordello owner, and a pornographer also have things stored in the vault, so the break-in threatens many a powerful personage. Is there any way these amateurs can pull it off?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"episode_id":13310,"content_control":"NORMAL"}}