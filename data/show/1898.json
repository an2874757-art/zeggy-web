nue_watching_progress":0},{"items":[],"id":37097,"title":"Mumu","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/c9c4dbf1-721d-422f-9559-b50fc73ec3a1.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":1365,"title":"Bring Me Home","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk48/shows/05ac38d2-4e35-4033-bbbd-23d46bcbfc03.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":1898,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama"],"id":1898,"type":"MOVIE","title":"The Secret Reunion","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/867c8cf6-262e-427f-9b61-d444cd4ec55f.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/9fe94a39-2211-4e80-8f5e-13311f52c73e.jpg","likes":19,"dislikes":0,"views":2537,"release_date":"1265241600000","length":7037,"description":"A North Korean killer known as \"Shadow\" is sent to assassinate an important dissident who found refuge in Seoul. He is helped by two sleeping agents: Son Tae-soon as look-out, and Song Ji-won, an elite fighter. The North Koreans have not counted with Lee Han-gyoo, from the South Korean National Intelligence Service, who has been tracking them and closes in with his men. Han-gyoo has not counted with the North Koreans' skill and ruthlessness. True to his reputation, \"Shadow\" disappears. Ji-won manages to escape, but cannot return to his country, where he is suspected to be a traitor, nor defect, for this means certain death for his wife and daughter who remained in North Korea. Discredited, Han-gyoo is fired from the NIS. Several years later, Ji-won and Han-gyoo meet unexpectedly, and pick up their confrontation -- but not quite from where they left it off.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"PG-13"},"episode_id":1898,"content_control":"NORMAL"}}