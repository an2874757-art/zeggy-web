d77fdf-d8e1-459c-aa4f-39de70261cff.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":5193,"title":"","description":"15","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy","Crime"],"id":5193,"type":"MOVIE","title":"Life","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/ab0eb1f3-6058-4159-a6c4-f43159560525.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/a6a67679-bf77-4529-b5b9-ddb01ee1293f.jpg","likes":126,"dislikes":5,"views":9205,"release_date":"924220800000","length":6510,"description":"In the mid-1990s, two inmates bury the burned bodies of two lifers at Mississippi's infamous Parchman Farm; a third old-timer relates their story. They'd served 65 years for a murder they didn't commit, framed by a local sheriff while buying moonshine whiskey for a Manhattan club owner to whom they owed money. In flashbacks we see this odd couple thrown together (Ray is a fast-talking con man, and Claude is a serious man about to start work as a bank teller), the loss of Ray's watch (sterling silver, from his daddy), the murder and trial, the hardships of Parchman, and the love-hate relationship of Claude and Ray as they spend 65 years bickering and looking for a way to escape.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":5193,"content_control":"NORMAL"}}