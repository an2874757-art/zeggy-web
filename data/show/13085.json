s":["Drama","Romance","Thriller"],"id":13085,"type":"MOVIE","title":"Colonia","logo":"","image":"https://cdn6.albox.co/storage/disk54/shows/75b8c937-6d77-4d07-b6ee-eda5bc2c072e.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/1006ccfa-c421-47f1-9816-2c86ca5954f9.jpg","likes":187,"dislikes":4,"views":21873,"release_date":"1460678400000","length":6595,"description":"Lena and Daniel, a young couple become entangled in the Chilean military coup of 1973. Daniel is abducted by Pinochet's secret police and Lena tracks him to a sealed off area in the South of the country, called Colonia Dignidad. The Colonia presents itself as a charitable mission run by lay preacher Paul Schäfer but, in fact, is a place nobody ever escaped from. Lena decides to join the cult in order to find Daniel. Based on true events.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.1}],"value":7.1,"age":"R"},"episode_id":13085,"content_control":"FAMILY"}}