ection_type":"comments"}],"post_info":{"genres":["Biography","Drama","Crime"],"id":10039,"type":"MOVIE","title":"Molly's Game","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/544c7372-58c2-4a4f-a78a-12df1d6df822.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/9c82f2d2-f106-4822-bd92-90a7ed2f2581.jpg","likes":52,"dislikes":2,"views":9563,"release_date":"1515110400000","length":8457,"description":"Molly Bloom a beautiful, young, Olympic-class skier who ran the world's most exclusive high-stakes poker game for a decade before being arrested in the middle of the night by 17 FBI agents wielding automatic weapons. Her players included Hollywood royalty, sports stars, business titans and finally, unbeknownst to her, the Russian mob. Her only ally was her criminal defense lawyer Charlie Jaffey, who learned that there was much more to Molly than the tabloids led us to believe.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"R"},"episode_id":10039,"content_control":"NORMAL"}}