ttps://cloud01.albox.co/shows/766a5a96-177a-405c-af88-90b0831cb6c4.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8655,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Crime"],"id":8655,"type":"MOVIE","title":"Pineapple Express","logo":"","image":"https://cdn6.albox.co/storage/disk48/shows/cb0b4259-a646-4bed-84bd-c5499c820403.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/d315f688-0053-4cc2-9f6e-c95655df2906.jpg","likes":28,"dislikes":2,"views":3411,"release_date":"1217980800000","length":7046,"description":"Lazy court-process clerk and stoner Dale Denton has only one reason to visit his equally lazy dealer Saul Silver: to purchase weed, specifically, a rare new strain called Pineapple Express. But when Dale becomes the only witness to a murder by a crooked cop and the city's most dangerous drug lord, he panics and dumps his roach of Pineapple Express at the scene. Dale now has another reason to visit Saul: to find out if the weed is so rare that it can be traced back to him--and it is. As Dale and Saul run for their lives, they quickly discover that they're not suffering from weed-fueled paranoia: incredibly, the bad guys really are hot on their trail and trying to figure out the fastest way to kill them both. All aboard the Pineapple Express.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":8655,"content_control":"FAMILY"}}