0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"," Shounen"," Mystery"," Adventure","Police"],"id":23072,"type":"MOVIE","title":"Detective Conan Movie 17: Private Eye in the Distant Sea","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/shows/d29fad98-00ca-4b47-9625-08eef555f9d1.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/shows/126b35f1-ea3b-42f8-bf6b-cd9de781d030.jpg","likes":176,"dislikes":4,"views":10316,"release_date":"1366416000000","length":6639,"description":"تجري السفينة الحربية إيجيس ديستروير تدريبات عامة في خليج مايزورو حيث تم اكتشاف سفينة أجنبية مشبوهة مؤخرًا بالصدفة. يحصل كل من كونان إيدوجاوا ، وران موري ، وكوجورو موري ، وسونوكو سوزوكي ، و The Detective Boys على تذكرة لحضور هذا الحدث. ومع ذلك ، في الوقت الذي تجري فيه العمليات العسكرية الجارية ، صادف أحد أفراد الطاقم ذراعه الأيسر المقطوع. اكتشف كونان لاحقًا أن جاسوسًا أجنبيًا ربما يكون قد تسلل إلى السفينة الحربية للحصول على معلومات سرية بأي وسيلة ضرورية. إذا تم تسريب المعلومات ، فسيتم كشف خط دفاع اليابان ، مما يترك البلاد غير محمية من هجوم معادي.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"G"},"episode_id":409962,"content_control":"NORMAL"}}