iption":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","Horror"],"id":8352,"type":"MOVIE","title":"The Unborn","logo":"","image":"https://cdn6.albox.co/storage/disk59/shows/7edc4524-f0e7-4762-8856-e891d6851a80.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/57358ab7-c8b2-4827-a809-a8ebaafa47d8.jpg","likes":60,"dislikes":9,"views":23087,"release_date":"1231459200000","length":5324,"description":"While babysitting a boy and his baby brother, Casey Beldon has a dreadful nightmare involving a weird dog and an evil child, and she tells her best friend Romy over the phone. Casey is haunted by this boy, and when she goes to the ophthalmologist, he asks if she has a twin brother or sister. She asks her father and discovers that her mother lost a son that died in the womb. Casey suspects that she is haunted by the spirit of her brother. She finds a letter addressed to a woman called Sofi Kozma and a creepy picture at home that belonged to her mother. She goes with Romy to a retirement home to meet Sofi, a survivor of the experiments during the Holocaust. But Sofi tells Casey that she had never met her mother and later calls Casey to tell her she is in great danger.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.8}],"value":4.8,"age":"PG-13"},"episode_id":8352,"content_control":"FAMILY"}}