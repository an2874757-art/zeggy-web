"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Comedy"],"id":23624,"type":"SERIES","title":"Hometown Cha-Cha-Cha","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/seasons/29946c0b-f66b-45fd-b46f-09175ab405a8.jpeg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/7476acef-ec81-4ebe-8127-8f639bc7efd2.jpg","likes":1162,"dislikes":15,"views":88351,"release_date":"1630108800000","season_number":1,"description":"يون هي جين ، التي تعمل كطبيبة أسنان ، هي امرأة تتمتع بجمال وعقل. ومع ذلك ، فإن خطة حياتها تنهار بسبب القليل من الصلاح في قلبها ، وبعد العديد من العقبات ، تنتقل إلى قرية شاطئ البحر Gongjin وتلتقي بـ Hong Doo Shik. أصبحت فضولية عنه. يطلق السكان المحليون على Hong Doo Shik اسم Chief Hong. إنه عاطل رسميًا عن العمل ، لكنه سيد الوظائف الفردية ويبدو أنه يساعد الجميع في Gongjin في أي موقف يواجهونه.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.9}],"value":8.9,"age":"R"},"background_color":"","current_season_id":12173,"content_control":"NORMAL"}}