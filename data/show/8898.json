"https://cloud02.albox.co/shows/84b0b8de-0ecd-4b21-9427-71b6cde7fa04.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8898,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Romance"],"id":8898,"type":"MOVIE","title":"Vatel","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/4713ae5f-d68a-44c2-92e8-0f652d1bbf35.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/68ac5ee4-5152-4207-b50a-8ee9a1142109.jpg","likes":16,"dislikes":0,"views":4674,"release_date":"957916800000","length":7028,"description":"In 1671, with war brewing with Holland, a penniless prince invites Louis XIV to three days of festivities at a chateau in Chantilly. The prince wants a commission as a general, so the extravagances are to impress the king. In charge of all is the steward, Vatel, a man of honor, talent, and low birth. The prince is craven in his longing for stature: no task is too menial or dishonorable for him to give Vatel. While Vatel tries to sustain dignity, he finds himself attracted to Anne de Montausier, the king's newest mistress. In Vatel, she finds someone who's authentic, living out his principles within the casual cruelties of court politics. Can the two of them escape unscathed?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"PG-13"},"episode_id":8898,"content_control":"NORMAL"}}