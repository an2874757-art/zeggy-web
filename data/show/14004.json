نطقة النائية، وتعجب كثيرا بالحياة البسيطة التي يعيشها الجميع في المزرعة الصغيرة.","rating":{"sources":[],"value":0,"age":"PG-13"},"current_season_id":666,"content_control":"NORMAL"}}