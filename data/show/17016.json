tion_type":"normalPoster"},{"data":[{"items":[],"id":17016,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Family"],"id":17016,"type":"SERIES","title":"Chesapeake Shores","logo":"","image":"https://cdn6.albox.co/storage/disk42/seasons/713a09fa-45ea-4acc-9d73-4ec3e4452095.jpg","background_image":"https://cdn6.albox.co/storage/disk42/seasons/68823a6a-cabc-4f4d-ab40-85fe817b3df9.jpg","likes":30,"dislikes":1,"views":6142,"release_date":"1471132800000","season_number":1,"description":"Abby O'Brien Winters returns to Chesapeake Shores when she receives a panicked phone call from her younger sister Jess, who has renovated the charming Inn at Eagle Point. The Maryland town her father built has many sad memories and Abby, thanks to her demanding career, divorce and young daughters of nine and seven years of age, has not had time to spare. Saving the inn from foreclosure means dealing not only with her fractured family but also with Trace Riley, the man she left ten years ago. Trace initially poses an obstacle but becomes an unexpected ally and a second chance at finding love.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"PG-13"},"background_color":"","current_season_id":4960,"content_control":"NORMAL"}}