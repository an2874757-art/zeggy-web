s://cloud02.albox.co/shows/701fa02e-f796-47c9-8c4f-bfe9c3d1de7c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7663,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Thriller"],"id":7663,"type":"MOVIE","title":"Die Another Day","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/98bb8371-5cee-4e91-8840-277962df67ff.jpg","background_image":"https://cdn6.albox.co/storage/disk42/shows/13dcd619-a9cf-416b-8401-61510e2334df.jpg","likes":77,"dislikes":1,"views":14142,"release_date":"1037923200000","length":7954,"description":"Pierce Brosnan gives one last mission as James Bond. Starting off in North Korea, Bond is betrayed and captured. 14 months later, Bond is set free, but traded for Zao who was captured by MI6. When back in his world, Bond sets off to track down Zao. Bond gets caught up in yet another scheme which sends him to millionaire Gustav Graves. Another MI6 agent known as Miranda Frost is also posing as a friend of Graves. Bond is invited to a presentation held by Graves about a satellite found in space which can project a huge laser beam. Bond must stop this madman with a fellow American agent, known as Jinx. Whilst Bond tries to stop Graves and Zao, will he finally reveal who betrayed him?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"PG-13"},"episode_id":7663,"content_control":"NORMAL"}}