d_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/46d9dd60-bebd-4ae6-87f5-85cbb7dd6775.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":3059,"title":"Kabir Singh","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk48/shows/62bf6550-d91b-4405-9451-1544c9cbffc5.jfif"},"length":0,"continue_watching_progress":0},{"items":[],"id":41737,"title":"Ikka","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/5ccabdb1-8d3c-4123-82e7-0067d4f0d530.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":11941,"title":"","description":"39","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":11941,"type":"MOVIE","title":"Drishyam","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk48/shows/4870fe59-6100-4729-b837-41337c89c729.jpg","likes":220,"dislikes":10,"views":63143,"release_date":"1438300800000","length":9811,"description":"Vijay Salgaonkar runs a cable TV network in a remote and hilly village of Goa. He lives a happy life with his wife Nandini and two daughters. A 4th grade dropout & an orphan, Vijay has worked his way towards success with his sheer hard-work & street smartness in order to provide for his family who mean the world to him. A man of few means & needs; Vijay believes life is to be lived simplistically - his wife, while she loves him devoutly, wants Vijay's thrifty & miserly behavior to end and wants the world for her family. If there's one thing that Vijay cannot live without, it is his passion for watching films. Such is his 'filmy' obsession that he doesn't mind staying up all night at his office binging on TV movies! In a bizarre turn of events; a teenage boy goes missing; he is the son of a headstrong & no-nonsense cop; IG Meera Deshmukh and the Salgaonkar family is the prime suspect! Will a humble & middle class man, be able to protect his family from oppression of the powerful? How the family weathers the storm that ensues during the violent investigation forms the rest of the story leading to an unexpected & shocking climax.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"PG-13"},"episode_id":11941,"content_control":"FAMILY"}}