tle":"Little Witch Academia: The Enchanted Parade","logo":"","image":"https://cdn7.albox.co/storage/CLOUD00/shows/909ac1e7-a893-4671-8f21-a21f732b5b28.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/shows/1a609561-681c-4eaf-b465-a4b5fdd4b77a.jpg","likes":53,"dislikes":1,"views":3296,"release_date":"1444348800000","length":3204,"description":"يمكنك أن تقول أن تدريب الساحرات لا يسير بسلاسة بالنسبة للسحرات الشابات عكا ، ولوت ، وسوسي - فهم يواجهون الطرد لأنهم أفسدوا فصلًا واحدًا أكثر من اللازم ، وطريقة خروجهم الوحيدة هي إذا نجحوا في تنظيم العرض السنوي لأكاديميتهم عبر بلدة مجاورة. لكن عندما يعثرون في اكتشاف بالغ الأهمية أن الهدف من العرض هو إذلال السحرة وإحياء ذكرى إخضاعهم الماضي ، قررت أكو أن الوقت قد حان للتغيير: لقد حان الوقت لإظهار للعالم مدى روعة السحرة المعاصرين حقًا! ومع ذلك ، مع الفتيات الأخريات يكافحن لمواكبة طموحات Akko العظيمة ، وكل شيء من الأولاد المؤذيين إلى العمالقة النائمين الذين يعترضون طريقهم ، ربما لن يتطلب الأمر كل البراعة السحرية التي يمكن لتلاميذ أكاديمية Luna Nova Magical Academy حشدها ، ولكن أيضًا معجزة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.8}],"value":7.8,"age":"PG"},"episode_id":276839,"content_control":"NORMAL"}}