pe":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Comedy","Family","Children"],"id":35667,"type":"SERIES","title":"That's So Raven","logo":"https://cloud02.albox.co/shows/2d7d9427-5a3a-418b-91ea-6b8ff9ecbd4b.png","image":"https://cloud02.albox.co/seasons/ba7d9acb-3d2c-42e8-aa67-cc7ff3a3e34a.jpg","background_image":"https://cloud02.albox.co/seasons/903e2b2e-1526-4065-beb3-6abd76929ab7.jpg","likes":13,"dislikes":1,"views":3401,"release_date":"1042761600000","season_number":1,"description":"أوه ، المفاجئة! تتمتع المراهق Raven Baxter بموهبة خاصة: غالبًا ما تحصل على رؤى متقطعة للمستقبل ، حيث ترى لمحات موجزة عما يمكن أو سيأتي. يحاول أفضل أصدقائها ، إدي وتشيلسي ، مساعدتها في تفسيرها وأحيانًا تغير المستقبل الذي يفترضون أنه رأته. من أجل الحفاظ على سرية موهبتها ، يجب على Raven أن تقرر ما إذا كانت ستخريب لعبة كرة السلة الكبيرة في إدي. تتساءل Raven إذا كان بإمكانها الاست","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"TV-G"},"background_color":"#f028a0","current_season_id":20313,"content_control":"NORMAL"}}