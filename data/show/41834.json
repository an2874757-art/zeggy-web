albox.co/seasons/614481bc-9f2f-4a76-9ba6-70aae64c486c.jpeg","background_image":"https://cloud02.albox.co/seasons/fd011cd9-175b-408f-96b8-9e26d8a962f1.jpg","likes":330,"dislikes":20,"views":67310,"release_date":"1783036800000","season_number":1,"description":"في اليوم الذي يبلغ فيه الطفل الخامسة عشرة من عمره، يخضع لطقوس البركة الإلهية. كان من المفترض أن يخلف إليماس، المنحدر من سلالة مبارزين بارعين، والده. إلا أنه اختار فئة الفارس الثقيل، وهي فئة معيبة، ولم يفقد مكانته كرئيس للعائلة فحسب، بل نُفي أيضًا. يُنظر إلى الفرسان الثقيل، بإحصائياتهم غير المتوازنة ومهاراتهم التي تبدو عديمة الفائدة، على أنهم فئة الجبناء والكسالى. لكن إليماس يعرف الحقيقة. العالم الذي يعيش فيه هو...…","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"NC-17"},"background_color":"","current_season_id":24395,"content_control":"NORMAL"}}