oster"},{"data":[{"items":[],"id":6981,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Biography","Drama","Thriller","Crime"],"id":6981,"type":"MOVIE","title":"The Iceman","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/85bb8652-e030-4bf8-ad13-f60369e95e2a.jpg","background_image":"https://cdn6.albox.co/storage/disk45/shows/f996c4f6-2ec1-447c-956d-1437e5a790f3.jpg","likes":55,"dislikes":0,"views":5325,"release_date":"1367452800000","length":6327,"description":"In the 1960s, Richard Kuklinski is working as a porn film lab tech until his mob bosses persuade him to change his career into that of a contract killer. For years, Kuklinski gains a reputation for cold blooded professionalism even as he raises a family who are kept in the dark about his true career. Unfortunately, mob politics ultimately forces him to secretly work independently with the psychopathic Robert 'Mr. Freezy' Pronge. As much as Kuklinski tries to keep his lives separate, circumstances and his own weaknesses threaten a terrible collision as the consequences of his choices finally catch up to him.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"R"},"episode_id":6981,"content_control":"NORMAL"}}