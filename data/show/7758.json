gth":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7758,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy","Music"],"id":7758,"type":"MOVIE","title":"Begin Again","logo":"","image":"https://cdn6.albox.co/storage/disk56/shows/c54b537f-b1ab-4a6d-921f-f7b779521892.png","background_image":"https://cdn6.albox.co/storage/disk42/shows/174774bd-6904-4cf3-8077-cd8824b2dbbe.png","likes":83,"dislikes":2,"views":6988,"release_date":"1405036800000","length":6265,"description":"Gretta (Keira Knightley) and her long-time boyfriend Dave (Adam Levine) are college sweethearts and songwriting partners who decamp for New York when he lands a deal with a major label. But the trappings of his new-found fame soon tempt Dave to stray, and a reeling, lovelorn Gretta is left on her own. Her world takes a turn for the better when Dan (Mark Ruffalo), a disgraced record-label exec, stumbles upon her performing on an East Village stage and is immediately captivated by her raw talent. From this chance encounter emerges an enchanting portrait of a mutually transformative collaboration, set to the soundtrack of a summer in New York City.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"episode_id":7758,"content_control":"NORMAL"}}