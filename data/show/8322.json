ge/disk57/shows/a5849305-02e3-4b8d-8a76-ee2ebc5483e9.jpg","background_image":"https://cdn6.albox.co/storage/disk47/shows/1edbb997-8cc7-470b-827f-d75ddc1e5e36.jpg","likes":939,"dislikes":30,"views":130345,"release_date":"-625795200000","length":4469,"description":"و فيلم رسوم المتحركة الأمريكية التي تنتجها والت ديزني ، واستنادا إلى خرافة \"سندريللون\" من قبل تشارلز بيرو. يعتبر الثاني عشر في سلسلة الرسوم المتحركة والت ديزني الكلاسيكية ، وكان الفيلم في نطاق محدود يوم 15 فبراير 1950 من قبل صور راديو ركو. انتقل إلى توجيه الاعتمادات كلايد جيروموني ، هاملتون وجاكسون ويلفريد. كانت مكتوبة من قبل أغاني ديفيد ماك ، وجيري ليفينغستون ، وآل هوفمان. و يتضمن أيضا الفيلم أغنيات مثل : الحلم هو أمنية يصنهعا القلب / بيبيدي - بيبيدي - بو / لذلك هذا هو الحب / غناء العندليب الحلو / أغنية العمل / و سندريلا .","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"PG"},"episode_id":8322,"background_color":"","content_control":"NORMAL"}}