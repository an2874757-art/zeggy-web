n":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cloud02.albox.co/shows/f1022a66-f1bd-42b1-8c48-f006fd05da45.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":37801,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Thriller"],"id":37801,"type":"SERIES","title":"Beloved ","logo":"","image":"https://cloud02.albox.co/seasons/3b273f54-453f-41e4-afa9-b85e2c378fc5.jpg","background_image":"https://cloud02.albox.co/seasons/1f9fb535-7ac4-4a97-8252-4c80ee72c0b5.jpg","likes":39,"dislikes":0,"views":6806,"release_date":"1756339200000","season_number":1,"description":"في مطلع القرن العشرين، وبسبب متطلبات تخزين المياه لمشاريع الحفاظ على المياه، كادت بلدة صغيرة على ضفاف النهر أن تغرق. كان الناس في أوج نشاطهم في بناء مدينة جديدة وهجرة سكانية. في صيف عام 2002، هطلت أمطار غزيرة على مدينة دونغجيانغ. ولفتت قضية قتل غريبة أنظار الشرطة. كان عشيق ميت وزوج اختفى ثم بعث من جديد هما \"القاتل\" و\"الميت\". أخيرًا، وتحت تحقيقات الشرطة المتواصلة، انكشف ماضٍ غامق لسنوات طويلة. لقد أعمى تعقيد الطبيعة البشرية الكثيرين، لكن الحقيقة لن تُمحى أبدًا. كل ما تراه هو نور الشمس.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"PG-13"},"background_color":"","current_season_id":21914,"content_control":"NORMAL"}}