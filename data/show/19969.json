box.co/storage/disk47/seasons/d0b6d176-920a-4d5a-b34f-cab96a70a464.jpg","likes":221,"dislikes":2,"views":16523,"release_date":"1526083200000","season_number":1,"description":"A \"gangster lawyer\" who doesn't trust the law and feels free to use his fists. He takes advantage of loopholes in the law and boasts an excellent win rate. Other lawyers may consider the legal code sacred, but he considers it more of a tool \"like an appliance user manual.\" He fights against those in absolute power, standing all alone in the world, driven solely by the thought of avenging his mother.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":""},"current_season_id":8782,"content_control":"NORMAL"}}