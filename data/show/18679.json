gth":0,"continue_watching_progress":0},{"items":[],"id":20330,"title":"Boys Over Flowers Korean","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk57/shows/72c2cb9f-257a-4feb-851e-c3abc3801d0d.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":18679,"title":"","description":"1","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Sci-Fi"],"id":18679,"type":"SERIES","title":"Borg Mom","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/ca332009-25d9-415f-9b8c-ee7639a77618.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/4fd4e722-8ab6-4932-8dd2-42768fd5a81a.jpg","likes":4,"dislikes":0,"views":1994,"release_date":"1504224000000","season_number":1,"description":"Buckinghum nursery school is a highly-competitive preschool where wealthy Korean families send their children. One day, a mysterious mom appears at the school with her child. Choi Go Bong developed a cyborg in the image of his late wife and to test its AI abilities, he is tasking the cyborg to parent his son and mingle with other moms at the competitive preschool, which he considers to be the ultimate test for his top-secret creation. When cyborg mom joins the PTA at Buckinghum nursery school and becomes a member of the invite-only Stylish Mom club, which is a high-status social club consisting of Buckinghum PTA members, she challenges the moms who are engrossed in acquiring higher status and bragging rights with her logical reasoning.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"R"},"current_season_id":7029,"content_control":"NORMAL"}}