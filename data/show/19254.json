وافق على العمل مع المفتش نارويباتي كجاسوسة والتقرب من السيد ريتشارد بالاعتماد على مهاراتها كممثلة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"N/A"},"background_color":"","current_season_id":7770,"content_control":"NORMAL"}}