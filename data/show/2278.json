card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure"],"id":2278,"type":"MOVIE","title":"The Swordsman in Double Flag Town","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk46/shows/33d89db5-fd74-43d4-8f94-3a12a807b6c1.jpg","likes":4,"dislikes":0,"views":3078,"release_date":"674438400000","length":5487,"description":"A young man comes to double flag town in order to marry his promised bride. Both his bride and her father do not like him, because he seems to be a nothing without any skills just wearing two swords on his legs. When some vagabonds try to rape his bride, the young man is able to beat them easily in a sword fight. He suddenly realizes in this first fight he ever did that his father did teach him a superior fighting style. Will those talents be enough for the upcoming? All inhabitants of double flag town expect a bloody revenge by the vagabonds.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.2}],"value":7.2,"age":"PG-13"},"episode_id":2278,"content_control":"NORMAL"}}