ox.co/shows/c2d85126-babc-4789-8eb0-801ecb14e10e.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9760,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Comedy"],"id":9760,"type":"MOVIE","title":"Harold & Kumar Escape from Guantanamo Bay","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/030f68a8-0170-438b-8647-0edc363f20fd.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/a220073f-30c6-4b61-a81c-ee0b3ced83f7.jpg","likes":27,"dislikes":2,"views":3604,"release_date":"1209081600000","length":6463,"description":"The morning they return from their White Castle road trip, Harold and Kumar decide to go to Amsterdam because Harold doesn't want to wait ten days to see Maria again. On the plane, Kumar lights up his new bong, the air marshals think it's a bomb, and Harold and Kumar are arrested as terrorists and sent to Guantanamo Bay. Ordered to fellate a guard, they manage to escape, make their way to Florida, and head for Texas to find Kumar's ex-girlfriend's fiancé, the well-connected Colton, and get him to intercede with Washington on their behalf. Kumar still has a thing for Vanessa, the feds are in hot pursuit, and the legal weed of Amsterdam seems a long way away.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.6}],"value":6.6,"age":"R"},"episode_id":9760,"content_control":"NORMAL"}}