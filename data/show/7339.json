,"url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy"],"id":7339,"type":"MOVIE","title":"Step Brothers","logo":"","image":"https://cdn6.albox.co/storage/disk45/shows/0b9e1c10-f7ae-433d-b33d-b6e55ee212cd.jpg","background_image":"https://cdn6.albox.co/storage/disk59/shows/9e8203de-f81e-4b81-af16-e8228555020a.jpg","likes":49,"dislikes":5,"views":4647,"release_date":"1216944000000","length":6332,"description":"Brennan Huff and Dale Doback are both about 40 when Brennan's mom and Dale's dad marry. The sons still live with the parents so they must now share a room. Initial antipathy threatens the household's peace and the parents' relationship. Dad lays down the law: both slackers have a week to find a job. Out of the job search and their love of music comes a pact that leads to friendship but more domestic disarray compounded by the boys' sleepwalking. Hovering nearby are Brennan's successful brother and his lonely wife: the brother wants to help sell his step-father's house, the wife wants Dale's attention, and the newlyweds want to retire and sail the seven seas. Can harmony come from the discord?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.9}],"value":6.9,"age":"R"},"episode_id":7339,"content_control":"NORMAL"}}