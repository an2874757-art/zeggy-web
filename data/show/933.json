ts"}],"post_info":{"genres":["Thriller","Crime","Horror"],"id":933,"type":"MOVIE","title":"Strangled","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/313f94ca-8d77-4a1d-96f3-ea02c3f55f32.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/e9670205-dd1d-4bd1-9195-c1389f965a60.jpg","likes":23,"dislikes":3,"views":6598,"release_date":"1478736000000","length":7248,"description":"Based on real-life events, this psycho-thriller is set in the provincial Hungary of the 1960s, when a series of atrocious murders shock the small town of Martfü. A psychotic killer is on the prowl, who continues to slaughter young women while an innocent man is wrongly accused and sentenced for crimes he could never have committed. A determined detective arrives on the scene and soon becomes obsessed with the case while under pressure from the prosecutor to see a man hang. Stuck in the suffocating social, political and psychological world of socialist Hungary, we soon find ourselves entangled in a web of intricate conspiracy and disturbing drama.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":933,"content_control":"FAMILY"}}