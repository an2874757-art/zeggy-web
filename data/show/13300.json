disk46/shows/653b5544-0b70-435c-90fc-055780415c8f.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":13300,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy","Family"],"id":13300,"type":"MOVIE","title":"The Nutcracker in 3D","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/498c8d1f-e066-471f-8d19-b3ed183aaa32.jpg","background_image":"https://cdn6.albox.co/storage/disk52/shows/62b42d7d-7422-4601-850a-72e6c0fb742b.jpg","likes":34,"dislikes":2,"views":4985,"release_date":"1323302400000","length":6481,"description":"1920s Vienna. Nine-year-old Mary lives in a home filled with lovely things and loneliness. Bothered by bratty brother Max and neglected by well intentioned, but distracted, parents, she yearns for companionship and adventure. On Christmas Eve, Mary's beloved Uncle Albert arrives with the gift of a wooden nutcracker doll. Later that night, Mary's imagination brings the doll to life. Introducing himself as \"NC,\" he takes her on a wondrous journey through a stunning dimension where toys assume human form and everything appears ten times larger. But danger lurks. An army of toothy rat creatures, led by the flamboyant Rat King and his devious mother, has unleashed a plot to overthrow humanity. When NC is captured and placed under a paralytic spell, Mary, Max and a spirited band of toy sidekicks must rescue him from the Rat King's clutches and thwart his wicked plans to 'ratify' the world.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.4}],"value":4.4,"age":"PG-13"},"episode_id":13300,"background_color":"","content_control":"NORMAL"}}