:"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," Comedy"," Youth"],"id":36648,"type":"SERIES","title":"The Comic Bang","logo":"","image":"https://cloud02.albox.co/seasons/f8d6de15-e51d-42e9-b4d0-849118431c8a.jpg","background_image":"https://cloud02.albox.co/seasons/8c536c35-b48d-4f75-9e22-0827e68cd81b.jpg","likes":88,"dislikes":1,"views":16574,"release_date":"1748131200000","season_number":1,"description":"لو يي تشي، طالب السنة الثانية في قسم الرياضيات، والذي يتميز بتواضعه وتفوقه الدراسي، لديه هوية غير معروفة للآخرين - فنان مانهوا شوجو محترف. لكن كطالب علوم، يفتقر في الواقع إلى معرفة معينة بمانهوا الشوجو. كان لو يي تشي يحلم في الأصل بأن يصبح فنان مانهوا شونين، لكنه بالخطأ سلك طريق مانهوا الشوجو. بدافع حبه للمانهوا، عزم على تحقيق حلمه حتى النهاية. الفتاة التي كانت معجبة به، زو تشيان داي، جُرّت إلى فريقه الكوميدي بالخطأ بعد اعترافها الفاشل.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.1}],"value":8.1,"age":"PG-13"},"background_color":"","current_season_id":21171,"content_control":"NORMAL"}}