8-a3eb-fcf5ed7a1d70.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":845,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Adventure","Drama"],"id":845,"type":"MOVIE","title":"The Old Man and the Sea","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/69429475-0240-4a94-8947-ffda6eea8b47.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/ba7ba4e9-6dbd-4654-8fbf-56166e8a1218.jpg","likes":21,"dislikes":1,"views":6885,"release_date":"-354240000000","length":5199,"description":"Now an old man, a lifelong fisherman sets out to sea to ply his trade as he has done all of his life. He's not had much good fortune of late and has gone almost three months without a major catch while others are catching one or even two large marlins every week. Many of the locals make fun of him and some say he's too old now to be fishing but he still loves what he does and is encouraged by a young boy who loves him and has faith in him. On this day he hooks the fish of a lifetime, a marlin that is larger than his skiff. As it slowly pulls him out to sea, the old man reminisces about his past, his successes and the high points of his life. When he does finally manage to land the fish he has to fight off sharks who are feeding on it as he tries to return to his Cuban village.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":845,"content_control":"NORMAL"}}