ching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":1054,"title":"","description":"11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":1054,"type":"MOVIE","title":"The Quiet","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/bd129816-ba79-40ef-a3a2-59ac9aeccc30.jpg","background_image":"https://cdn6.albox.co/storage/disk57/shows/b7ac13b7-ead2-4113-8889-35ebdde7f59b.jpg","likes":58,"dislikes":3,"views":11135,"release_date":"1156464000000","length":5776,"description":"Following the death of her father, a teenage Dot moves into the home of her godparents and their teenage daughter Nina. Dot arrives wrapped up in the silence of being deaf-mute. She finds a different kind of silence waiting for her in her new home, for this home is a place with a dark secret involving Nina and her father. At first, Dot and Nina seem to be polar opposites. However, they gradually realize how much they have in common. Bringing them together catalyzes a series of events in which both reveal their secrets and shed their double lives. A violent consummation almost destroys them. Yet they find hope for the future in the quiet after the storm.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.2}],"value":6.2,"age":"R"},"episode_id":1054,"content_control":"NORMAL"}}