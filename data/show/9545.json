type":"normalPoster"},{"data":[{"items":[],"id":9545,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller"],"id":9545,"type":"MOVIE","title":"Stone","logo":"","image":"https://cdn6.albox.co/storage/disk55/shows/e35a16b9-7869-4de3-96fd-2bc5a1d748e0.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/63db09bf-fcb8-475d-9ecb-61e18803f94d.jpg","likes":13,"dislikes":2,"views":5385,"release_date":"1287705600000","length":6300,"description":"Parole officer Jack Mabry (Robert De Niro) has only a few weeks left before retirement and wishes to finish out the cases he's been assigned. One such case is that of Gerald \"Stone\" Creeson (Edward Norton), a convicted arsonist who is up for parole. Jack is initially reluctant to indulge Stone in the coarse banter he wishes to pursue and feels little sympathy for the prisoner's pleas for an early release. Seeing little hope in convincing Jack by himself, Stone arranges for his wife, Lucetta (Milla Jovovich), to seduce the officer, but motives and intentions steadily blur amidst the passions and buried secrets of the corrupted players in this deadly game of deception.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.4}],"value":5.4,"age":"R"},"episode_id":9545,"content_control":"NORMAL"}}