":"https://cloud02.albox.co/seasons/88b88c14-30a8-4e9e-8461-23871409cb73.jpg","background_image":"https://cloud02.albox.co/seasons/587d2f98-4636-4c75-9dc3-436007df8059.jpg","likes":40,"dislikes":0,"views":8917,"release_date":"1747008000000","season_number":1,"description":"بعد تغيّر مملكة جينغزي، دُمّرت أرض الصين، فانتفض الشباب الطامح لإنقاذ وطنهم. كان الشاب الأرستقراطي ليانغ شيانغ، والحزب الثوري يانغ كاي تشي، وحارس بيانغ وويو لي رين جون، أول دفعة من الشباب التقدميين الذين ذهبوا إلى اليابان للدراسة في مدرسة ضباط الصف. التقوا بالمنفيين الثوريين يو تيان باي وتشيو هونغ على متن سفينة سياحية. ومنذ ذلك الحين، ارتبط هؤلاء الأشخاص الخمسة ارتباطًا مصيريًا.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.2}],"value":8.2,"age":"PG-13"},"background_color":"","current_season_id":21084,"content_control":"FAMILY"}}