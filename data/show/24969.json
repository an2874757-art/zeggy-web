":24969,"title":"","description":"17","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":[" Romance"," School"," Youth"],"id":24969,"type":"SERIES","title":"Our Secret","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/c32b2781-f67b-4c0e-9d03-853cbe0fd91e.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/48cdead5-bca6-4f8e-97db-df8f0e3efb09.jpeg","likes":272,"dislikes":5,"views":18629,"release_date":"1628553600000","season_number":1,"description":"من المدرسة الثانوية إلى الجامعة ، يستمر حب Ding Xian و Zhou Si Yue الشاب مدى الحياة. يعتبر تشو سي يو إله الحرم الجامعي المتفوق والجامع عبقريًا. إنه رفقاء في المقاعد مع دينغ شيان \"فتاة سندريلا\" القوية والرائعة. على الرغم من أنهم لم يتمكنوا من الوقوف مع بعضهم البعض في البداية ، إلا أنهم يقدّرون نقاط قوة بعضهم البعض في تفاعلاتهم اليومية ، وبالتالي يصبحون رفقاء مدى الحياة في رحلتهم عبر الشباب.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"PG-13"},"background_color":"","current_season_id":13148,"content_control":"NORMAL"}}