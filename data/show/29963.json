s":[],"id":29963,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":29963,"type":"SERIES","title":"دقات قلب","logo":"","image":"https://cloud01.albox.co/seasons/bc7b9e74-8093-4d99-91c5-7a596dbb01ea.jpg","background_image":"https://cloud01.albox.co/seasons/cbea4026-e998-40b6-b01f-6e4f0fb206fb.jpg","likes":113,"dislikes":7,"views":31435,"release_date":"1188777600000","season_number":1,"description":"حسين كنان موسيقي موهوب كافح للتغلب على الألم العاطفي لطفولة صعبة ، تميزت بانتحار والده واضطهاد عمه الصائب الذي قام بتربيته. يشعر كنان بعدم استحقاقه لحبه الأول ، ليلى ، ليصبح عازف كمان مشهور ، يضحى بعلاقاته للسفر إلى الخارج للتركيز على حياته المهنية. يتزوج جميل ابن عم كنان من ليلى على الرغم من علمه بأنها لا تحبه ، مما يسبب حزنًا ويأسًا عميقًا في كنان. وعندما يعود كينان يلتقي باليتيم الشاب لمياء التي تعجب به وبموسيقاه. ينشأ بينهما انجذاب مفاجئ ، لكن كنعان يقمع حبه بسبب المكانة الاجتماعية المتدنية لمياء ، لكنهما سيحبان بعضهما البعض إلى الأبد وسيكون حبهما لا يوصف.\r\n","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.3}],"value":5.3,"age":"PG-13"},"background_color":"","current_season_id":17009,"content_control":"NORMAL"}}