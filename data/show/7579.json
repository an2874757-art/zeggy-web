isk58/shows/c0db9d77-88cc-43d1-b1c8-ca7a63720ea6.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":2271,"title":"1917","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk56/shows/065de86f-dbe6-49eb-97df-55d6a00667fd.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":37740,"title":"I Know What You Did Last Summer","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/33939eb7-3cee-413c-8c17-c880977aef73.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":2937,"title":"It: Chapter Two","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk59/shows/c58a129f-5822-4d92-a335-5040de71ac2e.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7579,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Mystery","Horror"],"id":7579,"type":"MOVIE","title":"The Stranger","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk56/shows/32876121-062d-4604-a84f-95271cdef3a0.jpg","likes":35,"dislikes":2,"views":7909,"release_date":"1434067200000","length":5566,"description":"Martin, a drifter, arrives in a small town and asks about a woman named Ana. Peter, a teenager, directs him to a cemetery, but three thugs harass him. Peter interrupts them as they savagely beat Martin, but then flees. De Luca orders them cover up the crime. Peter convinces his mother, Monica, to perform first aid, which Martin refuses, saying that his blood is 'contagious'. When De Luca returns to bury the body and finds it missing, and suspects Peter. He sends Caleb to take care of the situation, but before they can kill Peter, Martin kills them. De Luca interrogates Peter. and sets Peter on fire. As Monica calls an ambulance, Martin recites a Latin blessing and rubs his blood on Peter. Later, at the hospital, Peter miraculously recovers and is discharged. The police capture Martin and make Monica, a nurse, perform a transfusion from Martin to Caleb. Martin begs her not to do so and insists that his blood must be blessed to prevent 'infection'.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":4.9}],"value":4.9,"age":"r"},"episode_id":7579,"content_control":"NORMAL"}}