l":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure","Drama","Thriller","Crime","Mystery","Suspense"],"id":33872,"type":"SERIES","title":"Leverage","logo":"https://cloud02.albox.co/shows/dfdda9b0-a22b-44ab-b47c-6bffc23d5fa3.jpg","image":"https://cloud02.albox.co/seasons/541c5c2f-be55-46e5-8a7e-204daafc628b.jpg","background_image":"https://cloud02.albox.co/seasons/90e50e97-ab15-45c4-83c9-dbb9f2d7a38d.jpg","likes":14,"dislikes":2,"views":7268,"release_date":"1228608000000","season_number":1,"description":"تعرف على ناثان فورد، المحقق السابق في مجال التأمين والذي قضى حياته المهنية مكرسًا نفسه للشركة التي رفضت إجراء عملية طبية قد تنقذ حياة ابنه. ناثان عاطل عن العمل ويتأرجح على حافة الهاوية، يطلب مساعدة أفضل اللصوص والمحتالين في العمل، وبمساعدتهم، يسرق من الأغنياء ويعطي للفقراء للمساعدة في تحقيق التوازن بين المحتالين في المناصب العليا. يساعد هو وفريقه في توفير... النفوذ.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"background_color":"#90a0a0","current_season_id":19037,"content_control":"FAMILY"}}