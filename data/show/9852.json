normalPoster"},{"data":[{"items":[],"id":9852,"title":"","description":"24","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Comedy","Crime"],"id":9852,"type":"MOVIE","title":"22 Jump Street","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/06bdbf35-f73c-4668-9a85-976bea52dfc9.jpg","background_image":"https://cdn6.albox.co/storage/disk48/shows/b9d0dd6b-9f86-4136-9681-3abb3614b172.jpg","likes":281,"dislikes":6,"views":23049,"release_date":"1402617600000","length":6716,"description":"After making their way through high school (twice), big changes are in store for officers Schmidt (Jonah Hill) and Jenko (Channing Tatum) when they go deep undercover at a local college. But when Jenko meets a kindred spirit on the football team, and Schmidt infiltrates the bohemian art major scene, they begin to question their partnership. Now they don't have to just crack the case - they have to figure out if they can have a mature relationship. If these two overgrown adolescents can grow from freshmen into real men, college might be the best thing that ever happened to them.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":9852,"content_control":"FAMILY"}}