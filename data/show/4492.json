s":[],"id":36355,"title":"Bullet Train Explosion","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/505dfd53-252b-44d6-bf91-1447eee94795.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":31467,"title":"Love Reset","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud01.albox.co/shows/fba06006-b71c-47ae-a9a6-91dc7beab40f.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":37754,"title":"Exit 8","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cloud02.albox.co/shows/9b809ac2-c563-4c35-9672-5b88663078ac.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":4492,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Romance"],"id":4492,"type":"MOVIE","title":"Curse of the Golden Flower","logo":"","image":"https://cdn6.albox.co/storage/disk47/shows/ed05f5a9-6f34-40fe-b60b-b1f38d52c64c.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/ff8dc94c-651e-409c-8530-26887af31e7d.jpg","likes":11,"dislikes":2,"views":3635,"release_date":"1168560000000","length":6840,"description":"China, Later Tang Dynasty, 10th Century. On the eve of the Chong Yang Festival, golden flowers fill the Imperial Palace. The Emperor (Chow Yun Fat) returns unexpectedly with his second son, Prince Jai (Jay Chou). His pretext is to celebrate the holiday with his family, but given the chilled relations between the Emperor and the ailing Empress (Gong Li), this seems disingenuous. For many years, the Empress and Crown Prince Wan (Liu Ye), her stepson, have had an illicit liaison. Feeling trapped, Prince Wan dreams of escaping the palace with his secret love Chan (Li Man), the Imperial Doctor's daughter. Meanwhile, Prince Jai, the faithful son, grows worried over the Empress's health and her obsession with golden chrysanthemums. Could she be headed down an ominous path? The Emperor harbors equally clandestine plans; the Imperial Doctor (Ni Dahong) is the only one privy to his machinations. When the Emperor senses a looming threat, he relocates the doctor's family from the Palace to a remote area. While they are en route, mysterious assassins attack them. Chan and her mother, Jiang Shi (Chen Jin) are forced back to the palace. Their return sets off a tumultuous sequence of dark surprises. Amid the glamour and grandeur of the festival, ugly secrets are revealed. As the Imperial Family continues its elaborate charade in a palatial setting, thousands of golden armored warriors charge the palace. Who is behind this brutal rebellion? Where do Prince Jai's loyalties lie? Between love and desire, is there a final winner? Against a moonlit night, thousands of chrysanthemum blossoms are trampled as blood spills across the Imperial Palace.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":4492,"content_control":"NORMAL"}}