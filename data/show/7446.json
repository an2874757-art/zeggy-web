ype":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk49/shows/4c06972f-3d5b-4979-bd62-71dcf5c06e4c.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7446,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama"],"id":7446,"type":"MOVIE","title":"Clouds of Sils Maria","logo":"","image":"https://cdn6.albox.co/storage/disk53/shows/941274b4-d8bc-4034-be83-a5060e67ab79.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/0f90575c-dad9-444d-b67b-7d511cc445db.jpg","likes":26,"dislikes":1,"views":6601,"release_date":"1408492800000","length":7431,"description":"At the peak of her international career, Maria Enders is asked to perform in a revival of the play that made her famous twenty years ago. But back then she played the role of Sigrid, an alluring young girl who disarms and eventually drives her boss Helena to suicide. Now she is being asked to step into the other role, that of the older Helena. She departs with her assistant to rehearse in Sils Maria; a remote region of the Alps. A young Hollywood starlet with a penchant for scandal is to take on the role of Sigrid, and Maria finds herself on the other side of the mirror, face to face with an ambiguously charming woman who is, in essence, an unsettling reflection of herself.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":7446,"content_control":"FAMILY"}}