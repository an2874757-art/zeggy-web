:0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":760,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","War"],"id":760,"type":"MOVIE","title":"Taking Chance","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/17fb4590-2b99-447a-b173-12b38349b6d5.jpg","background_image":"https://cdn6.albox.co/storage/disk54/shows/1c5d1706-f5a2-4a4a-8b55-2a0045c71563.jpg","likes":12,"dislikes":1,"views":3798,"release_date":"1235174400000","length":4804,"description":"In April, 2004, casualties mount in Iraq. At Quantico, choices focus on increasing troop strength or only replacing casualties. Lt. Col. Michael Strobl crunches numbers. Stung by his superior's rejection of his recommendation because he lacks recent combat experience, Strobl volunteers for escort duty, accompanying the remains Pfc. Chance Phelps, killed at 19. From Dover to Philadelphia by hearse, from there to Minneapolis and on to Billings by plane, and then by car to Phelps' Wyoming home - person after person pays respects. Kind words, small gifts, and gratitude are given Strobl to deliver to the family on this soul-searching journey. What are his own discoveries?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"episode_id":760,"content_control":"NORMAL"}}