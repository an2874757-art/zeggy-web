5-93f0-736bf1382213.png","image":"https://cloud02.albox.co/seasons/accd0bd8-b88b-43c2-a911-0c63615f7f3d.jpg","background_image":"https://cloud02.albox.co/seasons/6735c0da-e269-4202-8026-783de20d302e.jpg","likes":198,"dislikes":9,"views":10304,"release_date":"1706054400000","season_number":1,"description":"يقود الفارس المغامر لايوس تودين مجموعة صغيرة عبر زنزانة تبدو بلا نهاية، وهي متاهة تحت الأرض مليئة بالوحوش الخطيرة والفخاخ الخطيرة. ومن خلال استخدام السحر المتقدم، يمكن إحياء المستكشف في بعض الأحيان، مما يسمح له بالتعلم من أخطاء الماضي ومحاولة عبور الزنزانة مرة أخرى. ومع ذلك، عندما يأكل تنين قوي فالين، أخت لايوس التي تتولى إلقاء التعويذات، ترسل شقيقها ورفاقه إلى البداية لإنقاذهم من النهاية الدائمة.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.6}],"value":8.6,"age":"R"},"background_color":"#d5d5d6","current_season_id":20487,"content_control":"NORMAL"}}