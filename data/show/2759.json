ة التي لا تخصهم بما فيها من ثروة. يقرران بعدما فشلا في معرفة صاحبها أن يقتسما النقود، وتتوالى الأحداث بعدها وسط العديد من المفارقات الكوميدية والمفاجآت.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"PG-13"},"episode_id":2759,"content_control":"NORMAL"}}