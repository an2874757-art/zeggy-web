tems":[],"id":33570,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Fantasy","Romance"],"id":33570,"type":"SERIES","title":"Padam Padam .. The Sound of His and Her Heartbeats","logo":"","image":"https://cloud02.albox.co/seasons/cbcc5887-069d-497a-8115-b21f4c2bc1bc.jpg","background_image":"https://cloud02.albox.co/seasons/a9a93360-1e3d-40aa-941c-5aa3b1f88f7b.jpg","likes":6,"dislikes":0,"views":1314,"release_date":"1323043200000","season_number":1,"description":"رجل يقضي 16 عامًا في السجن لارتكابه جريمة قتل لم يرتكبها. يحافظ يانغ كانغ تشيل على طبيعته الطيبة ويحميه صديقه المقرب غوك سو. بعد إطلاق سراحه من السجن، أصبح كانغ تشيل نجارًا ويحاول إعادة بناء حياته. يقع في حب جانغ جي نا، الطبيبة البيطرية التي تصادف أنها ابنة أخت الضحية في قضية مقتل كانغ تشيل. هل يستطيع كانغ تشيل إثبات براءته وتقديم القاتل الحقيقي إلى العدالة لإنقاذ علاقته مع جي نا؟","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6}],"value":6,"age":"R"},"background_color":"","current_season_id":18879,"content_control":"NORMAL"}}