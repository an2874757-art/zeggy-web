 Oz and its puppets, Heero must unite with other rebels and save his people.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.3}],"value":8.3,"age":"pg-13"},"current_season_id":9071,"content_control":"NORMAL"}}