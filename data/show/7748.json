ated","section_type":"normalPoster"},{"data":[{"items":[],"id":7748,"title":"","description":"10","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Sci-Fi","Horror"],"id":7748,"type":"MOVIE","title":"Blade II","logo":"","image":"https://cdn6.albox.co/storage/disk46/shows/a48423e2-1f12-43ef-8c0e-43974dc5cd12.png","background_image":"https://cdn6.albox.co/storage/disk42/shows/0361cfb7-60b5-4096-af86-97153910d997.png","likes":179,"dislikes":1,"views":18872,"release_date":"1016755200000","length":7010,"description":"A rare mutation has occurred within the vampire community. The Reaper. A vampire so consumed with an insatiable bloodlust that they prey on vampires as well as humans, transforming victims who are unlucky enough to survive into Reapers themselves. Now their quickly expanding population threatens the existence of vampires, and soon there won't be enough humans in the world to satisfy their bloodlust. Blade, Whistler (Yes, he's back) and an armory expert named Scud are curiously summoned by the Shadow Council. The council reluctantly admits that they are in a dire situation and they require Blade's assistance. Blade then tenuously enters into an alliance with The Bloodpack, an elite team of vampires trained in all modes of combat to defeat the Reaper threat. Blade's team and the Bloodpack are the only line of defense which can prevent the Reaper population from wiping out the vampire and human populations.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.7}],"value":6.7,"age":"R"},"episode_id":7748,"content_control":"FAMILY"}}