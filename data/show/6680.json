s/37f8071b-cefd-4453-b5b6-4768ff4cd39a.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6680,"title":"","description":"5","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller","Crime"],"id":6680,"type":"MOVIE","title":"Get the Gringo","logo":"","image":"https://cdn6.albox.co/storage/disk52/shows/89a7bfb0-6a36-480e-a390-a10f68a865c8.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/2d6edea4-0e1e-442d-89dc-90314e0fe4fb.jpg","likes":29,"dislikes":1,"views":3871,"release_date":"1340323200000","length":5759,"description":"Heading toward the Mexican border, a getaway driver disguised as a clown and his wounded accomplice try to escape the American Police with a loot of over $2 million hidden in the trunk of the car. In a desperate attempt to break through the thick border fence, the driver crashes the car, the accomplice dies and he inevitably gets apprehended by Mexican Police officers Romero and Vasquez who want the money just for themselves. As the only American inmate in the infamous \"El Pueblito\" Mexican prison, which resembles more of a small village of convicts rather than a usual prison, the driver quickly gets the nickname \"The Gringo\" and finds out first hand how rough it is to be a stranger in the perilous world of Javi, the ruthless crime lord who runs the prison. Sooner or later, the Gringo will form an alliance with a 10-year-old kid whose peculiar immunity in this mad place will efficiently keep him alive, only to realise that in this pit, everyone knows about the $2 million. In the end, with an order issued for his execution and knowing that his time is short, will the Gringo manage to save himself and the kid's family, get his money and ultimately escape once and for all from the El Pueblito?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7}],"value":7,"age":"R"},"episode_id":6680,"content_control":"FAMILY"}}