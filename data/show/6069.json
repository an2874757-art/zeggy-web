0b3eb14b-aefa-4d72-af86-dcfb422c6912.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6069,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller"],"id":6069,"type":"MOVIE","title":"13","logo":"","image":"https://cdn6.albox.co/storage/disk58/shows/c49b14ae-5e05-498c-86fb-e7781f60d0a7.jpg","background_image":"https://cdn6.albox.co/storage/disk43/shows/251a1ec8-a8db-419f-9dc8-549d4ae9d190.jpg","likes":89,"dislikes":4,"views":19305,"release_date":"1267401600000","length":5832,"description":"In Talbot, Ohio, a father's need for surgeries puts the family in a financial bind. His son Vince, an electrician, overhears a man talking about making a fortune in just a day. When the man overdoses on drugs, Vince finds instructions and a cell phone that the man has received and substitutes himself: taking a train to New York and awaiting contact. He has no idea what it's about. He ends up at a remote house where wealthy men bet on who will survive a complicated game of Russian roulette: he's number 13. In flashbacks we meet other contestants, including a man whose brother takes him out of a mental institution in order to compete. Can Vince be the last one standing?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"episode_id":6069,"content_control":"NORMAL"}}