":11916,"title":"","description":"2","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Romance","Comedy"],"id":11916,"type":"MOVIE","title":"Mubarakan","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/da0bd219-4179-432d-a05c-e5488bd31dbb.jpg","background_image":"https://cdn6.albox.co/storage/disk49/shows/986d52e3-66a3-4667-9fa4-70e89e5def4c.jpg","likes":13,"dislikes":0,"views":3167,"release_date":"1501200000000","length":9310,"description":"Karan and Charan are identical twin brothers but their personalities are polar opposites. Karan has grown up in London while Charan was raised in Punjab. Karan is street-smart, calculating and flamboyant while Charan is simple, idealistic and honest in his approach. Karan is in love with Sweety while Charan is in a relationship with Nafisa. Karan's family fixes Karan's wedding with Binkle, daughter of one of the wealthiest families in London. He convinces his family to fix the match with Charan instead. The respective families are happy with this development except Charan because he wants to marry Nafisa.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5.6}],"value":5.6,"age":"PG-13"},"episode_id":11916,"content_control":"NORMAL"}}