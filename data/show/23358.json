torage/CLOUD00/seasons/66b9f763-649a-4d5f-872d-f0a9c4c1ba7a.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/seasons/3cf5880d-7ada-4c8f-a136-05c015dc5a23.jpg","likes":13,"dislikes":0,"views":3446,"release_date":"1611273600000","season_number":1,"description":"تعيش تاوان مع Yuanjai ، عمتها ، وابنتها Yadfa كخادمات. يهود ، قدم عمها ذات مرة وعدًا لصديقه ترونج لترتيب زواج بين أطفالهما. يرفض Yadfa ذلك ، معتقدًا أن Tomorn ، ابن Trong ، رجل ريفي فقير ، وهو أيضًا على علاقة مع Bunlaeng. إنهم لا يكسبون أي أموال ، فقط ينفقون أموال Yuanjai. في أحد الأيام ، أعطى تومورن يده لسداد دين لـ Yuanjai ، لذلك سمحت لـ Tawan بالزواج منه باسم Yadfa. في منزل تومورن ، تتعرض دائمًا للتخويف من قبل ساواي ، ووالدته ، وجينغكيو ، ومربية أخته ، وسوبيت ، صديقه الذي يعشقه","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.3}],"value":7.3,"age":"R"},"current_season_id":12002,"content_control":"NORMAL"}}