:{"image":"https://cdn6.albox.co/storage/disk50/shows/cd15b7ac-a298-4b85-93c7-a5ad74c7e190.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":7900,"title":"","description":"4","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Romance","Mystery"],"id":7900,"type":"MOVIE","title":"The Constant Gardener","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/81cab33c-f532-4f39-87ce-aaca854ec91d.jpeg","background_image":"https://cdn6.albox.co/storage/disk48/shows/43626c40-bd55-445d-bcd1-de013e9b4c0c.jpeg","likes":31,"dislikes":0,"views":4981,"release_date":"1125446400000","length":7709,"description":"In a remote area of Northern Kenya, activist Tessa Quayle is found brutally murdered. Tessa's companion, a doctor, appears to have fled the scene, and the evidence points to a crime of passion. Members of the British High Commission in Nairobi assume that Tessa's widower, their mild-mannered and unambitious colleague Justin Quayle, will leave the matter to them. They could not be more wrong. Haunted by remorse and jarred by rumors of his late wife's infidelities, Quayle surprises everyone by embarking on a personal odyssey that will take him across three continents. Using his privileged access to diplomatic secrets, he will risk his own life, stopping at nothing to uncover and expose the truth - a conspiracy more far-reaching and deadly than Quayle could ever have imagined.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.4}],"value":7.4,"age":"R"},"episode_id":7900,"content_control":"NORMAL"}}