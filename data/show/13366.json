":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":13366,"title":"","description":"0","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":13366,"type":"MOVIE","title":"Black Widow.","logo":"","image":"https://cdn6.albox.co/storage/disk51/shows/617248c7-96c2-4441-99e2-6660f95ee831.jpg","background_image":"https://cdn6.albox.co/storage/disk44/shows/f8e7e3a5-a5bb-4aee-b683-fb5f34c082ed.jpg","likes":8,"dislikes":1,"views":4287,"release_date":"539568000000","length":6111,"description":"Catherine is a black widow. \"She mates and then she kills\". Black Widow is the story of a lady (Catherine) who marries lonely millionaires, waits until they've changed their will to leave all to their beloved wives and then murders them to inherit the fortune. With each man Catherine marries, she changes her appearance to suit the mans personality. Only there's one problem. Alexandra is a smart cookie and has found a link between these unexplained mysterious deaths and the partners wives. But now her only problem is proving that a killer is on the loose and saving herself from the deadly Black Widow.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"R"},"episode_id":13366,"background_color":"","content_control":"NORMAL"}}