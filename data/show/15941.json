],"id":15941,"type":"SERIES","title":"The Affair","logo":"","image":"https://cdn6.albox.co/storage/disk57/shows/f6e75ccf-4250-4fc0-9446-8662890fd201.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/a99a9b05-829e-4b92-a335-08a2710dfb45.gif","likes":74,"dislikes":6,"views":31167,"release_date":"1413072000000","season_number":1,"description":"At once deeply observed and intriguingly elusive, The Affair explores the emotional effects of an extramarital relationship. Noah is a New York City schoolteacher and budding novelist with a wife of twenty years and four children. Alison is a young waitress and wife from Montauk at the end of Long Island, trying to piece her life back together in the wake of a tragedy. The provocative drama unfolds separately from multiple perspectives, using the distinct memory biases of each character to tell the story. Created by Sarah Treem.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8}],"value":8,"age":"R"},"current_season_id":3401,"content_control":"FAMILY"}}