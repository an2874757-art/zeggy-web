":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3631,"title":"","description":"3","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Thriller","Crime"],"id":3631,"type":"MOVIE","title":"Flash Point","logo":"","image":"https://cdn6.albox.co/storage/disk49/shows/10eaf71b-daba-4fb1-a5d4-3bd36ceea132.jpg","background_image":"https://cdn6.albox.co/storage/disk46/shows/29cc4299-1961-4271-9c29-63347674e3e6.jpg","likes":47,"dislikes":1,"views":8062,"release_date":"1185408000000","length":5231,"description":"Ma Jun, a cop known for dispensing justice during arrests, teams with Hua Sheng, who's undercover, to try to bring down three merciless Vietnamese brothers running a smuggling ring in the months before the mainland's takeover of Hong Kong. The eldest, Xian Wei Cha (called Zah), is arrested in an operation that exposes Sheng and almost gets him killed. His girlfriend, Qiu Di, who's been unaware of Sheng's profession, wants to see him quit. Jun pursues the gang tirelessly, sometimes ignoring police protocols. Zah's trial approaches, witnesses are in danger, and a showdown is inevitable.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.8}],"value":6.8,"age":"R"},"episode_id":3631,"content_control":"NORMAL"}}