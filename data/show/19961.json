"}],"post_info":{"genres":["Action"],"id":19961,"type":"SERIES","title":"تانغو","logo":"","image":"https://cdn6.albox.co/storage/disk57/seasons/838cd8db-6b24-497c-b807-9b0f0423e902.jpg","background_image":"https://cdn6.albox.co/storage/disk43/seasons/f18614ef-af57-46b0-a0f3-f797640d8505.jpg","likes":75,"dislikes":2,"views":26668,"release_date":"-2208988800000","season_number":1,"description":"تدور أحداث حول رجل الأعمال (عامر)، وزوجته ربة المنزل (لينا)، وطفلهما الصغير، والمهندس (سامي) وزوجته مدربة رقص التانغو (فرح)، يجمع الأربعة صداقة وثيقة وعلاقة عمل متينة، لكن الأسرار تجعل الغموض يتسرب إلى حياتهم خاصة بعد تعرض سيارة أحدهم لحادث مروع، وهو ما فتح الباب عن الحقائق المؤلمة عن الحب والخيانة والانتقام، فهل سيقع أحدهم في المحظور؟.","rating":{"sources":[],"value":0,"age":""},"current_season_id":8774,"content_control":"NORMAL"}}