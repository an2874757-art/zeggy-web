,"url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Comedy","Animation","Family"],"id":14578,"type":"SERIES","title":"The Pink Panther Show","logo":"","image":"https://cdn6.albox.co/storage/disk49/seasons/d89b0690-b67b-4d8b-8902-76cb21944fcb.jpg","background_image":"https://cdn6.albox.co/storage/disk48/seasons/24572452-9165-42e5-8ea9-828915dc83ba.jpg","likes":388,"dislikes":11,"views":50024,"release_date":"-10108800000","season_number":1,"description":"النمر الوردي هو قط كرتوني بطولي وأخلاقي ذو فراء وردي وأخلاق أرستقراطي إنجليزي. إنه يصبح مرتبكًا أو غاضبًا فقط من البشر المنفرجين أو المسيئين الذين يحاولون تعطيل وجوده، أو من الأدوات المزعجة أو القوارض أو الحشرات. في معظم رسومه الكاريكاتورية، يتعثر في موقف صعب ويسعى بصبر لتحقيق أقصى استفادة منه. تتميز حلقات هذه السلسلة بثلاثة رسوم كاريكاتورية مسرحية، اثنتان منها مع النمر الوردي، وواحدة تظهر المفتش، وهو نسخة كرتونية من المحقق الفرنسي المتلعثم المعرض للحوادث، المفتش كلوزو، الذي لعب دوره في أفلام بيتر سيلرز. غالبًا ما يتم مساعدة المفتش من قبل شرطي إسباني، الرقيب Deux-Deux، ويقاتلون معًا الأشرار من جميع الأشكال والأحجام في أجزاء مختلفة من العالم، دائمًا بناءً على أوامر المفوض الأمني ​​الذي طالت معاناته.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.6}],"value":7.6,"age":"TV-G"},"current_season_id":1522,"content_control":"NORMAL"}}