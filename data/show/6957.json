ogress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":6957,"title":"","description":"6","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Comedy"],"id":6957,"type":"MOVIE","title":"Meet Bill","logo":"","image":"https://cdn6.albox.co/storage/disk42/shows/d4d9a2a1-07cd-4fe4-aec0-5f37eeda9974.jpg","background_image":"https://cdn6.albox.co/storage/disk56/shows/0fee3499-79cd-4bec-85c8-5bba5dc5c70a.jpg","likes":23,"dislikes":0,"views":3374,"release_date":"1213747200000","length":5367,"description":"Bill is unhappy: he has married a banker's daughter and has a dead end job at the bank; his wife Jess is tied to daddy's wallet; and, Bill is developing a gut from lack of exercise and constantly eating candy bars. He dreams of buying a donut franchise to be independent of Jess's dad. Bill is roped into a mentoring program at his old prep school, assigned a smart-mouthed kid who pops up when least expected. When Jess starts an affair with Chip, a local TV personality and vain Rob Lowe look-alike, it sends Bill, the kid, and a young sales clerk from a lingerie shop on a quest to win back Jess and get the donuts. What about self-respect?","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"R"},"episode_id":6957,"content_control":"FAMILY"}}