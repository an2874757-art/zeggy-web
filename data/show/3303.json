ength":0,"continue_watching_progress":0},{"items":[],"id":9810,"title":"The Notebook","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk53/shows/ad25789e-24c3-4d35-bd20-128a953391b5.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":12983,"title":"The Maze Runner","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk51/shows/fba5f13f-990e-4fa0-8e6e-99555a0d7876.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":10226,"title":"The Avengers","description":"","card_type":"normalPoster","type":"MOVIE","url":"","style":{"image":"https://cdn6.albox.co/storage/disk58/shows/88d67035-c070-4881-b4ea-0d3dccfb3fd6.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":3303,"title":"","description":"7","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Thriller","Crime"],"id":3303,"type":"MOVIE","title":"The Hunted","logo":"","image":"https://cdn6.albox.co/storage/disk60/shows/cefd72eb-4398-496f-8ec0-2ddc4c6862df.jpg","background_image":"https://cdn6.albox.co/storage/disk55/shows/c35a232c-23b6-454a-bdf0-1f0f47b4b1e2.jpg","likes":59,"dislikes":1,"views":9417,"release_date":"1047600000000","length":5676,"description":"In the green woods of Silver Falls, Oregon, Aaron Hallam, a trained assassin AWOL from the Special Forces, keeps his own brand of wildlife vigil. After Hallam brutally slew four deer hunters in the area, FBI Special Agent Abby Durrell turns to L.T. Bonham-- the one man who may be able to stop him. At first L.T. resists the mission. Snug in retirement, he's closed off to his past, the years he spent in the Special Forces training soldiers to become skilled killers. But when he realizes that these recent slaying is the work of a man he trained, he feels obligated to stop him. Accepting the assignment under the condition that he works alone, L.T. enters the woods, unarmed--plagued by memories of his best student and riddled with guilt for not responding to Aaron's tortured letters to him as he began to slip over the edge of sanity. Furious as he is with his former mentor for ignoring his pleas for help, Aaron knows that he and L.T. share a tragic bond that is unbreakable. And, even as they go into their final combat against each other, neither can say with certainty who is the hunted and who is the hunter.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.1}],"value":6.1,"age":"R"},"episode_id":3303,"content_control":"FAMILY"}}