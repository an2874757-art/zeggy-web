ows/77310be4-6fbf-44ef-85c5-7b45c2e325d5.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":9049,"title":"","description":"60","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Drama","Crime"],"id":9049,"type":"MOVIE","title":"The Take: Bastille Day","logo":"https://cdn7.albox.co/storage/CLOUD00/shows/9d8ea6e8-0424-42a1-890b-14ebf63acc99.png","image":"https://cdn7.albox.co/storage/CLOUD00/shows/130226d7-ced4-4686-9c21-1bbe806b84bc.jpg","background_image":"https://cdn7.albox.co/storage/CLOUD00/shows/982d64a8-6a4c-4415-95bc-b0d10fdab37c.jpg","likes":482,"dislikes":12,"views":30851,"release_date":"1479427200000","length":5528,"description":"Michael Mason, a pick-pocket living in Paris steals a bag with a teddy bear in it. Not realizing the toy contains a timed bomb, he tosses it aside on a busy street. A few seconds later it explodes, killing four people. CCTV footage reveals Masons face and the French police tag him as a terrorist threat. The explosion, although botched, was set up by a select group of the French Interior Ministry as a decoy so they can make a half billion dollar digital transfer from a bank, (closed on French National Day) -hence the title Bastille Day. In a separate CIA investigation the unruly agent Sean Briar, discovers the real story behind Masons \"terrorist attack\". The two men, on different sides of the law, collaborate to bring the corrupt members of the Ministry down.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":6.3}],"value":6.3,"age":"R"},"episode_id":9049,"background_color":"","content_control":"NORMAL"}}