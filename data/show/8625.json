title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":8625,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Fantasy","Crime"],"id":8625,"type":"MOVIE","title":"Catwoman.","logo":"","image":"https://cdn6.albox.co/storage/disk50/shows/f744dd30-07fc-4330-be91-8cd0f7a1e1d9.jpg","background_image":"https://cdn6.albox.co/storage/disk58/shows/2d329400-d41a-4419-bc31-a5613d937c92.jpg","likes":233,"dislikes":9,"views":26427,"release_date":"1090540800000","length":6258,"description":"Catwoman is the story of shy, sensitive artist Patience Philips, a woman who can't seem to stop apologizing for her own existence. She works as a graphic designer for Hedare Beauty, a mammoth cosmetics company on the verge of releasing a revolutionary anti-aging product. When Patience inadvertently happens upon a dark secret her employer is hiding, she finds herself in the middle of a corporate conspiracy. What happens next changes Patience forever. In a mystical twist of fate, she is transformed into a woman with the strength, speed, agility and ultra-keen senses of a cat. With her newfound prowess and feline intuition, Patience becomes Catwoman, a sleek and stealthy creature balancing on the thin line between good and bad. Like any wildcat, she's dangerous, elusive and untamed. Her adventures are complicated by a burgeoning relationship with Tom Lone, a cop who has fallen for Patience but cannot shake his fascination with the mysterious Catwoman, who appears to be responsible for a string of crime sprees plaguing the city.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":3.3}],"value":3.3,"age":"PG-13"},"episode_id":8625,"content_control":"FAMILY"}}