11","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Animation","Crime"],"id":16655,"type":"SERIES","title":"Jormungand","logo":"","image":"https://cdn6.albox.co/storage/disk60/seasons/8ee8f49d-2f34-4446-bc41-dd6d7199cd70.png","background_image":"","likes":122,"dislikes":0,"views":9871,"release_date":"1334016000000","season_number":1,"description":"The series follows Koko Hekmatyar, a young arms dealer who sells weapons under HCLI, an international shipping corporation that secretly deals in the arms trade. As one of the company's unofficial weapon dealers, she secretly sells weapons in many countries while avoiding the local authorities and law enforcement agencies as most of her work is actually illegal under international law. Traveling with her is her team of bodyguards who are mostly composed of ex-military veterans. Her latest addition to her crew is Jonah, a seemingly emotionless child soldier who is skilled in combat yet ironically hates arms dealers. What follows is Koko and her crew's escapades around the world.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.5}],"value":7.5,"age":"r"},"current_season_id":4398,"content_control":"NORMAL"}}