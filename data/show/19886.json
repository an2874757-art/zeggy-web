f258.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":26382,"title":"The Summer I Turned Pretty","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/7d8ccd4a-e18a-4ea5-acdb-c160b52f1348.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":20821,"title":"suits","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk45/shows/b29de34e-f789-4238-95ca-c5efa4092f0c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":15735,"title":"La Casa de Papel","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn6.albox.co/storage/disk52/shows/7cd5ece5-c348-4082-b873-4a427da2b00c.jpg"},"length":0,"continue_watching_progress":0},{"items":[],"id":21115,"title":"Black Mirror","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn7.albox.co/storage/CLOUD00/shows/c9520ac0-e8f3-4c13-b253-0810cb5fe789.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":19886,"title":"","description":"34","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","Thriller","Crime"],"id":19886,"type":"SERIES","title":"Fargo","logo":"https://cloud01.albox.co/shows/64df2c25-64e8-418c-bfb9-32bacd54ac9b.png","image":"https://cdn6.albox.co/storage/disk58/seasons/b0972897-ab02-4d19-a5e0-c54e7cfadb24.png","background_image":"https://cdn6.albox.co/storage/disk44/seasons/cde1f013-25e0-48f5-af1b-59f7168e7131.png","likes":326,"dislikes":17,"views":51242,"release_date":"1397520000000","season_number":1,"description":"The all new \"true crime\" case of Fargo's new chapter travels back to 1979 in Sioux Falls, South Dakota and Luverne, Minnesota, where a young State Police Officer Lou Solverson, recently back from Vietnam, investigates a case involving a local crime gang and a major Mob syndicate. Helping him piece things together is his father-in-law, Sheriff Hank Larsson. The investigation will lead them to a colorful cast of characters that includes Karl Weathers, the town lawyer of Luverne, Minnesota. A Korean War vet, Karl is a flowery drunk blessed with the gift of gab and the eloquence of a true con artist. Joe Bulo, the front man for the northern expansion of a Kansas City crime syndicate. The new face of corporate crime, Joe's bringing a Walmart mentality to small town America. His number two is Mike Milligan. Part enforcer, part detective, Mike is always smiling - but the joke is usually on you. Bulo and his crew have their sights set on the Gerhardt crime family in Fargo, currently led by matriarch Floyd Gerhardt. With her husband at death's door, Floyd takes over the family business, frustrating her eldest son, Dodd Gerhardt. An impatient hothead with a cruel streak to match his ambitions, Dodd can't wait for both his parents to die so he can take over and expand their business from kingdom to empire. Bear Gerhardt is the middle son, an intimidatingly large man who, although inarticulate, is the most decent of his clan. Rye Gerhardt, the youngest of the Gerhardt clan, views himself as a big shot, but in reality he's just a small dog who barks big.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":8.9}],"value":8.9,"age":"r"},"background_color":"#fff0dc","current_season_id":8684,"content_control":"NORMAL"}}