:0,"continue_watching_progress":0},{"items":[],"id":24402,"title":"سندباد","description":"","card_type":"normalPoster","type":"SERIES","url":"","style":{"image":"https://cdn8.albox.co/storage/CLOUD00/shows/973312eb-b6f2-48b2-8aea-3dc61bc852b1.jpg"},"length":0,"continue_watching_progress":0}],"id":0,"title":"Related","section_type":"normalPoster"},{"data":[{"items":[],"id":26601,"title":"","description":"13","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Drama","رياضي"],"id":26601,"type":"SERIES","title":"شعلة ريكا","logo":"","image":"https://cdn8.albox.co/storage/CLOUD00/seasons/371f8573-2b08-4f96-9811-365f04757978.jpg","background_image":"https://cdn8.albox.co/storage/CLOUD00/seasons/068c139a-f2b5-4a97-9194-d20b795d9069.jpg","likes":370,"dislikes":1,"views":21215,"release_date":"1262736000000","season_number":1,"description":"تحكي القصة عن شاب في مقتبل العمر إسمه ريكا, وهو طالب في الثانويه يعيش حياة هادئه ومعروف بشدة ولعه بالنينجا وقوته في القتال ، حتى أن الجميع يحاولون التغلب عليهم لكن دون جدى.\r\nالمهم إلتقى ريكا بفتاة إسمها شيرا التي تمتلك القدرة على شفاء الآخرين والتي أنقذته من حادث وبعد ذلك الحادث أصبحوا أصدقاء.\r\nهوجم كل من منمها من قبل إمرأه غريبه حاولت قتلهما وفي نفس الوقت كانت تحاول إخراج قوة النار المتخزله في يد ريكا اليمنى, وبعد هذا الحدث ستطور الأحداث وستكشف حقيقة ريكا وحقيقة تلك المرأه التي هاجمته.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":5}],"value":5,"age":"PG"},"background_color":"","current_season_id":14330,"content_control":"NORMAL"}}