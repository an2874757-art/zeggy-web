":7519,"title":"","description":"19","card_type":"comments","type":"comments","url":"","style":null,"length":0,"continue_watching_progress":0}],"id":0,"title":"Comments","section_type":"comments"}],"post_info":{"genres":["Action","Adventure"],"id":7519,"type":"MOVIE","title":"First Blood","logo":"","image":"","background_image":"https://cdn6.albox.co/storage/disk44/shows/e7a31455-b923-40e0-a507-ec8b2274edf2.jpg","likes":229,"dislikes":3,"views":30298,"release_date":"404092800000","length":5604,"description":"(جون رامبو) المقاتل السابق في قوات العمليات الخاصة الأمريكية، وأحد أبطال حرب فيتنام، يعود مرة أخرى بعد تقاعده، وحصوله على وسام شجاعة، يذهب في زيارة لأحد أصدقائه في واشنطن، ويعلم مأمور البلدة (تيزل) بوجوده في المدينة، وهو يكن له عداء قديمًا، فيقوم باستفزازه، وتوجيه السباب له؛ مما يثير غضب (رامبو)، فيقوم بسبه وضربه، فيصدر المأمور أمرًا بسجنه، فيهرب (رامبو) إلى الغابات القريبة، ويعلم قائده السابق (تروتمان) بالأمر، فيحاول تداركه.","rating":{"sources":[{"title":"IMDb","logo":"https://a7.pnghunt.com/preview/450/662/555/computer-wallpaper-text-brand-yellow-imdb.jpg","max_value":10,"value":7.7}],"value":7.7,"age":"R"},"episode_id":7519,"content_control":"FAMILY"}}