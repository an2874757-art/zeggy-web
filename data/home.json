ه بعدها، والتي من أبرزها (Argo، Gone Girl، Pearl Harbor).","card_type":"actorArtWork","type":"ACTOR","style":{"image":"https://cdn6.albox.co/storage/disk58/actors/8a320cf3-9653-4897-9de7-5e9fdd7b146d.jpg"},"items":[{"id":5837,"image":"https://cdn6.albox.co/storage/disk44/shows/e17ff9b9-92da-473b-b7d8-17418aeaa0bd.jpg"},{"id":10444,"image":"https://cdn6.albox.co/storage/disk49/shows/5b34869e-e4dd-44ab-b186-759f152a3c31.jpg"},{"id":6682,"image":"https://cdn6.albox.co/storage/disk60/shows/24d63ca0-c8b8-416f-bfa1-feda6d18d28f.png"}]},{"id":746,"title":"Matt Damon","description":"","card_type":"actorArtWork","type":"ACTOR","style":{"image":"https://cdn6.albox.co/storage/disk50/actors/41d31961-93c5-4571-9a99-f537ef309d8b.jpg"},"items":[{"id":937,"image":"https://cdn6.albox.co/storage/disk56/shows/20a961bc-673a-4c59-88af-ff8761d83e71.jpg"},{"id":6719,"image":"https://cdn6.albox.co/storage/disk51/shows/427c1625-301a-4332-9d60-c150cfd98027.jpg"},{"id":13258,"image":"https://cdn6.albox.co/storage/disk48/shows/fcedc6d7-3794-4d3a-8420-9cb318cbdc98.jpg"}]},{"id":1482,"title":"Richard Brake","description":"","card_type":"actorArtWork","type":"ACTOR","style":{"image":"https://cdn6.albox.co/storage/disk44/actors/845dd06c-cead-4bfe-8556-5a8ce1b7c4a8.jpg"},"items":[{"id":10130,"image":"https://cdn6.albox.co/storage/disk56/shows/9bc68d4c-b831-454d-88d4-f05658cbed07.jpg"},{"id":2887,"image":"https://cdn6.albox.co/storage/disk59/shows/f746a183-5e26-40ab-b736-00fe5320f443.jpg"},{"id":8244,"image":"https://cdn6.albox.co/storage/disk44/shows/0636be2b-9b93-4833-a93f-593fe90742cb.jpg"}]},{"id":3607,"title":"Edgar Wright","description":"","card_type":"actorArtWork","type":"ACTOR","style":{"image":"https://cdn6.albox.co/storage/disk56/actors/0004dfa2-fc8d-44f0-bbe2-9b8cfdfc37bb.jpg"},"items":[{"id":8793,"image":"https://cdn6.albox.co/storage/disk46/shows/d8c7adcc-01c8-4db1-a2a2-e5b0c89297c5.jpg"},{"id":9364,"image":"https://cdn6.albox.co/storage/disk53/shows/bd37da1a-c5d6-4f40-b7dc-7d4c6b91618